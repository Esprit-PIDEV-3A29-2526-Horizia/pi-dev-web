parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        # Doctrine EntityManager/Repository interfaces don't expose createQueryBuilder
        - 
            message: '#Call to an undefined method Doctrine\\Persistence\\ObjectManager::createQueryBuilder\(\)#'
            paths:
                - src/
        # Method exists checks that are always true
        -
            message: '#Call to function method_exists\(\) with#'
            paths:
                - src/
        # Endroid QrCode enum constants not recognized
        -
            message: '#Access to constant (High|Margin) on an unknown class Endroid#'
            paths:
                - src/
        # Custom entity methods that may not be recognized
        -
            message: '#Call to an undefined method App\\Entity\\Reservation::getLogement\(\)#'
            paths:
                - src/

includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
