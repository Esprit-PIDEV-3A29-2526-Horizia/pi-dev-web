{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier un commentaire{% endblock %}

{% block admin_content %}
<div class="card">
    <div class="card-header bg-white">
        <h2 class="h4 mb-0">Modifier le commentaire #{{ commentaire.id }}</h2>
    </div>
    <div class="card-body">
        {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="mb-3">
            {{ form_label(form.contenu) }}
            {{ form_widget(form.contenu, {attr: {class: 'form-control', rows: 8}}) }}
            {{ form_errors(form.contenu) }}
        </div>
        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('admin_commentaire_index') }}" class="btn btn-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
'@ | Out-File -FilePath templates\admin\commentaire\edit.html.twig -Encoding utf8