{% extends 'base.html.twig' %}
{% block title %}Horizia - Réservation{% endblock %}
{% block body %}
<div class="hz-client">
  <nav class="hz-navbar">
    <div class="hz-nav-brand"><span class="hz-brand-text">HORIZIA</span></div>
    <div class="hz-nav-links">
      <a href="{{ path('client_accueil') }}" class="hz-nav-link">Accueil</a>
      <a href="{{ path('client_catalogue') }}" class="hz-nav-link active">Catalogue</a>
      <a href="{{ path('client_mes_reservations') }}" class="hz-nav-link">Mes Réservations</a>
      <a href="{{ path('client_planning') }}" class="hz-nav-link">Planning</a>
    </div>
    <div class="hz-nav-right">
      <div class="hz-user-badge"><i class="bi bi-person-fill me-1"></i>Client</div>
    </div>
  </nav>

  <div class="hz-page-banner">
    <h1><i class="bi bi-calendar-plus me-3"></i>Réservation</h1>
    <p>Complétez le formulaire pour réserver votre véhicule</p>
  </div>

  <div class="hz-main-content">
    {% if errors is defined and errors %}
    <div class="hz-alert-errors">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      {% for err in errors %}<div>{{ err }}</div>{% endfor %}
    </div>
    {% endif %}

    <form method="POST" action="{{ path('client_reservation', {id: vehicule.idVehicule}) }}" id="resa-form">
      <div class="hz-resa-layout">

        {# ── COL GAUCHE — VOITURE ── #}
        <div class="hz-col-left">
          <div class="hz-form-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-car-front-fill me-2" style="color:var(--hz-primary)"></i>Véhicule sélectionné
            </h5>
            {% if vehicule.imageUrl is defined and vehicule.imageUrl %}
              <img src="{{ asset('uploads/vehicules/' ~ vehicule.imageUrl) }}"
                   class="hz-veh-img" alt="{{ vehicule.immatriculation }}"
                   onerror="this.style.display='none'">
            {% endif %}
            <div class="hz-veh-title">
              {% if vehicule.modele is defined %}{{ vehicule.modele.nomModele ?? vehicule.immatriculation }}
              {% else %}{{ vehicule.immatriculation }}{% endif %}
            </div>
            <div class="hz-veh-specs">
              <span>📏 {{ vehicule.kilometrage|number_format(0,'.','') }} km</span>
              <span>🔖 {{ vehicule.immatriculation }}</span>
              {% if vehicule.carburant is defined %}<span>⛽ {{ vehicule.carburant }}</span>{% endif %}
            </div>
            <div class="hz-veh-price">
              <span class="hz-price-big">{{ vehicule.prixParJour|number_format(2,'.','') }} TND</span>
              <span class="hz-price-unit">/ jour</span>
            </div>
          </div>

          {# Récapitulatif auto #}
          <div class="hz-form-card hz-recap-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-receipt me-2" style="color:var(--hz-primary)"></i>Récapitulatif
            </h5>
            <div class="hz-recap-line">
              <span>Durée</span>
              <strong id="r-jours">— jours</strong>
            </div>
            <div class="hz-recap-line">
              <span>Prix de base</span>
              <strong id="r-base">0.000 TND</strong>
            </div>
            <div class="hz-recap-line" id="r-extras-row" style="display:none">
              <span>Extras</span>
              <strong id="r-extras">0.000 TND</strong>
            </div>
            <hr>
            <div class="hz-recap-line hz-recap-total">
              <span>Total</span>
              <strong id="r-total" style="color:#27ae60">0.000 TND</strong>
            </div>
            <div class="hz-recap-line">
              <span>Avance (30%)</span>
              <strong id="r-avance" style="color:var(--hz-primary)">0.000 TND</strong>
            </div>
          </div>
        </div>

        {# ── COL DROITE — FORMULAIRE ── #}
        <div class="hz-col-right">

          {# Dates #}
          <div class="hz-form-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-calendar-range me-2" style="color:var(--hz-primary)"></i>Période de location
            </h5>
            <div class="hz-form-row">
              <div class="hz-form-group">
                <label class="hz-label">Date de début *</label>
                <input type="date" name="date_debut" id="date_debut"
                       value="{{ date_debut ?? 'now'|date('Y-m-d') }}"
                       min="{{ 'now'|date('Y-m-d') }}"
                       class="hz-input" required>
              </div>
              <div class="hz-form-group">
                <label class="hz-label">Date de fin *</label>
                <input type="date" name="date_fin" id="date_fin"
                       value="{{ date_fin ?? '+3 days'|date('Y-m-d') }}"
                       min="{{ 'now'|date('Y-m-d') }}"
                       class="hz-input" required>
              </div>
            </div>
          </div>

          {# Informations client #}
          <div class="hz-form-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-person-fill me-2" style="color:var(--hz-primary)"></i>Informations client
            </h5>
            <div class="hz-form-group">
              <label class="hz-label">Nom complet *</label>
              <input type="text" name="nom_complet" value="{{ data.nom_complet ?? '' }}"
                     class="hz-input" placeholder="Prénom et Nom" required>
            </div>
            <div class="hz-form-row">
              <div class="hz-form-group">
                <label class="hz-label">Téléphone *</label>
                <input type="text" name="telephone" value="{{ data.telephone ?? '' }}"
                       class="hz-input" placeholder="+216 XX XXX XXX" required>
              </div>
              <div class="hz-form-group">
                <label class="hz-label">CIN / Passport *</label>
                <input type="text" name="cin" value="{{ data.cin ?? '' }}"
                       class="hz-input" placeholder="12345678" required>
              </div>
            </div>
            <div class="hz-form-group">
              <label class="hz-label">Email (pour confirmation)</label>
              <input type="email" name="email" value="{{ data.email ?? '' }}"
                     class="hz-input" placeholder="client@email.com">
            </div>
            <div class="hz-form-group">
              <label class="hz-label">Adresse</label>
              <input type="text" name="adresse" value="{{ data.adresse ?? '' }}"
                     class="hz-input" placeholder="Adresse complète">
            </div>
          </div>

          {# Extras #}
          <div class="hz-form-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-plus-circle me-2" style="color:var(--hz-primary)"></i>Options supplémentaires
            </h5>
            <div class="hz-extras-grid">
              <label class="hz-extra-item">
                <input type="checkbox" name="gps" value="1" onchange="calculer()"> 
                <i class="bi bi-geo-alt-fill"></i>
                <div><div class="hz-extra-name">GPS</div><div class="hz-extra-price">+10.000 TND</div></div>
              </label>
              <label class="hz-extra-item">
                <input type="checkbox" name="siege_bebe" value="1" onchange="calculer()">
                <i class="bi bi-person-fill"></i>
                <div><div class="hz-extra-name">Siège bébé</div><div class="hz-extra-price">+15.000 TND</div></div>
              </label>
              <label class="hz-extra-item">
                <input type="checkbox" name="assurance" value="1" onchange="calculer()">
                <i class="bi bi-shield-check"></i>
                <div><div class="hz-extra-name">Assurance compl.</div><div class="hz-extra-price">+25.000 TND</div></div>
              </label>
            </div>
          </div>

          {# Notes #}
          <div class="hz-form-card">
            <h5 class="hz-form-section-title">
              <i class="bi bi-sticky me-2" style="color:var(--hz-primary)"></i>Notes
            </h5>
            <textarea name="notes" class="hz-input" rows="3"
                      placeholder="Informations supplémentaires...">{{ data.notes ?? '' }}</textarea>
          </div>

          {# Conditions + Boutons #}
          <div class="hz-form-card">
            <label class="hz-conditions">
              <input type="checkbox" name="conditions" value="1" required>
              <span>J'accepte les <a href="#" class="hz-link">conditions générales</a> de location.</span>
            </label>
            <div class="hz-form-actions">
              <a href="{{ path('client_catalogue') }}" class="hz-btn-cancel">
                <i class="bi bi-x-lg me-2"></i>Annuler
              </a>
              <button type="submit" class="hz-btn-confirm">
                <i class="bi bi-check-lg me-2"></i>Confirmer la réservation
              </button>
            </div>
          </div>

        </div>
      </div>
    </form>
  </div>

  <footer class="hz-footer">
    <div><i class="bi bi-car-front-fill me-2"></i>HORIZIA <span class="ms-3 text-white-50">Agence de Voyage — Tunis, Tunisie</span></div>
    <div><span><i class="bi bi-telephone me-1"></i>+216 53661445</span><span class="ms-4">© 2025 Horizia</span></div>
  </footer>
</div>

{% block javascripts %}{{ parent() }}<script>
const PRIX_JOUR = {{ vehicule.prixParJour }};
const EXTRAS    = { gps: 10, siege_bebe: 15, assurance: 25 };

function calculer() {
  const d1 = new Date(document.getElementById('date_debut').value);
  const d2 = new Date(document.getElementById('date_fin').value);
  let jours = isNaN(d1) || isNaN(d2) ? 0 : Math.max(1, Math.ceil((d2 - d1) / 86400000));

  let extras = 0;
  Object.keys(EXTRAS).forEach(k => {
    if (document.querySelector(`input[name="${k}"]`)?.checked) extras += EXTRAS[k];
  });

  const base  = jours * PRIX_JOUR;
  const total = base + extras;
  const avance = total * 0.30;

  document.getElementById('r-jours').textContent  = jours + ' jour(s)';
  document.getElementById('r-base').textContent   = base.toFixed(3)  + ' TND';
  document.getElementById('r-total').textContent  = total.toFixed(3) + ' TND';
  document.getElementById('r-avance').textContent = avance.toFixed(3)+ ' TND';
  if (extras > 0) {
    document.getElementById('r-extras').textContent = extras.toFixed(3) + ' TND';
    document.getElementById('r-extras-row').style.display = '';
  } else {
    document.getElementById('r-extras-row').style.display = 'none';
  }
}
document.getElementById('date_debut').addEventListener('change', calculer);
document.getElementById('date_fin').addEventListener('change', calculer);
calculer();
</script>{% endblock %}

<style>
:root { --hz-primary:#23779C; --hz-accent:#e8a020; --hz-nav-bg:#1a3a4a; }
.hz-client { font-family:'Segoe UI',sans-serif; background:#f0f4f7; min-height:100vh; }
.hz-navbar { background:var(--hz-nav-bg); display:flex; align-items:center; justify-content:space-between; padding:0 32px; height:64px; position:sticky; top:0; z-index:100; }
.hz-brand-text { color:white; font-size:18px; font-weight:700; }
.hz-nav-links { display:flex; gap:8px; }
.hz-nav-link { color:rgba(255,255,255,.75); text-decoration:none; padding:8px 16px; border-radius:20px; font-size:14px; font-weight:500; }
.hz-nav-link:hover,.hz-nav-link.active { background:var(--hz-accent); color:white; }
.hz-nav-right { display:flex; align-items:center; gap:12px; }
.hz-user-badge { background:rgba(255,255,255,.15); color:white; padding:6px 16px; border-radius:20px; font-size:13px; }
.hz-btn-logout { background:var(--hz-accent); color:white; text-decoration:none; padding:8px 18px; border-radius:20px; font-size:13px; font-weight:600; }
.hz-page-banner { background:linear-gradient(135deg,#23779C,#1a5a7a); padding:40px 32px; text-align:center; color:white; }
.hz-page-banner h1 { font-size:28px; font-weight:800; margin-bottom:6px; }
.hz-page-banner p { opacity:.85; }
.hz-main-content { max-width:1200px; margin:0 auto; padding:32px; }
.hz-alert-errors { background:#fef2f2; border:1px solid #fca5a5; border-radius:10px; padding:16px 20px; margin-bottom:20px; color:#b91c1c; font-size:14px; }
.hz-resa-layout { display:grid; grid-template-columns:340px 1fr; gap:24px; }
.hz-form-card { background:white; border-radius:16px; padding:24px; margin-bottom:16px; box-shadow:0 2px 10px rgba(0,0,0,.06); }
.hz-form-section-title { font-size:15px; font-weight:700; color:#1a2a3a; margin-bottom:16px; }
.hz-veh-img { width:100%; border-radius:10px; margin-bottom:12px; object-fit:cover; height:160px; }
.hz-veh-title { font-size:20px; font-weight:800; color:#1a2a3a; margin-bottom:8px; }
.hz-veh-specs { display:flex; flex-wrap:wrap; gap:8px; font-size:13px; color:#9ca3af; margin-bottom:12px; }
.hz-veh-price { display:flex; align-items:baseline; gap:6px; }
.hz-price-big { font-size:28px; font-weight:800; color:#27ae60; }
.hz-price-unit { font-size:13px; color:#9ca3af; }
.hz-recap-card { background:#f8fbfd; }
.hz-recap-line { display:flex; justify-content:space-between; font-size:14px; padding:6px 0; color:#374151; }
.hz-recap-total { font-size:16px; padding:10px 0; }
.hz-form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.hz-form-group { margin-bottom:14px; }
.hz-label { font-size:12px; font-weight:600; color:#6b7c8d; text-transform:uppercase; display:block; margin-bottom:6px; }
.hz-input { width:100%; border:1.5px solid #e0e8f0; border-radius:10px; padding:11px 14px; font-size:14px; outline:none; background:#f9fbfd; transition:border .2s; box-sizing:border-box; }
.hz-input:focus { border-color:var(--hz-primary); background:white; }
.hz-extras-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; }
.hz-extra-item { display:flex; align-items:center; gap:10px; padding:12px; border:1.5px solid #e0e8f0; border-radius:10px; cursor:pointer; transition:all .2s; }
.hz-extra-item:has(input:checked) { border-color:var(--hz-primary); background:#f0f8ff; }
.hz-extra-item i { font-size:20px; color:var(--hz-primary); }
.hz-extra-name { font-size:13px; font-weight:600; color:#374151; }
.hz-extra-price { font-size:12px; color:var(--hz-primary); }
.hz-conditions { display:flex; align-items:flex-start; gap:10px; font-size:14px; cursor:pointer; margin-bottom:20px; }
.hz-link { color:var(--hz-primary); }
.hz-form-actions { display:flex; gap:12px; justify-content:flex-end; }
.hz-btn-cancel { background:#f0f0f0; color:#374151; text-decoration:none; padding:12px 24px; border-radius:10px; font-weight:600; font-size:14px; }
.hz-btn-confirm { background:var(--hz-primary); color:white; border:none; padding:12px 28px; border-radius:10px; font-weight:700; font-size:14px; cursor:pointer; }
.hz-btn-confirm:hover { opacity:.88; }
.hz-footer { background:#1a3a4a; color:rgba(255,255,255,.7); padding:18px 32px; display:flex; align-items:center; justify-content:space-between; font-size:13px; margin-top:40px; }
@media(max-width:900px) { .hz-resa-layout { grid-template-columns:1fr; } .hz-extras-grid { grid-template-columns:1fr 1fr; } }
</style>
{% endblock %}
