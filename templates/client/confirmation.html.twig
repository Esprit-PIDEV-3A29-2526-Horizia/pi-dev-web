{% extends 'client/base_client.html.twig' %}
{% block title %}Horizia - Confirmation{% endblock %}
{% block navbar_extra_class %}nav-static{% endblock %}

{% block body %}

<div class="hero-banner">
    <div class="inner">
        <h1><i class="fas fa-check-circle mr-2"></i>Réservation Confirmée</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('client_accueil') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Confirmation</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">

                {# ── Bandeau succès ── #}
                <div class="card text-center mb-4" style="border-top:4px solid #27ae60;">
                    <div class="card-body p-5">
                        <span class="icon-circle mb-4" style="background:rgba(39,174,96,.1); display:inline-flex; align-items:center; justify-content:center; width:72px; height:72px; border-radius:50%;">
                            <i class="fas fa-check fa-2x" style="color:#27ae60;"></i>
                        </span>
                        <h3 class="font-weight-700 mt-3 mb-2">Réservation confirmée !</h3>
                        <p class="text-muted">Votre réservation a bien été enregistrée.</p>

                        {# Controller envoie "location" pas "reservation" #}
                        {% if location is defined %}
                        <span style="background:var(--teal);color:#fff;padding:8px 24px;border-radius:20px;font-size:1rem;font-weight:700;">
                            Référence #{{ location.idLocation }}
                        </span>
                        {% endif %}
                    </div>
                </div>

                {# ── Détails ── #}
                {% if location is defined %}
                <div class="card mb-4">
                    <div class="card-header-teal">
                        <i class="fas fa-info-circle mr-2"></i>Détails de votre réservation
                    </div>
                    <div class="card-body p-4">
                        <div class="payment-box">

                            {# Véhicule via relations #}
                            {% if location.vehicule %}
                            <div class="payment-row">
                                <span>Véhicule</span>
                                <strong>
                                    {{ location.vehicule.modele.marque.nomMarque }}
                                    {{ location.vehicule.modele.nomModele }}
                                    ({{ location.vehicule.annee }})
                                </strong>
                            </div>
                            <div class="payment-row">
                                <span>Immatriculation</span>
                                <strong>{{ location.vehicule.immatriculation }}</strong>
                            </div>
                            {% endif %}

                            <div class="payment-row">
                                <span>Client</span>
                                <strong>{{ location.clientNomComplet }}</strong>
                            </div>
                            <div class="payment-row">
                                <span>Téléphone</span>
                                <strong>{{ location.clientTelephone }}</strong>
                            </div>
                            <div class="payment-row">
                                <span>CIN</span>
                                <strong>{{ location.clientCin ?? '—' }}</strong>
                            </div>
                            <div class="payment-row">
                                <span>Date de début</span>
                                <strong>{{ location.dateDebut ? location.dateDebut|date('d/m/Y') : 'N/A' }}</strong>
                            </div>
                            <div class="payment-row">
                                <span>Date de fin prévue</span>
                                <strong>{{ location.dateFinPrevue ? location.dateFinPrevue|date('d/m/Y') : 'N/A' }}</strong>
                            </div>
                            <div class="payment-row">
                                <span>Prix / jour</span>
                                <strong>{{ location.prixParJour }} DT</strong>
                            </div>

                            {# Extras #}
                            {% if location.extras %}
                            <div class="payment-row">
                                <span>Extras</span>
                                <strong>
                                    {% for nom, prix in location.extras %}
                                        {{ nom|replace({'_': ' '})|capitalize }} ({{ prix }} DT){% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                </strong>
                            </div>
                            {% endif %}

                            <div class="payment-row">
                                <span>Avance (30%)</span>
                                <strong>{{ location.avance }} DT</strong>
                            </div>
                            <div class="payment-row total">
                                <span>Montant total</span>
                                <strong style="color:var(--orange);">{{ location.montantTotal }} DT</strong>
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Email confirmation ── #}
                {% if email_envoye is defined %}
                    {% if email_envoye %}
                    <div class="alert alert-success mb-4">
                        <i class="fas fa-envelope mr-2"></i>Email de confirmation envoyé avec succès.
                    </div>
                    {% elseif email_envoye == false %}
                    <div class="alert alert-warning mb-4">
                        <i class="fas fa-exclamation-triangle mr-2"></i>L'email n'a pas pu être envoyé.
                    </div>
                    {% endif %}
                {% endif %}

                {# Formulaire renvoi email #}
                <div class="card mb-4">
                    <div class="card-body p-4">
                        <h6 class="font-weight-700 mb-3"><i class="fas fa-envelope mr-2"></i>Recevoir la confirmation par email</h6>
                        <form method="post" action="{{ path('client_confirmation', {id: location.idLocation}) }}">
                            <div class="input-group">
                                <input type="email" name="email" class="form-control"
                                       placeholder="votre@email.com" required>
                                <div class="input-group-append">
                                    <button type="submit" class="btn-orange"
                                            style="border:none; padding:0 20px; border-radius:0 8px 8px 0; font-weight:600; cursor:pointer;">
                                        <i class="fas fa-paper-plane mr-1"></i> Envoyer
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                {% endif %}

                {# ── Actions ── #}
                <div class="row">
                    <div class="col-6">
                        <a href="{{ path('client_mes_reservations') }}" class="btn btn-block"
                           style="display:block; text-align:center; text-decoration:none; padding:12px;
                                  border-radius:30px; font-weight:600; background:var(--teal); color:#fff;">
                            <i class="fas fa-list mr-2"></i>Mes réservations
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="{{ path('client_accueil') }}" class="btn btn-block"
                           style="display:block; text-align:center; text-decoration:none; padding:12px;
                                  border-radius:30px; font-weight:600; border:2px solid var(--teal); color:var(--teal);">
                            <i class="fas fa-home mr-2"></i>Accueil
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
{% endblock %}
