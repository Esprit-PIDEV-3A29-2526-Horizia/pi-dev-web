{% extends 'base_front.html.twig' %}
{% block title %}Horizia - Réservation Confirmée !{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            {# Carte de confirmation #}
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #23779C, #1a5a78);">
                    <i class="fas fa-check-circle fa-4x mb-2" style="color: #27ae60;"></i>
                    <h2 class="mb-0 fw-bold">Réservation Confirmée !</h2>
                    <p class="mb-0 opacity-75">Votre réservation a été enregistrée avec succès</p>
                </div>
                
                <div class="card-body p-4">
                    
                    {# Numéro de réservation #}
                    <div class="text-center mb-4">
                        <span class="badge bg-light text-dark px-4 py-2 rounded-pill">
                            <i class="fas fa-ticket-alt me-2 text-teal"></i>
                            Réservation #{{ location.idLocation }}
                        </span>
                    </div>

                    {# Détails de la réservation #}
                    <div class="border rounded-3 p-3 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--teal);">
                            <i class="fas fa-info-circle me-2"></i>Détails de la réservation
                        </h6>
                        
                        <div class="row mb-2">
                            <div class="col-5 text-muted">
                                <i class="fas fa-user me-2"></i>Client :
                            </div>
                            <div class="col-7 fw-semibold">
                                {{ location.clientNomComplet }}
                            </div>
                        </div>
                        
                        <div class="row mb-2">
                            <div class="col-5 text-muted">
                                <i class="fas fa-car me-2"></i>Véhicule :
                            </div>
                            <div class="col-7 fw-semibold">
                                {% if location.vehicule %}
                                    {{ location.vehicule.modele.marque.nomMarque }} {{ location.vehicule.modele.nomModele }}
                                    <br><small class="text-muted">{{ location.vehicule.immatriculation }}</small>
                                {% else %}—{% endif %}
                            </div>
                        </div>
                        
                        <div class="row mb-2">
                            <div class="col-5 text-muted">
                                <i class="fas fa-calendar-alt me-2"></i>Période :
                            </div>
                            <div class="col-7 fw-semibold">
                                {{ location.dateDebut ? location.dateDebut|date('d/m/Y') : '—' }}
                                <i class="fas fa-arrow-right mx-1 text-teal"></i>
                                {{ location.dateFinPrevue ? location.dateFinPrevue|date('d/m/Y') : '—' }}
                            </div>
                        </div>
                    </div>

                    {# Détails financiers #}
                    <div class="bg-light rounded-3 p-3 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--teal);">
                            <i class="fas fa-credit-card me-2"></i>Détails financiers
                        </h6>
                        
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Montant total :</span>
                            <span class="fw-bold text-success fs-5">{{ location.montantTotal|number_format(3,'.','') }} DT</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Avance (30%) :</span>
                            <span class="fw-bold" style="color: var(--teal);">{{ location.avance|number_format(3,'.','') }} DT</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Reste à payer :</span>
                            <span class="fw-bold">{{ location.getResteAPayer|number_format(3,'.','') }} DT</span>
                        </div>
                    </div>

                    {# Section email - email pré-rempli #}
                    <div class="border rounded-3 p-3 mb-4">
                        <h6 class="fw-bold mb-3" style="color: var(--teal);">
                            <i class="fas fa-envelope me-2"></i>Recevoir la confirmation par email
                        </h6>
                        
                        <form method="POST" action="{{ path('client_confirmation', {id: location.idLocation}) }}" class="email-form">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0">
                                    <i class="fas fa-envelope text-muted"></i>
                                </span>
                                <input type="email" name="email" class="form-control border-start-0" 
                                       placeholder="Votre adresse email..."
                                       value="{{ app.user.email|default('') }}"
                                       {% if app.user %}readonly{% endif %}
                                       required>
                                {% if app.user %}
                                    <span class="input-group-text bg-light border-start-0">
                                        <i class="fas fa-check-circle text-success"></i>
                                    </span>
                                {% endif %}
                            </div>
                            {% if app.user %}
                                <small class="text-muted form-text">
                                    <i class="fas fa-info-circle"></i> Email pré-rempli depuis votre profil
                                </small>
                            {% endif %}
                            
                            <button type="submit" class="btn btn-teal w-100 mt-3" style="border-radius: 10px;">
                                <i class="fas fa-paper-plane me-2"></i>Envoyer la confirmation
                            </button>
                        </form>
                        
                        {% if email_envoye is same as true %}
                            <div class="alert alert-success mt-3 mb-0 py-2">
                                <i class="fas fa-check-circle me-2"></i>Email envoyé avec succès !
                            </div>
                        {% elseif email_envoye is same as false %}
                            <div class="alert alert-danger mt-3 mb-0 py-2">
                                <i class="fas fa-exclamation-circle me-2"></i>Erreur lors de l'envoi. Réessayez.
                            </div>
                        {% endif %}
                    </div>

                    {# Boutons d'action #}
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a href="{{ path('client_mes_reservations') }}" class="btn btn-outline-teal px-4">
                            <i class="fas fa-list me-2"></i>Mes réservations
                        </a>
                        <a href="{{ path('client_catalogue') }}" class="btn btn-outline-teal px-4">
                            <i class="fas fa-car me-2"></i>Voir le catalogue
                        </a>
                        <a href="{{ path('client_accueil') }}" class="btn btn-orange px-4">
                            <i class="fas fa-home me-2"></i>Accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --orange: #e84a3e;
        --teal: #23779C;
        --teal-dk: #1a5a78;
    }
    
    .btn-orange {
        background: var(--orange);
        color: white;
        border: none;
        transition: all .3s;
    }
    .btn-orange:hover {
        background: #c73a2e;
        color: white;
        transform: translateY(-2px);
    }
    .btn-teal {
        background: var(--teal);
        color: white;
        border: none;
        transition: all .3s;
    }
    .btn-teal:hover {
        background: var(--teal-dk);
        color: white;
        transform: translateY(-2px);
    }
    .btn-outline-teal {
        border: 2px solid var(--teal);
        color: var(--teal);
        background: transparent;
        transition: all .3s;
    }
    .btn-outline-teal:hover {
        background: var(--teal);
        color: white;
    }
    .text-teal {
        color: var(--teal);
    }
    
    @media (max-width: 576px) {
        .btn-outline-teal, .btn-orange, .btn-teal {
            padding: 8px 16px;
            font-size: 0.85rem;
        }
    }
</style>
{% endblock %}