{% extends 'client/base_client.html.twig' %}
{% block title %}Horizia - Mes Réservations{% endblock %}
{% block navbar_extra_class %}nav-static{% endblock %}
{% block nav_reservations %}active{% endblock %}

{% block body %}

<div class="hero-banner">
    <div class="inner">
        <h1><i class="fas fa-clipboard-check mr-2"></i>Mes Réservations</h1>
        <p>Retrouvez toutes vos réservations en saisissant votre CIN</p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('client_accueil') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Mes Réservations</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
    <div class="container">

        {# ── Recherche ── #}
        <div class="row justify-content-center mb-5">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header-teal">
                        <i class="fas fa-search mr-2"></i>Rechercher mes réservations
                    </div>
                    <div class="card-body p-4">
                        <form method="GET" action="{{ path('client_mes_reservations') }}">
                            <div class="input-group">
                                <input type="text" name="cin" class="form-control"
                                       placeholder="Entrez votre CIN"
                                       value="{{ cin ?? '' }}">
                                <div class="input-group-append">
                                    <button class="btn-orange" type="submit"
                                            style="border:none; padding:0 24px; border-radius:0 8px 8px 0; font-weight:600; cursor:pointer;">
                                        <i class="fas fa-search mr-1"></i> Rechercher
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        {# ── Résultats — le controller envoie "locations" pas "reservations" ── #}
        {% if recherche %}
            {% if locations is empty %}
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-4x mb-4" style="color:#ccc;"></i>
                <h4 class="text-muted">Aucune réservation trouvée pour ce CIN.</h4>
                <a href="{{ path('client_catalogue') }}" class="btn-orange mt-3"
                   style="display:inline-block; text-decoration:none; padding:12px 28px; border-radius:30px; font-weight:600;">
                    <i class="fas fa-car mr-2"></i>Voir le catalogue
                </a>
            </div>
            {% else %}
            <div class="row">
                {% for loc in locations %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">

                        {# Photo véhicule → vehicule.photo #}
                        <div style="position:relative; overflow:hidden;">
                            {% if loc.vehicule and loc.vehicule.photo %}
                                <img src="{{ asset('uploads/vehicules/' ~ loc.vehicule.photo) }}"
                                     style="height:180px; object-fit:cover; width:100%;"
                                     alt="Véhicule">
                            {% else %}
                                <div class="d-flex align-items-center justify-content-center"
                                     style="height:180px; background:#23779C;">
                                    <i class="fas fa-car fa-3x text-white opacity-50"></i>
                                </div>
                            {% endif %}

                            {# Badge statut #}
                            <span style="position:absolute;top:10px;right:10px;padding:4px 12px;border-radius:20px;font-size:.75rem;font-weight:700;
                                {% if loc.statut == 'réservée' %}background:#f39c12;color:#fff;
                                {% elseif loc.statut == 'en_cours' %}background:#27ae60;color:#fff;
                                {% elseif loc.statut == 'terminée' %}background:#6c757d;color:#fff;
                                {% elseif loc.statut == 'annulée' %}background:#e74c3c;color:#fff;
                                {% else %}background:#23779C;color:#fff;{% endif %}">
                                {{ loc.statut|capitalize }}
                            </span>
                        </div>

                        <div class="card-body p-3">
                            {# Marque + Modèle via relations #}
                            <h6 class="font-weight-700 mb-2">
                                {% if loc.vehicule %}
                                    {{ loc.vehicule.modele.marque.nomMarque }}
                                    {{ loc.vehicule.modele.nomModele }}
                                {% else %}
                                    Véhicule
                                {% endif %}
                            </h6>

                            <p class="text-muted small mb-1">
                                <i class="fas fa-hashtag mr-1" style="color:var(--teal);"></i>
                                Réf #{{ loc.idLocation }}
                            </p>
                            <p class="text-muted small mb-1">
                                <i class="fas fa-calendar mr-1" style="color:var(--teal);"></i>
                                {{ loc.dateDebut ? loc.dateDebut|date('d/m/Y') : 'N/A' }}
                                →
                                {{ loc.dateFinPrevue ? loc.dateFinPrevue|date('d/m/Y') : 'N/A' }}
                            </p>
                            <p class="text-muted small mb-1">
                                <i class="fas fa-user mr-1" style="color:var(--teal);"></i>
                                {{ loc.clientNomComplet }}
                            </p>
                            <p class="font-weight-700 mt-2 mb-0" style="color:var(--orange);">
                                {{ loc.montantTotal }} DT
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <a href="{{ path('client_confirmation', {id: loc.idLocation}) }}"
                               class="btn btn-block"
                               style="display:block; text-align:center; text-decoration:none; padding:8px;
                                      border-radius:30px; font-weight:600; border:2px solid var(--teal); color:var(--teal);">
                                <i class="fas fa-eye mr-1"></i>Voir détails
                            </a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

        {% else %}
        {# Pas encore de recherche #}
        <div class="text-center py-4">
            <i class="fas fa-search fa-4x mb-4" style="color:var(--teal); opacity:.3;"></i>
            <h5>Entrez votre CIN pour retrouver vos réservations.</h5>
        </div>
        {% endif %}

    </div>
</section>
{% endblock %}
