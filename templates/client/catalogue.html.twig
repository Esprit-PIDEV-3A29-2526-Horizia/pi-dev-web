{% extends 'client/base_client.html.twig' %}

{% block title %}Catalogue — Horizia Location{% endblock %}

{% block body %}

{# ── HERO SEARCH ─────────────────────────────────────────── #}
<section class="hero-section py-5">
    <div class="container">
        <h1 class="hero-title text-center mb-4">Notre Flotte</h1>

        <form method="get" action="{{ path('client_catalogue') }}" class="card p-4 shadow-sm">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date de début</label>
                    <input type="date" name="date_debut" class="form-control"
                           value="{{ date_debut ?? '' }}" min="{{ 'now'|date('Y-m-d') }}">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Date de fin</label>
                    <input type="date" name="date_fin" class="form-control"
                           value="{{ date_fin ?? '' }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Carburant</label>
                    <select name="type" class="form-select">
                        <option value="Tous les types" {% if type == 'Tous les types' %}selected{% endif %}>Tous les types</option>
                        <option value="essence"  {% if type == 'essence'  %}selected{% endif %}>Essence</option>
                        <option value="diesel"   {% if type == 'diesel'   %}selected{% endif %}>Diesel</option>
                        <option value="electrique" {% if type == 'electrique' %}selected{% endif %}>Électrique</option>
                        <option value="hybride"  {% if type == 'hybride'  %}selected{% endif %}>Hybride</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-orange w-100">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

{# ── GRILLE VÉHICULES ────────────────────────────────────── #}
<section class="py-5">
    <div class="container">

        {% if vehicules is empty %}
            <div class="text-center py-5">
                <i class="fas fa-car fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">Aucun véhicule disponible pour le moment.</h4>
                <a href="{{ path('client_catalogue') }}" class="btn btn-orange mt-3">Voir tout le catalogue</a>
            </div>
        {% else %}
            <p class="text-muted mb-4">{{ vehicules|length }} véhicule(s) disponible(s)</p>
            <div class="row">
                {% for vehicule in vehicules %}
                <div class="col-md-6 col-lg-4 mb-4">

                    {% if loop.index is odd %}
                    {# Carte teal (style collègue) #}
                    <div class="card card-teal h-100">
                        <div class="card-body p-4">

                            {# Titre : Marque + Modèle via relations #}
                            <h5 class="font-weight-700 mb-1">
                                {{ vehicule.modele.marque.nomMarque }}
                                {{ vehicule.modele.nomModele }}
                            </h5>
                            <p class="small mb-3 opacity-75">{{ vehicule.annee }} · {{ vehicule.couleur ?? '' }}</p>

                            {# Photo si dispo #}
                            {% if vehicule.photo %}
                            <img src="{{ asset('uploads/vehicules/' ~ vehicule.photo) }}"
                                 alt="{{ vehicule.modele.marque.nomMarque }} {{ vehicule.modele.nomModele }}"
                                 class="img-fluid rounded mb-3"
                                 style="height:160px;width:100%;object-fit:cover;">
                            {% else %}
                            <div class="rounded mb-3 d-flex align-items-center justify-content-center"
                                 style="height:160px;background:rgba(255,255,255,.15);">
                                <i class="fas fa-car fa-3x opacity-50"></i>
                            </div>
                            {% endif %}

                            <ul class="list-unstyled mb-3">
                                <li class="mb-2"><i class="fas fa-gas-pump mr-2"></i>{{ vehicule.carburant|capitalize }}</li>
                                <li class="mb-2"><i class="fas fa-tachometer-alt mr-2"></i>{{ vehicule.kilometrage|number_format(0, ',', ' ') }} km</li>
                                <li class="mb-2"><i class="fas fa-credit-card mr-2"></i>{{ vehicule.prixParJour }} DT / jour</li>
                                <li class="mb-2">
                                    <i class="fas fa-circle mr-2" style="font-size:.6rem;"></i>
                                    <span class="badge badge-light text-dark">{{ vehicule.etat|capitalize }}</span>
                                </li>
                            </ul>

                            <a href="{{ path('client_reservation', {id: vehicule.idVehicule, date_debut: date_debut, date_fin: date_fin}) }}"
                               class="btn btn-light btn-block font-weight-bold">
                                Réserver <i class="fas fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>

                    {% else %}
                    {# Carte blanche #}
                    <div class="card card-white h-100">
                        <div class="card-body p-4">

                            <h5 class="font-weight-700 mb-1 text-dark">
                                {{ vehicule.modele.marque.nomMarque }}
                                {{ vehicule.modele.nomModele }}
                            </h5>
                            <p class="small text-muted mb-3">{{ vehicule.annee }} · {{ vehicule.couleur ?? '' }}</p>

                            {% if vehicule.photo %}
                            <img src="{{ asset('uploads/vehicules/' ~ vehicule.photo) }}"
                                 alt="{{ vehicule.modele.marque.nomMarque }} {{ vehicule.modele.nomModele }}"
                                 class="img-fluid rounded mb-3"
                                 style="height:160px;width:100%;object-fit:cover;">
                            {% else %}
                            <div class="rounded mb-3 d-flex align-items-center justify-content-center bg-light"
                                 style="height:160px;">
                                <i class="fas fa-car fa-3x text-muted"></i>
                            </div>
                            {% endif %}

                            <ul class="list-unstyled mb-3">
                                <li class="mb-2 text-muted"><i class="fas fa-gas-pump mr-2 text-orange"></i>{{ vehicule.carburant|capitalize }}</li>
                                <li class="mb-2 text-muted"><i class="fas fa-tachometer-alt mr-2 text-orange"></i>{{ vehicule.kilometrage|number_format(0, ',', ' ') }} km</li>
                                <li class="mb-2 text-muted"><i class="fas fa-credit-card mr-2 text-orange"></i>{{ vehicule.prixParJour }} DT / jour</li>
                                <li class="mb-2">
                                    <i class="fas fa-circle mr-2 text-success" style="font-size:.6rem;"></i>
                                    <span class="badge badge-success">{{ vehicule.etat|capitalize }}</span>
                                </li>
                            </ul>

                            <a href="{{ path('client_reservation', {id: vehicule.idVehicule, date_debut: date_debut, date_fin: date_fin}) }}"
                               class="btn btn-orange btn-block font-weight-bold">
                                Réserver <i class="fas fa-arrow-right ml-1"></i>
                            </a>
                        </div>
                    </div>
                    {% endif %}

                </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>

{% endblock %}
