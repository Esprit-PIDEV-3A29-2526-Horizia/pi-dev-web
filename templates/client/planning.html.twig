{% extends 'client/base_client.html.twig' %}
{% block title %}Horizia - Planning{% endblock %}
{% block navbar_extra_class %}nav-static{% endblock %}
{% block nav_planning %}active{% endblock %}

{% block body %}

<div class="hero-banner">
    <div class="inner">
        <h1><i class="fas fa-calendar-alt mr-2"></i>Planning des Locations</h1>
        <p>Disponibilité de nos véhicules</p>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('client_accueil') }}">Accueil</a></li>
                <li class="breadcrumb-item active">Planning</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
    <div class="container">

        {# ── Légende ── #}
        <div class="card mb-4">
            <div class="card-header-teal"><i class="fas fa-info-circle mr-2"></i>Légende</div>
            <div class="card-body d-flex flex-wrap" style="gap:24px;">
                <span>
                    <span style="display:inline-block;width:14px;height:14px;background:#27ae60;border-radius:3px;vertical-align:middle;" class="mr-2"></span>
                    Disponible
                </span>
                <span>
                    <span style="display:inline-block;width:14px;height:14px;background:var(--orange);border-radius:3px;vertical-align:middle;" class="mr-2"></span>
                    Réservé
                </span>
                <span>
                    <span style="display:inline-block;width:14px;height:14px;background:#f39c12;border-radius:3px;vertical-align:middle;" class="mr-2"></span>
                    En cours
                </span>
            </div>
        </div>

        {# ── Sélecteur mois/année ── #}
        <div class="card mb-4">
            <div class="card-body p-3">
                <form method="GET" action="{{ path('client_planning') }}" class="form-inline" style="gap:12px;">
                    <label class="mr-2">Mois :</label>
                    <select name="mois" class="form-control mr-3">
                        {% for m in 1..12 %}
                        <option value="{{ m }}" {% if m == mois %}selected{% endif %}>
                            {{ ['','Janvier','Février','Mars','Avril','Mai','Juin',
                                'Juillet','Août','Septembre','Octobre','Novembre','Décembre'][m] }}
                        </option>
                        {% endfor %}
                    </select>
                    <label class="mr-2">Année :</label>
                    <select name="annee" class="form-control mr-3">
                        {% for a in (annee - 1)..(annee + 1) %}
                        <option value="{{ a }}" {% if a == annee %}selected{% endif %}>{{ a }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn-orange"
                            style="border:none;padding:8px 20px;border-radius:8px;font-weight:600;cursor:pointer;">
                        <i class="fas fa-filter mr-1"></i>Filtrer
                    </button>
                </form>
            </div>
        </div>

        {# ── Tableau planning ── #}
        {% if vehicules is defined and vehicules|length > 0 %}
        <div class="card">
            <div class="card-header-teal"><i class="fas fa-table mr-2"></i>Disponibilités</div>
            <div class="table-responsive">
                <table class="table table-bordered mb-0" style="font-size:.85rem;">
                    <thead>
                        <tr>
                            <th style="min-width:180px;">Véhicule</th>
                            {% for d in 1..30 %}
                            <th class="text-center" style="min-width:34px;font-size:.75rem;padding:8px 4px;">{{ d }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for vehicule in vehicules %}
                        <tr>
                            {# Marque + Modèle via relations #}
                            <td class="font-weight-600" style="vertical-align:middle;">
                                {{ vehicule.modele.marque.nomMarque }}
                                {{ vehicule.modele.nomModele }}
                                <br>
                                <small class="text-muted">{{ vehicule.immatriculation }}</small>
                            </td>
                            {% for d in 1..30 %}
                            <td style="padding:6px; text-align:center;
                                {% if vehicule.idVehicule == vehicule_id and d in jours_occupes %}
                                    background:var(--orange);
                                {% elseif vehicule.etat == 'louee' %}
                                    background:#f39c12;
                                {% else %}
                                    background:#27ae60;
                                {% endif %}">
                            </td>
                            {% endfor %}
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% else %}
        <div class="text-center py-5">
            <i class="fas fa-calendar-times fa-4x mb-4" style="color:#ccc;"></i>
            <h5 class="text-muted">Aucun véhicule à afficher</h5>
        </div>
        {% endif %}

        <div class="text-center mt-5">
            <a href="{{ path('client_catalogue') }}" class="btn-orange"
               style="display:inline-block;text-decoration:none;padding:13px 36px;border-radius:30px;font-weight:600;">
                <i class="fas fa-car mr-2"></i>Voir le catalogue et réserver
            </a>
        </div>

    </div>
</section>
{% endblock %}
