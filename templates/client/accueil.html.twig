{% extends 'client/base_client.html.twig' %}
{% block title %}Horizia - Accueil{% endblock %}
{% block nav_accueil %}active{% endblock %}

{% block body %}

{# ── HERO SECTION (style index.html.twig) ── #}
<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2"><a href="{{ path('app_front_home') }}">Accueil <i class="fa fa-chevron-right"></i></a></span>
                    <span>Espace Client<i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Horizia Location</h1>
            </div>
        </div>
    </div>
</section>

{# ── STATS ── #}
<section style="background:var(--teal); padding:36px 0;">
    <div class="container">
        <div class="row text-center text-white">
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <h3 style="font-size:2.2rem; font-weight:800; margin:0;">50+</h3>
                <p style="opacity:.8; margin:0; font-size:.9rem;">Véhicules disponibles</p>
            </div>
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <h3 style="font-size:2.2rem; font-weight:800; margin:0;">500+</h3>
                <p style="opacity:.8; margin:0; font-size:.9rem;">Clients satisfaits</p>
            </div>
            <div class="col-6 col-md-3 mb-3 mb-md-0">
                <h3 style="font-size:2.2rem; font-weight:800; margin:0;">24/7</h3>
                <p style="opacity:.8; margin:0; font-size:.9rem;">Support client</p>
            </div>
            <div class="col-6 col-md-3">
                <h3 style="font-size:2.2rem; font-weight:800; margin:0;">5★</h3>
                <p style="opacity:.8; margin:0; font-size:.9rem;">Note moyenne</p>
            </div>
        </div>
    </div>
</section>

{# ── SERVICES ── #}
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Nos services</span>
                <h2 class="mb-4">Pourquoi choisir Horizia ?</h2>
            </div>
        </div>
        <div class="row">
            {% for item in [
                {icon:'fa-car', title:'Flotte premium', desc:'Des véhicules récents, bien entretenus et parfaitement assurés pour votre sécurité.'},
                {icon:'fa-bolt', title:'Réservation rapide', desc:'Réservez en moins de 2 minutes depuis votre téléphone ou ordinateur.'},
                {icon:'fa-shield-alt', title:'100 % sécurisé', desc:'Paiement sécurisé et confirmation instantanée par email.'}
            ] %}
                <div class="col-md-4 ftco-animate mb-4">
                    <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                        <div class="icon mb-3">
                            <span class="fa {{ item.icon }} text-primary"></span>
                        </div>
                        <h3 class="mb-3">{{ item.title }}</h3>
                        <p>{{ item.desc }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── VÉHICULES EN VEDETTE ── #}
{% if vehicules is defined and vehicules|length > 0 %}
<section class="ftco-section bg-light">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Notre flotte</span>
                <h2 class="mb-4">Véhicules disponibles</h2>
            </div>
        </div>
        <div class="row">
            {% for vehicule in vehicules|slice(0,3) %}
            <div class="col-md-4 ftco-animate mb-4">
                <div class="project-wrap h-100">
                    <div class="img" style="background-image: url('{{ vehicule.photo ? (vehicule.photo starts with 'http' ? vehicule.photo : asset('uploads/vehicules/'~vehicule.photo)) : 'https://via.placeholder.com/400x300/23779C/fff?text='~vehicule.modele.marque.nomMarque }}');">
                        <span class="price">{{ vehicule.prixParJour ?? '—' }} DT / jour</span>
                    </div>
                    <div class="text p-4">
                        <h3>
                            <a href="{{ path('client_reservation', {id: vehicule.idVehicule}) }}">
                                {{ vehicule.modele.marque.nomMarque }} {{ vehicule.modele.nomModele }}
                            </a>
                        </h3>
                        <p class="location">
                            <span class="fa fa-gas-pump"></span> {{ vehicule.carburant ?? 'N/A' }}
                            &nbsp;|&nbsp;
                            <span class="fa fa-calendar"></span> {{ vehicule.annee }}
                        </p>
                        <div class="d-flex mt-3">
                            <a href="{{ path('client_reservation', {id: vehicule.idVehicule}) }}" class="btn btn-primary py-2 px-3" style="flex:1; text-align:center;">
                                <span class="fa fa-calendar-check mr-1"></span> Réserver
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="row justify-content-center mt-4">
            <div class="col-md-12 text-center">
                <a href="{{ path('client_catalogue') }}" class="btn btn-primary py-3 px-4">
                    Tout le catalogue <i class="fa fa-arrow-right ml-2"></i>
                </a>
            </div>
        </div>
    </div>
</section>
{% endif %}

{# ── CTA ── #}
<section class="ftco-intro ftco-section ftco-no-pt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 text-center">
                <div class="img" style="background-image: url({{ asset('assets/images/bg_2.jpg') }});">
                    <div class="overlay"></div>
                    <h2>Prêt à prendre la route ?</h2>
                    <p>Réservez votre véhicule dès maintenant et profitez de nos meilleurs tarifs.</p>
                    <p class="mb-0">
                        <a href="{{ path('client_catalogue') }}" class="btn btn-primary px-4 py-3">
                            <i class="fa fa-car mr-2"></i> Réserver maintenant
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}