{% extends 'admin/base_admin.html.twig' %}

{% block title %}Demandes d'annulation - Horozia{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Demandes d'annulation en attente</h1>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Logement</th>
                <th>Dates</th>
                <th>Montant</th>
                <th>Demandée le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for r in requests %}
            <tr id="row-{{ r.idreslog }}" class="cancel-row">
                <td>{{ r.logement.nom }}</td>
                <td>{{ r.dateDebut|date('d/m/Y') }} → {{ r.dateFin|date('d/m/Y') }}</td>
                <td>{{ r.montant }} DT</td>
                <td>{{ r.createdAt|date('d/m/Y H:i') }}</td>
                <td>
                    <button class="btn btn-sm btn-success btn-approve" data-id="{{ r.idreslog }}">✔ Approuver</button>
                    <button class="btn btn-sm btn-danger btn-reject" data-id="{{ r.idreslog }}">✘ Rejeter</button>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="text-center">Aucune demande en attente</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<style>
    /* Style de surbrillance pour la ligne cliquée */
    .highlight-row {
        background-color: #091786 !important;
        transition: all 0.3s ease-in-out;
        box-shadow: 0 0 10px rgba(129, 137, 253, 0.5);
    }
    
    /* Animation de pulsation pour attirer l'attention */
    @keyframes pulse {
        0% {
            background-color: #6d77b0;
            transform: scale(1);
        }
        50% {
            background-color: #141b99;
            transform: scale(1.01);
        }
        100% {
            background-color: #5c99ee;
            transform: scale(1);
        }
    }
    
    .highlight-row-pulse {
        animation: pulse 0.8s ease-in-out 2;
    }
</style>

<script>
    function handleAction(id, action) {
        fetch(`/admin/reservation/${action}-cancel/${id}`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                document.getElementById(`row-${id}`).remove();
                // Recharger le badge et la liste dans la navbar
                if (typeof loadCancelRequests !== 'undefined') {
                    loadCancelRequests();
                }
                location.reload();
            } else {
                alert('Erreur: ' + (data.error || 'Inconnue'));
            }
        });
    }
    
    document.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', () => handleAction(btn.dataset.id, 'approve'));
    });
    document.querySelectorAll('.btn-reject').forEach(btn => {
        btn.addEventListener('click', () => handleAction(btn.dataset.id, 'reject'));
    });
    
    // Gestion du scroll automatique vers la demande mise en surbrillance
    const urlParams = new URLSearchParams(window.location.search);
    const highlightId = urlParams.get('highlight');
    
    if (highlightId) {
        const targetRow = document.getElementById(`row-${highlightId}`);
        if (targetRow) {
            // Supprimer la query string de l'URL sans recharger
            const newUrl = window.location.pathname;
            window.history.replaceState({}, document.title, newUrl);
            
            // Scroll vers l'élément
            targetRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
            
            // Ajouter une classe de surbrillance avec animation
            targetRow.classList.add('highlight-row');
            targetRow.classList.add('highlight-row-pulse');
            
            // Retirer la surbrillance après 3 secondes
            setTimeout(() => {
                targetRow.classList.remove('highlight-row');
                targetRow.classList.remove('highlight-row-pulse');
            }, 3000);
        }
    }
</script>
{% endblock %}