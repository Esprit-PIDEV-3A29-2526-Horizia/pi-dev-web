{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau profil{% endblock %}

{% block body %}
<div class="mb-4">
    <a href="{{ path('app_profil_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4">
        <h2 class="h4 mb-0">
            <i class="bi bi-plus-circle-fill me-2 text-primary"></i>
            Créer un nouveau profil
        </h2>
    </div>
    <div class="card-body">
        {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-select rounded-pill'}}) }}
                </div>
                <div class="col-md-6 mb-3">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'form-select rounded-pill'}}) }}
                </div>
            </div>
            <div class="d-flex gap-3 mt-3 pt-3 border-top">
                <button class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-check-lg me-2"></i> Créer
                </button>
                <a href="{{ path('app_profil_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-x-lg me-2"></i> Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}