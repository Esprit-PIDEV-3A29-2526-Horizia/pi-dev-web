{% extends 'admin/base.html.twig' %}

{% block title %}Profils{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h3 mb-0">
        <i class="bi bi-tags-fill me-2 text-primary"></i>
        Gestion des profils
    </h2>
    <a href="{{ path('app_profil_new') }}" class="btn btn-primary rounded-pill shadow-sm">
        <i class="bi bi-plus-lg me-1"></i> Nouveau profil
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for profil in profils %}
                    <tr>
                        <td class="ps-3 fw-semibold">{{ profil.id }}</td>
                        <td>
                            {% if profil.type == 'ADMIN' %}
                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                    <i class="bi bi-shield-lock-fill me-1"></i> {{ profil.type }}
                                </span>
                            {% elseif profil.type == 'AGENT' %}
                                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-badge-fill me-1"></i> {{ profil.type }}
                                </span>
                            {% else %}
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                    <i class="bi bi-person-fill-check me-1"></i> {{ profil.type }}
                                </span>
                            {% endif %}
                        </td>
                        <td>
                            {% if profil.statut == 'ACTIF' %}
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> ACTIF
                                </span>
                            {% else %}
                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                    <i class="bi bi-x-circle-fill me-1"></i> INACTIF
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group gap-2">
                                <a href="{{ path('app_profil_edit', {id: profil.id}) }}" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8fafc;
    }
    
    .badge.bg-danger {
        background-color: #fee2e2 !important;
        color: #dc2626 !important;
    }
    
    .badge.bg-warning {
        background-color: #fef3c7 !important;
        color: #d97706 !important;
    }
    
    .badge.bg-success {
        background-color: #dcfce7 !important;
        color: #10b981 !important;
    }
</style>
{% endblock %}