{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ marque.nomMarque }} – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">{{ marque.nomMarque }}</h1>
        <p class="text-muted mb-0">{{ marque.modeles|length }} modèle(s) enregistré(s)</p>
    </div>
    <a href="{{ path('admin_marque_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card text-center p-4">
            {% if marque.logo %}
            <img src="{{ marque.logo }}" alt="{{ marque.nomMarque }}" class="mx-auto mb-3" style="width:120px;height:120px;object-fit:contain;">
            {% else %}
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:100px;height:100px;">
                <i class="bi bi-truck fs-1 text-primary"></i>
            </div>
            {% endif %}
            <h3 class="fw-bold">{{ marque.nomMarque }}</h3>
            <div class="text-muted">{{ marque.modeles|length }} modèle(s)</div>
            <div class="mt-3 d-flex gap-2 justify-content-center">
                <a href="{{ path('admin_marque_edit', {id: marque.idMarque}) }}" class="btn btn-warning btn-sm"><i class="bi bi-pencil me-1"></i>Modifier</a>
                <a href="{{ path('admin_modele_new') }}?marque_id={{ marque.idMarque }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Ajouter modèle</a>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-list-ul me-2 text-primary"></i>Modèles de cette marque
            </div>
            <div class="card-body">
                {% if marque.modeles|length > 0 %}
                <div class="row g-2">
                    {% for modele in marque.modeles %}
                    <div class="col-md-6">
                        <div class="bg-light rounded p-3 d-flex justify-content-between align-items-center">
                            <span class="fw-bold">{{ modele.nomModele }}</span>
                            <a href="{{ path('admin_modele_show', {id: modele.idModele}) }}" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-list-ul fs-1 opacity-50 mb-2 d-block"></i>
                    Aucun modèle pour cette marque.
                    <a href="{{ path('admin_modele_new') }}?marque_id={{ marque.idMarque }}" class="d-block mt-2">Ajouter un modèle</a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}