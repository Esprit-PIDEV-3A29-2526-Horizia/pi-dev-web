{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle marque – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Nouvelle marque</h1>
        <p class="text-muted mb-0">Ajouter une nouvelle marque de véhicule</p>
    </div>
    <a href="{{ path('admin_marque_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-tags-fill me-2 text-primary"></i>Informations marque
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.nomMarque) }}
                    {{ form_widget(form.nomMarque, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nomMarque) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.logo) }}
                    {{ form_widget(form.logo, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.logo) }}
                    <div class="small text-muted mt-1">URL de l'image du logo (ex: https://example.com/logo.png)</div>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-lg me-2"></i>Enregistrer
                </button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

{% endblock %}