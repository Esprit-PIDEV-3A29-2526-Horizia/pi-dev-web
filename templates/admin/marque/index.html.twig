{% extends 'admin/base_admin.html.twig' %}

{% block title %}Marques – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Marques</h1>
        <p class="text-muted mb-0">Gestion des marques de véhicules</p>
    </div>
    <a href="{{ path('admin_marque_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouvelle marque
    </a>
</div>

<div class="row g-3">
    {% for marque in marques %}
    <div class="col-6 col-md-4 col-lg-3">
        <div class="card h-100 shadow-sm text-center p-3">
            {% if marque.logo %}
            <img src="{{ marque.logo }}" alt="{{ marque.nomMarque }}" class="mx-auto mb-3" style="width:70px;height:70px;object-fit:contain;">
            {% else %}
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:70px;height:70px;">
                <i class="bi bi-truck fs-1 text-primary"></i>
            </div>
            {% endif %}
            <h6 class="fw-bold mb-1">{{ marque.nomMarque }}</h6>
            <div class="small text-muted mb-3">{{ marque.modeles|length }} modèle(s)</div>
            <div class="d-flex gap-2 justify-content-center">
                <a href="{{ path('admin_marque_show', {id: marque.idMarque}) }}" class="btn btn-sm btn-outline-info" title="Voir"><i class="bi bi-eye"></i></a>
                <a href="{{ path('admin_marque_edit', {id: marque.idMarque}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
            </div>
        </div>
    </div>
    {% else %}
    <div class="col-12">
        <div class="card text-center py-5">
            <i class="bi bi-tags fs-1 text-muted opacity-50 mb-3"></i>
            <p class="text-muted">Aucune marque trouvée.</p>
            <a href="{{ path('admin_marque_new') }}" class="btn btn-primary btn-sm">Ajouter une marque</a>
        </div>
    </div>
    {% endfor %}
</div>

{% endblock %}