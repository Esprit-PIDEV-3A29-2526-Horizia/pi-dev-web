{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des réservations{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des réservations</h1>
    </div>

    <div class="card card-horozia mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="searchInput" class="form-label">Recherche d'une réservation</label>
                    <input
                        type="text"
                        id="searchInput"
                        class="form-control"
                        placeholder="Rechercher par statut, voyage ou client"
                        value="{{ search }}"
                    >
                </div>

                <div class="col-md-4">
                    <label for="sortSelect" class="form-label">Filtrer par :</label>
                    <select id="sortSelect" class="form-select">
                        <option value="">Voulez-vous choisir ?</option>
                        <option value="date_desc" {{ sort == 'date_desc' ? 'selected' : '' }}>Date réservation récente</option>
                        <option value="date_asc" {{ sort == 'date_asc' ? 'selected' : '' }}>Date réservation ancienne</option>
                        <option value="statut_asc" {{ sort == 'statut_asc' ? 'selected' : '' }}>Statut A-Z</option>
                        <option value="nbr_asc" {{ sort == 'nbr_asc' ? 'selected' : '' }}>Nb personnes croissant</option>
                        <option value="nbr_desc" {{ sort == 'nbr_desc' ? 'selected' : '' }}>Nb personnes décroissant</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="button" id="resetBtn" class="btn btn-secondary w-100">
                        Réinitialiser
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="reservationTable" class="table table-bordered table-hover align-middle">
                <thead class="table-horozia">
                    <tr>                        
                        <th>Date réservation</th>
                        <th>Statut</th>
                        <th>Voyage</th>
                        <th>Client</th>
                        <th>Adultes</th>
                        <th>Enfants</th>
                        <th>Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for reservation in reservations %}
                    {% set clientName = reservation.user ? (
                        (reservation.user.nom is defined ? reservation.user.nom : '') ~ ' ' ~
                        (reservation.user.prenom is defined ? reservation.user.prenom : '')
                    )|trim : '' %}

                    <tr>
                        <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d H:i') : '' }}</td>

                        <td>
                            {% if reservation.statut == 'CONFIRMEE' %}
                                <span class="badge bg-success">Confirmée</span>
                            {% elseif reservation.statut == 'EN_ATTENTE' %}
                                <span class="badge bg-warning text-dark">En attente</span>
                            {% else %}
                                <span class="badge bg-danger">Annulée</span>
                            {% endif %}
                        </td>

                        <td>{{ reservation.voyage ? reservation.voyage.titre : 'Voyage inconnu' }}</td>
                        <td>{{ clientName != '' ? clientName : 'Utilisateur inconnu' }}</td>
                        <td>{{ reservation.nbAdultes }}</td>
                        <td>{{ reservation.nbEnfants }}</td>
                        <td>{{ reservation.nbrPersonnes }}</td>

                        <td>
                            <div class="d-flex gap-1 flex-wrap">

                                {# CONFIRMER #}
                                {% if reservation.statut == 'EN_ATTENTE' %}
                                    <form method="post"
                                          action="{{ path('app_reservation_confirmer', {'id': reservation.id}) }}"
                                          class="reservation-confirm-form"
                                          data-reservation-id="{{ reservation.id }}">
                                        <button type="submit" class="btn btn-success btn-sm">
                                            ✔
                                        </button>
                                    </form>
                                {% endif %}

                                {# ANNULER #}
                                {% if reservation.statut != 'ANNULEE' %}
                                    <form method="post"
                                          action="{{ path('app_reservation_annuler', {'id': reservation.id}) }}"
                                          class="reservation-cancel-form"
                                          data-reservation-id="{{ reservation.id }}">
                                        <button type="submit" class="btn btn-warning btn-sm">
                                            ✖
                                        </button>
                                    </form>
                                {% endif %}

                                {# REPORTER #}
                                {% if reservation.statut == 'EN_ATTENTE' %}
                                    <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}"
                                       class="btn btn-info btn-sm"
                                       title="Reporter">
                                        ⏳
                                    </a>
                                {% endif %}

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center">Aucune réservation trouvée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const sortSelect = document.getElementById('sortSelect');
            const resetBtn = document.getElementById('resetBtn');

            function applyFilters() {
                const params = new URLSearchParams(window.location.search);

                if (searchInput.value.trim()) {
                    params.set('search', searchInput.value.trim());
                } else {
                    params.delete('search');
                }

                if (sortSelect.value) {
                    params.set('sort', sortSelect.value);
                } else {
                    params.delete('sort');
                }

                window.location.search = params.toString();
            }

            if (searchInput) {
                searchInput.addEventListener('change', applyFilters);
            }

            if (sortSelect) {
                sortSelect.addEventListener('change', applyFilters);
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    window.location.href = "{{ path('app_reservation_index') }}";
                });
            }

            const confirmForms = document.querySelectorAll('.reservation-confirm-form');
            const cancelForms = document.querySelectorAll('.reservation-cancel-form');

            confirmForms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const reservationId = this.dataset.reservationId || '';

                    Swal.fire({
                        title: 'Confirmer cette réservation ?',
                        html: `Vous êtes sur le point de confirmer la réservation <strong>#${reservationId}</strong>.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#198754',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui, confirmer',
                        cancelButtonText: 'Annuler',
                        reverseButtons: true,
                        background: '#ffffff',
                        borderRadius: '18px'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });

            cancelForms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    const reservationId = this.dataset.reservationId || '';

                    Swal.fire({
                        title: 'Annuler cette réservation ?',
                        html: `Vous êtes sur le point d’annuler la réservation <strong>#${reservationId}</strong>.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#f0ad4e',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui, annuler',
                        cancelButtonText: 'Retour',
                        reverseButtons: true,
                        background: '#ffffff',
                        borderRadius: '18px'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}