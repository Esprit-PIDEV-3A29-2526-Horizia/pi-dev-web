{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des réservations{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des réservations</h1>
            <a href="{{ path('app_reservation_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Ajouter une réservation
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Date réservation</th>
                            <th>Statut</th>
                            <th>ID Voyage</th>
                            <th>ID User</th>
                            <th>Nombre personnes</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for reservation in reservations %}
                        <tr>
                            <td>{{ reservation.id }}</td>
                            <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d H:i') : '' }}</td>
                            <td>{{ reservation.statut }}</td>
                            <td>{{ reservation.idVoyage }}</td>
                            <td>{{ reservation.idUser }}</td>
                            <td>{{ reservation.nbrPersonnes }}</td>
                            <td>
                                <a href="{{ path('app_reservation_edit', {'id': reservation.id}) }}" class="btn btn-warning btn-sm">
                                    Modifier
                                </a>
                                <a href="{{ path('app_reservation_delete', {'id': reservation.id}) }}"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Voulez-vous vraiment supprimer cette réservation ?');">
                                    Supprimer
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">Aucune réservation trouvée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}