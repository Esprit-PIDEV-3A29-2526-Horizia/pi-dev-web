{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter une réservation{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Ajouter une réservation</h1>
        <a href="{{ path('app_reservation_index') }}" class="btn btn-horozia-neutral">
            Retour
        </a>
    </div>

    <div class="card card-horozia">
        <div class="card-body">
            {{ form_start(form) }}

            <div class="row">
                <div class="col-md-4 mb-3">
                    {{ form_label(form.dateReservation) }}
                    {{ form_widget(form.dateReservation, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.dateReservation) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.statut) }}
                </div>

                <div class="col-md-4 mb-3">
                    {{ form_label(form.nbrPersonnes) }}
                    {{ form_widget(form.nbrPersonnes, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nbrPersonnes) }}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_label(form.voyage) }}
                    {{ form_widget(form.voyage, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.voyage) }}
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_label(form.user) }}
                    {{ form_widget(form.user, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.user) }}
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-horozia-secondary">
                    Enregistrer
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}