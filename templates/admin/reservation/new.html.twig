{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter une réservation{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <h1 class="mb-4">Ajouter une réservation</h1>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.dateReservation) }}
                            {{ form_widget(form.dateReservation, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.dateReservation) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.statut) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.idVoyage) }}
                            {{ form_widget(form.idVoyage, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.idVoyage) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.idUser) }}
                            {{ form_widget(form.idUser, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.idUser) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.nbrPersonnes) }}
                            {{ form_widget(form.nbrPersonnes, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.nbrPersonnes) }}
                        </div>
                    </div>

                    <button class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('app_reservation_index') }}" class="btn btn-secondary">Retour</a>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}