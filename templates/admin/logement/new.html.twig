{% extends 'admin/layout.html.twig' %}

{% block title %}Ajouter un logement - Horozia{% endblock %}

{% block admin_content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-gradient-primary text-white py-3" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                    <h5 class="card-title mb-0 fs-4">
                        <i class="bi bi-building-add me-2"></i>
                        Nouveau logement
                    </h5>
                </div>
                <div class="card-body p-5">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation'}}) }}

                    {% if form_errors(form) %}
                        <div class="alert alert-danger alert-horozia mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            {{ form_errors(form) }}
                        </div>
                    {% endif %}

                    <div class="row g-4">
                        <!-- Type (dropdown) -->
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(form.type, 'Type de logement', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                                {{ form_errors(form.type) }}
                            </div>
                        </div>

                        <!-- Nom avec micro -->
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(form.nom, 'Nom du logement', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                <div class="input-group">
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'id': 'logement_nom', 'placeholder': 'ex: Villa Soleil'}}) }}
                                    <button type="button" class="btn btn-outline-secondary mic-btn" data-target="logement_nom" title="Reconnaissance vocale">
                                        <i class="bi bi-mic"></i>
                                    </button>
                                </div>
                                {{ form_errors(form.nom) }}
                            </div>
                        </div>

                        <!-- Adresse avec micro -->
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(form.adresse, 'Adresse complète', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                <div class="input-group">
                                    {{ form_widget(form.adresse, {'attr': {'class': 'form-control', 'id': 'logement_adresse', 'placeholder': 'ex: Tunis, Centre-ville'}}) }}
                                    <button type="button" class="btn btn-outline-secondary mic-btn" data-target="logement_adresse" title="Reconnaissance vocale">
                                        <i class="bi bi-mic"></i>
                                    </button>
                                </div>
                                {{ form_errors(form.adresse) }}
                            </div>
                        </div>

                        <!-- Capacité et Tarif -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.capacite, 'Capacité (personnes)', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                {{ form_widget(form.capacite, {'attr': {'class': 'form-control', 'type': 'number', 'min': '1'}}) }}
                                {{ form_errors(form.capacite) }}
                            </div>
                        </div>
                        <div class="col-md-6">
    <div class="mb-3">
        {{ form_label(form.tarif_nuit, 'Tarif par nuit (DT)', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
        <div class="input-group">
            {{ form_widget(form.tarif_nuit, {
                'attr': {
                    'class': 'form-control',
                    'type': 'number',
                    'step': '0.01',
                    'min': '0',
                    'id': 'logement_tarif_nuit'
                }
            }) }}
            <button type="button" class="btn btn-outline-secondary mic-btn" data-target="logement_tarif_nuit" title="Reconnaissance vocale">
                <i class="bi bi-mic"></i>
            </button>
        </div>
        {{ form_errors(form.tarif_nuit) }}
    </div>
</div>

                        <!-- Équipements avec micro -->
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(form.equipement, 'Équipements', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                <div class="input-group">
                                    {{ form_widget(form.equipement, {'attr': {'class': 'form-control', 'id': 'logement_equipement', 'rows': '3', 'placeholder': 'ex: WiFi, climatisation, piscine, parking'}}) }}
                                    <button type="button" class="btn btn-outline-secondary mic-btn" data-target="logement_equipement" title="Reconnaissance vocale">
                                        <i class="bi bi-mic"></i>
                                    </button>
                                </div>
                                {{ form_errors(form.equipement) }}
                            </div>
                        </div>

                        <!-- Image -->
                        <div class="col-12">
                            <div class="mb-3">
                                {{ form_label(form.image, 'Image du logement', {'label_attr': {'class': 'form-label fw-semibold text-horozia-primary'}}) }}
                                <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light">
                                    {{ form_widget(form.image, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                                    <div class="text-muted small mt-2">
                                        <i class="bi bi-image"></i> Formats acceptés : JPG, PNG (max 5 Mo)
                                    </div>
                                </div>
                                {{ form_errors(form.image) }}
                            </div>
                        </div>

                        <!-- Disponibilité -->
                        <div class="col-12">
                            <div class="form-check form-switch">
                                {{ form_widget(form.disponibilite, {'attr': {'class': 'form-check-input', 'id': 'logement_disponibilite'}}) }}
                                {{ form_label(form.disponibilite, 'Disponible immédiatement', {'label_attr': {'class': 'form-check-label fw-semibold text-horozia-primary fs-5'}}) }}
                                {{ form_errors(form.disponibilite) }}
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex gap-3 justify-content-end">
                        <a href="{{ path('admin_logement_index') }}" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                            <i class="bi bi-arrow-left me-2"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-horozia-primary px-5 py-2 rounded-pill">
                            <i class="bi bi-check-circle me-2"></i>
                            Enregistrer le logement
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Vérifier la disponibilité de l'API Web Speech
            if ('webkitSpeechRecognition' in window) {
                console.log('✅ API Web Speech disponible');
            } else {
                console.log('❌ API Web Speech indisponible');
            }

            // Initialisation des boutons de reconnaissance vocale
            const micButtons = document.querySelectorAll('.mic-btn');
            micButtons.forEach(btn => {
                btn.addEventListener('click', function(event) {
                    const targetId = this.getAttribute('data-target');
                    startDictation(targetId, this);
                });
            });
        });

        function startDictation(fieldId, button) {
            if (!('webkitSpeechRecognition' in window)) {
                alert("Votre navigateur ne supporte pas la reconnaissance vocale. Utilisez Chrome ou Edge.");
                return;
            }

            // Désactiver le bouton pendant la reconnaissance
            button.disabled = true;
            const originalIcon = button.innerHTML;
            button.innerHTML = '<i class="bi bi-mic-mute-fill spinner-border spinner-border-sm me-0"></i>';

            const recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
            recognition.lang = 'fr-FR';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            recognition.onstart = () => console.log('🎤 Reconnaissance vocale démarrée...');
            
            recognition.onresult = (event) => {
                const text = event.results[0][0].transcript;
                const field = document.getElementById(fieldId);
                if (field) {
                    field.value = text;
                    console.log('✅ Texte transcrit:', text);
                }
            };

            recognition.onend = () => {
                button.disabled = false;
                button.innerHTML = originalIcon;
            };

            recognition.onerror = (event) => {
                console.error('❌ Erreur reconnaissance:', event.error);
                button.disabled = false;
                button.innerHTML = originalIcon;
                alert('Erreur de reconnaissance vocale. Essayez à nouveau.');
            };

            recognition.start();
        }
    </script>
{% endblock %}