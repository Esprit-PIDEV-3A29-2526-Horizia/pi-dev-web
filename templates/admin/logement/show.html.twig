{% extends 'admin/layout.html.twig' %}

{% block title %}Détail du logement - {{ logement.nom }}{% endblock %}

{% block admin_content %}
<div class="container-fluid px-4 py-5">
    <div class="row g-5">
        <!-- Colonne principale : image et informations -->
        <div class="col-lg-8">
            <!-- Image hero -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="position-relative">
                    <img src="{{ logement.image ? logement.image : 'https://placehold.co/800x450?text=Image+indisponible' }}"
                         alt="{{ logement.nom }}"
                         class="img-fluid w-100"
                         style="max-height: 450px; object-fit: cover;"
                         onerror="this.src='https://placehold.co/800x450?text=Image+indisponible'">
                    <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-50 text-white p-4">
                        <h1 class="display-5 fw-bold mb-1">{{ logement.nom }}</h1>
                        <p class="lead mb-0">{{ logement.type }}</p>
                    </div>
                </div>
            </div>

            <!-- Description et équipements -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold text-horozia-primary">
                        <i class="bi bi-geo-alt-fill me-2"></i>Emplacement
                    </h3>
                    <p class="text-muted fs-5">{{ logement.adresse }}</p>
                </div>
            </div>

            {% if logement.equipement %}
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold text-horozia-primary">
                        <i class="bi bi-grid-3x3-gap-fill me-2"></i>Équipements
                    </h3>
                    <div class="mt-3">
                        {% set equipements = logement.equipement|split(',') %}
                        {% for equip in equipements %}
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-2 me-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                {{ equip|trim }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
            </div>
            {% endif %}
        </div>

        <!-- Colonne latérale : statistiques et actions -->
        <div class="col-lg-4">
            <!-- Carte de prix -->
            <div class="card border-0 shadow-lg rounded-4 mb-4 bg-gradient-primary text-white" style="background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));">
                <div class="card-body text-center p-4">
                    <h3 class="display-4 fw-bold mb-2">{{ logement.tarifNuit|number_format(0, ',', ' ') }} DT</h3>
                    <p class="text-white-50 mb-0">par nuit</p>
                    <hr class="my-3 bg-white opacity-25">
                    <p class="mb-0"><i class="bi bi-calendar-check me-2"></i>Tarif par personne : inclus</p>
                </div>
            </div>

            <!-- Carte capacité et statut -->
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="card border-0 shadow-sm h-100 text-center">
                        <div class="card-body">
                            <div class="stat-icon mb-2 bg-horozia-primary bg-opacity-10 rounded-circle p-3 d-inline-block">
                                <i class="bi bi-people fs-1 text-horozia-primary"></i>
                            </div>
                            <h2 class="display-6 fw-bold mb-0">{{ logement.capacite }}</h2>
                            <p class="text-muted">personnes max</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm h-100 text-center">
                        <div class="card-body">
                            <div class="stat-icon mb-2 {{ logement.disponibilite ? 'bg-success bg-opacity-10' : 'bg-danger bg-opacity-10' }} rounded-circle p-3 d-inline-block">
                                <i class="bi {{ logement.disponibilite ? 'bi-check-circle-fill fs-1 text-success' : 'bi-x-circle-fill fs-1 text-danger' }}"></i>
                            </div>
                            <h3 class="fw-bold mb-0 {{ logement.disponibilite ? 'text-success' : 'text-danger' }}">
                                {{ logement.disponibilite ? 'Disponible' : 'Indisponible' }}
                            </h3>
                            <p class="text-muted">Statut</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <a href="{{ path('admin_logement_edit', {'id': logement.id}) }}" class="btn btn-horozia-primary btn-lg rounded-pill">
                    <i class="bi bi-pencil-square me-2"></i>Modifier ce logement
                </a>
                <a href="{{ path('admin_logement_index') }}" class="btn btn-outline-secondary btn-lg rounded-pill">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                </a>
                {{ include('admin/logement/_delete_form.html.twig', {'logement': logement}, with_context = false) }}
            </div>

            <!-- Badge supplémentaire (optionnel) -->
            <div class="mt-4 text-center text-muted small">
                <i class="bi bi-shield-check me-1"></i> Vérifié par Horozia
            </div>
        </div>
    </div>
</div>
{% endblock %}