{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier {{ vehicule.immatriculation }} – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Modifier : {{ vehicule.immatriculation }}</h1>
        <p class="text-muted mb-0">{{ vehicule.modele.marque.nomMarque }} {{ vehicule.modele.nomModele }}</p>
    </div>
    <a href="{{ path('admin_vehicule_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

{# Erreurs globales #}
{% if not form.vars.valid and form.vars.submitted %}
<div class="alert alert-danger mb-3">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    Veuillez corriger les erreurs ci-dessous.
</div>
{% endif %}

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-truck-front-fill me-2 text-primary"></i>Informations véhicule
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.immatriculation) }}
                        {{ form_widget(form.immatriculation, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.immatriculation) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.modele) }}
                        {{ form_widget(form.modele, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.modele) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.annee) }}
                        {{ form_widget(form.annee, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.annee) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.carburant) }}
                        {{ form_widget(form.carburant, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.carburant) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.couleur) }}
                        {{ form_widget(form.couleur, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.couleur) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.kilometrage) }}
                        {{ form_widget(form.kilometrage, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.kilometrage) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.etat) }}
                        {{ form_widget(form.etat, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.etat) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.prixParJour) }}
                        {{ form_widget(form.prixParJour, {'attr': {'class': 'form-control', 'step': '0.001'}}) }}
                        {{ form_errors(form.prixParJour) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.photo) }}
                        {{ form_widget(form.photo, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.photo) }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white fw-bold">Actions</div>
            <div class="card-body">
                <button type="submit" class="btn btn-primary w-100 mb-2">
                    <i class="bi bi-check-lg me-2"></i>Enregistrer
                </button>
                <a href="{{ path('admin_vehicule_show', {id: vehicule.idVehicule}) }}" class="btn btn-outline-secondary w-100 mb-2">
                    <i class="bi bi-eye me-1"></i>Voir
                </a>
                <button type="button" class="btn btn-danger w-100" onclick="document.getElementById('form-delete-vehicule').submit()">
                    <i class="bi bi-trash me-1"></i>Supprimer
                </button>
            </div>
        </div>
        <div class="card mt-3">
            <div class="card-body">
                <i class="bi bi-info-circle me-1 text-primary"></i>
                <small class="text-muted">Les champs marqués <span class="text-danger fw-bold">*</span> sont obligatoires.</small>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<form id="form-delete-vehicule"
      method="post"
      action="{{ path('admin_vehicule_delete', {id: vehicule.idVehicule}) }}"
      onsubmit="return confirm('Supprimer définitivement ce véhicule ?')">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vehicule.idVehicule) }}">
</form>

{% endblock %}