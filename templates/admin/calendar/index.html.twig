{% extends 'admin/base_admin.html.twig' %}

{% block title %}Calendrier - Horozia{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="dashboard-card">
            <div class="calendar-header mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="calendar-header-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <h2 class="calendar-page-title mb-1">Calendrier des voyages</h2>
                        <p class="calendar-page-subtitle mb-0">
                            Visualisation des voyages selon leurs dates de départ et de retour.
                        </p>
                    </div>
                </div>
            </div>

            <div id="calendar-holder"></div>
        </div>
    </div>

    <div class="modal fade" id="voyageModal" tabindex="-1" aria-labelledby="voyageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="voyageModalLabel">Détails du voyage</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-2">
                    <div class="mb-3">
                        <span class="text-muted small">Titre</span>
                        <div class="fw-semibold fs-5" id="modalTitre"></div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light">
                                <div class="text-muted small">Destination</div>
                                <div class="fw-semibold" id="modalDestination"></div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light">
                                <div class="text-muted small">Prix</div>
                                <div class="fw-semibold" id="modalPrix"></div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light">
                                <div class="text-muted small">Date de départ</div>
                                <div class="fw-semibold" id="modalDateDepart"></div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light">
                                <div class="text-muted small">Date de retour</div>
                                <div class="fw-semibold" id="modalDateRetour"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-horozia-secondary" data-bs-dismiss="modal">
                        Fermer
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar-holder');
            const voyageModalElement = document.getElementById('voyageModal');
            const voyageModal = new bootstrap.Modal(voyageModalElement);

            if (calendarEl) {
                const calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'fr',
                    firstDay: 1,
                    height: 'auto',
                    fixedWeekCount: false,
                    dayMaxEvents: 2,
                    moreLinkText: 'plus',
                    headerToolbar: {
                        left: 'title',
                        center: '',
                        right: 'today prev,next'
                    },
                    buttonText: {
                        today: "Aujourd'hui"
                    },
                    events: '/fc-load-events',
                    eventDisplay: 'block',
                    displayEventTime: false,

                    eventClick: function(info) {
                        info.jsEvent.preventDefault();

                        const props = info.event.extendedProps;

                        document.getElementById('modalTitre').textContent = props.titre || info.event.title || '';
                        document.getElementById('modalDestination').textContent = props.destination || '';
                        document.getElementById('modalPrix').textContent = props.prix !== undefined ? props.prix + ' DT' : '';
                        document.getElementById('modalDateDepart').textContent = props.dateDepart || '';
                        document.getElementById('modalDateRetour').textContent = props.dateRetour || '';

                        voyageModal.show();
                    }
                });

                calendar.render();
            }
        });
    </script>
{% endblock %}