{% extends 'admin/base.html.twig' %}

{% block title %}Détail de l'utilisateur{% endblock %}

{% block body %}
<div class="mb-4">
    <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary btn-sm rounded-pill">
        <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h2 class="h3 mb-1">
                    <i class="bi bi-person-circle me-2 text-primary"></i>
                    {{ user.nom }} {{ user.prenom }}
                </h2>
                <p class="text-muted">ID: #{{ user.id }}</p>
            </div>
            <div class="dropdown">
                <button class="btn btn-light rounded-circle" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    <li>
                        <a class="dropdown-item" href="{{ path('app_user_edit', {id: user.id}) }}">
                            <i class="bi bi-pencil me-2 text-warning"></i> Modifier
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form method="post" action="{{ path('app_user_delete', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button class="dropdown-item text-danger" onclick="return confirm('Supprimer cet utilisateur ?')">
                                <i class="bi bi-trash3 me-2"></i> Supprimer
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="row">
            <!-- Informations personnelles -->
            <div class="col-md-6 mb-4">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-person-badge me-2 text-primary"></i>
                            Informations personnelles
                        </h5>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Nom complet</div>
                            <div class="col-8 fw-semibold">{{ user.nom }} {{ user.prenom }}</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Email</div>
                            <div class="col-8">
                                <i class="bi bi-envelope-fill me-1 text-muted"></i>
                                {{ user.email }}
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Téléphone</div>
                            <div class="col-8">
                                <i class="bi bi-telephone-fill me-1 text-muted"></i>
                                {{ user.telephone ?: 'Non renseigné' }}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-muted">Adresse</div>
                            <div class="col-8">
                                <i class="bi bi-geo-alt-fill me-1 text-muted"></i>
                                {{ user.addresse ?: 'Non renseignée' }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profil et Statut -->
            <div class="col-md-6 mb-4">
                <div class="card bg-light border-0 h-100">
                    <div class="card-body">
                        <h5 class="card-title mb-3">
                            <i class="bi bi-shield-check me-2 text-primary"></i>
                            Profil & Statut
                        </h5>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Profil</div>
                            <div class="col-8">
                                {% if user.profil %}
                                    {% if user.profil.type == 'ADMIN' %}
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                            <i class="bi bi-shield-lock-fill me-1"></i> ADMIN
                                        </span>
                                    {% elseif user.profil.type == 'AGENT' %}
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                            <i class="bi bi-person-badge-fill me-1"></i> AGENT
                                        </span>
                                    {% else %}
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                            <i class="bi bi-person-fill-check me-1"></i> CLIENT
                                        </span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                        <i class="bi bi-question-circle-fill me-1"></i> Non défini
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-4 text-muted">Statut</div>
                            <div class="col-8">
                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> ACTIF
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="d-flex gap-3 mt-3 pt-3 border-top">
            <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-outline-warning rounded-pill px-4">
                <i class="bi bi-pencil me-2"></i> Modifier le profil
            </a>
            <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-list-ul me-2"></i> Retour à la liste
            </a>
        </div>
    </div>
</div>

<style>
    .bg-light {
        background-color: #f8fafc !important;
    }
    
    .badge.bg-danger {
        background-color: #fee2e2 !important;
        color: #dc2626 !important;
    }
    
    .badge.bg-warning {
        background-color: #fef3c7 !important;
        color: #d97706 !important;
    }
    
    .badge.bg-success {
        background-color: #dcfce7 !important;
        color: #10b981 !important;
    }
    
    .badge.bg-secondary {
        background-color: #f1f5f9 !important;
        color: #64748b !important;
    }
    
    .btn-outline-secondary {
        border-color: #e2e8f0;
        color: #475569;
    }
    
    .btn-outline-secondary:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #1e293b;
    }
</style>
{% endblock %}