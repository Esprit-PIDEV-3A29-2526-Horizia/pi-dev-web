<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Profil</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="ps-3 fw-bold text-primary">{{ user.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                                    <i class="bi bi-person-fill text-primary"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">{{ user.nom }} {{ user.prenom }}</div>
                                    <div class="small text-muted">ID: #{{ user.id }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {{ user.email }}
                            {% if user.telephone %}
                                <div class="small text-muted"><i class="bi bi-telephone"></i> {{ user.telephone }}</div>
                            {% endif %}
                        </td>
                        <td>
                            {% set badgeClass = {
                                'ADMIN': 'danger',
                                'AGENT': 'warning',
                                'CLIENT': 'success'
                            } %}
                            <span class="badge bg-{{ badgeClass[user.profil.type] ?? 'secondary' }} bg-opacity-10 text-{{ badgeClass[user.profil.type] ?? 'secondary' }} px-3 py-2 rounded-pill">
                                <i class="bi bi-shield-lock-fill me-1"></i> {{ user.profil.type ?? 'Non défini' }}
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group gap-2">
                                <a href="{{ path('app_user_show', {id: user.id}) }}" class="btn btn-sm btn-outline-info rounded-pill px-3" title="Voir">
                                    <i class="bi bi-eye me-1"></i> Voir
                                </a>
                                <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-warning rounded-pill px-3" title="Modifier">
                                    <i class="bi bi-pencil me-1"></i> Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>