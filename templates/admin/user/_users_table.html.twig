<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" width="5%">ID</th>
                        <th width="25%">Nom complet</th>
                        <th width="30%">Email</th>
                        <th width="15%">Profil</th>
                        <th class="text-end pe-3" width="25%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="ps-3 fw-semibold">{{ user.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="avatar-circle bg-primary bg-opacity-10 text-primary">
                                    {{ user.prenom|first }}{{ user.nom|first }}
                                </div>
                                <div>
                                    <div class="fw-semibold">{{ user.nom }} {{ user.prenom }}</div>
                                    <div class="small text-muted">ID: #{{ user.id }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span>{{ user.email }}</span>
                                {% if user.telephone %}
                                    <small class="text-muted"><i class="bi bi-telephone"></i> {{ user.telephone }}</small>
                                {% endif %}
                            </div>
                        </td>
                        <td>
                            {% if user.profil %}
                                {% if user.profil.type == 'ADMIN' %}
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill">
                                        <i class="bi bi-shield-lock-fill me-1"></i> ADMIN
                                    </span>
                                {% elseif user.profil.type == 'AGENT' %}
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill">
                                        <i class="bi bi-person-badge-fill me-1"></i> AGENT
                                    </span>
                                {% else %}
                                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                        <i class="bi bi-person-fill-check me-1"></i> CLIENT
                                    </span>
                                {% endif %}
                            {% else %}
                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                    <i class="bi bi-question-circle-fill me-1"></i> Non défini
                                </span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-3">
                            <div class="btn-group gap-2">
                                <a href="{{ path('app_user_show', {id: user.id}) }}" class="btn btn-sm btn-outline-info rounded-pill px-3" title="Voir">
                                    <i class="bi bi-eye me-1"></i> Voir
                                </a>
                                <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-sm btn-outline-warning rounded-pill px-3" title="Modifier">
                                    <i class="bi bi-pencil me-1"></i> Modifier
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>