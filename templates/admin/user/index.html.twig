{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des utilisateurs</h1>
            <a href="{{ path('app_user_new') }}" class="btn btn-horozia-secondary">
                <i class="bi bi-plus-circle"></i> Ajouter un utilisateur
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
             </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="card card-horozia mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="searchInput" class="form-label">Recherche d'un utilisateur</label>
                        <input
                            type="text"
                            id="searchInput"
                            class="form-control"
                            placeholder="Rechercher par nom, prénom, email ou profil"
                        >
                    </div>

                    <div class="col-md-4">
                        <label for="sortSelect" class="form-label">Filtrer par :</label>
                        <select id="sortSelect" class="form-select">
                            <option value="">Voulez-vous choisir ?</option>
                            <option value="nom_asc">Nom A-Z</option>
                            <option value="nom_desc">Nom Z-A</option>
                            <option value="prenom_asc">Prénom A-Z</option>
                            <option value="email_asc">Email A-Z</option>
                            <option value="profil_asc">Profil A-Z</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="button" id="resetBtn" class="btn btn-secondary w-100">
                            Réinitialiser
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-horozia">
            <div class="card-body">
                <table id="userTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-horozia">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Adresse</th>
                            <th>Profil</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr
                            data-nom="{{ user.nom ? user.nom|lower : '' }}"
                            data-prenom="{{ user.prenom ? user.prenom|lower : '' }}"
                            data-email="{{ user.email ? user.email|lower : '' }}"
                            data-telephone="{{ user.telephone ? user.telephone|lower : '' }}"
                            data-addresse="{{ user.addresse ? user.addresse|lower : '' }}"
                            data-profil="{{ user.profil ? user.profil.type|lower : '' }}"
                        >
                            <td>{{ user.id }}</td>
                            <td>{{ user.nom }}</td>
                            <td>{{ user.prenom }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.telephone }}</td>
                            <td>{{ user.addresse }}</td>
                            <td>{{ user.profil ? user.profil.type : '' }}</td>
                            <td>
                                <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn btn-horozia-warning btn-sm">
                                    Modifier
                                </a>
                                <a href="{{ path('app_user_delete', {'id': user.id}) }}"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
                                    Supprimer
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr id="noResultRow">
                            <td colspan="8" class="text-center">Aucun utilisateur trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <div id="emptySearchMessage" class="alert alert-warning mt-3 d-none">
                    Aucun utilisateur ne correspond à votre recherche.
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('searchInput');
            const sortSelect = document.getElementById('sortSelect');
            const resetBtn = document.getElementById('resetBtn');
            const table = document.getElementById('userTable');
            const tbody = table.querySelector('tbody');
            const emptySearchMessage = document.getElementById('emptySearchMessage');

            function getDataRows() {
                return Array.from(tbody.querySelectorAll('tr')).filter(row => row.dataset.nom !== undefined);
            }

            function applySearch() {
                const value = searchInput.value.toLowerCase().trim();
                const rows = getDataRows();
                let visibleCount = 0;

                rows.forEach(row => {
                    const nom = row.dataset.nom || '';
                    const prenom = row.dataset.prenom || '';
                    const email = row.dataset.email || '';
                    const telephone = row.dataset.telephone || '';
                    const addresse = row.dataset.addresse || '';
                    const profil = row.dataset.profil || '';

                    const matches =
                        nom.includes(value) ||
                        prenom.includes(value) ||
                        email.includes(value) ||
                        telephone.includes(value) ||
                        addresse.includes(value) ||
                        profil.includes(value);

                    if (matches) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                emptySearchMessage.classList.toggle('d-none', visibleCount > 0);
            }

            function applySort() {
                const rows = getDataRows();
                const sortValue = sortSelect.value;

                rows.sort((a, b) => {
                    if (sortValue === 'nom_asc') {
                        return (a.dataset.nom || '').localeCompare(b.dataset.nom || '');
                    }

                    if (sortValue === 'nom_desc') {
                        return (b.dataset.nom || '').localeCompare(a.dataset.nom || '');
                    }

                    if (sortValue === 'prenom_asc') {
                        return (a.dataset.prenom || '').localeCompare(b.dataset.prenom || '');
                    }

                    if (sortValue === 'email_asc') {
                        return (a.dataset.email || '').localeCompare(b.dataset.email || '');
                    }

                    if (sortValue === 'profil_asc') {
                        return (a.dataset.profil || '').localeCompare(b.dataset.profil || '');
                    }

                    return 0;
                });

                rows.forEach(row => tbody.appendChild(row));
            }

            function applyFilters() {
                applySort();
                applySearch();
            }

            searchInput.addEventListener('input', applyFilters);
            sortSelect.addEventListener('change', applyFilters);

            resetBtn.addEventListener('click', function () {
                searchInput.value = '';
                sortSelect.value = '';
                applyFilters();
            });
        });
    </script>
