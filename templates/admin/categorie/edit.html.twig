{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier une catégorie{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Modifier une catégorie</h2>
        <p class="text-muted mb-0">Mettez à jour les informations de la catégorie.</p>
    </div>

    <div class="dashboard-card">
        {% include 'admin/categorie/form.html.twig' with {
            form: form,
            button_label: 'Mettre à jour'
        } %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('categorie_image_url');
            const preview = document.getElementById('categorie-image-preview');

            function normalizePath(value) {
                if (!value) return '';
                return value.trim();
            }

            function updatePreview() {
                if (!imageInput || !preview) return;

                const value = normalizePath(imageInput.value);

                if (!value) {
                    preview.src = 'https://via.placeholder.com/800x400?text=Aper%C3%A7u+image';
                    return;
                }

                preview.src = value;
            }

            if (imageInput) {
                imageInput.addEventListener('input', updatePreview);
            }
        });
    </script>
{% endblock %}