{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des catégories</h1>
            <a href="{{ path('app_categorie_new') }}" class="btn btn-horozia-secondary">
                <i class="bi bi-plus-circle"></i> Ajouter une catégorie
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
             </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning alert-horozia alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span>{{ message }}</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <div class="card card-horozia mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="searchInput" class="form-label">Recherche d'une catégorie</label>
                        <input
                            type="text"
                            id="searchInput"
                            class="form-control"
                            placeholder="Rechercher par nom ou description"
                        >
                    </div>

                    <div class="col-md-4">
                        <label for="sortSelect" class="form-label">Filtrer par :</label>
                        <select id="sortSelect" class="form-select">
                            <option value="">Voulez-vous choisir ?</option>
                            <option value="nom_asc">Nom A-Z</option>
                            <option value="nom_desc">Nom Z-A</option>
                            <option value="nbvoyages_asc">Nb voyages croissant</option>
                            <option value="nbvoyages_desc">Nb voyages décroissant</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="button" id="resetBtn" class="btn btn-secondary w-100">
                            Réinitialiser
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-horozia">
            <div class="card-body">
                <table id="categorieTable" class="table table-bordered table-hover align-middle">
                    <thead class="table-horozia">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Nb Voyages</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for categorie in categories %}
                        <tr
                            data-nom="{{ categorie.nom ? categorie.nom|lower : '' }}"
                            data-description="{{ categorie.description ? categorie.description|lower : '' }}"
                            data-nbvoyages="{{ categorie.voyages|length }}"
                        >
                            <td>{{ categorie.id }}</td>
                            <td>{{ categorie.nom }}</td>
                            <td>{{ categorie.description }}</td>
                            <td>{{ categorie.voyages|length }}</td>
                            <td>
                                <a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}" class="btn btn-horozia-warning btn-sm">
                                    Modifier
                                </a>
                                <a href="{{ path('app_categorie_delete', {'id': categorie.id}) }}" class="btn btn-danger btn-sm btn-delete-categorie" data-categorie-name="{{ categorie.nom }}">
                                    Supprimer
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr id="noResultRow">
                            <td colspan="5" class="text-center">Aucune catégorie trouvée.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                <div id="emptySearchMessage" class="alert alert-warning mt-3 d-none">
                    Aucune catégorie ne correspond à votre recherche.
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.btn-delete-categorie');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const deleteUrl = this.getAttribute('href');
                const categorieName = this.dataset.categorieName || 'cette catégorie';

                Swal.fire({
                    title: 'Supprimer cette catégorie ?',
                    html: `Vous êtes sur le point de supprimer <strong>${categorieName}</strong>.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Oui, supprimer',
                    cancelButtonText: 'Annuler',
                    reverseButtons: true,
                    background: '#ffffff',
                    borderRadius: '18px'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });
    });
</script>
{% endblock %}