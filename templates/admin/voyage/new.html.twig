{% extends 'admin/base_admin.html.twig' %}

{% block title %}Ajouter un voyage{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="dashboard-card">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">Ajouter un voyage</h2>
                <p class="text-muted mb-0">Remplissez les informations du voyage puis enregistrez.</p>
            </div>

            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            {% if form.vars.errors|length > 0 %}
                <div class="validation-error mb-3">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="row">
                <div class="col-md-6 mb-3 {% if form.titre.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.titre) }}
                    {{ form_widget(form.titre, {
                        'attr': {
                            'class': 'form-control'
                        }
                    }) }}
                    {% if form.titre.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.titre) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-6 mb-3 {% if form.destination.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.destination) }}
                    {{ form_widget(form.destination, {
                        'attr': {
                            'class': 'form-control'
                        }
                    }) }}

                    <div class="mt-2 d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="generate-ai-btn">
                            <i class="bi bi-stars me-1"></i> Générer avec IA
                        </button>
                        <span id="generate-ai-status" class="small text-muted"></span>
                    </div>

                    {% if form.destination.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.destination) }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="mb-3 {% if form.description.vars.errors|length > 0 %}field-error{% endif %}">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'form-control',
                        'rows': 5
                    }
                }) }}
                {% if form.description.vars.errors|length > 0 %}
                    <div class="validation-error">{{ form_errors(form.description) }}</div>
                {% endif %}
            </div>

            <div class="row">
                <div class="col-md-4 mb-3 {% if form.prix.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.prix) }}
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                    {% if form.prix.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.prix) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-4 mb-3 {% if form.dateDepart.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.dateDepart) }}
                    {{ form_widget(form.dateDepart, {'attr': {'class': 'form-control'}}) }}
                    {% if form.dateDepart.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.dateDepart) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-4 mb-3 {% if form.dateRetour.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.dateRetour) }}
                    {{ form_widget(form.dateRetour, {'attr': {'class': 'form-control'}}) }}
                    {% if form.dateRetour.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.dateRetour) }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3 {% if form.categorie.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.categorie) }}
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
                    {% if form.categorie.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.categorie) }}</div>
                    {% endif %}
                </div>

                <div class="col-md-6 mb-3 {% if form.placesTotal.vars.errors|length > 0 %}field-error{% endif %}">
                    {{ form_label(form.placesTotal) }}
                    {{ form_widget(form.placesTotal, {'attr': {'class': 'form-control'}}) }}
                    {% if form.placesTotal.vars.errors|length > 0 %}
                        <div class="validation-error">{{ form_errors(form.placesTotal) }}</div>
                    {% endif %}
                </div>
            </div>

            <div class="mb-3 {% if form.imageUrl.vars.errors|length > 0 %}field-error{% endif %}">
                {{ form_label(form.imageUrl) }}
                {{ form_widget(form.imageUrl, {'attr': {
                    'class': 'form-control',
                    'id': 'image-url-input',
                    'placeholder': 'https://...'
                }}) }}

                <div class="form-text">
                    L’image sera remplie automatiquement via l’API si disponible, sinon vous pouvez saisir une URL manuellement.
                </div>

                {% if form.imageUrl.vars.errors|length > 0 %}
                    <div class="validation-error">{{ form_errors(form.imageUrl) }}</div>
                {% endif %}

                {% set currentImage = form.vars.value.imageUrl %}

                <div class="mt-3">
                    <div class="small text-muted mb-2">Aperçu de l’image</div>
                    <div class="image-preview-wrapper">
                        <img
                            id="image-preview"
                            src="{% if currentImage %}
                                    {% if currentImage starts with 'http://' or currentImage starts with 'https://' %}
                                        {{ currentImage }}
                                    {% else %}
                                        {{ asset(currentImage starts with '/' ? currentImage|slice(1) : currentImage) }}
                                    {% endif %}
                                 {% else %}
                                    /images/placeholder_voyage.jpg
                                 {% endif %}"
                            alt="Aperçu de l'image"
                            class="image-preview-element"
                            style="max-width: 100%; height: auto; border-radius: 12px; object-fit: cover;"
                        >
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-horozia-secondary">
                    <i class="bi bi-check-circle me-1"></i> Enregistrer
                </button>
                <a href="{{ path('app_voyage_index') }}" class="btn btn-horozia-neutral">
                    Retour
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const imageInput = document.getElementById('image-url-input');
            const preview = document.getElementById('image-preview');
            const placeholder = '/images/placeholder_voyage.jpg';

            function updatePreview(value) {
                if (!preview) return;

                const finalValue = (value || '').trim();

                if (finalValue === '') {
                    preview.src = placeholder;
                    return;
                }

                if (finalValue.startsWith('http://') || finalValue.startsWith('https://')) {
                    preview.src = finalValue;
                } else {
                    const cleanPath = finalValue.startsWith('/') ? finalValue.substring(1) : finalValue;
                    preview.src = '/' + cleanPath;
                }
            }

            if (imageInput && preview) {
                imageInput.addEventListener('input', function () {
                    updatePreview(imageInput.value);
                });

                preview.addEventListener('error', function () {
                    preview.src = placeholder;
                });
            }

            const generateBtn = document.getElementById('generate-ai-btn');
            const destinationInput = document.getElementById('{{ form.destination.vars.id }}');
            const titreInput = document.getElementById('{{ form.titre.vars.id }}');
            const descriptionInput = document.getElementById('{{ form.description.vars.id }}');
            const statusEl = document.getElementById('generate-ai-status');

            if (!generateBtn || !destinationInput || !titreInput || !descriptionInput) {
                console.error('Un ou plusieurs éléments du formulaire sont introuvables.');
                return;
            }

            generateBtn.addEventListener('click', async function () {
                const destination = destinationInput.value.trim();

                if (!destination) {
                    if (statusEl) {
                        statusEl.textContent = 'Veuillez saisir une destination.';
                    }
                    alert('Veuillez saisir une destination.');
                    return;
                }

                titreInput.value = '';
                descriptionInput.value = '';

                if (imageInput) {
                    imageInput.value = '';
                    updatePreview('');
                }

                generateBtn.disabled = true;

                if (statusEl) {
                    statusEl.textContent = 'Génération en cours...';
                }

                try {
                    const response = await fetch('{{ path('app_voyage_generate_content') }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            destination: destination
                        })
                    });

                    const data = await response.json();
                    console.log('DATA API =', data);

                    if (!response.ok || !data.success) {
                        if (statusEl) {
                            statusEl.textContent = data.message || 'Erreur lors de la génération.';
                        }
                        alert(data.message || 'Erreur lors de la génération.');
                        return;
                    }

                    if (data.titre) {
                        titreInput.value = data.titre;
                    }

                    if (data.description) {
                        descriptionInput.value = data.description;
                    }

                    if (imageInput) {
                        console.log('IMAGE URL =', data.image_url);

                        if (data.image_url && data.image_url.trim() !== '') {
                            imageInput.value = data.image_url;
                            updatePreview(data.image_url);
                        } else {
                            imageInput.value = placeholder;
                            updatePreview(placeholder);
                        }
                    }

                    if (statusEl) {
                        statusEl.textContent = 'Contenu généré avec succès.';
                    }
                } catch (error) {
                    console.error('Erreur fetch =', error);

                    if (statusEl) {
                        statusEl.textContent = 'Erreur de connexion avec le serveur.';
                    }

                    alert('Erreur de connexion avec le serveur.');
                } finally {
                    generateBtn.disabled = false;
                }
            });
        });
    </script>
{% endblock %}