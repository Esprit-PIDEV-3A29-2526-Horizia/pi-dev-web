{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des voyages{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1">Liste des voyages</h2>
            <p class="text-muted mb-0">Consultez et gérez les voyages disponibles.</p>
        </div>

        <a href="{{ path('app_voyage_new') }}" class="btn btn-horozia-secondary">
            <i class="bi bi-plus-circle me-1"></i> Ajouter un voyage
        </a>
    </div>

    <div class="dashboard-card mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label fw-semibold">Recherche</label>
                <input
                    type="text"
                    id="voyageSearch"
                    class="form-control"
                    placeholder="Rechercher par titre ou destination"
                >
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Filtrer par</label>
                <select id="voyageFilter" class="form-select">
                    <option value="">Voulez-vous choisir ?</option>
                    <option value="disponible">Disponible</option>
                    <option value="bientot">Bientôt complet</option>
                    <option value="complet">Complet</option>
                </select>
            </div>

            <div class="col-md-2">
                <button type="button" id="resetVoyageFilter" class="btn btn-horozia-neutral w-100">
                    Réinitialiser
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4" id="voyagesCardsContainer">
        {% for voyage in voyages %}
            {% set statut = 'disponible' %}
            {% if voyage.placesRestantes == 0 %}
                {% set statut = 'complet' %}
            {% elseif voyage.placesRestantes <= 10 %}
                {% set statut = 'bientot' %}
            {% endif %}

            {% set imagePath = '' %}
            {% if voyage.imageUrl %}
                {% if voyage.imageUrl starts with 'http://' or voyage.imageUrl starts with 'https://' %}
                    {% set imagePath = voyage.imageUrl %}
                {% else %}
                    {% set imagePath = asset(voyage.imageUrl starts with '/' ? voyage.imageUrl|slice(1) : voyage.imageUrl) %}
                {% endif %}
            {% endif %}

            <div
                class="col-md-6 col-xl-4 voyage-card-item"
                data-search="{{ (voyage.titre ~ ' ' ~ voyage.destination)|lower }}"
                data-status="{{ statut }}"
            >
                <div class="voyage-card h-100">
                    <a href="{{ path('app_voyage_show', {'id': voyage.id}) }}" class="voyage-card-link">
                        <div class="voyage-card-image-wrapper">
                            {% if imagePath %}
                                <img
                                    src="{{ imagePath }}"
                                    alt="{{ voyage.titre }}"
                                    class="voyage-card-image"
                                >
                            {% else %}
                                <div class="voyage-card-no-image">Pas d'image</div>
                            {% endif %}

                            <div class="voyage-card-overlay"></div>

                            <div class="voyage-card-topbar">
    <div class="voyage-card-badge-wrapper">
        {% if statut == 'complet' %}
            <span class="badge voyage-badge-complet">Complet</span>
        {% elseif statut == 'bientot' %}
            <span class="badge voyage-badge-bientot">Bientôt complet</span>
        {% else %}
            <span class="badge voyage-badge-disponible">Disponible</span>
        {% endif %}
    </div>

    <span class="voyage-price">{{ voyage.prix }} DT</span>
</div>
                        </div>

                        <div class="p-4">
                            <h5 class="voyage-card-title">{{ voyage.titre }}</h5>

                            {% set totalPlaces = voyage.placesTotal ?: 0 %}
{% set restantes = voyage.placesRestantes ?: 0 %}
{% set pourcentage = totalPlaces > 0 ? ((restantes / totalPlaces) * 100)|round(0, 'floor') : 0 %}

<div class="voyage-card-destination mb-3">
    <i class="bi bi-geo-alt"></i>
    <span>{{ voyage.destination }}</span>
</div>

<div class="voyage-places-section mb-4">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="voyage-places-label">Places disponibles</span>
        <span class="voyage-places-value">{{ restantes }}/{{ totalPlaces }}</span>
    </div>

    <div class="voyage-progress">
        <div
            class="voyage-progress-bar
                {% if restantes == 0 %}
                    progress-complet
                {% elseif pourcentage <= 20 %}
                    progress-low
                {% elseif pourcentage <= 50 %}
                    progress-medium
                {% else %}
                    progress-good
                {% endif %}"
            style="width: {{ pourcentage }}%;"
        ></div>
    </div>
</div>
                        </div>
                    </a>

                    <div class="px-4 pb-4 pt-0 mt-auto d-flex gap-2">
                        <a href="{{ path('app_voyage_edit', {'id': voyage.id}) }}"
                           class="btn btn-voyage-edit flex-fill"
                           onclick="event.stopPropagation();">
                            <i class="bi bi-pencil-square me-1"></i> Modifier
                        </a>

                       <a href="{{ path('app_voyage_delete', {'id': voyage.id}) }}"
   class="btn btn-voyage-delete flex-fill btn-delete-voyage"
   data-voyage-title="{{ voyage.titre }}"
   onclick="event.stopPropagation();">
    <i class="bi bi-trash me-1"></i> Supprimer
</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="dashboard-card text-center text-muted py-5">
                    Aucun voyage trouvé.
                </div>
            </div>
        {% endfor %}
    </div>

    <div id="voyageNoResult" class="dashboard-card text-center text-muted py-5 mt-4 d-none">
        Aucun voyage ne correspond à votre recherche.
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('voyageSearch');
            const filterSelect = document.getElementById('voyageFilter');
            const resetBtn = document.getElementById('resetVoyageFilter');
            const cards = document.querySelectorAll('.voyage-card-item');
            const noResult = document.getElementById('voyageNoResult');

            function applyFilters() {
                const searchValue = (searchInput?.value || '').trim().toLowerCase();
                const filterValue = filterSelect?.value || '';
                let visibleCount = 0;

                cards.forEach(card => {
                    const searchData = card.dataset.search || '';
                    const statusData = card.dataset.status || '';

                    const matchesSearch = searchData.includes(searchValue);
                    const matchesFilter = filterValue === '' || statusData === filterValue;

                    if (matchesSearch && matchesFilter) {
                        card.classList.remove('d-none');
                        visibleCount++;
                    } else {
                        card.classList.add('d-none');
                    }
                });

                if (noResult) {
                    noResult.classList.toggle('d-none', visibleCount !== 0);
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            if (filterSelect) {
                filterSelect.addEventListener('change', applyFilters);
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    if (filterSelect) filterSelect.value = '';
                    applyFilters();
                });
            }

            const deleteButtons = document.querySelectorAll('.btn-delete-voyage');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const deleteUrl = this.getAttribute('href');
                    const voyageTitle = this.dataset.voyageTitle || 'ce voyage';

                    Swal.fire({
                        title: 'Supprimer ce voyage ?',
                        html: `Vous êtes sur le point de supprimer <strong>${voyageTitle}</strong>.`,
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui, supprimer',
                        cancelButtonText: 'Annuler',
                        reverseButtons: true,
                        background: '#ffffff',
                        borderRadius: '18px'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = deleteUrl;
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}