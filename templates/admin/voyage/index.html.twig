{% extends 'admin/base_admin.html.twig' %}

{% block title %}Liste des voyages{% endblock %}

{% block admin_content %}
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Liste des voyages</h1>
            <a href="{{ path('app_voyage_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Ajouter un voyage
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Destination</th>
                            <th>Prix</th>
                            <th>Date départ</th>
                            <th>Date retour</th>
                            <th>Places</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for voyage in voyages %}
                        <tr>
                            <td>{{ voyage.id }}</td>
                            <td>{{ voyage.titre }}</td>
                            <td>{{ voyage.destination }}</td>
                            <td>{{ voyage.prix }}</td>
                            <td>{{ voyage.dateDepart ? voyage.dateDepart|date('Y-m-d') : '' }}</td>
                            <td>{{ voyage.dateRetour ? voyage.dateRetour|date('Y-m-d') : '' }}</td>
                            <td>{{ voyage.placesRestantes }}/{{ voyage.placesTotal }}</td>
                            <td>
                                <a href="{{ path('app_voyage_edit', {'id': voyage.id}) }}" class="btn btn-warning btn-sm">
                                    Modifier
                                </a>
                                <a href="{{ path('app_voyage_delete', {'id': voyage.id}) }}"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Voulez-vous vraiment supprimer ce voyage ?');">
                                    Supprimer
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center">Aucun voyage trouvé.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}