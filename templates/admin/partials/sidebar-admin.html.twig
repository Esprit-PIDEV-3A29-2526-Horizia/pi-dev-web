<div class="admin-sidebar">
    <div class="sidebar-brand-center">
        <img src="{{ asset('images/logo.png') }}" alt="Logo Horozia" class="sidebar-logo-large">
    </div>

    <ul class="sidebar-menu">
        <!-- Dashboard -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') == 'app_admin' ? 'active' : '' }}" href="{{ path('app_admin') }}">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <!-- Gestion Utilisateurs (exemple) -->
        <li>
            <a class="sidebar-link" href="{{ path('app_user_index') }}">
                <i class="bi bi-person"></i>
                <span>Gestion Utilisateurs</span>
            </a>
        </li>

        <!-- Gestion Profils -->
        <li>
            <a class="sidebar-link" href="{{ path('app_profil_index') }}">
                <i class="bi bi-person-badge"></i>
                <span>Gestion Profils</span>
            </a>
        </li>

        <!-- Gestion Catégories -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_categorie_' ? 'active' : '' }}" href="{{ path('app_categorie_index') }}">
                <i class="bi bi-tags-fill"></i>
                <span>Gestion Catégories</span>
            </a>
        </li>

        <!-- Gestion Voyages -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_voyage_' ? 'active' : '' }}" href="{{ path('app_voyage_index') }}">
                <i class="bi bi-airplane-fill"></i>
                <span>Gestion Voyages</span>
            </a>
        </li>

        <!-- Gestion Logements -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'admin_logement_' ? 'active' : '' }}" href="{{ path('admin_logement_index') }}">
                <i class="bi bi-building"></i>
                <span>Gestion Logements</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_reservation_' ? 'active' : '' }}"
            href="{{ path('app_reservation_index') }}">
                <i class="bi bi-calendar-check-fill"></i>
                <span>Gestion Réservations</span>
            </a>
        </li>

        <!-- Demandes d'annulation (spécifique logements) -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') == 'admin_cancel_requests' ? 'active' : '' }}" href="{{ path('admin_cancel_requests') }}">
                <i class="bi bi-clock-history"></i>
                <span>Demandes annulation</span>
                {% set pendingCount = pendingCancelRequests|default(0) %}
                {% if pendingCount > 0 %}
                    <span class="badge bg-danger rounded-pill ms-2">{{ pendingCount }}</span>
                {% endif %}
            </a>
        </li>

        <!-- Calendrier (si utilisé) -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') == 'app_calendar' ? 'active' : '' }}" href="{{ path('app_calendar') }}">
                <i class="bi bi-calendar3"></i>
                <span>Calendrier</span>
            </a>
        </li>

        <!-- Gestion Participations -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_participation' ? 'active' : '' }}" href="{{ path('app_participation_index') }}">
                <i class="bi bi-people-fill"></i>
                <span>Gestion Participations</span>
            </a>
        </li>

        <!-- Gestion Événements -->
        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'app_event_' ? 'active' : '' }}" href="{{ path('app_event_index') }}">
                <i class="bi bi-list-ul"></i>
                <span>Gestion Événements</span>
            </a>
        </li>
        <!--gestion publications-->
        <li><a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'admin_publication' ? 'active' : '' }}" href="{{ path('admin_publication_index') }}"><i class="bi bi-file-text-fill"></i><span>Publications</span></a></li>

        <li>
            <a class="sidebar-link {{ app.request.attributes.get('_route') starts with 'admin_commentaire' ? 'active' : '' }}" href="{{ path('admin_commentaire_index') }}">
                <i class="bi bi-chat-dots-fill"></i>
                <span>Commentaires</span>
            </a>
        </li>
    </ul>
</div>