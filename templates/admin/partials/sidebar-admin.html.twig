<style>
/* Styles pour les dropdowns dans la sidebar admin */
.sidebar-dropdown {
    position: relative;
}

.sidebar-dropdown .dropdown-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: space-between;
}

.sidebar-dropdown .dropdown-toggle .bi-chevron-down {
    transition: transform 0.3s ease;
    font-size: 0.8rem;
    margin-left: auto;
}

/* Masquer la flèche quand la sidebar est réduite */
body.sidebar-collapsed .sidebar-dropdown .dropdown-toggle .bi-chevron-down {
    display: none;
}

.sidebar-dropdown .dropdown-toggle[aria-expanded="true"] .bi-chevron-down {
    transform: rotate(180deg);
}

.sidebar-dropdown-menu {
    position: static;
    float: none;
    width: 100%;
    background: rgba(255,255,255,0.08);
    border: none;
    border-radius: 0;
    padding: 0;
    margin: 0;
    box-shadow: none;
    display: none;
}

/* Masquer complètement le menu déroulant quand la sidebar est réduite */
body.sidebar-collapsed .sidebar-dropdown-menu {
    display: none !important;
}

.sidebar-dropdown-menu.show {
    display: block;
}

/* En mode réduit, les dropdowns redeviennent des liens simples */
body.sidebar-collapsed .sidebar-dropdown > .dropdown-toggle {
    pointer-events: auto;
}

body.sidebar-collapsed .sidebar-dropdown > .dropdown-toggle[aria-expanded="true"] {
    background: transparent;
}

.sidebar-dropdown-menu .dropdown-item {
    padding: 10px 24px 10px 48px;
    color: rgba(255,255,255,0.75);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    transition: all 0.2s ease;
}

.sidebar-dropdown-menu .dropdown-item:hover {
    background: rgba(61,148,202,0.18);
    color: #fff;
}

.sidebar-dropdown-menu .dropdown-item.active {
    background: rgba(61,148,202,0.25);
    color: #fff;
}

.sidebar-dropdown-menu .dropdown-item i {
    width: 20px;
    font-size: 0.9rem;
}

.sidebar-divider {
    margin: 15px 20px;
    border-color: rgba(255,255,255,0.1);
}

/* En mode réduit, le texte des liens est masqué (déjà fait dans votre CSS global) */
body.sidebar-collapsed .sidebar-dropdown .dropdown-toggle span {
    display: none;
}

body.sidebar-collapsed .sidebar-dropdown .dropdown-toggle {
    justify-content: center;
    padding: 14px 0;
}

/* Badges dans les dropdowns */
.sidebar-dropdown-menu .dropdown-item .badge {
    margin-left: auto;
}
</style>

<script>
// Dans votre script existant, modifiez la gestion des dropdowns
document.addEventListener('DOMContentLoaded', function() {
    const body = document.body;
    const dropdownToggles = document.querySelectorAll('.sidebar-dropdown > .dropdown-toggle');
    
    function isSidebarCollapsed() {
        return body.classList.contains('sidebar-collapsed');
    }
    
    dropdownToggles.forEach(function(toggle) {
        toggle.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            // Ne pas ouvrir le dropdown si la sidebar est réduite
            if (isSidebarCollapsed()) {
                // En mode réduit, rediriger vers la première page du dropdown ou rester sur la même
                const firstLink = this.closest('.sidebar-dropdown').querySelector('.dropdown-item');
                if (firstLink && firstLink.href) {
                    window.location.href = firstLink.href;
                }
                return;
            }
            
            const parent = this.closest('.sidebar-dropdown');
            const menu = parent.querySelector('.sidebar-dropdown-menu');
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            
            // Fermer tous les autres dropdowns
            document.querySelectorAll('.sidebar-dropdown-menu.show').forEach(function(openMenu) {
                if (openMenu !== menu) {
                    openMenu.classList.remove('show');
                    const otherToggle = openMenu.closest('.sidebar-dropdown').querySelector('.dropdown-toggle');
                    if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
                }
            });
            
            // Toggle le dropdown actuel
            if (menu) {
                if (isExpanded) {
                    menu.classList.remove('show');
                    this.setAttribute('aria-expanded', 'false');
                } else {
                    menu.classList.add('show');
                    this.setAttribute('aria-expanded', 'true');
                }
            }
        });
    });
    
    // Garder le dropdown ouvert si un sous-menu est actif
    const activeDropdownItem = document.querySelector('.sidebar-dropdown-menu .dropdown-item.active');
    if (activeDropdownItem) {
        const parentDropdown = activeDropdownItem.closest('.sidebar-dropdown');
        if (parentDropdown) {
            const toggle = parentDropdown.querySelector('.dropdown-toggle');
            const menu = parentDropdown.querySelector('.sidebar-dropdown-menu');
            if (toggle && menu) {
                menu.classList.add('show');
                toggle.setAttribute('aria-expanded', 'true');
            }
        }
    }
});
</script>