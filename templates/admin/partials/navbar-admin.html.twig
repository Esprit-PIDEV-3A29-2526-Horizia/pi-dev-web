<script>
    // Fonction pour échapper les caractères HTML (corrigée)
    function escapeHtml(str) {
        // Conversion explicite en chaîne de caractères
        if (str === null || str === undefined) return '';
        const stringValue = String(str);
        return stringValue.replace(/[&<>]/g, function(m) {
            if (m === '&') return '&amp;';
            if (m === '<') return '&lt;';
            if (m === '>') return '&gt;';
            return m;
        });
    }

    // Récupérer la liste initiale des demandes via AJAX
    function loadCancelRequests() {
        fetch('{{ path('admin_cancel_requests_api') }}', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(res => res.json())
        .then(data => {
            const badge = document.getElementById('cancelRequestBadge');
            const count = data.count;
            if (count > 0) {
                badge.innerText = count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }

            const listContainer = document.getElementById('cancelRequestsList');
            if (data.requests.length === 0) {
                listContainer.innerHTML = '<li class="text-center py-3 text-muted">Aucune demande en attente</li>';
            } else {
                let html = '';
                data.requests.forEach(req => {
                    html += `
                        <li class="dropdown-item border-bottom" data-id="${escapeHtml(req.id)}" data-logement="${escapeHtml(req.logement)}" style="cursor: pointer;">
                            <strong>${escapeHtml(req.logement)}</strong><br>
                            <small>${escapeHtml(req.dateDebut)} → ${escapeHtml(req.dateFin)}</small>
                        </li>
                    `;
                });
                listContainer.innerHTML = html;
                
                document.querySelectorAll('#cancelRequestsList .dropdown-item[data-id]').forEach(item => {
                    item.addEventListener('click', function(e) {
                        e.preventDefault();
                        const reservationId = this.getAttribute('data-id');
                        window.location.href = `{{ path('admin_cancel_requests') }}?highlight=${reservationId}`;
                    });
                });
            }
        })
        .catch(err => console.error('Erreur chargement demandes:', err));
    }

    // Connexion au hub Mercure public avec polling de secours
    let eventSource = null;
    let reconnectAttempts = 0;
    const maxReconnectAttempts = 10;
    let usePolling = false;
    
    function connectEventSource() {
        if (eventSource) {
            eventSource.close();
        }
        
        try {
            const mercureUrl = 'https://demo.mercure.rocks/.well-known/mercure';
            const topic = 'https://horozia/admin/cancel-requests';
            const url = new URL(mercureUrl);
            url.searchParams.append('topic', topic);
            
            eventSource = new EventSource(url);
            
            eventSource.onopen = function() {
                console.log('EventSource connecté à Mercure');
                reconnectAttempts = 0;
                usePolling = false;
            };
            
            eventSource.onmessage = (event) => {
                try {
                    const data = JSON.parse(event.data);
                    if (data.type === 'new_cancel_request') {
                        updateNotificationList(data);
                    }
                } catch (err) {
                    console.error('Erreur traitement message:', err);
                }
            };
            
            eventSource.onerror = (err) => {
                console.error('EventSource error:', err);
                eventSource.close();
                eventSource = null;
                
                // Passer en mode polling si EventSource échoue
                if (!usePolling) {
                    usePolling = true;
                    startPolling();
                }
            };
        } catch (err) {
            console.error('Erreur connexion EventSource:', err);
            startPolling();
        }
    }
    
    // Polling de secours (recharge les données toutes les 5 secondes)
    let pollingInterval = null;
    
    function startPolling() {
        if (pollingInterval) clearInterval(pollingInterval);
        
        console.log('Mode polling activé (recharge toutes les 5 secondes)');
        
        // Chargement immédiat
        loadCancelRequests();
        
        // Puis toutes les 5 secondes
        pollingInterval = setInterval(() => {
            loadCancelRequests();
        }, 5000);
    }
    
    function updateNotificationList(data) {
        // Mettre à jour le badge
        const badge = document.getElementById('cancelRequestBadge');
        let count = parseInt(badge.innerText);
        if (isNaN(count)) count = 0;
        badge.innerText = count + 1;
        badge.style.display = 'inline-block';
        
        // Ajouter la nouvelle demande en haut de la liste
        const listContainer = document.getElementById('cancelRequestsList');
        const newItem = document.createElement('li');
        newItem.className = 'dropdown-item border-bottom';
        newItem.setAttribute('data-id', escapeHtml(data.reservationId));
        newItem.setAttribute('data-logement', escapeHtml(data.logement));
        newItem.style.cursor = 'pointer';
        newItem.innerHTML = `<strong>${escapeHtml(data.logement)}</strong><br>
                             <small>${escapeHtml(data.dateDebut)} → ${escapeHtml(data.dateFin)}</small>`;
        
        newItem.addEventListener('click', function(e) {
            e.preventDefault();
            const id = this.getAttribute('data-id');
            window.location.href = `{{ path('admin_cancel_requests') }}?highlight=${id}`;
        });
        
        if (listContainer.firstChild) {
            listContainer.insertBefore(newItem, listContainer.firstChild);
        } else {
            listContainer.appendChild(newItem);
        }
        
        if (listContainer.innerText.includes('Aucune demande')) {
            listContainer.innerHTML = '';
            listContainer.appendChild(newItem);
        }
        
        // Notification navigateur
        if (Notification.permission === 'granted') {
            new Notification('Nouvelle demande d\'annulation', { 
                body: data.message || `Demande pour ${data.logement}` 
            });
        }
    }
    
    // Arrêter le polling si nécessaire
    function stopPolling() {
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
    }
    
    if (Notification.permission !== 'denied') {
        Notification.requestPermission();
    }
    
    // Chargement initial
    loadCancelRequests();
    
    // Essayer EventSource, démarrer le polling en cas d'échec
    setTimeout(() => {
        if (!usePolling && !eventSource) {
            connectEventSource();
        }
    }, 1000);
    
    // Démarrage immédiat du polling au cas où
    setTimeout(() => {
        if (!eventSource && !usePolling) {
            startPolling();
        }
    }, 3000);
</script>