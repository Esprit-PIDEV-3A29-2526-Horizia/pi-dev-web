{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des réservations - Horozia{% endblock %}

{% block admin_content %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h1 class="h2 mb-0">
            <i class="bi bi-calendar-check me-2"></i>Gestion des réservations
            <span class="badge bg-secondary ms-2">{{ totalReservations|default(0) }}</span>
        </h1>
        <a href="{{ path('admin_logement_index') }}" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-2"></i>Retour aux logements
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted mb-2"><i class="bi bi-funnel me-1"></i>Statut</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="" {{ app.request.query.get('status') == '' ? 'selected' }}>Tous</option>
                        <option value="en_attente" {{ app.request.query.get('status') == 'en_attente' ? 'selected' }}>En attente</option>
                        <option value="confirmée" {{ app.request.query.get('status') == 'confirmée' ? 'selected' }}>Confirmée</option>
                        <option value="terminée" {{ app.request.query.get('status') == 'terminée' ? 'selected' }}>Terminée</option>
                        <option value="annulée" {{ app.request.query.get('status') == 'annulée' ? 'selected' }}>Annulée</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted mb-2"><i class="bi bi-arrow-down-up me-1"></i>Trier par montant</label>
                    <select name="sort" class="form-select rounded-3">
                        <option value="" {{ app.request.query.get('sort') == '' ? 'selected' }}>Défaut (ID)</option>
                        <option value="montant_asc" {{ app.request.query.get('sort') == 'montant_asc' ? 'selected' }}>Montant croissant</option>
                        <option value="montant_desc" {{ app.request.query.get('sort') == 'montant_desc' ? 'selected' }}>Montant décroissant</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill py-2"><i class="bi bi-search me-2"></i>Filtrer / Trier</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Logement</th>
                            <th class="py-3">Client</th>
                            <th class="py-3">Arrivée</th>
                            <th class="py-3">Départ</th>
                            <th class="py-3">Montant</th>
                            <th class="py-3">Statut</th>
                            <th class="py-3 pe-4">Modalité</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for reservation in reservationlogs|default([]) %}
                        <tr>
                            <td class="ps-4 fw-semibold">{{ reservation.logement ? reservation.logement.nom : 'N/A' }}</td>
                            <td>{% if reservation.user %}{{ reservation.user.prenom }} {{ reservation.user.nom }}{% else %}N/A{% endif %}</td>
                            <td>{{ reservation.dateDebut ? reservation.dateDebut|date('d/m/Y') : '-' }}</td>
                            <td>{{ reservation.dateFin ? reservation.dateFin|date('d/m/Y') : '-' }}</td>
                            <td class="fw-bold">{{ reservation.montant|number_format(2, ',', ' ') }} DT</td>
                            <td>
                                <span class="badge 
                                    {% if reservation.status == 'confirmée' %}bg-success
                                    {% elseif reservation.status == 'en_attente' %}bg-warning text-dark
                                    {% elseif reservation.status == 'terminée' %}bg-secondary
                                    {% else %}bg-danger{% endif %} px-3 py-2 rounded-pill">
                                    {{ reservation.status }}
                                </span>
                            </td>
                            <td class="pe-4">{{ reservation.modalites|default('-') }}</td>
                        </tr>
                        {% else %}
                        <tr><td colspan="7" class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>Aucune réservation trouvée.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}