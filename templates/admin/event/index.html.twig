{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Gestion des Événements</h1>
    <a href="{{ path('app_event_new') }}" class="btn btn-horozia-primary">
        <i class="bi bi-plus-lg"></i> Ajouter un événement
    </a>
</div>

<div class="card-horozia p-4 mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Rechercher par titre ou catégorie..." value="{{ search }}">
        </div>
        <div class="col-md-3">
            <select name="sort" class="form-select">
                <option value="">Trier par</option>
                <option value="titre_asc" {% if sort == 'titre_asc' %}selected{% endif %}>Titre (A-Z)</option>
                <option value="prix_asc" {% if sort == 'prix_asc' %}selected{% endif %}>Prix (croissant)</option>
                <option value="prix_desc" {% if sort == 'prix_desc' %}selected{% endif %}>Prix (décroissant)</option>
                <option value="date_asc" {% if sort == 'date_asc' %}selected{% endif %}>Date (plus ancien)</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-horozia-secondary w-100">Filtrer</button>
        </div>
    </form>
</div>

<div class="card-horozia">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-horozia">
                <tr>
                    <th>ID</th>
                    <th>Image</th>
                    <th>Titre</th>
                    <th>Catégorie</th>
                    <th>Lieu</th>
                    <th>Date début</th>
                    <th>Prix</th>
                    <th>Capacité</th>
                    <th>Places rest.</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                <tr>
                    <td>{{ event.id_event }}</td>
                    <td>
                        {% if event.image_url %}
                            <img src="{{ asset(event.image_url) }}" alt="{{ event.titre }}" width="50" height="50" style="object-fit: cover; border-radius: 8px;">
                        {% else %}
                            <div class="bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; border-radius: 8px;">
                                <i class="bi bi-image text-muted"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td>{{ event.titre }}</td>
                    <td>{{ event.categorie }}</td>
                    <td>{{ event.location }}</td>
                    <td>{{ event.date_debut|date('d/m/Y H:i') }}</td>
                    <td>{{ event.prix }} €</td>
                    <td>{{ event.capacite_max }}</td>
                    <td>{{ event.places_restantes }}</td>
                    <td>
                        <span class="badge {% if event.statut == 'à venir' %}bg-primary{% elseif event.statut == 'en cours' %}bg-warning{% else %}bg-secondary{% endif %}">
                            {{ event.statut }}
                        </span>
                    </td>
                    <td>
                        <a href="{{ path('app_event_show', {'id': event.id_event}) }}" class="btn btn-sm btn-info text-white">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('app_event_edit', {'id': event.id_event}) }}" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_event_delete', {'id': event.id_event}) }}" style="display: inline-block;" onsubmit="return confirm('Supprimer cet événement ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id_event) }}">
                            <button class="btn btn-sm btn-danger" type="submit">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="11" class="text-center py-4">Aucun événement trouvé.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}