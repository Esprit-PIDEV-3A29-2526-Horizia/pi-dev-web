{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Événements - Horozia{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="color:#1f2d3d;">Gestion des Événements</h1>
        <p class="text-muted mb-0">{{ events|length }} événement(s) trouvé(s)</p>
    </div>
    <a href="{{ path('app_event_new') }}" class="btn btn-horozia-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Nouvel Événement
    </a>
</div>

{# ── Search & Sort bar ── #}
<div class="card-horozia p-3 mb-4">
    <form method="GET" action="{{ path('app_event_index') }}" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-semibold small text-muted">Recherche</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="search" class="form-control border-start-0"
                       placeholder="Titre ou catégorie..." value="{{ search ?? '' }}">
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Trier par</label>
            <select name="sort" class="form-select">
                <option value="">-- Par défaut --</option>
                <option value="prix_asc"  {{ sort == 'prix_asc'  ? 'selected' : '' }}>Prix croissant</option>
                <option value="prix_desc" {{ sort == 'prix_desc' ? 'selected' : '' }}>Prix décroissant</option>
                <option value="date_asc"  {{ sort == 'date_asc'  ? 'selected' : '' }}>Date (plus proche)</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-horozia-primary w-100">
                <i class="bi bi-funnel-fill me-1"></i> Filtrer
            </button>
            <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

{# ── Table ── #}
<div class="card-horozia overflow-hidden">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-horozia">
            <tr>
                <th>#</th>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Lieu</th>
                <th>Date début</th>
                <th>Prix</th>
                <th>Places</th>
                <th>Statut</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
            <tr>
                <td class="text-muted small">{{ event.getId_event() }}</td>
                <td class="fw-semibold">{{ event.getTitre() }}</td>
                <td>
                    <span class="badge rounded-pill bg-horozia-secondary">
                        {{ event.getCategorie() }}
                    </span>
                </td>
                <td class="text-muted small"><i class="bi bi-geo-alt me-1"></i>{{ event.getLocation() }}</td>
                <td class="small">{{ event.getDate_debut()|date('d/m/Y H:i') }}</td>
                <td class="fw-semibold text-horozia-primary">{{ event.getPrix() }} TND</td>
                <td>
                    <span class="badge {{ event.getPlaces_restantes() == 0 ? 'bg-danger' : (event.getPlaces_restantes() <= 5 ? 'bg-warning text-dark' : 'bg-success') }}">
                        {{ event.getPlaces_restantes() }} / {{ event.getCapacite_max() }}
                    </span>
                </td>
                <td>
                    {% set statut = event.getStatut() %}
                    <span class="badge rounded-pill
                        {{ statut == 'à venir'  ? 'bg-info text-dark' :
                           statut == 'en cours' ? 'bg-success' :
                           statut == 'terminé'  ? 'bg-secondary' : 'bg-warning text-dark' }}">
                        {{ statut }}
                    </span>
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center gap-2">
                        <a href="{{ path('app_event_show', {id: event.getId_event()}) }}"
                           class="btn btn-sm btn-outline-primary" title="Voir">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('app_event_edit', {id: event.getId_event()}) }}"
                           class="btn btn-sm btn-horozia-warning" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="POST"
                              action="{{ path('app_event_delete', {id: event.getId_event()}) }}"
                              onsubmit="return confirm('Supprimer cet événement ?')">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ event.getId_event()) }}">
                            <button type="submit" class="btn btn-sm btn-horozia-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                    Aucun événement trouvé.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
