{% extends 'base_back.html.twig' %}

{% block title %}Modifier {{ event.getTitre() }} - Horozia{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="fw-bold mb-1" style="color:#1f2d3d;">Modifier l'Événement</h1>
        <p class="text-muted mb-0">{{ event.getTitre() }}</p>
    </div>
    <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary d-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="card-horozia p-4" style="max-width:800px;">
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

    <div class="row g-3">
        <div class="col-md-8">
            <label class="form-label fw-semibold">Titre <span class="text-danger">*</span></label>
            {{ form_widget(form.titre) }}
            {{ form_errors(form.titre) }}
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Catégorie <span class="text-danger">*</span></label>
            {{ form_widget(form.categorie) }}
            {{ form_errors(form.categorie) }}
        </div>
        <div class="col-12">
            <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Lieu <span class="text-danger">*</span></label>
            {{ form_widget(form.location) }}
            {{ form_errors(form.location) }}
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">URL de l'image</label>
            {{ form_widget(form.image_url) }}
            {{ form_errors(form.image_url) }}
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Date de début <span class="text-danger">*</span></label>
            {{ form_widget(form.date_debut) }}
            {{ form_errors(form.date_debut) }}
        </div>
        <div class="col-md-6">
            <label class="form-label fw-semibold">Date de fin <span class="text-danger">*</span></label>
            {{ form_widget(form.date_fin) }}
            {{ form_errors(form.date_fin) }}
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Prix (TND) <span class="text-danger">*</span></label>
            {{ form_widget(form.prix) }}
            {{ form_errors(form.prix) }}
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Capacité max <span class="text-danger">*</span></label>
            {{ form_widget(form.capacite_max) }}
            {{ form_errors(form.capacite_max) }}
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold">Statut <span class="text-danger">*</span></label>
            {{ form_widget(form.statut) }}
            {{ form_errors(form.statut) }}
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-horozia-primary px-4">
            <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
        </button>
        <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary px-4">Annuler</a>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
