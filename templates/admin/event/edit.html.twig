{% extends 'base_back.html.twig' %}

{% block title %}Modifier un événement{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Modifier un événement</h1>
    <a href="{{ path('app_event_index') }}" class="btn btn-horozia-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<div class="card-horozia p-4">
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.titre) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.categorie, 'Catégorie', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.categorie) }}
            </div>
            <div class="col-md-12 mb-3">
                {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                {{ form_errors(form.description) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.location, 'Lieu', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.location, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.location) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.date_debut, 'Date début', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.date_debut, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.date_debut) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.date_fin, 'Date fin', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.date_fin, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.date_fin) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.prix, 'Prix', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.prix) }}
            </div>
            <div class="col-md-3 mb-3">
                {{ form_label(form.capacite_max, 'Capacité max', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.capacite_max, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.capacite_max) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.image_url, 'URL de l\'image', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.image_url, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.image_url) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.statut, 'Statut', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.statut) }}
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-horozia-primary">Mettre à jour</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}