{% extends 'admin/base_admin.html.twig' %}

{% block title %}Dashboard Admin - Horozia{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Analytics Dashboard</h2>
        <p class="text-muted mb-0">Vue d’ensemble des statistiques principales de l’application.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Voyages</div>
                        <div class="stat-value">{{ nbVoyages }}</div>
                        <div class="stat-meta text-muted">Total des voyages</div>
                    </div>
                    <div class="stat-icon soft-blue">
                        <i class="bi bi-airplane-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Réservations</div>
                        <div class="stat-value">{{ nbReservations }}</div>
                        <div class="stat-meta text-muted">Total des réservations</div>
                    </div>
                    <div class="stat-icon soft-green">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Utilisateurs</div>
                        <div class="stat-value">{{ nbUsers }}</div>
                        <div class="stat-meta text-muted">Comptes créés</div>
                    </div>
                    <div class="stat-icon soft-yellow">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="dashboard-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Revenu estimé</div>
                        <div class="stat-value">{{ revenuTotalEstime|number_format(0, ',', ' ') }} DT</div>
                        <div class="stat-meta text-muted">Réservations confirmées</div>
                    </div>
                    <div class="stat-icon soft-neutral">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Statut des réservations</div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3" style="background: rgba(129,174,141,.15);">
                            <div class="small text-muted mb-1">Confirmées</div>
                            <div class="fs-3 fw-bold">{{ nbReservationsConfirmees }}</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded-3" style="background: rgba(232,177,86,.18);">
                            <div class="small text-muted mb-1">En attente</div>
                            <div class="fs-3 fw-bold">{{ nbReservationsEnAttente }}</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 rounded-3" style="background: rgba(220,53,69,.12);">
                            <div class="small text-muted mb-1">Annulées</div>
                            <div class="fs-3 fw-bold">{{ nbReservationsAnnulees }}</div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="card-title-custom mb-3">Top 5 voyages les plus réservés</div>
                <div class="bar-chart-box">
                    <canvas id="topVoyagesBarChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Répartition globale</div>

                <div class="chart-box mb-4">
                    <canvas id="dashboardDonutChart"></canvas>
                </div>

                <div class="mt-3 small">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Voyages</span>
                        <span>{{ nbVoyages }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Réservations</span>
                        <span>{{ nbReservations }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Utilisateurs</span>
                        <span>{{ nbUsers }}</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span>Catégories</span>
                        <span>{{ nbCategories }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Évolution mensuelle des réservations</div>
                <div class="line-chart-box">
                    <canvas id="reservationLineChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Courbe des confirmations uniquement</div>
                <div class="line-chart-box">
                    <canvas id="confirmedReservationLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Top clients</div>
                <div class="bar-chart-box">
                    <canvas id="topClientsBarChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Statistiques par catégorie</div>
                <div class="bar-chart-box">
                    <canvas id="categoriesBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Dernières réservations</div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 dashboard-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Statut</th>
                                <th>Date</th>
                                <th>Personnes</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for reservation in recentReservations %}
                                <tr>
                                    <td>{{ reservation.id }}</td>
                                    <td>
                                        {% if reservation.statut == 'CONFIRMEE' %}
                                            <span class="badge bg-success">Confirmée</span>
                                        {% elseif reservation.statut == 'EN_ATTENTE' %}
                                            <span class="badge bg-warning text-dark">En attente</span>
                                        {% else %}
                                            <span class="badge bg-danger">Annulée</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d H:i') : '' }}</td>
                                    <td>{{ reservation.nbrPersonnes }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Aucune réservation trouvée.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="dashboard-card h-100">
                <div class="card-title-custom mb-3">Prochains voyages</div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 dashboard-table">
                        <thead>
                            <tr>
                                <th>Titre</th>
                                <th>Destination</th>
                                <th>Départ</th>
                                <th>Places</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for voyage in recentVoyages %}
                                <tr>
                                    <td>{{ voyage.titre }}</td>
                                    <td>{{ voyage.destination }}</td>
                                    <td>{{ voyage.dateDepart ? voyage.dateDepart|date('Y-m-d') : '' }}</td>
                                    <td>{{ voyage.placesRestantes }}/{{ voyage.placesTotal }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-center text-muted">Aucun voyage trouvé.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.dashboard-card {
    background: #fff;
    border-radius: 20px;
    padding: 22px;
    border: 1px solid #edf1f5;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
}

.stat-label {
    font-size: .95rem;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: #1f2937;
    line-height: 1.1;
}

.stat-meta {
    font-size: .88rem;
    margin-top: 6px;
}

.stat-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.soft-blue {
    background: rgba(61, 148, 202, .14);
    color: #3D94CA;
}

.soft-green {
    background: rgba(129, 174, 141, .14);
    color: #81AE8D;
}

.soft-yellow {
    background: rgba(232, 177, 86, .18);
    color: #E8B156;
}

.soft-neutral {
    background: rgba(218, 206, 182, .3);
    color: #8b7d62;
}

.card-title-custom {
    font-size: 1.02rem;
    font-weight: 800;
    color: #1f2937;
}

.chart-box,
.line-chart-box,
.bar-chart-box {
    position: relative;
    height: 320px;
}

.dashboard-table thead th {
    font-size: .9rem;
    color: #6b7280;
    font-weight: 700;
}

.dashboard-table tbody td {
    font-size: .95rem;
}

@media (max-width: 768px) {
    .chart-box,
    .line-chart-box,
    .bar-chart-box {
        height: 280px;
    }
}
</style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const donutCtx = document.getElementById('dashboardDonutChart');

            if (donutCtx && window.Chart) {
                new Chart(donutCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ chartLabels|json_encode|raw }},
                        datasets: [{
                            data: {{ chartData|json_encode|raw }},
                            backgroundColor: ['#3D94CA', '#E8B156', '#81AE8D', '#DACEB6'],
                            borderColor: '#ffffff',
                            borderWidth: 4,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.raw;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const lineCtx = document.getElementById('reservationLineChart');

            if (lineCtx && window.Chart) {
                new Chart(lineCtx, {
                    type: 'line',
                    data: {
                        labels: {{ lineChartLabels|json_encode|raw }},
                        datasets: [{
                            label: 'Réservations',
                            data: {{ lineChartData|json_encode|raw }},
                            borderColor: '#3D94CA',
                            backgroundColor: 'rgba(61, 148, 202, 0.15)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#3D94CA',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            const confirmedLineCtx = document.getElementById('confirmedReservationLineChart');

            if (confirmedLineCtx && window.Chart) {
                new Chart(confirmedLineCtx, {
                    type: 'line',
                    data: {
                        labels: {{ confirmedLineChartLabels|json_encode|raw }},
                        datasets: [{
                            label: 'Confirmations',
                            data: {{ confirmedLineChartData|json_encode|raw }},
                            borderColor: '#81AE8D',
                            backgroundColor: 'rgba(129, 174, 141, 0.15)',
                            fill: true,
                            tension: 0.4,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            pointBackgroundColor: '#ffffff',
                            pointBorderColor: '#81AE8D',
                            pointBorderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            const barCtx = document.getElementById('topVoyagesBarChart');

            if (barCtx && window.Chart) {
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: {{ topVoyagesLabels|json_encode|raw }},
                        datasets: [{
                            label: 'Réservations',
                            data: {{ topVoyagesData|json_encode|raw }},
                            backgroundColor: '#3D94CA',
                            borderRadius: 12
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            const topClientsCtx = document.getElementById('topClientsBarChart');

            if (topClientsCtx && window.Chart) {
                new Chart(topClientsCtx, {
                    type: 'bar',
                    data: {
                        labels: {{ topClientsLabels|json_encode|raw }},
                        datasets: [{
                            label: 'Réservations',
                            data: {{ topClientsData|json_encode|raw }},
                            backgroundColor: '#E8B156',
                            borderRadius: 12
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }

            const categoriesCtx = document.getElementById('categoriesBarChart');

            if (categoriesCtx && window.Chart) {
                new Chart(categoriesCtx, {
                    type: 'bar',
                    data: {
                        labels: {{ categoriesLabels|json_encode|raw }},
                        datasets: [{
                            label: 'Réservations',
                            data: {{ categoriesData|json_encode|raw }},
                            backgroundColor: '#81AE8D',
                            borderRadius: 12
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { grid: { display: false } },
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 }
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}