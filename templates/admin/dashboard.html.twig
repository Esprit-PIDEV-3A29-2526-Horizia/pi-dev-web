{% extends 'base_back.html.twig' %}

{% block title %}Dashboard Événements - Horozia{% endblock %}

{% block body %}
<div class="mb-4">
    <h1 class="fw-bold mb-1" style="color:#1f2d3d;">Dashboard Événements</h1>
    <p class="text-muted mb-0">Vue d'ensemble de la gestion des événements</p>
</div>

{# ── Stat cards ── #}
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-card d-flex align-items-center gap-3">
            <div class="stat-icon soft-blue">
                <i class="bi bi-calendar-event fs-4"></i>
            </div>
            <div>
                <div class="stat-label">Total Événements</div>
                <div class="stat-value">{{ totalEvents }}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-card d-flex align-items-center gap-3">
            <div class="stat-icon soft-yellow">
                <i class="bi bi-clock fs-4"></i>
            </div>
            <div>
                <div class="stat-label">À venir</div>
                <div class="stat-value">{{ eventsAVenir }}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-card d-flex align-items-center gap-3">
            <div class="stat-icon soft-green">
                <i class="bi bi-play-circle fs-4"></i>
            </div>
            <div>
                <div class="stat-label">En cours</div>
                <div class="stat-value">{{ eventsEnCours }}</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-card d-flex align-items-center gap-3">
            <div class="stat-icon soft-red">
                <i class="bi bi-check-circle fs-4"></i>
            </div>
            <div>
                <div class="stat-label">Terminés</div>
                <div class="stat-value">{{ eventsTermines }}</div>
            </div>
        </div>
    </div>
</div>

{# ── Recent events table ── #}
<div class="card-horozia overflow-hidden">
    <div class="p-4 border-bottom d-flex align-items-center justify-content-between">
        <h5 class="fw-bold mb-0" style="color:#1f2d3d;">
            <i class="bi bi-clock-history me-2 text-horozia-primary"></i>Événements récents
        </h5>
        <a href="{{ path('app_event_index') }}" class="btn btn-sm btn-horozia-primary">
            Voir tout <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead class="table-horozia">
            <tr>
                <th>Titre</th>
                <th>Catégorie</th>
                <th>Date début</th>
                <th>Prix</th>
                <th>Statut</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for event in recentEvents %}
            <tr>
                <td class="fw-semibold">{{ event.getTitre() }}</td>
                <td>
                    <span class="badge rounded-pill bg-horozia-secondary">{{ event.getCategorie() }}</span>
                </td>
                <td class="small text-muted">{{ event.getDate_debut()|date('d/m/Y H:i') }}</td>
                <td class="fw-semibold text-horozia-primary">{{ event.getPrix() }} TND</td>
                <td>
                    {% set statut = event.getStatut() %}
                    <span class="badge rounded-pill
                        {{ statut == 'à venir'  ? 'bg-info text-dark' :
                           statut == 'en cours' ? 'bg-success' :
                           statut == 'terminé'  ? 'bg-secondary' : 'bg-warning text-dark' }}">
                        {{ statut }}
                    </span>
                </td>
                <td class="text-center">
                    <a href="{{ path('app_event_show', {id: event.getId_event()}) }}"
                       class="btn btn-sm btn-outline-primary me-1">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('app_event_edit', {id: event.getId_event()}) }}"
                       class="btn btn-sm btn-horozia-warning">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" class="text-center py-4 text-muted">Aucun événement pour le moment.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
