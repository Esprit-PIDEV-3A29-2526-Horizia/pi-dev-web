{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ modele.nomModele }} – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Modifier : {{ modele.nomModele }}</h1>
        <p class="text-muted mb-0">Modifier les informations du modèle</p>
    </div>
    <a href="{{ path('admin_modele_index') }}" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-list-ul me-2 text-primary"></i>Modifier le modèle
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.marque) }}
                    {{ form_widget(form.marque, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.marque) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.nomModele) }}
                    {{ form_widget(form.nomModele, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nomModele) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.image) }}
                    {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.image) }}
                    <div class="small text-muted mt-1">URL de l'image du modèle (optionnel)</div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-check-lg me-2"></i>Enregistrer
                    </button>
                    <a href="{{ path('admin_modele_show', {id: modele.idModele}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-eye me-1"></i>Voir
                    </a>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-lg-6">
        <div class="card border-danger">
            <div class="card-header bg-white text-danger fw-bold">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Zone dangereuse
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('admin_modele_delete', {id: modele.idModele}) }}" onsubmit="return confirm('Supprimer définitivement ce modèle ? Les véhicules associés seront également supprimés.')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ modele.idModele) }}">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-trash me-1"></i>Supprimer le modèle
                    </button>
                </form>
                <div class="small text-muted mt-2 text-center">Cette action est irréversible.</div>
            </div>
        </div>
    </div>
</div>

{% endblock %}