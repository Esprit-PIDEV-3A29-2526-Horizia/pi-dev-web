{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modèles – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Modèles</h1>
        <p class="text-muted mb-0">Gestion des modèles de véhicules</p>
    </div>
    <a href="{{ path('admin_modele_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nouveau modèle
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Marque</th>
                    <th>Modèle</th>
                    <th>Véhicules</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for modele in modeles %}
                <tr>
                    <td class="fw-bold text-primary">{{ modele.idModele }}</td>
                    <td><span class="badge bg-info bg-opacity-10 text-info">{{ modele.marque.nomMarque }}</span></td>
                    <td class="fw-bold">{{ modele.nomModele }}</td>
                    <td>{{ modele.vehicules|length }} véhicule(s)</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('admin_modele_show', {id: modele.idModele}) }}" class="btn btn-sm btn-outline-info" title="Voir"><i class="bi bi-eye"></i></a>
                            <a href="{{ path('admin_modele_edit', {id: modele.idModele}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">Aucun modèle trouvé.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}