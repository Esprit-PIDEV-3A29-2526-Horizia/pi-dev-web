{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord - Horozia{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Tableau de bord</h1>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">Demandes d'annulation</h5>
                <p class="card-text display-4">{{ pendingCancelRequests|default(0) }}</p>
                <a href="{{ path('admin_cancel_requests') }}" class="btn btn-light mt-2">Voir les demandes</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}