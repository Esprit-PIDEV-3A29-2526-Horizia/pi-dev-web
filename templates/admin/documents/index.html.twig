{% extends 'admin/base_admin.html.twig' %}

{% block title %}Documents – Horizia{% endblock %}

{% block admin_content %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Documents</h1>
        <p class="text-muted mb-0">Contrats, factures et QR codes</p>
    </div>
</div>

<div class="card mb-3 p-3">
    <form method="get" class="d-flex gap-2 align-items-end flex-wrap">
        <div class="flex-grow-1" style="min-width:200px;">
            <label class="form-label small mb-1">Rechercher</label>
            <input type="text" name="q" class="form-control form-control-sm" placeholder="Client, véhicule..." value="{{ app.request.query.get('q') }}">
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
        {% if app.request.query.get('q') %}
        <a href="{{ path('admin_documents_index') }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Effacer</a>
        {% endif %}
    </form>
</div>

<div class="card">
    {% if locations|length > 0 %}
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Client</th>
                    <th>Véhicule</th>
                    <th>Période</th>
                    <th>Statut</th>
                    <th>Documents</th>
                </tr>
            </thead>
            <tbody>
                {% for location in locations %}
                <tr>
                    <td class="fw-bold text-primary">#{{ location.idLocation }}</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:34px;height:34px;">
                                <i class="bi bi-person-fill text-primary"></i>
                            </div>
                            <strong>{{ location.clientNomComplet }}</strong>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-info bg-opacity-10 text-info">
                            <i class="bi bi-truck me-1"></i>{{ location.vehicule.immatriculation }}
                        </span>
                    </td>
                    <td>{{ location.dateDebut|date('d/m/Y') }} → {{ location.dateFinPrevue|date('d/m/Y') }}</td>
                    <td>{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap">
                            <a href="{{ path('admin_documents_contrat', {id: location.idLocation}) }}" class="btn btn-success btn-sm" title="Contrat" style="font-size:.75rem;">
                                <i class="bi bi-file-earmark-text me-1"></i>Contrat
                            </a>
                            <a href="{{ path('admin_documents_qrcode', {id: location.idLocation}) }}" class="btn btn-info btn-sm text-white" title="QR Code" style="font-size:.75rem;">
                                <i class="bi bi-qr-code me-1"></i>QR
                            </a>
                            <a href="{{ path('admin_location_show', {id: location.idLocation}) }}" class="btn btn-sm btn-outline-info" title="Voir">
                                <i class="bi bi-eye"></i>
                            </a>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="text-center py-5 text-muted">
        <i class="bi bi-file-earmark-x fs-1 opacity-50 mb-3 d-block"></i>
        <p>Aucun document disponible.</p>
    </div>
    {% endif %}
</div>

{% endblock %}