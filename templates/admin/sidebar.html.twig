{% set route = app.request.attributes.get('_route') %}
<div class="admin-sidebar" id="adminSidebar">

    <div class="sidebar-brand-center">
        <img src="{{ asset('images/logo.jpeg') }}" alt="Horizia" class="sidebar-logo-large">
        <span class="sidebar-brand-text">HORIZIA</span>
        <span class="sidebar-brand-sub">Location de Vehicules</span>
    </div>

    <ul class="sidebar-menu">

        <li>
            <a class="sidebar-link {{ route in ['admin_dashboard','admin_dashboard_index'] ? 'active' : '' }}"
               href="{{ path('admin_dashboard') }}" data-tooltip="Dashboard">
                <i class="bi bi-grid-fill sidebar-icon"></i>
                <span class="sidebar-label">Dashboard</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ route starts with 'admin_profile' ? 'active' : '' }}"
               href="#" data-tooltip="Gestion Profile">
                <i class="bi bi-person-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Profile</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ (route starts with 'admin_marque' or route starts with 'admin_modele') ? 'active' : '' }}"
               href="{{ path('admin_marque_index') }}" data-tooltip="Gestion Catégories">
                <i class="bi bi-tags-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Catégories</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ route starts with 'admin_vehicule' ? 'active' : '' }}"
               href="{{ path('admin_vehicule_index') }}" data-tooltip="Gestion Voyages">
                <i class="bi bi-airplane-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Voyages</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ route starts with 'admin_planning' ? 'active' : '' }}"
               href="{{ path('admin_planning_index') }}" data-tooltip="Gestion Logements">
                <i class="bi bi-building-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Logements</span>
            </a>
        </li>

        <li>
            <a class="sidebar-link {{ route starts with 'admin_documents' ? 'active' : '' }}"
               href="{{ path('admin_documents_index') }}" data-tooltip="Gestion Réservations">
                <i class="bi bi-journal-bookmark-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Réservations</span>
            </a>
        </li>

        <li class="sidebar-separator"></li>

        {# ★ Ta partie — Gestion Locations #}
        <li>
            <a class="sidebar-link sidebar-link-accent {{ route starts with 'admin_location' ? 'active' : '' }}"
               href="{{ path('admin_location_index') }}" data-tooltip="Gestion Locations">
                <i class="bi bi-calendar-check-fill sidebar-icon"></i>
                <span class="sidebar-label">Gestion Locations</span>
            </a>
        </li>

    </ul>
</div>
