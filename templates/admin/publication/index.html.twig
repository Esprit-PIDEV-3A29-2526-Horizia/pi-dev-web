{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Publications - Horizia{% endblock %}

{% block admin_content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Gestion des Publications</h1>
    <a href="{{ path('admin_publication_new') }}" class="btn btn-horozia-primary">
        <i class="bi bi-plus-lg"></i> Nouvelle publication
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <input type="text" name="search" class="form-control" placeholder="Rechercher une publication..." value="{{ app.request.query.get('search') }}">
            </div>
            <div class="col-md-4">
                <select name="categorie" class="form-select">
                    <option value="">Toutes catégories</option>
                    {% for cat in ['Plage','Montagne','Ville','Désert','Campagne','Historique'] %}
                        <option value="{{ cat }}" {% if app.request.query.get('categorie') == cat %}selected{% endif %}>{{ cat }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-horozia-secondary w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

<div class="row">
    {% for publication in publications %}
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="card h-100 shadow-sm">
            {% if publication.image %}
                <img src="{{ asset(publication.image) }}" class="card-img-top" style="height: 200px; object-fit: cover;" onerror="this.src='https://placehold.co/600x400?text=Image+manquante'">
            {% else %}
                <div class="bg-light text-center py-5">Pas d'image</div>
            {% endif %}
            <div class="card-body">
                <h5 class="card-title">{{ publication.titre }}</h5>
                <p class="card-text text-muted small">{{ publication.description|slice(0, 100) }}...</p>
                <div class="mb-2">
                    <span class="badge bg-secondary">{{ publication.categorie }}</span>
                    <span class="badge bg-light text-dark">{{ publication.auteur }}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">{{ publication.dateCreation|date('d/m/Y') }}</small>
                    <div>
                        <a href="{{ path('admin_publication_show', {'id': publication.id}) }}" class="btn btn-sm btn-outline-primary" title="Voir">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_publication_edit', {'id': publication.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="{{ path('admin_commentaire_index', {'publication': publication.id}) }}" class="btn btn-sm btn-outline-info" title="Commentaires">
                            <i class="bi bi-chat-dots-fill"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">Aucune publication trouvée.</div>
        </div>
    {% endfor %}
</div>
{% endblock %}