{% extends 'admin/base_admin.html.twig' %}

{% block title %}Commentaires de "{{ publication.titre }}"{% endblock %}
{% block stylesheets %}
{{ parent() }}
<style>
    /* Force sidebar to be full width */
    .admin-sidebar {
        width: 280px !important;
        min-width: 280px !important;
    }
    
    body.sidebar-collapsed .admin-sidebar,
    .admin-sidebar.collapsed {
        width: 90px !important;
        min-width: 90px !important;
    }

    /* Pagination custom styles */
    .pagination-custom {
        gap: 0.25rem;
    }

    .pagination-custom .page-link {
        border: none;
        color: #23779C;
        background-color: transparent;
        padding: 0.5rem 0.9rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .pagination-custom .page-link:hover {
        background-color: #23779C;
        color: white;
        transform: translateY(-2px);
    }

    .pagination-custom .page-item.active .page-link {
        background-color: #23779C;
        color: white;
        box-shadow: 0 4px 10px rgba(35, 119, 156, 0.3);
    }

    .pagination-custom .page-item.disabled .page-link {
        color: #adb5bd;
        cursor: not-allowed;
    }

    .pagination-custom .page-link.rounded-circle {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination-custom .page-link.rounded-pill {
        padding-left: 1.2rem;
        padding-right: 1.2rem;
    }

    /* Responsive pagination */
    @media (max-width: 768px) {
        .pagination-custom .page-link {
            padding: 0.35rem 0.7rem;
            font-size: 0.85rem;
        }
        
        .pagination-custom .page-link.rounded-circle {
            width: 32px;
            height: 32px;
        }
    }
</style>
{% endblock %}
{% block admin_content %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Commentaires de "{{ publication.titre }}"</h2>
        <a href="{{ path('admin_publication_show', {id: publication.id}) }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la publication
        </a>
    </div>
    <div class="card-body">
        {% if commentaires is defined and commentaires|length > 0 %}
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Auteur</th>
                            <th>Commentaire</th>
                            <th>Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for com in commentaires %}
                        <tr>
                            <td>{{ com.id }}</td>
                            <td>{{ com.auteur }}</td>
                            <td>{{ com.contenu|nl2br }}</td>
                            <td>{{ com.dateCreation|date('d/m/Y H:i') }}</td>
                            <td>
                                <a href="{{ path('admin_commentaire_edit', {id: com.id}) }}" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('admin_commentaire_delete', {id: com.id}) }}" style="display: inline-block;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ com.id) }}">
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Supprimer ce commentaire ?')">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-info">Aucun commentaire pour cette publication.</div>
        {% endif %}
    </div>
</div>
{% endblock %}