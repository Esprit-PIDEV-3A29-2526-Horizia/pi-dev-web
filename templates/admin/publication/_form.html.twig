{{ form_start(form, {attr: {novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

<div class="mb-3">
    {{ form_label(form.titre, 'Titre *', {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.titre, {attr: {class: 'form-control', placeholder: 'Ex: Belle plage à Hammamet, Randonnée en montagne...'}}) }}
    {{ form_errors(form.titre) }}
</div>

<div class="mb-3">
    {{ form_label(form.categorie, 'Catégorie *', {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.categorie, {attr: {class: 'form-select'}}) }}
    {{ form_errors(form.categorie) }}
</div>

<div class="row mb-3">
    <div class="col-md-6">
        {{ form_label(form.ville, 'Ville', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.ville, {attr: {class: 'form-control'}}) }}
    </div>
    <div class="col-md-6">
        {{ form_label(form.pays, 'Pays', {label_attr: {class: 'form-label'}}) }}
        {{ form_widget(form.pays, {attr: {class: 'form-control'}}) }}
    </div>
</div>

<div class="mb-3">
    {{ form_label(form.description, 'Description *', {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.description, {attr: {class: 'form-control', rows: 6, id: 'publication_description', placeholder: 'Décrivez votre expérience, vos recommandations...'}}) }}
    <div class="mt-2">
        <button type="button" id="generate-description-btn" class="btn btn-sm btn-info">🤖 Générer description par IA</button>
        <button type="button" id="translate-description-btn" class="btn btn-sm btn-secondary" style="display: none;">🌐 Traduire en anglais</button>
    </div>
    {{ form_errors(form.description) }}
</div>

<div class="mb-3">
    {{ form_label(form.tags, 'Tags (séparés par des virgules)', {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.tags, {attr: {class: 'form-control', placeholder: 'plage, soleil, famille, budget, été, voyage...'}}) }}
</div>

<div class="mb-3">
    {{ form_label(form.imageFile, 'Photo', {label_attr: {class: 'form-label'}}) }}
    {{ form_widget(form.imageFile, {attr: {class: 'form-control', accept: 'image/*'}}) }}
    <div class="form-text">Glissez une photo ou cliquez pour parcourir</div>
    {% if publication.image %}
        <div class="mt-2">
            <img src="{{ asset(publication.image) }}" alt="aperçu" style="max-height: 100px;">
        </div>
    {% endif %}
</div>

<div class="d-flex justify-content-end gap-2">
    <a href="{{ path('admin_publication_index') }}" class="btn btn-secondary">Annuler</a>
    <button type="submit" class="btn btn-horozia-primary">Publier</button>
</div>

{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const titreField = document.querySelector('#publication_titre');
        const categorieField = document.querySelector('#publication_categorie');
        const villeField = document.querySelector('#publication_ville');
        const paysField = document.querySelector('#publication_pays');
        const descriptionField = document.querySelector('#publication_description');
        const generateBtn = document.getElementById('generate-description-btn');
        const translateBtn = document.getElementById('translate-description-btn');

        if (generateBtn) {
            generateBtn.addEventListener('click', function() {
                const titre = titreField ? titreField.value : '';
                const categorie = categorieField ? categorieField.value : '';
                const ville = villeField ? villeField.value : '';
                const pays = paysField ? paysField.value : '';

                if (!titre || !categorie) {
                    alert('Veuillez remplir le titre et la catégorie avant de générer la description.');
                    return;
                }

                generateBtn.disabled = true;
                generateBtn.innerHTML = 'Génération en cours...';

                fetch('/api/generate-description', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ titre, categorie, ville, pays })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.description) {
                        descriptionField.value = data.description;
                        translateBtn.style.display = 'inline-block';
                    } else if (data.error) {
                        alert('Erreur : ' + data.error);
                    }
                })
                .catch(err => alert('Erreur réseau : ' + err))
                .finally(() => {
                    generateBtn.disabled = false;
                    generateBtn.innerHTML = '🤖 Générer description par IA';
                });
            });
        }

        if (translateBtn) {
            translateBtn.addEventListener('click', function() {
                const description = descriptionField.value;
                if (!description) {
                    alert('Aucune description à traduire.');
                    return;
                }

                translateBtn.disabled = true;
                translateBtn.innerHTML = 'Traduction en cours...';

                fetch('/api/translate-description', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description, lang: 'en' })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.description) {
                        if (confirm('Remplacer la description par sa traduction en anglais ?')) {
                            descriptionField.value = data.description;
                        }
                    } else if (data.error) {
                        alert('Erreur : ' + data.error);
                    }
                })
                .catch(err => alert('Erreur réseau : ' + err))
                .finally(() => {
                    translateBtn.disabled = false;
                    translateBtn.innerHTML = '🌐 Traduire en anglais';
                });
            });
        }
    });
</script>