{% extends 'admin/base_admin.html.twig' %}

{% block title %}Location #{{ location.idLocation }} – Horizia{% endblock %}

{% block admin_content %}

{# ── Leaflet CSS ── #}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Location #{{ location.idLocation }}</h1>
        <p class="text-muted mb-0">{{ location.clientNomComplet }}</p>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="btn btn-warning btn-sm">
            <i class="bi bi-pencil me-1"></i>Modifier
        </a>
        <a href="{{ path('admin_location_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <!-- Carte client -->
        <div class="card mb-3">
            <div class="card-body text-center">
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:80px;height:80px;">
                    <i class="bi bi-person-fill text-primary fs-1"></i>
                </div>
                <h4 class="fw-bold">{{ location.clientNomComplet }}</h4>
                {% if location.clientTelephone %}
                <p class="text-muted mb-1"><i class="bi bi-telephone me-1"></i>{{ location.clientTelephone }}</p>
                {% endif %}
                {% if location.clientCin %}
                <p class="text-muted mb-1"><i class="bi bi-card-text me-1"></i>CIN : {{ location.clientCin }}</p>
                {% endif %}
                {% if location.clientPermisNumero %}
                <p class="text-muted mb-3"><i class="bi bi-file-earmark-person me-1"></i>Permis : {{ location.clientPermisNumero }}</p>
                {% endif %}

                <div>{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</div>

                {% if location.montantTotal %}
                <div class="mt-3 pt-3 border-top">
                    <div class="text-muted small">Montant total</div>
                    <div class="fs-3 fw-bold text-primary">{{ location.montantTotal|number_format(3, ',', ' ') }} TND</div>
                    {% if location.avance %}
                    <div class="small text-success">Avance : {{ location.avance|number_format(3, ',', ' ') }} TND</div>
                    <div class="small text-danger">Reste : {{ location.resteAPayer|number_format(3, ',', ' ') }} TND</div>
                    {% endif %}
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Carte véhicule -->
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-truck me-2 text-primary"></i>Véhicule
            </div>
            <div class="card-body">
                {% if location.vehicule.photo %}
                <img src="{{ location.vehicule.photo starts with 'http' ? location.vehicule.photo : asset('uploads/vehicules/' ~ location.vehicule.photo) }}"
                     class="img-fluid rounded mb-3" style="height:120px; object-fit:cover; width:100%;">
                {% endif %}
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Immatriculation</span>
                    <span class="fw-bold">{{ location.vehicule.immatriculation }}</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Prix/jour</span>
                    <span class="fw-bold text-primary">{{ location.vehicule.prixParJour|number_format(3, ',', ' ') }} TND</span>
                </div>
            </div>
        </div>

        <!-- Carte position -->
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-geo-alt-fill me-2 text-danger"></i>Position client
            </div>
            <div class="card-body">
                {% if location.clientAdresse or location.clientVille %}
                <div class="bg-light p-2 rounded mb-2 small">
                    <i class="bi bi-house me-1"></i>
                    {{ location.clientAdresse ?? '' }}{% if location.clientVille %}, {{ location.clientVille }}{% endif %}
                </div>
                {% endif %}
                <div id="map-client" style="height:240px;border-radius:8px;overflow:hidden;"></div>
                {% if location.clientLatitude and location.clientLongitude %}
                <a href="https://www.google.com/maps?q={{ location.clientLatitude }},{{ location.clientLongitude }}"
                   target="_blank" class="btn btn-outline-primary btn-sm w-100 mt-2">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Ouvrir dans Google Maps
                </a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Période -->
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-calendar-range me-2 text-primary"></i>Période
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="bg-light rounded p-3">
                            <div class="small text-muted"><i class="bi bi-calendar-event"></i> Début</div>
                            <div class="fw-bold">{{ location.dateDebut|date('d/m/Y') }}</div>
                            <div class="small text-muted">{{ location.dateDebut|date('H:i') }}</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-light rounded p-3">
                            <div class="small text-muted"><i class="bi bi-hourglass"></i> Durée</div>
                            {% set jours = ((location.dateFinPrevue|date('U') - location.dateDebut|date('U')) / 86400)|round %}
                            <div class="fs-3 fw-bold text-primary">{{ jours }}</div>
                            <div class="small text-muted">jour(s)</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="bg-light rounded p-3">
                            <div class="small text-muted"><i class="bi bi-calendar-check"></i> Fin prévue</div>
                            <div class="fw-bold">{{ location.dateFinPrevue|date('d/m/Y') }}</div>
                            <div class="small text-muted">{{ location.dateFinPrevue|date('H:i') }}</div>
                        </div>
                    </div>
                </div>
                {% if location.dateFinReelle %}
                <div class="alert alert-success mt-3 mb-0 py-2">
                    <i class="bi bi-calendar2-check me-2"></i>Date fin réelle : <strong>{{ location.dateFinReelle|date('d/m/Y') }}</strong>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Détails financiers -->
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-receipt me-2 text-primary"></i>Détails financiers
            </div>
            <div class="card-body">
                {% set jours = ((location.dateFinPrevue|date('U') - location.dateDebut|date('U')) / 86400)|round %}
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Prix/jour × {{ jours }} jour(s)</span>
                    <span class="fw-bold">{{ (location.prixParJour * jours)|number_format(3, ',', ' ') }} TND</span>
                </div>
                {% if location.extras %}
                    {% for cle, prix in location.extras %}
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">{{ extras_dispo[cle].label ?? cle }}</span>
                        <span>{{ prix|number_format(3, ',', ' ') }} TND</span>
                    </div>
                    {% endfor %}
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fst-italic">Total extras</span>
                        <span class="text-primary">{{ location.extrasTotal|number_format(3, ',', ' ') }} TND</span>
                    </div>
                {% endif %}
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="fw-bold">Montant total</span>
                    <span class="fw-bold text-primary fs-5">{{ location.montantTotal|number_format(3, ',', ' ') }} TND</span>
                </div>
                {% if location.avance %}
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted">Avance versée</span>
                    <span class="fw-bold text-success">{{ location.avance|number_format(3, ',', ' ') }} TND</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="fw-bold">Reste à payer</span>
                    <span class="fw-bold text-danger">{{ location.resteAPayer|number_format(3, ',', ' ') }} TND</span>
                </div>
                {% endif %}
                {% if location.kilometrageDebut %}
                <div class="d-flex justify-content-between py-2 border-top mt-2">
                    <span class="text-muted">Km départ</span>
                    <span>{{ location.kilometrageDebut|number_format(0, ',', ' ') }} km</span>
                </div>
                {% endif %}
                {% if location.kilometrageRetour %}
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Km retour</span>
                    <span>{{ location.kilometrageRetour|number_format(0, ',', ' ') }} km</span>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Notes -->
        {% if location.notes %}
        <div class="card mb-3">
            <div class="card-header bg-white fw-bold">
                <i class="bi bi-chat-text me-2 text-primary"></i>Notes
            </div>
            <div class="card-body">
                <p class="mb-0">{{ location.notes|nl2br }}</p>
            </div>
        </div>
        {% endif %}

        <!-- Actions -->
        <div class="card">
            <div class="card-header bg-white fw-bold">Actions</div>
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Modifier
                    </a>
                    <a href="{{ path('admin_documents_qrcode', {id: location.idLocation}) }}" class="btn btn-info text-white">
                        <i class="bi bi-qr-code me-1"></i>QR Code
                    </a>
                    <a href="{{ path('admin_documents_contrat', {id: location.idLocation}) }}" class="btn btn-success" target="_blank">
                        <i class="bi bi-file-earmark-pdf me-1"></i>Contrat PDF
                    </a>
                    <form method="post" action="{{ path('admin_location_delete', {id: location.idLocation}) }}"
                          onsubmit="return confirm('Supprimer cette location ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.idLocation) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const lat  = {{ location.clientLatitude  is not null ? location.clientLatitude  : 36.8065 }};
    const lng  = {{ location.clientLongitude is not null ? location.clientLongitude : 10.1815 }};
    const hasCoords = {{ (location.clientLatitude is not null and location.clientLongitude is not null) ? 'true' : 'false' }};

    const map = L.map('map-client').setView([lat, lng], hasCoords ? 14 : 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    const markerColor = hasCoords ? '#dc3545' : '#f59e0b';
    const markerIcon = L.divIcon({
        html: `<div style="width:32px;height:32px;border-radius:50% 50% 50% 0;background:${markerColor};border:3px solid #fff;transform:rotate(-45deg);"></div>`,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -34]
    });

    L.marker([lat, lng], { icon: markerIcon })
        .addTo(map)
        .bindPopup(`<strong>{{ location.clientNomComplet }}</strong><br>{{ location.clientTelephone }}`)
        .openPopup();

    L.marker([36.8559, 10.1938], {
        icon: L.divIcon({ html: '<div style="background:#23779C;color:#fff;padding:4px 8px;border-radius:8px;">🏢 Horizia</div>', iconAnchor: [30, 16] })
    }).addTo(map).bindPopup('<strong>Agence Horizia</strong>');
});
</script>

{% endblock %}