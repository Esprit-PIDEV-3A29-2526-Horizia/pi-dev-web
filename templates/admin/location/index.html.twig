{% extends 'admin/layout.html.twig' %}
{% block title %}Locations – Horizia{% endblock %}
{% block topbar_title %}Locations{% endblock %}
{% block admin_content %}

<style>
.view-toggle-btn {
    padding: 6px 12px;
    border: 1.5px solid var(--color-primary);
    background: #fff;
    color: var(--color-primary);
    border-radius: 7px;
    cursor: pointer;
    font-size: .88rem;
    transition: .15s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.view-toggle-btn.active, .view-toggle-btn:hover { background: var(--color-primary); color: #fff; }
.pagination-bar { display:flex; align-items:center; justify-content:space-between; padding:14px 16px 14px; flex-wrap:wrap; gap:8px; border-top:1px solid #f1f5f9; }
.pg-info { font-size:.88rem; color:#6c757d; }
.pg-btns { display:flex; gap:4px; }
.pg-btn {
    min-width:34px; height:34px; padding:0 8px;
    border:1.5px solid #dde3ea; border-radius:8px;
    background:#fff; color:#1e293b;
    font-size:.85rem; font-weight:600;
    display:inline-flex; align-items:center; justify-content:center;
    text-decoration:none; transition:.15s;
}
.pg-btn:hover { border-color:var(--color-primary); color:var(--color-primary); }
.pg-btn.active { background:var(--color-primary); border-color:var(--color-primary); color:#fff; }
.pg-btn.disabled { opacity:.4; pointer-events:none; }
.pg-dots { min-width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; color:#94a3b8; font-weight:700; font-size:.9rem; }
</style>

{# ── En-tête ── #}
<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon"><i class="bi bi-calendar-check-fill"></i></div>
        <div>
            <h2>Locations <span class="badge-count">{{ total }}</span></h2>
            <p class="text-muted mb-0" style="font-size:.92rem;">Gestion des locations de véhicules</p>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <div class="d-flex gap-1">
            <a href="{{ path('admin_location_index', {vue: 'table', page: 1, search: recherche}) }}"
               class="view-toggle-btn {{ vue == 'table' ? 'active' : '' }}">
                <i class="bi bi-table"></i> Tableau
            </a>
            <a href="{{ path('admin_location_index', {vue: 'cards', page: 1, search: recherche}) }}"
               class="view-toggle-btn {{ vue == 'cards' ? 'active' : '' }}">
                <i class="bi bi-grid-3x3-gap"></i> Cartes
            </a>
        </div>
        <form method="post" action="{{ path('admin_location_update_statuts') }}" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('update_statuts') }}">
            <button type="submit" class="btn btn-horozia-outline btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Maj statuts</button>
        </form>
        <a href="{{ path('admin_location_new') }}" class="btn btn-horozia-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nouvelle location</a>
    </div>
</div>

{# ── Recherche ── #}
<div class="card-horozia p-3 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="vue" value="{{ vue }}">
        <input type="hidden" name="page" value="1">
        <div>
            <label class="form-label mb-1">Rechercher</label>
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Nom client, téléphone..." value="{{ recherche }}" style="min-width:220px;">
        </div>
        <button type="submit" class="btn btn-horozia-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
        {% if recherche %}
        <a href="{{ path('admin_location_index', {vue: vue}) }}" class="btn btn-horozia-outline btn-sm"><i class="bi bi-x-lg me-1"></i>Effacer</a>
        {% endif %}
    </form>
</div>

{% if total > 0 %}

{# ════════════════════════════
   VUE TABLEAU — 10 par page
════════════════════════════ #}
{% if vue == 'table' %}
<div class="card-horozia">
    <div class="table-responsive">
        <table class="table dashboard-table mb-0">
            <thead><tr class="table-horozia">
                <th>#</th><th>Client</th><th>Véhicule</th><th>Début</th><th>Fin prévue</th><th>Montant</th><th>Statut</th><th>Actions</th>
            </tr></thead>
            <tbody>
            {% for location in locations %}
            <tr>
                <td><span style="font-weight:700;color:var(--color-primary);">#{{ location.idLocation }}</span></td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#23779C,#3D94CA);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;flex-shrink:0;"><i class="bi bi-person-fill"></i></div>
                        <div>
                            <strong style="font-size:.92rem;">{{ location.clientNomComplet }}</strong>
                            <div style="font-size:.82rem;color:#6c757d;">{{ location.clientTelephone }}</div>
                        </div>
                    </div>
                </td>
                <td><span style="background:rgba(61,148,202,.12);color:#174f6a;padding:4px 10px;border-radius:20px;font-size:.82rem;font-weight:700;"><i class="bi bi-truck me-1"></i>{{ location.vehicule.immatriculation }}</span></td>
                <td style="font-size:.9rem;">{{ location.dateDebut|date('d/m/Y') }}</td>
                <td style="font-size:.9rem;">{{ location.dateFinPrevue|date('d/m/Y') }}</td>
                <td style="font-weight:700;color:var(--color-primary);">{% if location.montantTotal %}{{ location.montantTotal|number_format(3, ',', ' ') }} TND{% endif %}</td>
                <td>{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('admin_location_show', {id: location.idLocation}) }}" class="action-btn action-btn-view" title="Voir"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="action-btn action-btn-edit" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ path('admin_location_delete', {id: location.idLocation}) }}" onsubmit="return confirm('Supprimer cette location ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.idLocation) }}">
                            <button type="submit" class="action-btn action-btn-delete" title="Supprimer"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'admin/location/_pagination.html.twig' %}
</div>

{# ════════════════════════════
   VUE CARTES — 6 par page
════════════════════════════ #}
{% else %}
<div class="row g-3">
    {% for location in locations %}
    {% set colorMap = {
        'reservee':'#f59e0b','réservée':'#f59e0b',
        'en_cours':'#3b82f6',
        'terminee':'#10b981','terminée':'#10b981',
        'annulee':'#ef4444','annulée':'#ef4444',
        'no_show':'#6b7280'
    } %}
    {% set color = colorMap[location.statut] ?? '#6b7280' %}
    <div class="col-12 col-sm-6 col-xl-4">
        <div style="border-radius:14px;border:1px solid #e2e8f0;background:#fff;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.06);transition:box-shadow .2s;"
             onmouseover="this.style.boxShadow='0 6px 20px rgba(35,119,156,.15)'"
             onmouseout="this.style.boxShadow='0 2px 8px rgba(0,0,0,.06)'">
            <div style="background:{{ color }};padding:10px 16px;display:flex;justify-content:space-between;align-items:center;">
                <span style="color:#fff;">{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</span>
                <span style="color:rgba(255,255,255,.85);font-size:.82rem;font-weight:700;">#{{ location.idLocation }}</span>
            </div>
            <div style="padding:16px;">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#23779C,#3D94CA);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;"><i class="bi bi-person-fill" style="font-size:16px;"></i></div>
                    <div>
                        <div style="font-weight:700;font-size:.95rem;color:#1e293b;">{{ location.clientNomComplet }}</div>
                        <div style="font-size:.82rem;color:#64748b;"><i class="bi bi-telephone me-1"></i>{{ location.clientTelephone }}</div>
                    </div>
                </div>
                <div style="background:#f0f7fb;border-radius:8px;padding:8px 12px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
                    <i class="bi bi-truck" style="color:#23779C;font-size:1.1rem;"></i>
                    <span style="font-weight:700;color:#174f6a;font-size:.9rem;">{{ location.vehicule.immatriculation }}</span>
                    {% if location.vehicule.modele %}
                    <span style="color:#64748b;font-size:.82rem;">– {{ location.vehicule.modele }}</span>
                    {% endif %}
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div>
                        <div style="font-size:.75rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Début</div>
                        <div style="font-size:.9rem;font-weight:600;color:#1e293b;">{{ location.dateDebut|date('d/m/Y') }}</div>
                    </div>
                    <div style="color:#cbd5e1;align-self:center;"><i class="bi bi-arrow-right"></i></div>
                    <div>
                        <div style="font-size:.75rem;color:#94a3b8;text-transform:uppercase;font-weight:600;">Fin prévue</div>
                        <div style="font-size:.9rem;font-weight:600;color:#1e293b;">{{ location.dateFinPrevue|date('d/m/Y') }}</div>
                    </div>
                </div>
                {% if location.montantTotal %}
                <div style="text-align:right;margin-bottom:14px;">
                    <span style="font-size:1.1rem;font-weight:800;color:#23779C;">{{ location.montantTotal|number_format(3, ',', ' ') }} TND</span>
                </div>
                {% endif %}
                <div class="d-flex gap-2 justify-content-end border-top pt-3" style="border-color:#f1f5f9!important;">
                    <a href="{{ path('admin_location_show', {id: location.idLocation}) }}" class="action-btn action-btn-view" title="Voir"><i class="bi bi-eye"></i></a>
                    <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="action-btn action-btn-edit" title="Modifier"><i class="bi bi-pencil"></i></a>
                    <form method="post" action="{{ path('admin_location_delete', {id: location.idLocation}) }}" onsubmit="return confirm('Supprimer cette location ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.idLocation) }}">
                        <button type="submit" class="action-btn action-btn-delete" title="Supprimer"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% include 'admin/location/_pagination.html.twig' %}
{% endif %}

{% else %}
<div class="card-horozia">
    <div class="text-center py-5" style="color:#6c757d;">
        <i class="bi bi-calendar-x" style="font-size:3rem;opacity:.3;display:block;margin-bottom:12px;"></i>
        <p class="mb-3">Aucune location trouvée.</p>
        <a href="{{ path('admin_location_new') }}" class="btn btn-horozia-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Créer une location</a>
    </div>
</div>
{% endif %}

{% endblock %}
