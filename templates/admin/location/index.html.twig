{% extends 'admin/base_admin.html.twig' %}

{% block title %}Locations – Horizia{% endblock %}

{% block admin_content %}

<style>
.view-toggle-btn {
    padding: 6px 12px;
    border: 1.5px solid var(--color-primary);
    background: #fff;
    color: var(--color-primary);
    border-radius: 7px;
    cursor: pointer;
    font-size: .88rem;
    transition: .15s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
}
.view-toggle-btn.active, .view-toggle-btn:hover { background: var(--color-primary); color: #fff; }
.pagination-bar { display:flex; align-items:center; justify-content:space-between; padding:14px 16px 14px; flex-wrap:wrap; gap:8px; border-top:1px solid #f1f5f9; }
.pg-info { font-size:.88rem; color:#6c757d; }
.pg-btns { display:flex; gap:4px; }
.pg-btn {
    min-width:34px; height:34px; padding:0 8px;
    border:1.5px solid #dde3ea; border-radius:8px;
    background:#fff; color:#1e293b;
    font-size:.85rem; font-weight:600;
    display:inline-flex; align-items:center; justify-content:center;
    text-decoration:none; transition:.15s;
}
.pg-btn:hover { border-color:var(--color-primary); color:var(--color-primary); }
.pg-btn.active { background:var(--color-primary); border-color:var(--color-primary); color:#fff; }
.pg-btn.disabled { opacity:.4; pointer-events:none; }
.pg-dots { min-width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; color:#94a3b8; font-weight:700; font-size:.9rem; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1">Locations</h1>
        <p class="text-muted mb-0">Gestion des locations de véhicules</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <div class="d-flex gap-1">
            <a href="{{ path('admin_location_index', {vue: 'table', page: 1, search: recherche}) }}"
               class="view-toggle-btn {{ vue == 'table' ? 'active' : '' }}">
                <i class="bi bi-table"></i> Tableau
            </a>
            <a href="{{ path('admin_location_index', {vue: 'cards', page: 1, search: recherche}) }}"
               class="view-toggle-btn {{ vue == 'cards' ? 'active' : '' }}">
                <i class="bi bi-grid-3x3-gap"></i> Cartes
            </a>
        </div>
        <form method="post" action="{{ path('admin_location_update_statuts') }}" style="display:inline;">
            <input type="hidden" name="_token" value="{{ csrf_token('update_statuts') }}">
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Maj statuts</button>
        </form>
        <a href="{{ path('admin_location_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Nouvelle location</a>
    </div>
</div>

{# ── Recherche ── #}
<div class="card p-3 mb-3">
    <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="vue" value="{{ vue }}">
        <input type="hidden" name="page" value="1">
        <div class="flex-grow-1">
            <label class="form-label mb-1">Rechercher</label>
            <input type="text" name="search" class="form-control form-control-sm"
                   placeholder="Nom client, téléphone..." value="{{ recherche }}" style="min-width:220px;">
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-search me-1"></i>Rechercher</button>
        {% if recherche %}
        <a href="{{ path('admin_location_index', {vue: vue}) }}" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Effacer</a>
        {% endif %}
    </form>
</div>

{% if total > 0 %}

{# VUE TABLEAU #}
{% if vue == 'table' %}
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Client</th><th>Véhicule</th><th>Début</th><th>Fin prévue</th><th>Montant</th><th>Statut</th><th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for location in locations %}
            <tr>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;">
                            <i class="bi bi-person-fill text-primary"></i>
                        </div>
                        <div>
                            <strong>{{ location.clientNomComplet }}</strong>
                            <div class="small text-muted">{{ location.clientTelephone }}</div>
                        </div>
                    </div>
                </td>
                <td><span class="badge bg-info bg-opacity-10 text-info">{{ location.vehicule.immatriculation }}</span></td>
                <td>{{ location.dateDebut|date('d/m/Y') }}</td>
                <td>{{ location.dateFinPrevue|date('d/m/Y') }}</td>
                <td class="fw-bold text-primary">{{ location.montantTotal|number_format(3, ',', ' ') }} TND</td>
                <td>{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</td>
                <td>
                    <div class="d-flex gap-1">
                        <a href="{{ path('admin_location_show', {id: location.idLocation}) }}" class="btn btn-sm btn-outline-info" title="Voir"><i class="bi bi-eye"></i></a>
                        <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="btn btn-sm btn-outline-warning" title="Modifier"><i class="bi bi-pencil"></i></a>
                        <form method="post" action="{{ path('admin_location_delete', {id: location.idLocation}) }}" onsubmit="return confirm('Supprimer cette location ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.idLocation) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'admin/location/_pagination.html.twig' %}
</div>

{# VUE CARTES #}
{% else %}
<div class="row g-3">
    {% for location in locations %}
    {% set colorMap = {
        'reservee':'#f59e0b','réservée':'#f59e0b',
        'en_cours':'#3b82f6',
        'terminee':'#10b981','terminée':'#10b981',
        'annulee':'#ef4444','annulée':'#ef4444',
        'no_show':'#6b7280'
    } %}
    {% set color = colorMap[location.statut] ?? '#6b7280' %}
    <div class="col-12 col-sm-6 col-xl-4">
        <div class="card h-100 shadow-sm">
            <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center" style="background:{{ color }}; color:#fff;">
                <span>{% include 'admin/location/_badge_statut.html.twig' with {statut: location.statut} %}</span>
                <span class="fw-bold">#{{ location.idLocation }}</span>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                        <i class="bi bi-person-fill text-primary fs-5"></i>
                    </div>
                    <div>
                        <div class="fw-bold">{{ location.clientNomComplet }}</div>
                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>{{ location.clientTelephone }}</div>
                    </div>
                </div>
                <div class="bg-light rounded p-2 mb-3">
                    <i class="bi bi-truck text-primary me-1"></i>
                    <span class="fw-bold">{{ location.vehicule.immatriculation }}</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <div class="small text-muted text-uppercase">Début</div>
                        <div class="fw-bold">{{ location.dateDebut|date('d/m/Y') }}</div>
                    </div>
                    <div class="text-muted align-self-center"><i class="bi bi-arrow-right"></i></div>
                    <div>
                        <div class="small text-muted text-uppercase">Fin prévue</div>
                        <div class="fw-bold">{{ location.dateFinPrevue|date('d/m/Y') }}</div>
                    </div>
                </div>
                <div class="text-end mb-3">
                    <span class="fs-5 fw-bold text-primary">{{ location.montantTotal|number_format(3, ',', ' ') }} TND</span>
                </div>
                <div class="d-flex gap-2 justify-content-end border-top pt-2">
                    <a href="{{ path('admin_location_show', {id: location.idLocation}) }}" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i> Voir</a>
                    <a href="{{ path('admin_location_edit', {id: location.idLocation}) }}" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i> Modifier</a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% include 'admin/location/_pagination.html.twig' %}
{% endif %}

{% else %}
<div class="card">
    <div class="text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted opacity-50"></i>
        <p class="text-muted mt-3">Aucune location trouvée.</p>
        <a href="{{ path('admin_location_new') }}" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Créer une location</a>
    </div>
</div>
{% endif %}

{% endblock %}