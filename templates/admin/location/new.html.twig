{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle location – Horizia{% endblock %}

{% block admin_content %}

<style>
/* ── Sélecteur véhicule ── */
.vhl-search-wrapper {
    position: relative;
}
.vhl-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border: 1.5px solid rgba(35,119,156,.35);
    border-top: none;
    border-radius: 0 0 10px 10px;
    background: #fff;
    max-height: 300px;
    overflow-y: auto;
    display: none;
    z-index: 1050;
    box-shadow: 0 8px 24px rgba(0,0,0,.13);
}
.vhl-dropdown.open { display: block; }

.vhl-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
    cursor: pointer;
    border-bottom: 1px solid rgba(0,0,0,.05);
    transition: background .12s;
}
.vhl-item:hover { background: rgba(35,119,156,.08); }
.vhl-item.active-selected { background: rgba(35,119,156,.14); }
.vhl-item-icon {
    width: 38px; height: 38px;
    border-radius: 8px;
    background: rgba(35,119,156,.12);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #23779C;
}
.vhl-item-title { font-weight: 700; }
.vhl-item-sub { font-size: .76rem; color: #6c757d; }
.vhl-item-prix { font-weight: 700; color: #23779C; }

.extras-card {
    display: block; padding: 10px 14px;
    border: 2px solid rgba(0,0,0,.08); border-radius: 10px;
    cursor: pointer; transition: all .2s;
}
.extras-card:hover { border-color: #23779C; }
.extras-card.selected { border-color: #23779C; background: rgba(35,119,156,.1); }
.extras-card input { display: none; }

/* Animation pour le scan */
@keyframes scanPulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
}
.scan-loading {
    animation: scanPulse 1s infinite;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Nouvelle location</h1>
        <p class="text-muted mb-0">Remplissez les informations ci-dessous</p>
    </div>
    <a href="{{ path('admin_location_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Retour
    </a>
</div>

{# Erreurs globales #}
{% if not form.vars.valid and form.vars.submitted %}
<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle-fill me-2"></i>
    Veuillez corriger les erreurs ci-dessous.
</div>
{% endif %}

