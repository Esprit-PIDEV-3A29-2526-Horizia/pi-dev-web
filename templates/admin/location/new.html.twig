{% extends 'base.html.twig' %}

{% block title %}Nouvelle Location — Horizia{% endblock %}

{% block body %}
<div class="container-fluid px-4 py-3">

  {# ── EN-TÊTE ── #}
  <div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('admin_location_index') }}" class="btn-hz-ghost">
      <i class="bi bi-arrow-left"></i>
    </a>
    <div>
      <h4 class="fw-800 mb-0" style="color:var(--accent);">
        <i class="bi bi-plus-circle me-2"></i>Nouvelle Location
      </h4>
      <div class="fs-12 text-hz-muted">Remplissez les informations ci-dessous</div>
    </div>
  </div>

  {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'location-form'}}) }}

  <div class="row g-3">

    {# ════════════════════════════════════════════
       COL GAUCHE — CLIENT + VÉHICULE
    ════════════════════════════════════════════ #}
    <div class="col-lg-6">

      {# ── VÉHICULE ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-car-front-fill me-2" style="color:var(--accent);"></i>Véhicule
        </h6>
        <div class="mb-3">
          {{ form_label(form.vehicule) }}
          {{ form_widget(form.vehicule, {'attr': {'class': 'form-control', 'id': 'vehicule_select'}}) }}
        </div>
        {# Prix par jour (pré-rempli automatiquement via JS) #}
        <div class="mb-2">
          {{ form_label(form.prixParJour) }}
          {{ form_widget(form.prixParJour, {'attr': {'class': 'form-control', 'id': 'prix_par_jour', 'step': '0.001'}}) }}
        </div>
      </div>

      {# ── INFORMATIONS CLIENT ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-person-fill me-2" style="color:var(--accent);"></i>Informations client
        </h6>

        <div class="mb-2">
          {{ form_label(form.clientNomComplet) }}
          {{ form_widget(form.clientNomComplet, {'attr': {'class': 'form-control', 'id': 'nom_input', 'required': 'required', 'minlength': '3', 'placeholder': 'Nom et prénom complet'}}) }}
          <div class='invalid-feedback' id='err-nom'>Le nom complet est requis (min. 3 caractères).</div>
        </div>
        <div class="mb-2">
          {{ form_label(form.clientTelephone) }}
          {{ form_widget(form.clientTelephone, {'attr': {'class': 'form-control', 'id': 'tel_input', 'required': 'required', 'placeholder': '+216 XX XXX XXX'}}) }}
          <div class='invalid-feedback' id='err-tel'>Téléphone requis (chiffres uniquement).</div>
        </div>

        {# ── CIN + bouton scanner ── #}
        <div class="mb-2">
          {{ form_label(form.clientCin) }}
          <div class="input-group">
            {{ form_widget(form.clientCin, {'attr': {'class': 'form-control', 'id': 'cin_input', 'required': 'required', 'pattern': '[0-9]{8}', 'maxlength': '8', 'placeholder': '12345678', 'title': '8 chiffres exactement'}}) }}
            <button type="button" class="btn btn-outline-secondary" id="btn-scan-cin"
                    title="Scanner la CIN via photo">
              <i class="bi bi-camera-fill"></i> Scanner
            </button>
          </div>
          {# Input file caché déclenché par le bouton #}
          <input type="file" id="cin_file_input" accept="image/*" capture="environment" class="d-none">
          <div id="cin-scan-status" class="fs-12 mt-1"></div>
        </div>

        <div class="mb-2">
          {{ form_label(form.clientPermisNumero) }}
          {{ form_widget(form.clientPermisNumero, {'attr': {'class': 'form-control', 'id': 'permis_input', 'required': 'required', 'placeholder': 'Numéro de permis'}}) }}
          <div class='invalid-feedback' id='err-permis'>Le numéro de permis est requis.</div>
        </div>
      </div>

      {# ── ADRESSE CLIENT + GÉOLOCALISATION ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-geo-alt-fill me-2" style="color:var(--accent);"></i>Adresse client
        </h6>

        <div class="mb-2">
          {{ form_label(form.clientAdresse) }}
          <div class="input-group">
            {{ form_widget(form.clientAdresse, {'attr': {'class': 'form-control', 'id': 'adresse_input', 'placeholder': 'Ex: 12 Rue de la Liberté, Tunis'}}) }}
            <button type="button" class="btn btn-outline-secondary" id="btn-geolocate"
                    title="Géolocaliser cette adresse">
              <i class="bi bi-pin-map-fill"></i> Localiser
            </button>
          </div>
          <div id="geo-status" class="fs-12 mt-1"></div>
        </div>

        <div class="row g-2">
          <div class="col-8">
            {{ form_label(form.clientVille) }}
            {{ form_widget(form.clientVille, {'attr': {'class': 'form-control', 'id': 'ville_input'}}) }}
          </div>
          <div class="col-4">
            {{ form_label(form.clientCodePostal) }}
            {{ form_widget(form.clientCodePostal, {'attr': {'class': 'form-control', 'id': 'cp_input'}}) }}
          </div>
        </div>

        {# Coordonnées GPS (champs cachés, remplis par AJAX) #}
        {# Ces champs doivent correspondre aux champs clientLatitude / clientLongitude du formulaire #}
        <input type="hidden" id="lat_hidden"
               name="{{ form.clientLatitude.vars.full_name ?? 'location[clientLatitude]' }}"
               value="{{ form.clientLatitude.vars.value ?? '' }}">
        <input type="hidden" id="lon_hidden"
               name="{{ form.clientLongitude.vars.full_name ?? 'location[clientLongitude]' }}"
               value="{{ form.clientLongitude.vars.value ?? '' }}">

        {# Badge distance affiché après géolocalisation #}
        <div id="geo-distance-badge" class="mt-2 d-none">
          <span class="badge" style="background:var(--accent);font-size:12px;">
            <i class="bi bi-pin-map me-1"></i>
            Distance agence : <span id="geo-distance-val"></span>
          </span>
        </div>
      </div>

    </div>{# /col-lg-6 gauche #}

    {# ════════════════════════════════════════════
       COL DROITE — DATES + EXTRAS + MONTANT
    ════════════════════════════════════════════ #}
    <div class="col-lg-6">

      {# ── PÉRIODE ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-calendar-range me-2" style="color:var(--accent);"></i>Période de location
        </h6>
        <div class="mb-2">
          {{ form_label(form.dateDebut) }}
          {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control', 'id': 'date_debut'}}) }}
        </div>
        <div class="mb-2">
          {{ form_label(form.dateFinPrevue) }}
          {{ form_widget(form.dateFinPrevue, {'attr': {'class': 'form-control', 'id': 'date_fin'}}) }}
        </div>
        <div class="mb-2">
          {{ form_label(form.dateFinReelle) }}
          {{ form_widget(form.dateFinReelle, {'attr': {'class': 'form-control'}}) }}
        </div>
        <div class="mb-2">
          {{ form_label(form.kilometrageDebut) }}
          {{ form_widget(form.kilometrageDebut) }}
        </div>
      </div>

      {# ── EXTRAS ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-plus-circle me-2" style="color:var(--accent);"></i>Options supplémentaires
        </h6>
        <div class="row g-2">
          {% set extras_icons = {
            'siege_bebe':                'bi-person-fill',
            'gps':                       'bi-geo-alt-fill',
            'plein_carburant':           'bi-fuel-pump-fill',
            'conducteur_supplementaire': 'bi-person-plus-fill',
            'wifi':                      'bi-wifi',
            'assurance_complementaire':  'bi-shield-check'
          } %}
          {% for cle, extra in extras_dispo %}
          <div class="col-md-6">
            <label class="extra-card" id="extra-label-{{ cle }}">
              <input type="checkbox" name="extras[]" value="{{ cle }}"
                     onchange="calculerTotal()">
              <div class="d-flex align-items-center gap-2">
                <i class="bi {{ extras_icons[cle] ?? 'bi-star' }}"
                   style="color:var(--accent);font-size:18px;"></i>
                <div>
                  <div class="fw-600 fs-13">{{ extra.label }}</div>
                  <div class="fs-12 text-hz-muted">+{{ extra.prix }} TND</div>
                </div>
              </div>
            </label>
          </div>
          {% endfor %}
        </div>
      </div>

      {# ── MONTANT TOTAL AUTO ── #}
      <div class="card-hz p-3 mb-3" style="border:2px solid var(--accent);">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="fs-13 fw-600">Montant total</div>
            <div class="fs-12 text-hz-muted" id="resume_calcul">Prix/jour × jours + extras</div>
          </div>
          <div style="font-size:26px;font-weight:800;color:var(--accent);">
            <span id="montant_affiche">0.000</span> TND
          </div>
        </div>
      </div>

      {# ── PAIEMENT + STATUT ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-3">
          <i class="bi bi-cash-coin me-2" style="color:var(--accent);"></i>Paiement & Statut
        </h6>
        <div class="mb-2">
          {{ form_label(form.avance) }}
          {{ form_widget(form.avance) }}
        </div>
        <div class="mb-2">
          {{ form_label(form.statut) }}
          {{ form_widget(form.statut) }}
        </div>
        <div class="mb-2">
          <label class="form-label fs-13">Email client (optionnel)</label>
          <input type="email" name="email_client" class="form-control"
                 placeholder="client@email.com">
          <div class="fs-12 text-hz-muted mt-1">Un email de confirmation sera envoyé si renseigné.</div>
        </div>
      </div>

      {# ── NOTES ── #}
      <div class="card-hz p-3 mb-3">
        <h6 class="fw-700 mb-2">
          <i class="bi bi-sticky me-2" style="color:var(--accent);"></i>Notes
        </h6>
        {{ form_widget(form.notes) }}
      </div>

    </div>{# /col-lg-6 droite #}
  </div>{# /row #}

  {# ── ACTIONS ── #}
  <div class="d-flex gap-2 justify-content-end mt-2">
    <a href="{{ path('admin_location_index') }}" class="btn-hz-ghost">Annuler</a>
    <button type="submit" class="btn-hz-primary">
      <i class="bi bi-check-lg me-1"></i>Créer la location
    </button>
  </div>

  {{ form_end(form) }}

</div>{# /container #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// ══════════════════════════════════════════════
// UTILITAIRE — sélecteur robuste pour les champs Symfony
// ══════════════════════════════════════════════
function getField(id, suffixes) {
  let el = document.getElementById(id);
  if (el) return el;
  for (const s of (suffixes || [])) {
    el = document.querySelector('[id$="' + s + '"]') || document.querySelector('[name*="' + s + '"]');
    if (el) return el;
  }
  return null;
}

const fNom     = getField('nom_input',     ['_clientNomComplet','clientNomComplet']);
const fTel     = getField('tel_input',     ['_clientTelephone', 'clientTelephone']);
const fCin     = getField('cin_input',     ['_clientCin',       'clientCin']);
const fPermis  = getField('permis_input',  ['_clientPermisNumero','clientPermisNumero']);
const fVehicule= getField('vehicule_select',['_vehicule','vehicule']);
const fDebut   = getField('date_debut',    ['_dateDebut',   'dateDebut']);
const fFin     = getField('date_fin',      ['_dateFinPrevue','dateFinPrevue']);
const fPrix    = getField('prix_par_jour', ['_prixParJour',  'prixParJour']);

// ══════════════════════════════════════════════
// VALIDATION FORMULAIRE
// ══════════════════════════════════════════════
function validerFormulaire(e) {
  let ok = true;
  document.querySelectorAll('.form-control').forEach(el => el.classList.remove('is-invalid','is-valid'));

  if (!fNom || fNom.value.trim().length < 3) {
    fNom?.classList.add('is-invalid'); ok = false;
  } else { fNom.classList.add('is-valid'); }

  if (!fTel || !/^[0-9+\s]{8,15}$/.test(fTel.value.trim())) {
    fTel?.classList.add('is-invalid'); ok = false;
  } else { fTel.classList.add('is-valid'); }

  if (!fCin || !/^[0-9]{8}$/.test(fCin.value.trim())) {
    fCin?.classList.add('is-invalid');
    const st = document.getElementById('cin-scan-status');
    if (st) st.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>CIN invalide - 8 chiffres requis.</span>`;
    ok = false;
  } else { fCin.classList.add('is-valid'); }

  if (!fPermis || fPermis.value.trim().length < 2) {
    fPermis?.classList.add('is-invalid'); ok = false;
  } else { fPermis.classList.add('is-valid'); }

  if (!fVehicule || !fVehicule.value) {
    fVehicule?.classList.add('is-invalid'); ok = false;
  } else { fVehicule.classList.add('is-valid'); }

  if (fDebut?.value && fFin?.value) {
    if (new Date(fFin.value) <= new Date(fDebut.value)) {
      fFin.classList.add('is-invalid'); ok = false;
    } else {
      fDebut.classList.add('is-valid');
      fFin.classList.add('is-valid');
    }
  } else {
    if (!fDebut?.value) fDebut?.classList.add('is-invalid');
    if (!fFin?.value)   fFin?.classList.add('is-invalid');
    ok = false;
  }

  const emailEl = document.querySelector('input[name="email_client"]');
  if (emailEl && emailEl.value.trim()) {
    const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim());
    emailEl.classList.toggle('is-invalid', !emailOk);
    emailEl.classList.toggle('is-valid', emailOk);
    if (!emailOk) ok = false;
  }

  if (!ok) {
    e.preventDefault();
    const first = document.querySelector('.is-invalid');
    first?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    first?.focus();
  }
  return ok;
}

document.getElementById('location-form')?.addEventListener('submit', validerFormulaire);

[fNom, fTel, fCin, fPermis].forEach(el => {
  if (!el) return;
  el.addEventListener('blur', function () {
    this.classList.remove('is-invalid','is-valid');
    const v = this.value.trim();
    let valid = false;
    if (this === fNom)    valid = v.length >= 3;
    if (this === fTel)    valid = /^[0-9+\s]{8,15}$/.test(v);
    if (this === fCin)    valid = /^[0-9]{8}$/.test(v);
    if (this === fPermis) valid = v.length >= 2;
    this.classList.add(valid ? 'is-valid' : 'is-invalid');
  });
});


// ══════════════════════════════════════════════
// CALCUL AUTOMATIQUE DU MONTANT
// ══════════════════════════════════════════════
const EXTRAS_PRIX = {
  siege_bebe: 15, gps: 10, plein_carburant: 50,
  conducteur_supplementaire: 20, wifi: 8, assurance_complementaire: 25
};
let _distanceClientKm = 0;

function calculerTotal() {
  const debut = fDebut?.value;
  const fin   = fFin?.value;
  const prix  = parseFloat(fPrix?.value || 0);

  let jours = 0;
  if (debut && fin) {
    const d1 = new Date(debut), d2 = new Date(fin);
    jours = Math.max(1, Math.ceil((d2 - d1) / 86400000));
  }

  let extras = 0;
  document.querySelectorAll('input[name="extras[]"]').forEach(cb => {
    const lbl = cb.closest('label');
    if (cb.checked) { extras += EXTRAS_PRIX[cb.value] || 0; lbl?.classList.add('selected'); }
    else            { lbl?.classList.remove('selected'); }
  });

  const base = (prix * jours) + extras;
  let pctDist = 0, palierLabel = '';
  if      (_distanceClientKm > 100) { pctDist = 0.15; palierLabel = '> 100 km (+15%)'; }
  else if (_distanceClientKm > 50)  { pctDist = 0.10; palierLabel = '51-100 km (+10%)'; }
  else if (_distanceClientKm > 20)  { pctDist = 0.05; palierLabel = '21-50 km (+5%)'; }

  const supplement = base * pctDist;
  const total = base + supplement;

  const affiche = document.getElementById('montant_affiche');
  const resume  = document.getElementById('resume_calcul');
  if (affiche) affiche.textContent = total.toFixed(3);
  if (resume) {
    let txt = prix.toFixed(3) + ' TND x ' + jours + ' jour(s) + ' + extras + ' TND options';
    if (supplement > 0) txt += ' | Distance ' + _distanceClientKm.toFixed(1) + ' km ' + palierLabel + ' = +' + supplement.toFixed(3) + ' TND';
    resume.textContent = txt;
  }
}

[fDebut, fFin, fPrix, fVehicule].forEach(el => {
  el?.addEventListener('change', calculerTotal);
  el?.addEventListener('input',  calculerTotal);
});
setTimeout(calculerTotal, 100);


// ══════════════════════════════════════════════
// SCANNER CIN — navigateur → OCR.space
// ══════════════════════════════════════════════
const btnScanCin   = document.getElementById('btn-scan-cin');
const cinFileInput = document.getElementById('cin_file_input');
const cinStatus    = document.getElementById('cin-scan-status');

btnScanCin?.addEventListener('click', () => cinFileInput?.click());

cinFileInput?.addEventListener('change', async function () {
  const file = this.files[0];
  if (!file) return;
  cinStatus.innerHTML = `<span class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Analyse en cours...</span>`;
  btnScanCin.disabled = true;

  const toBase64 = f => new Promise((res, rej) => {
    const r = new FileReader();
    r.onload  = () => res(r.result.split(',')[1]);
    r.onerror = rej;
    r.readAsDataURL(f);
  });

  const tryOCR = async (engine) => {
    const b64 = await toBase64(file);
    const fd  = new FormData();
    fd.append('base64Image', 'data:' + file.type + ';base64,' + b64);
    fd.append('language',    'ara');
    fd.append('OCREngine',   engine);
    fd.append('apikey',      'K81891239788957');
    const r = await fetch('https://api.ocr.space/parse/image', { method: 'POST', body: fd });
    return r.json();
  };

  try {
    let data = await tryOCR(2);
    if (!data?.ParsedResults?.[0]?.ParsedText) data = await tryOCR(1);
    const text  = data?.ParsedResults?.[0]?.ParsedText || '';
    const match = text.replace(/\s/g, '').match(/\d{8}/);
    if (match) {
      if (fCin) fCin.value = match[0];
      cinStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>CIN : <strong>${match[0]}</strong></span>`;
    } else {
      cinStatus.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Aucun numero a 8 chiffres trouve.</span>`;
    }
  } catch (err) {
    cinStatus.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>Erreur OCR : ${err.message}</span>`;
  } finally {
    btnScanCin.disabled = false;
    cinFileInput.value  = '';
  }
});


// ══════════════════════════════════════════════
// GEOLOCALISATION — navigateur → Nominatim
// ══════════════════════════════════════════════
const btnGeo       = document.getElementById('btn-geolocate');
const geoStatus    = document.getElementById('geo-status');
const distBadge    = document.getElementById('geo-distance-badge');
const distVal      = document.getElementById('geo-distance-val');
const adresseInput = getField('adresse_input', ['_clientAdresse','clientAdresse']);

const AGENCE_LAT = 36.8190;
const AGENCE_LON = 10.1658;

function haversine(lat1, lon1, lat2, lon2) {
  const R = 6371, toRad = x => x * Math.PI / 180;
  const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
  const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

btnGeo?.addEventListener('click', async function () {
  const adresse = adresseInput?.value?.trim();
  if (!adresse) {
    geoStatus.innerHTML = `<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Saisissez d'abord une adresse.</span>`;
    return;
  }
  geoStatus.innerHTML = `<span class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Localisation en cours...</span>`;
  btnGeo.disabled = true;

  try {
    const url  = 'https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(adresse) + '&format=json&addressdetails=1&limit=1';
    const resp = await fetch(url, { headers: { 'Accept-Language': 'fr' } });
    const res  = await resp.json();
    if (!res.length) throw new Error('Adresse introuvable');

    const lat  = parseFloat(res[0].lat);
    const lon  = parseFloat(res[0].lon);
    const addr = res[0].address || {};

    document.getElementById('lat_hidden').value = lat;
    document.getElementById('lon_hidden').value = lon;

    const fVille = document.getElementById('ville_input');
    const fCp    = document.getElementById('cp_input');
    const ville  = addr.city || addr.town || addr.village || addr.county || '';
    const cp     = addr.postcode || '';
    if (fVille && !fVille.value && ville) fVille.value = ville;
    if (fCp    && !fCp.value    && cp)    fCp.value    = cp;

    _distanceClientKm = haversine(AGENCE_LAT, AGENCE_LON, lat, lon);
    calculerTotal();

    geoStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${res[0].display_name}</span>`;
    if (distVal)   distVal.textContent   = _distanceClientKm.toFixed(1) + ' km';
    if (distBadge) distBadge.classList.remove('d-none');

  } catch (err) {
    geoStatus.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${err.message}</span>`;
  } finally {
    btnGeo.disabled = false;
  }
});
</script>

<style>
.extra-card {
  display: block;
  padding: 10px 14px;
  border: 1.5px solid rgba(255,255,255,0.08);
  border-radius: 8px;
  cursor: pointer;
  transition: all .2s;
  background: rgba(255,255,255,0.03);
}
.extra-card:hover { border-color: var(--accent); }
.extra-card.selected { border-color: var(--accent); background: rgba(35,119,156,0.15); }
.extra-card input[type="checkbox"] { display: none; }
</style>
{% endblock %}
