<script>
const EXTRAS_PRIX = {
    siege_bebe:15, gps:10, plein_carburant:50,
    conducteur_supplementaire:20, wifi:8, assurance_complementaire:25
};

function toggleCard(cb) {
    cb.closest('.extras-card').classList.toggle('selected', cb.checked);
}

function calculerTotal() {
    const debut = document.getElementById('date_debut')?.value || '';
    const fin = document.getElementById('date_fin')?.value || '';
    const prix = parseFloat(document.getElementById('prix_par_jour')?.value || 0);
    let jours = 0;
    if (debut && fin) {
        const d1 = new Date(debut), d2 = new Date(fin);
        jours = Math.max(1, Math.ceil((d2 - d1) / 86400000));
    }
    let extras = 0;
    document.querySelectorAll('input[name="extras[]"]:checked').forEach(cb => { extras += EXTRAS_PRIX[cb.value] || 0; });
    const total = (prix * jours) + extras;
    const el = document.getElementById('montant_affiche');
    if (el) el.textContent = total.toFixed(3).replace('.', ',');
    const re = document.getElementById('resume_calcul');
    if (re) re.textContent = prix.toFixed(3) + ' TND × ' + jours + ' jour(s) + ' + extras + ' TND extras';
    
    const recapEl = document.getElementById('recap_lines');
    if (recapEl && jours > 0) {
        recapEl.innerHTML = `
            <div class="d-flex justify-content-between mb-1">
                <span>Prix/jour:</span>
                <span class="fw-bold">${prix.toFixed(3)} DT</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Durée:</span>
                <span class="fw-bold">${jours} jour(s)</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span>Extras:</span>
                <span class="fw-bold">${extras.toFixed(3)} DT</span>
            </div>
            <div class="d-flex justify-content-between pt-2 mt-1 border-top">
                <span>Total:</span>
                <span class="fw-bold text-primary fs-6">${total.toFixed(3)} DT</span>
            </div>
        `;
    }
}

document.addEventListener('DOMContentLoaded', function() {
    ['date_debut','date_fin'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('change', calculerTotal);
            el.addEventListener('input', calculerTotal);
        }
    });
    calculerTotal();
});
// ============================================
// SÉLECTEUR VÉHICULE - Version corrigée
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    const nativeSel = document.querySelector('select[name$="[vehicule]"]');
    const vehicules = JSON.parse(document.getElementById('vhl_data')?.textContent || '[]');
    const searchEl = document.getElementById('vhl_search');
    const listEl = document.getElementById('vhl_list');
    const prixInput = document.getElementById('prix_par_jour');
    let isOpen = false;
    let selectedValue = nativeSel?.value || '';

    function renderList(query) {
        const q = (query || '').toLowerCase();
        const filtered = q ? vehicules.filter(v => 
            (v.marque || '').toLowerCase().includes(q) || 
            (v.modele || '').toLowerCase().includes(q) || 
            (v.immat || '').toLowerCase().includes(q)
        ) : vehicules;
        
        if (filtered.length === 0) {
            listEl.innerHTML = '<div class="p-3 text-center text-muted">Aucun véhicule trouvé</div>';
            return;
        }
        
        listEl.innerHTML = filtered.map(v => `
            <div class="vhl-item" data-value="${v.value}" data-prix="${v.prix}" data-marque="${v.marque || ''}" data-modele="${v.modele || ''}" data-immat="${v.immat || ''}">
                <div class="vhl-item-icon"><i class="bi bi-car-front-fill"></i></div>
                <div class="flex-grow-1">
                    <div class="vhl-item-title">${v.marque || ''} ${v.modele || ''}</div>
                    <div class="vhl-item-sub">${v.immat || ''}</div>
                </div>
                <div class="vhl-item-prix">${parseFloat(v.prix).toFixed(3)} TND/j</div>
            </div>
        `).join('');
        
        // Attacher les événements après le rendu
        listEl.querySelectorAll('.vhl-item').forEach(el => {
            el.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const value = this.dataset.value;
                const prix = this.dataset.prix;
                const marque = this.dataset.marque;
                const modele = this.dataset.modele;
                const immat = this.dataset.immat;
                
                console.log('Véhicule sélectionné:', {value, prix, marque, modele});
                
                // Mettre à jour le select natif
                if (nativeSel) {
                    nativeSel.value = value;
                    // Déclencher l'événement change manuellement
                    nativeSel.dispatchEvent(new Event('change', { bubbles: true }));
                }
                
                // Mettre à jour le champ prix
                if (prixInput) {
                    const prixNumber = parseFloat(prix);
                    if (!isNaN(prixNumber)) {
                        prixInput.value = prixNumber.toFixed(3);
                        prixInput.readOnly = true;
                        prixInput.style.backgroundColor = '#e9ecef';
                        console.log('Prix mis à jour:', prixInput.value);
                    } else {
                        console.warn('Prix invalide:', prix);
                    }
                }
                
                // Mettre à jour l'aperçu
                const previewNom = document.getElementById('vhl_preview_nom');
                if (previewNom) previewNom.innerHTML = `${marque || ''} ${modele || ''}`.trim() || 'Véhicule';
                
                const previewSub = document.getElementById('vhl_preview_sub');
                if (previewSub) previewSub.innerHTML = `${immat || ''} · ${parseFloat(prix).toFixed(3)} TND/jour`;
                
                const preview = document.getElementById('vhl_preview');
                if (preview) preview.classList.remove('d-none');
                
                // Fermer la liste et recalculer le total
                closeList();
                
                // Forcer le recalcul du total
                setTimeout(() => {
                    calculerTotal();
                }, 100);
            });
        });
    }

    function openList() { 
        if (!isOpen) {
            listEl.classList.add('open'); 
            isOpen = true; 
            if (searchEl) renderList(searchEl.value);
        }
    }
    
    function closeList() { 
        if (isOpen) {
            listEl.classList.remove('open'); 
            isOpen = false;
        }
    }
    
    // Événements de recherche
    if (searchEl) {
        searchEl.addEventListener('focus', function() { openList(); });
        searchEl.addEventListener('input', function() { 
            if (isOpen) renderList(this.value); 
        });
        searchEl.addEventListener('click', function(e) {
            e.stopPropagation();
            openList();
        });
    }
    
    // Bouton d'ouverture
    const btnOpen = document.getElementById('btn_open_vhl');
    if (btnOpen) {
        btnOpen.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            if (isOpen) closeList();
            else openList();
        });
    }
    
    // Fermeture lors du clic en dehors
    document.addEventListener('click', function(e) {
        const wrapper = document.querySelector('.vhl-search-wrapper');
        if (wrapper && !wrapper.contains(e.target)) {
            closeList();
        }
    });
    
    // Bouton pour changer de véhicule
    const btnChanger = document.getElementById('btn_changer_vhl');
    if (btnChanger) {
        btnChanger.addEventListener('click', function() {
            const preview = document.getElementById('vhl_preview');
            if (preview) preview.classList.add('d-none');
            if (nativeSel) {
                nativeSel.value = '';
                nativeSel.dispatchEvent(new Event('change', { bubbles: true }));
            }
            if (prixInput) {
                prixInput.value = '';
                prixInput.readOnly = false;
                prixInput.style.backgroundColor = '';
            }
            if (searchEl) {
                searchEl.value = '';
                renderList('');
            }
            openList();
            calculerTotal();
        });
    }
    
    // Si un véhicule est déjà sélectionné, initialiser l'aperçu
    if (nativeSel && nativeSel.value && vehicules.length > 0) {
        const selected = vehicules.find(v => v.value == nativeSel.value);
        if (selected && prixInput) {
            prixInput.value = parseFloat(selected.prix).toFixed(3);
            prixInput.readOnly = true;
            prixInput.style.backgroundColor = '#e9ecef';
            
            const previewNom = document.getElementById('vhl_preview_nom');
            if (previewNom) previewNom.innerHTML = `${selected.marque || ''} ${selected.modele || ''}`.trim();
            
            const previewSub = document.getElementById('vhl_preview_sub');
            if (previewSub) previewSub.innerHTML = `${selected.immat || ''} · ${parseFloat(selected.prix).toFixed(3)} TND/jour`;
            
            const preview = document.getElementById('vhl_preview');
            if (preview) preview.classList.remove('d-none');
        }
    }
    
    // Ouvrir la liste par défaut (optionnel)
    // openList();
    
    console.log('Sélecteur véhicule initialisé, véhicules disponibles:', vehicules.length);
});
// ============================================
// SCANNER CIN - Version backend Symfony
// ============================================

const btnScan = document.getElementById('btn-scan-cin');
const cinFileInput = document.getElementById('cin_file_input');
const cinStatus = document.getElementById('cin-scan-status');
const cinInput = document.getElementById('cin_input');

// Scanner via backend Symfony
async function scanCINWithBackend(file) {
    const formData = new FormData();
    formData.append('image', file);
    
    const response = await fetch('{{ path('admin_location_scan_cin') }}', {
        method: 'POST',
        body: formData,
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    });
    
    if (!response.ok) {
        throw new Error('HTTP ' + response.status);
    }
    
    const data = await response.json();
    if (data.success && data.cin) {
        return data.cin;
    }
    return null;
}

// Bouton scanner
if (btnScan) {
    btnScan.addEventListener('click', () => {
        if (cinFileInput) cinFileInput.click();
    });
}

// Traitement de l'image
if (cinFileInput) {
    cinFileInput.addEventListener('change', async function() {
        const file = this.files[0];
        if (!file) return;
        
        // Vérifications
        if (!file.type.startsWith('image/')) {
            if (cinStatus) cinStatus.innerHTML = '<span class="text-danger">Format non supporté (JPG/PNG)</span>';
            this.value = '';
            return;
        }
        
        if (file.size > 5 * 1024 * 1024) {
            if (cinStatus) cinStatus.innerHTML = '<span class="text-danger">Image trop volumineuse (max 5MB)</span>';
            this.value = '';
            return;
        }
        
        if (cinStatus) cinStatus.innerHTML = '<span class="text-primary"><i class="bi bi-hourglass-split me-1"></i>Analyse en cours...</span>';
        if (btnScan) btnScan.disabled = true;
        
        try {
            const cin = await scanCINWithBackend(file);
            
            if (cin && cinInput) {
                cinInput.value = cin;
                cinInput.classList.add('is-valid');
                cinInput.classList.remove('is-invalid');
                if (cinStatus) cinStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>CIN détecté: ${cin}</span>`;
                setTimeout(() => {
                    if (cinStatus) cinStatus.innerHTML = '';
                }, 3000);
            } else {
                if (cinStatus) cinStatus.innerHTML = '<span class="text-danger">Aucun CIN à 8 chiffres trouvé</span>';
            }
        } catch (err) {
            console.error('Erreur:', err);
            if (cinStatus) cinStatus.innerHTML = '<span class="text-danger">Erreur de connexion, saisie manuelle</span>';
        } finally {
            if (btnScan) btnScan.disabled = false;
            this.value = '';
        }
    });
}

// Validation CIN temps réel
if (cinInput) {
    cinInput.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8);
        
        if (this.value.length === 8) {
            this.classList.add('is-valid');
            this.classList.remove('is-invalid');
        } else if (this.value.length > 0) {
            this.classList.add('is-invalid');
            this.classList.remove('is-valid');
        } else {
            this.classList.remove('is-valid', 'is-invalid');
        }
    });
}
// ============================================
// GÉOLOCALISATION - Version corrigée
// ============================================

const btnGeo = document.getElementById('btn-geolocate');
const geoStatus = document.getElementById('geo-status');
const distBadge = document.getElementById('geo-distance-badge');
const distVal = document.getElementById('geo-distance-val');
const AGENCE_LAT = 36.8065;
const AGENCE_LON = 10.1815;

// Fonction pour calculer la distance
function haversine(la1, lo1, la2, lo2) {
    const R = 6371;
    const r = x => x * Math.PI / 180;
    const dLa = r(la2 - la1);
    const dLo = r(lo2 - lo1);
    const a = Math.sin(dLa / 2) ** 2 + Math.cos(r(la1)) * Math.cos(r(la2)) * Math.sin(dLo / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
}

// Événement de clic sur le bouton Localiser
if (btnGeo) {
    btnGeo.addEventListener('click', async function(e) {
        e.preventDefault();
        
        // Récupérer l'adresse - plusieurs méthodes possibles
        let adresse = '';
        
        // Méthode 1: via l'ID
        const adresseInput1 = document.getElementById('adresse_input');
        if (adresseInput1) {
            adresse = adresseInput1.value.trim();
        }
        
        // Méthode 2: via le champ Symfony (fallback)
        if (!adresse) {
            const adresseInput2 = document.querySelector('[id$="_clientAdresse"]');
            if (adresseInput2) {
                adresse = adresseInput2.value.trim();
            }
        }
        
        // Méthode 3: via le name
        if (!adresse) {
            const adresseInput3 = document.querySelector('[name$="[clientAdresse]"]');
            if (adresseInput3) {
                adresse = adresseInput3.value.trim();
            }
        }
        
        console.log('Adresse récupérée:', adresse);
        
        if (!adresse) {
            if (geoStatus) {
                geoStatus.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i>Veuillez saisir une adresse</span>';
            }
            return;
        }
        
        if (geoStatus) {
            geoStatus.innerHTML = '<span class="text-warning"><i class="bi bi-hourglass-split me-1"></i>Recherche de l\'adresse...</span>';
        }
        
        if (btnGeo) btnGeo.disabled = true;
        
        try {
            // Appel à l'API Nominatim (OpenStreetMap)
            const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(adresse)}&format=json&addressdetails=1&limit=1`;
            
            const response = await fetch(url, {
                headers: {
                    'Accept-Language': 'fr',
                    'User-Agent': 'Horizia-App/1.0'
                }
            });
            
            const data = await response.json();
            console.log('Réponse API:', data);
            
            if (data && data.length > 0) {
                const result = data[0];
                const lat = parseFloat(result.lat);
                const lon = parseFloat(result.lon);
                const displayName = result.display_name;
                const address = result.address || {};
                
                // Remplir les champs cachés
                const latHidden = document.getElementById('lat_hidden');
                const lonHidden = document.getElementById('lon_hidden');
                if (latHidden) latHidden.value = lat;
                if (lonHidden) lonHidden.value = lon;
                
                // Remplir la ville automatiquement
                const villeInput = document.getElementById('ville_input');
                if (villeInput && !villeInput.value) {
                    villeInput.value = address.city || address.town || address.village || '';
                }
                
                // Remplir le code postal automatiquement
                const cpInput = document.getElementById('cp_input');
                if (cpInput && !cpInput.value) {
                    cpInput.value = address.postcode || '';
                }
                
                // Calculer la distance
                const distance = haversine(AGENCE_LAT, AGENCE_LON, lat, lon);
                let distanceText = '';
                if (distance < 1) {
                    distanceText = Math.round(distance * 1000) + ' m';
                } else {
                    distanceText = distance.toFixed(1) + ' km';
                }
                
                if (geoStatus) {
                    geoStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>✓ Localisé : ${displayName.substring(0, 80)}</span>`;
                }
                
                // Afficher la distance
                if (distVal) distVal.textContent = distanceText;
                if (distBadge) distBadge.classList.remove('d-none');
                
                setTimeout(() => {
                    if (geoStatus && geoStatus.innerHTML.includes('Localisé')) {
                        geoStatus.innerHTML = '';
                    }
                }, 5000);
                
            } else {
                if (geoStatus) {
                    geoStatus.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i>Adresse non trouvée. Vérifiez l\'adresse saisie.</span>';
                }
            }
        } catch (error) {
            console.error('Erreur géolocalisation:', error);
            if (geoStatus) {
                geoStatus.innerHTML = '<span class="text-danger"><i class="bi bi-wifi-off me-1"></i>Erreur de connexion. Réessayez.</span>';
            }
        } finally {
            if (btnGeo) btnGeo.disabled = false;
        }
    });
}
</script>

