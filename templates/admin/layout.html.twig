{% extends 'base.html.twig' %}

{% block navbar %}
<nav class="navbar navbar-expand navbar-dark bg-horozia-dark shadow-sm">
    <div class="container-fluid">
        <button class="navbar-toggler d-md-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="navbar-nav flex-grow-1 justify-content-between">
            <div class="navbar-brand d-flex align-items-center gap-2 ms-3">
                <i class="bi bi-house-door-fill fs-4"></i>
                <span>Admin Panel</span>
            </div>
            
            <div class="d-flex align-items-center gap-3 me-3">
                <span class="navbar-text text-white small fw-semibold">
                    Bonjour, {{ app.user ? app.user.username : 'Admin' }}
                </span>
                <a href="#" onclick="document.logoutForm.submit(); return false;" class="btn btn-outline-light btn-sm px-3">
                    <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
                </a>
                <form method="POST" action="/logout" id="logoutForm" style="display: none;">
                    <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                </form>
            </div>
        </div>
    </div>
</nav>
{% endblock %}

{% block body %}
<div class="admin-layout">
    {% include 'admin/sidebar.twig' %}

    <div class="admin-main">
        <div class="admin-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show mb-4" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </div>
    </div>
</div>
{% endblock %}
