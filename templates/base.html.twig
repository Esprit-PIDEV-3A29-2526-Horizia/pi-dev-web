<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <title>{% block title %}Horozia{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <style>
            :root {
                --color-primary: #23779C;
                --color-secondary: #3D94CA;
                --color-accent: #81AE8D;
                --color-warning: #E8B156;
                --color-neutral: #DACEB6;
                --color-dark: #103749;
                --color-sidebar: #1f2d3d;
                --color-light-bg: #f8f6f1;
                --color-white: #ffffff;
                --color-border: #e9edf3;
                --color-muted: #6c757d;
            }

            body {
                background-color: var(--color-light-bg);
                margin: 0;
                padding: 0;
            }

            /* Navbar */
            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
            }
            .bg-horozia-dark {
                background-color: var(--color-dark) !important;
            }
            .bg-horozia-primary {
                background-color: var(--color-primary) !important;
            }
            .bg-horozia-secondary {
                background-color: var(--color-secondary) !important;
            }
            .bg-horozia-accent {
                background-color: var(--color-accent) !important;
            }
            .bg-horozia-neutral {
                background-color: var(--color-neutral) !important;
            }
            .text-horozia-primary {
                color: var(--color-primary) !important;
            }
            .text-horozia-secondary {
                color: var(--color-secondary) !important;
            }
            .text-horozia-accent {
                color: var(--color-accent) !important;
            }

            /* Boutons */
            .btn-horozia-primary,
            .btn-horozia-secondary,
            .btn-horozia-accent,
            .btn-horozia-warning,
            .btn-horozia-neutral {
                border-radius: 10px;
                font-weight: 600;
                transition: 0.2s ease;
            }
            .btn-horozia-primary {
                background-color: var(--color-primary);
                border-color: var(--color-primary);
                color: white;
            }
            .btn-horozia-primary:hover {
                background-color: #1d6482;
                border-color: #1d6482;
                color: white;
            }
            .btn-horozia-secondary {
                background-color: var(--color-secondary);
                border-color: var(--color-secondary);
                color: white;
            }
            .btn-horozia-secondary:hover {
                background-color: #337fad;
                border-color: #337fad;
                color: white;
            }
            .btn-horozia-accent {
                background-color: var(--color-accent);
                border-color: var(--color-accent);
                color: white;
            }
            .btn-horozia-accent:hover {
                background-color: #709b7b;
                border-color: #709b7b;
                color: white;
            }
            .btn-horozia-warning {
                background-color: var(--color-warning);
                border-color: var(--color-warning);
                color: white;
            }
            .btn-horozia-warning:hover {
                background-color: #d39d47;
                border-color: #d39d47;
                color: white;
            }
            .btn-horozia-neutral {
                background-color: var(--color-neutral);
                border-color: var(--color-neutral);
                color: #333;
            }
            .btn-horozia-neutral:hover {
                background-color: #cfc2a9;
                border-color: #cfc2a9;
                color: #333;
            }

            /* Cartes */
            .card-horozia {
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                border-radius: 14px;
                background-color: #fff;
            }
            .card-hover:hover {
                transform: translateY(-4px);
                transition: 0.3s;
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            }

            /* Administration */
            .admin-layout {
                display: flex;
                min-height: 100vh;
            }
            .admin-sidebar {
                width: 280px;
                background: var(--color-sidebar);
                color: #fff;
                flex-shrink: 0;
                min-height: 100vh;
                padding: 1.5rem 0;
            }
            .sidebar-brand-center {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 0 24px 24px;
                text-align: center;
            }
            .sidebar-logo-large {
                width: 350px;
                height: 100px;
                object-fit: contain;
                display: block;
            }
            .sidebar-title-center {
                font-size: 1.15rem;
                font-weight: 700;
                color: #fff;
            }
            .sidebar-section-title {
                color: rgba(255,255,255,.65);
                font-size: .9rem;
                font-weight: 600;
                padding: 0 24px;
                margin-bottom: 10px;
            }
            .sidebar-menu {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .sidebar-menu li {
                margin-bottom: 4px;
            }
            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 24px;
                color: rgba(255,255,255,.85);
                text-decoration: none;
                transition: .2s ease;
            }
            .sidebar-link:hover,
            .sidebar-link.active {
                background: rgba(61,148,202,.18);
                color: #fff;
            }
            .admin-main {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                background: #f5f7fb;
                min-width: 0;
            }
            .admin-content {
                padding: 32px;
            }
            .admin-footer {
                background: #fff;
                border-top: 1px solid var(--color-border);
                color: var(--color-muted);
                font-size: .95rem;
            }

            /* Tableaux */
            .table-horozia {
                background-color: var(--color-primary);
                color: white;
            }
            .table-horozia th {
                background-color: var(--color-primary) !important;
                color: white !important;
                border-color: rgba(255,255,255,0.12);
            }

            /* Alertes personnalisées */
            .alert-horozia {
                border: none;
                border-radius: 14px;
                padding: 14px 18px;
                font-weight: 500;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
            }
            .alert-success.alert-horozia {
                background-color: rgba(129, 174, 141, 0.18);
                color: #2f5d3a;
            }
            .alert-danger.alert-horozia {
                background-color: rgba(220, 53, 69, 0.12);
                color: #842029;
            }
            .alert-warning.alert-horozia {
                background-color: rgba(232, 177, 86, 0.22);
                color: #7a5714;
            }
            .alert-info.alert-horozia {
                background-color: rgba(61, 148, 202, 0.16);
                color: #174f6a;
            }

            /* Validation */
            .validation-error {
                margin-top: 6px;
                padding: 10px 12px;
                border-radius: 10px;
                background-color: rgba(220, 53, 69, 0.08);
                border: 1px solid rgba(220, 53, 69, 0.18);
                color: #842029;
                font-size: 0.92rem;
                font-weight: 500;
            }
            .validation-error ul {
                margin: 0;
                padding-left: 1rem;
            }
            .validation-error li {
                margin: 0;
            }
            .field-error .form-control,
            .field-error .form-select,
            .field-error textarea {
                border-color: #dc3545 !important;
                background-color: rgba(220, 53, 69, 0.02);
            }
        </style>
    {% endblock %}
</head>
<body>

    {% block navbar %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-horozia-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" >
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Horozia" width="40" height="40" style="object-fit: contain;">
                    <span>Horozia</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" >Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Voyages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Réservations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-light btn-sm">Connexion</a>
                        <a href="{{ path('app_admin') }}" class="btn btn-horozia-secondary btn-sm">Espace Admin</a>
                    </div>
                </div>
            </div>
        </nav>
    {% endblock %}

    <main>
        {% block body %}{% endblock %}
    </main>

    {% block footer %}
        <footer class="bg-horozia-dark text-white text-center py-3 mt-5">
            <div class="container">
                <small>© 2026 Horozia - Projet Symfony</small>
            </div>
        </footer>
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(() => {
                    document.querySelectorAll('.alert-horozia').forEach(alert => {
                        if (window.bootstrap) {
                            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                            bsAlert.close();
                        }
                    });
                }, 3000);
            });
        </script>
    {% endblock %}
</body>
</html>