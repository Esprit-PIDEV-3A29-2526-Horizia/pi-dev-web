<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Horozia{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
            <style>
                body {
                    background-color: #f8f9fa;
                }

                .navbar-brand {
                    font-weight: 700;
                    letter-spacing: 0.5px;
                }

                .hero-section {
                    background: linear-gradient(135deg, #0d6efd, #0a58ca);
                    color: white;
                    padding: 80px 0;
                    border-radius: 0 0 30px 30px;
                    margin-bottom: 40px;
                }

                .card-hover:hover {
                    transform: translateY(-4px);
                    transition: 0.3s;
                    box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
                }

                footer {
                    margin-top: 60px;
                }
            </style>
        {% endblock %}
    </head>
    <body>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="#">Horozia</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="#">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Voyages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Réservations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-light btn-sm">Connexion</a>
                        <a href="#" class="btn btn-primary btn-sm">Espace Admin</a>
                    </div>
                </div>
            </div>
        </nav>

        {% block body %}
            <section class="hero-section text-center">
                <div class="container">
                    <h1 class="display-5 fw-bold">Bienvenue sur Horozia</h1>
                    <p class="lead mt-3">
                        Plateforme de gestion de voyages et réservations en Symfony
                    </p>
                    <a href="#" class="btn btn-light btn-lg mt-3">Découvrir</a>
                </div>
            </section>

            <div class="container">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card card-hover h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-airplane"></i> Voyages</h5>
                                <p class="card-text">Consultez les voyages disponibles avec leurs détails.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-hover h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-calendar-check"></i> Réservations</h5>
                                <p class="card-text">Gérez vos réservations rapidement et simplement.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card card-hover h-100 border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title"><i class="bi bi-speedometer2"></i> Dashboard</h5>
                                <p class="card-text">Un espace administrateur clair pour gérer votre projet.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}

        <footer class="bg-dark text-white text-center py-3">
            <div class="container">
                <small>© 2026 Horozia - Projet Symfony</small>
            </div>
        </footer>

        {% block javascripts %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% endblock %}
    </body>
</html>