<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <title>{% block title %}Horozia{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <style>
            :root {
                --color-primary: #23779C;
                --color-secondary: #3D94CA;
                --color-accent: #81AE8D;
                --color-warning: #E8B156;
                --color-neutral: #DACEB6;
                --color-dark: #103749;
                --color-sidebar: #1f2d3d;
                --color-light-bg: #f8f6f1;
                --color-white: #ffffff;
                --color-border: #e9edf3;
                --color-muted: #6c757d;
            }

            body {
                background-color: var(--color-light-bg);
                margin: 0;
                padding: 0;
                transition: margin-left 0.3s ease;
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .hero-section {
                background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
                color: white;
                padding: 80px 0;
                border-radius: 0 0 30px 30px;
                margin-bottom: 40px;
            }

            .card-hover:hover {
                transform: translateY(-4px);
                transition: 0.3s;
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            }

            .bg-horozia-dark { background-color: var(--color-dark) !important; }
            .bg-horozia-primary { background-color: var(--color-primary) !important; }
            .bg-horozia-secondary { background-color: var(--color-secondary) !important; }
            .bg-horozia-accent { background-color: var(--color-accent) !important; }
            .bg-horozia-neutral { background-color: var(--color-neutral) !important; }

            .text-horozia-primary { color: var(--color-primary) !important; }
            .text-horozia-secondary { color: var(--color-secondary) !important; }
            .text-horozia-accent { color: var(--color-accent) !important; }

            .btn-horozia-primary,
            .btn-horozia-secondary,
            .btn-horozia-accent,
            .btn-horozia-warning,
            .btn-horozia-neutral {
                border-radius: 10px;
                font-weight: 600;
                transition: 0.2s ease;
            }

            .btn-horozia-primary {
                background-color: var(--color-primary);
                border-color: var(--color-primary);
                color: white;
            }
            .btn-horozia-primary:hover {
                background-color: #1d6482;
                border-color: #1d6482;
                color: white;
            }

            .btn-horozia-secondary {
                background-color: var(--color-secondary);
                border-color: var(--color-secondary);
                color: white;
            }
            .btn-horozia-secondary:hover {
                background-color: #337fad;
                border-color: #337fad;
                color: white;
            }

            .card-horozia {
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                border-radius: 14px;
                background-color: #fff;
            }
        </style>
    {% endblock %}
</head>
<body>

    {% block navbar %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-horozia-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Horozia" width="60" height="60" style="object-fit: contain;">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Voyages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Réservations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-outline-light btn-sm">Connexion</a>
                        <a href="{{ path('app_admin') }}" class="btn btn-horozia-secondary btn-sm">Espace Admin</a>
                    </div>
                </div>
            </div>
        </nav>
    {% endblock %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="swal-flash-message d-none"
                 data-type="{{ label }}"
                 data-message="{{ message|e('html_attr') }}">
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}

    {% block footer %}
        <footer class="bg-horozia-dark text-white text-center py-3">
            <div class="container">
                <small>© 2026 Horozia - Projet Symfony</small>
            </div>
        </footer>
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                setTimeout(() => {
                    document.querySelectorAll('.alert-horozia').forEach(alert => {
                        if (window.bootstrap) {
                            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                            bsAlert.close();
                        }
                    });
                }, 3000);

                const flashMessages = document.querySelectorAll('.swal-flash-message');

                flashMessages.forEach(item => {
                    const type = item.dataset.type;
                    const message = item.dataset.message;

                    let icon = 'info';
                    let title = 'Information';

                    if (type === 'success') {
                        icon = 'success';
                        title = 'Succès';
                    } else if (type === 'error' || type === 'danger') {
                        icon = 'error';
                        title = 'Erreur';
                    } else if (type === 'warning') {
                        icon = 'warning';
                        title = 'Attention';
                    } else if (type === 'info') {
                        icon = 'info';
                        title = 'Information';
                    }

                    Swal.fire({
                        icon: icon,
                        title: title,
                        text: message,
                        timer: 2500,
                        showConfirmButton: false,
                        background: '#ffffff',
                        borderRadius: '18px'
                    });
                });

                const toggleButton = document.getElementById('sidebarToggle');
                const body = document.body;

                if (localStorage.getItem('sidebar-collapsed') === 'true') {
                    body.classList.add('sidebar-collapsed');
                }

                if (toggleButton) {
                    toggleButton.addEventListener('click', function () {
                        body.classList.toggle('sidebar-collapsed');
                        localStorage.setItem('sidebar-collapsed', body.classList.contains('sidebar-collapsed'));
                    });
                }
            });
        </script>
    {% endblock %}
</body>
</html>