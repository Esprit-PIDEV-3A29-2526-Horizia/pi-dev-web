<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <title>{% block title %}Horozia{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <style>
            :root {
                --color-primary: #23779C;
                --color-secondary: #3D94CA;
                --color-accent: #81AE8D;
                --color-warning: #E8B156;
                --color-neutral: #DACEB6;
                --color-dark: #103749;
                --color-sidebar: #1f2d3d;
                --color-light-bg: #f8f6f1;
                --color-white: #ffffff;
                --color-border: #e9edf3;
                --color-muted: #6c757d;
            }

            body {
                background-color: var(--color-light-bg);
                margin: 0;
                padding: 0;
                transition: margin-left 0.3s ease;
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .hero-section {
                background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
                color: white;
                padding: 80px 0;
                border-radius: 0 0 30px 30px;
                margin-bottom: 40px;
            }

            .card-hover:hover {
                transform: translateY(-4px);
                transition: 0.3s;
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            }

            .bg-horozia-dark { background-color: var(--color-dark) !important; }
            .bg-horozia-primary { background-color: var(--color-primary) !important; }
            .bg-horozia-secondary { background-color: var(--color-secondary) !important; }
            .bg-horozia-accent { background-color: var(--color-accent) !important; }
            .bg-horozia-neutral { background-color: var(--color-neutral) !important; }

            .text-horozia-primary { color: var(--color-primary) !important; }
            .text-horozia-secondary { color: var(--color-secondary) !important; }
            .text-horozia-accent { color: var(--color-accent) !important; }

            .btn-horozia-primary,
            .btn-horozia-secondary,
            .btn-horozia-accent,
            .btn-horozia-warning,
            .btn-horozia-neutral {
                border-radius: 10px;
                font-weight: 600;
                transition: 0.2s ease;
            }

            .btn-horozia-primary {
                background-color: var(--color-primary);
                border-color: var(--color-primary);
                color: white;
            }

            .btn-horozia-primary:hover {
                background-color: #1d6482;
                border-color: #1d6482;
                color: white;
            }

            .btn-horozia-secondary {
                background-color: var(--color-secondary);
                border-color: var(--color-secondary);
                color: white;
            }

            .btn-horozia-secondary:hover {
                background-color: #337fad;
                border-color: #337fad;
                color: white;
            }

            .btn-horozia-accent {
                background-color: var(--color-accent);
                border-color: var(--color-accent);
                color: white;
            }

            .btn-horozia-accent:hover {
                background-color: #709b7b;
                border-color: #709b7b;
                color: white;
            }

            .btn-horozia-warning {
                background-color: var(--color-warning);
                border-color: var(--color-warning);
                color: white;
            }

            .btn-horozia-warning:hover {
                background-color: #d39d47;
                border-color: #d39d47;
                color: white;
            }

            .btn-horozia-neutral {
                background-color: var(--color-neutral);
                border-color: var(--color-neutral);
                color: #333;
            }

            .btn-horozia-neutral:hover {
                background-color: #cfc2a9;
                border-color: #cfc2a9;
                color: #333;
            }

            .card-horozia {
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                border-radius: 14px;
                background-color: #fff;
            }

            .table-horozia {
                background-color: var(--color-primary);
                color: white;
            }

            .table-horozia th {
                background-color: var(--color-primary) !important;
                color: white !important;
                border-color: rgba(255,255,255,0.12);
            }

            .admin-layout {
                display: flex;
                min-height: 100vh;
            }

            .admin-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 280px;
                height: 100vh;
                background: var(--color-sidebar);
                color: #fff;
                padding: 1.5rem 0;
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1030;
                transition: width 0.3s ease;
            }

            .sidebar-brand-center {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 0 24px 24px;
                text-align: center;
            }

            .sidebar-logo-large {
                width: 120px;
                height: 120px;
                object-fit: contain;
                display: block;
                margin-bottom: 10px;
            }

            .sidebar-menu {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .sidebar-menu li {
                margin-bottom: 4px;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 24px;
                color: rgba(255,255,255,.85);
                text-decoration: none;
                transition: .2s ease;
            }

            .sidebar-link:hover,
            .sidebar-link.active {
                background: rgba(61,148,202,.18);
                color: #fff;
            }

            .admin-main {
                margin-left: 280px;
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                background: #f5f7fb;
                min-width: 0;
                min-height: 100vh;
                transition: margin-left 0.3s ease;
            }

            body.sidebar-collapsed .admin-sidebar {
                width: 90px;
            }

            body.sidebar-collapsed .admin-main {
                margin-left: 90px;
            }

            body.sidebar-collapsed .sidebar-link span,
            body.sidebar-collapsed .sidebar-title-center,
            body.sidebar-collapsed .sidebar-section-title {
                display: none;
            }

            body.sidebar-collapsed .sidebar-link {
                justify-content: center;
                padding: 14px 0;
            }

            body.sidebar-collapsed .sidebar-brand-center {
                padding: 0 10px 20px;
            }

            body.sidebar-collapsed .sidebar-logo-large {
                width: 56px;
                height: 56px;
                margin-bottom: 0;
            }

            body.sidebar-collapsed .sidebar-menu {
                padding-top: 10px;
            }

            body.sidebar-collapsed .sidebar-link i {
                font-size: 1.25rem;
                margin: 0;
            }

            .admin-topbar {
                position: sticky;
                top: 0;
                z-index: 1020;
                height: 72px;
                background: #fff;
                border-bottom: 1px solid var(--color-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 24px;
            }

            .sidebar-toggle-btn {
                background: transparent;
                border: none;
                color: #495057;
                font-size: 1.8rem;
                line-height: 1;
                padding: 0;
                cursor: pointer;
            }

            .sidebar-toggle-btn:hover {
                color: var(--color-primary);
            }

            .topbar-icon-btn {
                background: transparent;
                border: none;
                color: #495057;
                position: relative;
            }

            .notification-badge {
                position: absolute;
                top: -4px;
                right: -6px;
                width: 20px;
                height: 20px;
                border-radius: 50%;
                background: #3D94CA;
                color: #fff;
                font-size: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .admin-content {
                padding: 32px;
            }

            .admin-footer {
                background: #fff;
                border-top: 1px solid var(--color-border);
                color: var(--color-muted);
                font-size: .95rem;
            }

            .dashboard-card {
                background: #fff;
                border-radius: 14px;
                padding: 22px;
                box-shadow: 0 0 0 1px rgba(15, 23, 42, 0.03), 0 10px 30px rgba(15, 23, 42, 0.04);
            }

            .stat-label {
                font-size: .95rem;
                color: #7c8793;
                margin-bottom: 10px;
                font-weight: 600;
            }

            .stat-value {
                font-size: 2.2rem;
                font-weight: 700;
                line-height: 1;
                margin-bottom: 12px;
            }

            .stat-meta {
                font-size: .95rem;
            }

            .stat-icon {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .soft-blue { background: rgba(61,148,202,.16); color: #3D94CA; }
            .soft-green { background: rgba(129,174,141,.18); color: #81AE8D; }
            .soft-yellow { background: rgba(232,177,86,.18); color: #E8B156; }
            .soft-neutral { background: rgba(218,206,182,.45); color: #23779C; }

            .card-title-custom {
                font-size: 1.05rem;
                font-weight: 700;
                color: #4d5965;
            }

            .dashboard-table thead th {
                color: #6f7c89;
                font-weight: 700;
                border-bottom: 1px solid #e9edf3;
            }

            .dashboard-table td,
            .dashboard-table th {
                padding: 14px 12px;
            }

            .alert-horozia {
                border: none;
                border-radius: 14px;
                padding: 14px 18px;
                font-weight: 500;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
            }

            .alert-success.alert-horozia {
                background-color: rgba(129, 174, 141, 0.18);
                color: #2f5d3a;
            }

            .alert-danger.alert-horozia {
                background-color: rgba(220, 53, 69, 0.12);
                color: #842029;
            }

            .alert-warning.alert-horozia {
                background-color: rgba(232, 177, 86, 0.22);
                color: #7a5714;
            }

            .alert-info.alert-horozia {
                background-color: rgba(61, 148, 202, 0.16);
                color: #174f6a;
            }

            .validation-error {
                margin-top: 6px;
                padding: 10px 12px;
                border-radius: 10px;
                background-color: rgba(220, 53, 69, 0.08);
                border: 1px solid rgba(220, 53, 69, 0.18);
                color: #842029;
                font-size: 0.92rem;
                font-weight: 500;
            }

            .validation-error ul {
                margin: 0;
                padding-left: 1rem;
            }

            .validation-error li {
                margin: 0;
            }

            .field-error .form-control,
            .field-error .form-select,
            .field-error textarea {
                border-color: #dc3545 !important;
                background-color: rgba(220, 53, 69, 0.02);
            }

            .chart-box {
                width: 220px;
                height: 220px;
                margin: 0 auto;
                position: relative;
            }

            .line-chart-box {
                width: 100%;
                height: 320px;
                position: relative;
            }

            .calendar-header {
                border-bottom: 1px solid #eef2f7;
                padding-bottom: 14px;
            }

            .calendar-header-icon {
                width: 56px;
                height: 56px;
                border-radius: 14px;
                background: linear-gradient(135deg, rgba(61,148,202,0.15), rgba(35,119,156,0.20));
                display: flex;
                align-items: center;
                justify-content: center;
                color: #23779C;
                font-size: 1.4rem;
            }

            .calendar-page-title {
                font-size: 2rem;
                font-weight: 700;
                color: #1f2d3d;
            }

            .calendar-page-subtitle {
                color: #6b7280;
                font-size: 0.98rem;
            }

            .modal-content {
                border-radius: 18px;
            }

            .image-preview-wrapper {
                width: 100%;
                max-width: 500px;
                border: 1px solid #e5e7eb;
                border-radius: 14px;
                overflow: hidden;
                background: #f8fafc;
                box-shadow: 0 6px 20px rgba(15, 23, 42, 0.05);
            }

            .image-preview-element {
                display: block;
                width: 100%;
                height: 280px;
                object-fit: cover;
                background: #eef2f7;
            }

            .voyage-card {
                background: #ffffff;
                border-radius: 24px;
                overflow: hidden;
                border: 1px solid #edf2f7;
                box-shadow: 0 12px 32px rgba(15, 23, 42, 0.07);
                transition: transform 0.25s ease, box-shadow 0.25s ease;
            }

            .voyage-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 44px rgba(15, 23, 42, 0.12);
            }

            .voyage-card-image-wrapper {
                position: relative;
                height: 250px;
                overflow: hidden;
                background: #eef2f7;
            }

            .voyage-card-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
                transition: transform 0.4s ease;
            }

            .voyage-card:hover .voyage-card-image {
                transform: scale(1.05);
            }

            .voyage-card-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(to top, rgba(16,55,73,0.35), rgba(16,55,73,0.03));
                pointer-events: none;
            }

            .voyage-card-topbar {
                position: absolute;
                top: 16px;
                left: 16px;
                right: 16px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                z-index: 2;
            }

            .voyage-card-title {
                font-size: 1.15rem;
                font-weight: 800;
                color: #1f2d3d;
                line-height: 1.3;
                margin-bottom: 8px;
            }

            .voyage-card-destination {
                display: flex;
                align-items: center;
                gap: 8px;
                color: #667085;
                font-size: 0.95rem;
                font-weight: 500;
                margin-bottom: 16px;
            }

            .voyage-card-destination i {
                color: #23779C;
            }

            .voyage-card-infos {
                display: grid;
                gap: 12px;
                margin-bottom: 20px;
            }

            .voyage-info-line {
                display: flex;
                align-items: flex-start;
                gap: 10px;
                color: #334155;
                font-size: 0.92rem;
                padding: 10px 12px;
                border-radius: 14px;
                background: #f8fafc;
            }

            .voyage-info-line i {
                color: #23779C;
                margin-top: 2px;
            }

            .voyage-price {
                background: rgba(255,255,255,0.94);
                color: #23779C;
                padding: 8px 14px;
                border-radius: 14px;
                font-weight: 800;
                font-size: 0.95rem;
                box-shadow: 0 6px 16px rgba(15, 23, 42, 0.10);
                backdrop-filter: blur(4px);
                white-space: nowrap;
            }

            .voyage-badge-disponible,
            .voyage-badge-bientot,
            .voyage-badge-complet {
                padding: 8px 12px;
                border-radius: 12px;
                font-size: 0.8rem;
                font-weight: 700;
                box-shadow: 0 6px 16px rgba(15, 23, 42, 0.10);
            }

            .voyage-badge-disponible {
                background: rgba(129, 174, 141, 0.96);
                color: #fff;
            }

            .voyage-badge-bientot {
                background: rgba(232, 177, 86, 0.96);
                color: #fff;
            }

            .voyage-badge-complet {
                background: rgba(220, 53, 69, 0.96);
                color: #fff;
            }

            .btn-voyage-edit {
                background: #E8B156;
                border: none;
                color: #fff;
                border-radius: 12px;
                font-weight: 700;
                padding: 10px 14px;
                font-size: 0.95rem;
            }

            .btn-voyage-edit:hover {
                background: #d6a041;
                color: #fff;
            }

            .btn-voyage-delete {
                background: #dc3545;
                border: none;
                color: #fff;
                border-radius: 12px;
                font-weight: 700;
                padding: 10px 14px;
                font-size: 0.95rem;
            }

            .btn-voyage-delete:hover {
                background: #bb2d3b;
                color: #fff;
            }

            .voyage-card-no-image {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #6b7280;
                font-weight: 600;
                background: #eef2f7;
            }

            .voyage-card-link {
                text-decoration: none;
                color: inherit;
                display: block;
            }

            .voyage-show-image {
                width: 100%;
                height: 430px;
                object-fit: cover;
                border-radius: 20px;
                border: 1px solid #e5e7eb;
                box-shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
                display: block;
            }

            .voyage-show-placeholder {
                width: 100%;
                height: 430px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eef2f7;
                color: #6b7280;
                border-radius: 20px;
                font-weight: 600;
                border: 1px solid #e5e7eb;
            }

            .voyage-description-card {
                background: #f8fafc;
                border: 1px solid #e9edf3;
                border-radius: 18px;
                padding: 22px;
            }

            .voyage-section-title {
                font-size: 1.1rem;
                font-weight: 800;
                color: #1f2d3d;
            }

            .voyage-description-text {
                color: #4b5563;
                line-height: 1.8;
                font-size: 0.98rem;
                white-space: pre-line;
            }

            .voyage-show-side-card {
                background: #ffffff;
                border: 1px solid #e9edf3;
                border-radius: 20px;
                padding: 24px;
                height: 100%;
                box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
            }

            .voyage-show-title {
                font-size: 2rem;
                font-weight: 800;
                color: #1f2d3d;
                line-height: 1.2;
            }

            .voyage-show-info-list {
                display: grid;
                gap: 14px;
            }

            .voyage-show-info-item {
                display: flex;
                gap: 14px;
                align-items: flex-start;
                padding: 15px 16px;
                background: #f8fafc;
                border-radius: 16px;
                border: 1px solid #eef2f7;
            }

            .voyage-show-info-item i {
                color: #23779C;
                font-size: 1.1rem;
                margin-top: 4px;
            }

            .voyage-show-info-item strong {
                color: #1f2d3d;
                font-size: 0.96rem;
            }

            .voyage-show-info-item span {
                color: #667085;
                font-size: 0.95rem;
            }

            .voyage-detail-status-badge {
                display: inline-block;
                padding: 10px 16px;
                border-radius: 999px;
                font-size: 0.9rem;
                font-weight: 800;
            }

            .voyage-detail-badge-disponible {
                background: rgba(129, 174, 141, 0.16);
                color: #5b8a67;
            }

            .voyage-detail-badge-bientot {
                background: rgba(232, 177, 86, 0.18);
                color: #b27a19;
            }

            .voyage-detail-badge-complet {
                background: rgba(220, 53, 69, 0.14);
                color: #b42318;
            }

            .voyage-places-section {
                background: #f8fafc;
                border-radius: 14px;
                padding: 14px 16px;
                border: 1px solid #eef2f7;
            }

            .voyage-places-label {
                font-size: 0.92rem;
                font-weight: 700;
                color: #334155;
            }

            .voyage-places-value {
                font-size: 0.92rem;
                font-weight: 800;
                color: #23779C;
            }

            .voyage-progress {
                width: 100%;
                height: 10px;
                background: #e9eef5;
                border-radius: 999px;
                overflow: hidden;
            }

            .voyage-progress-bar {
                height: 100%;
                border-radius: 999px;
                transition: width 0.4s ease;
            }

            .progress-good {
                background: linear-gradient(90deg, #81AE8D, #6fa57c);
            }

            .progress-medium {
                background: linear-gradient(90deg, #E8B156, #d8a145);
            }

            .progress-low {
                background: linear-gradient(90deg, #f59e0b, #ea580c);
            }

            .progress-complet {
                background: linear-gradient(90deg, #dc3545, #b91c1c);
            }

            .categorie-card-item {
                display: flex;
            }

            .categorie-flip-card {
                position: relative;
                width: 100%;
                height: 430px;
                border-radius: 18px;
                overflow: hidden;
                perspective: 1000px;
                background-color: #daceb6;
                box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
                transition: transform 0.35s ease, box-shadow 0.35s ease;
            }

            .categorie-flip-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 16px 34px rgba(15, 23, 42, 0.14);
            }

            .categorie-flip-front,
            .categorie-flip-content {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                border-radius: 18px;
            }

            .categorie-flip-front {
                display: flex;
                align-items: center;
                justify-content: center;
                background: #daceb6;
                overflow: hidden;
                transition: opacity 0.3s ease;
            }

            .categorie-flip-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .categorie-flip-icon {
                font-size: 3rem;
                color: #1f2d3d;
            }

            .categorie-flip-content {
                padding: 22px;
                box-sizing: border-box;
                background-color: #daceb6;
                color: #1f2d3d;
                transform: rotateX(-90deg);
                transform-origin: bottom;
                transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                backface-visibility: hidden;
            }

            .categorie-flip-card:hover .categorie-flip-content {
                transform: rotateX(0deg);
            }

            .categorie-flip-card:hover .categorie-flip-front {
                opacity: 0;
            }

            .categorie-flip-title {
                font-size: 1.35rem;
                font-weight: 800;
                color: #1f2d3d;
                line-height: 1.2;
                margin: 0;
            }

            .categorie-flip-description {
                margin: 14px 0 18px;
                font-size: 0.95rem;
                color: #4b5563;
                line-height: 1.6;
                overflow: hidden;
                display: -webkit-box;
                -webkit-line-clamp: 4;
                -webkit-box-orient: vertical;
            }

            .categorie-flip-badge {
