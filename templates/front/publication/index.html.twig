{% extends 'front/base_front.html.twig' %}

{% block title %}Publications - Horozia{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
<section class="ftco-section" id="voyages">
    <div class="container">
        {# Titre centré #}
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Nos publications</span>
                <h2 class="mb-4">Dernières expériences partagées</h2>
            </div>
        </div>

        {# Grille des publications #}
        <div class="row">
            {% for publication in publications %}
            <div class="col-md-4 ftco-animate" data-publication-id="{{ publication.id }}">
                <div class="card h-100 shadow-sm">
                    <img src="{{ asset(publication.image ?? 'https://placehold.co/600x400') }}" class="card-img-top" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <span class="badge bg-secondary">{{ publication.categorie }}</span>
                        <h5 class="mt-2">{{ publication.titre }}</h5>
                        <p>{{ publication.description|slice(0, 100) }}...</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small>{{ publication.auteur }} • {{ publication.dateCreation|date('d/m/Y') }}</small>
                            <div class="d-flex gap-1">
                                {# Like #}
                                {% set liked = publication.id in likedIds|default([]) %}
                                <button class="btn btn-sm like-btn {% if liked %}btn-danger{% else %}btn-outline-danger{% endif %}" data-id="{{ publication.id }}">
                                    ❤️ <span class="likes-count">{{ publication.likes }}</span>
                                </button>
                                {# Favori (étoile) #}
                                {% set isFavorite = publication.id in favoritesIds|default([]) %}
                                <button class="btn btn-sm favorite-btn {% if isFavorite %}btn-warning{% else %}btn-outline-warning{% endif %}" data-id="{{ publication.id }}">
                                    <i class="fa {% if isFavorite %}fa-star{% else %}fa-star-o{% endif %}"></i>
                                </button>
                                {# Commentaires #}
                                <a href="{{ path('front_publication_show', {'id': publication.id}) }}#comment-form" class="btn btn-sm btn-outline-secondary">
                                    💬 {{ publication.commentaires }}
                                </a>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <a href="{{ path('front_publication_show', {'id': publication.id}) }}" class="btn btn-primary btn-sm w-100 me-2">
                                Voir détails
                            </a>
                            {% if app.user and (app.user.userIdentifier == publication.auteur or is_granted('ROLE_ADMIN')) %}
                                <a href="{{ path('front_publication_edit', {'id': publication.id}) }}" class="btn btn-warning btn-sm">
                                    <i class="fa fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('front_publication_delete', {'id': publication.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_publication_' ~ publication.id) }}">
                                    <button class="btn btn-danger btn-sm" onclick="return confirm('Supprimer cette publication ?')">
                                        <i class="fa fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            {% endif %}
                        </div>

                        {# Boutons de partage #}
                        {% set url = url('front_publication_show', {'id': publication.id}) %}
                        {% set titre = publication.titre|url_encode %}
                        <div class="share-buttons d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
                            <a href="https://www.facebook.com/sharer/sharer.php?u={{ url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" title="Partager sur Facebook">
                                <i class="fa fa-facebook"></i>
                            </a>
                            <a href="https://twitter.com/intent/tweet?url={{ url }}&text={{ titre }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info" title="Partager sur Twitter">
                                <i class="fa fa-twitter"></i>
                            </a>
                            <a href="https://wa.me/?text={{ titre }}%20{{ url }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-success" title="Partager sur WhatsApp">
                                <i class="fa fa-whatsapp"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-secondary copy-link-btn" data-url="{{ url }}" title="Copier le lien">
                                <i class="fa fa-link"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
                <div class="col-12 text-center">Aucune publication trouvée.</div>
            {% endfor %}
        </div>

        {# Pagination #}
        <div class="row mt-5">
            <div class="col-12 d-flex justify-content-center">
                {{ knp_pagination_render(publications) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Gestion des likes (AJAX)
            document.querySelectorAll('.like-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const publicationId = this.dataset.id;
                    fetch(`/publication/${publicationId}/like`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        const likesSpan = this.querySelector('.likes-count');
                        likesSpan.textContent = data.likesCount;
                        if (data.liked) {
                            this.classList.remove('btn-outline-danger');
                            this.classList.add('btn-danger');
                        } else {
                            this.classList.remove('btn-danger');
                            this.classList.add('btn-outline-danger');
                        }
                    })
                    .catch(error => console.error('Erreur like:', error));
                });
            });

            // Gestion des favoris (AJAX)
            document.querySelectorAll('.favorite-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const publicationId = this.dataset.id;
                    const icon = this.querySelector('i');
                    fetch(`/favorite/${publicationId}/toggle`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.isFavorite) {
                            this.classList.remove('btn-outline-warning');
                            this.classList.add('btn-warning');
                            icon.classList.remove('fa-star-o');
                            icon.classList.add('fa-star');
                        } else {
                            this.classList.remove('btn-warning');
                            this.classList.add('btn-outline-warning');
                            icon.classList.remove('fa-star');
                            icon.classList.add('fa-star-o');
                        }
                    })
                    .catch(error => console.error('Erreur favori:', error));
                });
            });

            // Copier le lien
            document.querySelectorAll('.copy-link-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const url = this.dataset.url;
                    navigator.clipboard.writeText(url).then(() => {
                        alert('Lien copié dans le presse-papiers !');
                    }).catch(() => {
                        alert('Impossible de copier le lien.');
                    });
                });
            });
        });
    </script>
{% endblock %}