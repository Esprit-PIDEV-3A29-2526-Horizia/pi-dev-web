{% extends 'front/base_front.html.twig' %}

{% block title %}Mes publications{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
<section class="ftco-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Mes publications</h1>
            <a href="{{ path('front_publication_new') }}" class="btn btn-primary">Nouvelle publication</a>
        </div>

        {% if publications is empty %}
            <div class="alert alert-info">Aucune publication trouvée. Créez votre première publication !</div>
        {% else %}
            <div class="row">
                {% for publication in publications %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <img src="{{ asset(publication.image ?? 'https://placehold.co/600x400') }}" class="card-img-top">
                        <div class="card-body">
                            <h5>{{ publication.titre }}</h5>
                            <p>{{ publication.description|slice(0, 100) }}...</p>
                            <div class="mt-2">
                                <a href="{{ path('front_publication_show', {'id': publication.id}) }}" class="btn btn-sm btn-primary">Voir</a>
                                <a href="{{ path('front_publication_edit', {'id': publication.id}) }}" class="btn btn-sm btn-warning">Modifier</a>
                                <form method="post" action="{{ path('front_publication_delete', {'id': publication.id}) }}" style="display:inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_publication_' ~ publication.id) }}">
                                    <button class="btn btn-sm btn-danger" onclick="return confirm('Supprimer cette publication ?')">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}