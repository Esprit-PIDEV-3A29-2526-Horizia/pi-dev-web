<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Horozia{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Arizonia&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <!-- Pacific CSS -->
    <link rel="stylesheet" href="{{ asset('front/pacific/css/animate.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/owl.carousel.min.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/owl.theme.default.min.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/magnific-popup.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/bootstrap-datepicker.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/jquery.timepicker.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/flaticon.css') }}">
    <link rel="stylesheet" href="{{ asset('front/pacific/css/style.css') }}">

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_front_home') }}">
            Horozia
            <span>TRAVEL AGENCY</span>
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav" aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>
        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                {% set current_route = app.request.attributes.get('_route') %}
                <li class="nav-item {% if current_route == 'app_front_home' %}active{% endif %}">
                    <a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a>
                </li>
                <li class="nav-item {% if current_route starts with 'front_publication_' %}active{% endif %}">
                    <a href="{{ path('front_publication_index') }}" class="nav-link">Publications</a>
                </li>
                <li class="nav-item">
                    <a href="#services" class="nav-link">Services</a>
                </li>
                <li class="nav-item">
                    <a href="#contact" class="nav-link">Contact</a>
                </li>
                <li class="nav-item {% if current_route == 'front_publication_new' %}active{% endif %}">
                    <a href="{{ path('front_publication_new') }}" class="nav-link">Publier</a>
                </li>
                {# Lien "Mes publications" basé sur la session (pseudo) #}
                {% if app.session.get('mon_pseudo') %}
                    <li class="nav-item {% if current_route == 'front_my_publications' %}active{% endif %}">
                        <a href="{{ path('front_my_publications') }}" class="nav-link">Mes publications</a>
                    </li>
                {% endif %}
                {# NOUVEAU : Lien "Mes favoris" (toujours visible) #}
                <li class="nav-item {% if current_route == 'front_my_favorites' %}active{% endif %}">
                    <a href="{{ path('front_my_favorites') }}" class="nav-link">
                        <i class="fa fa-star text-warning"></i> Mes favoris
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{% block hero %}
<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/back.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Bienvenue chez Horozia</span>
                <h1 class="mb-4">Découvrez votre prochaine destination</h1>
                <p class="mb-4">
                    Horozia vous propose des voyages soigneusement sélectionnés, une réservation simple
                    et une expérience moderne pour explorer le monde avec élégance.
                </p>
                <p><a href="#voyages" class="btn btn-primary py-3 px-4">Explorer les voyages</a></p>
            </div>
        </div>
    </div>
</section>
{% endblock %}

<main>
    {% block body %}{% endblock %}
</main>

{% block services %}
<section class="ftco-section soft-section" id="services">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Pourquoi choisir Horozia</span>
                <h2 class="mb-4">Une plateforme pensée pour vos voyages</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3"><span class="fa fa-globe text-primary"></span></div>
                    <h3 class="mb-3">Destinations variées</h3>
                    <p>Découvrez des voyages soigneusement sélectionnés : détente, urbain, aventure et évasion.</p>
                </div>
            </div>
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3"><span class="fa fa-calendar-check-o text-primary"></span></div>
                    <h3 class="mb-3">Réservation simple</h3>
                    <p>Réservez votre voyage rapidement grâce à une interface claire, moderne et intuitive.</p>
                </div>
            </div>
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3"><span class="fa fa-star text-primary"></span></div>
                    <h3 class="mb-3">Expérience premium</h3>
                    <p>Horozia met l’accent sur le confort, le design et la qualité de l’expérience utilisateur.</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

<footer class="ftco-footer bg-bottom" id="contact" style="background-color: #23779C;">
    <div class="container py-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Horozia</h2>
                <p class="text-white-50">Horozia est une plateforme dédiée à la gestion des voyages et des réservations, offrant une expérience élégante et moderne aux voyageurs.</p>
            </div>
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Liens rapides</h2>
                <ul class="list-unstyled">
                    <li><a href="{{ path('app_front_home') }}" class="text-white-50">Accueil</a></li>
                    <li><a href="{{ path('front_publication_index') }}" class="text-white-50">Publications</a></li>
                    <li><a href="#services" class="text-white-50">Services</a></li>
                    <li><a href="#contact" class="text-white-50">Contact</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Contact</h2>
                <p class="text-white-50 mb-1">Tunisie</p>
                <p class="text-white-50 mb-1">contact@horozia.com</p>
                <p class="text-white-50">+216 00 000 000</p>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-12 text-center">
                <p class="text-white-50 mb-0">© {{ "now"|date("Y") }} Horozia. Tous droits réservés.</p>
            </div>
        </div>
    </div>
</footer>

<script src="{{ asset('front/pacific/js/jquery.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery-migrate-3.0.1.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/popper.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/bootstrap.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery.easing.1.3.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery.waypoints.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery.stellar.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/owl.carousel.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery.magnific-popup.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/jquery.animateNumber.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/bootstrap-datepicker.js') }}"></script>
<script src="{{ asset('front/pacific/js/scrollax.min.js') }}"></script>
<script src="{{ asset('front/pacific/js/main.js') }}"></script>

<script>
    window.addEventListener('scroll', function () {
        const navbar = document.getElementById('ftco-navbar');
        if (navbar && window.scrollY > 50) {
            navbar.classList.add('scrolled');
        } else if (navbar) {
            navbar.classList.remove('scrolled');
        }
    });
</script>

{% block javascripts %}{% endblock %}
</body>
</html>