{% extends 'front/base.html.twig' %}

{% block title %}Accueil - Horozia{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="container text-center">
        <h1 class="display-4 fw-bold">Explorez le monde avec Horozia</h1>
        <p class="lead">Découvrez des destinations uniques et vivez des expériences inoubliables</p>
        {% if not app.user %}
            <a href="{{ path('app_register') }}" class="btn btn-light btn-lg rounded-pill px-4 mt-3">
                <i class="bi bi-person-plus me-2"></i> Commencer l'aventure
            </a>
        {% else %}
            <a href="{{ path('app_profile') }}" class="btn btn-light btn-lg rounded-pill px-4 mt-3">
                <i class="bi bi-person-circle me-2"></i> Mon profil
            </a>
        {% endif %}
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="card-horozia p-4 card-hover">
                <i class="bi bi-airplane-fill fs-1" style="color: var(--color-primary);"></i>
                <h4 class="mt-3">Voyages sur mesure</h4>
                <p class="text-muted">Des circuits adaptés à vos envies et votre budget</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card-horozia p-4 card-hover">
                <i class="bi bi-shield-check fs-1" style="color: var(--color-primary);"></i>
                <h4 class="mt-3">Sécurité garantie</h4>
                <p class="text-muted">Des voyages sécurisés avec une assistance 24/7</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card-horozia p-4 card-hover">
                <i class="bi bi-star-fill fs-1" style="color: var(--color-primary);"></i>
                <h4 class="mt-3">Meilleurs prix</h4>
                <p class="text-muted">Des offres exclusives au meilleur rapport qualité-prix</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}