{% extends 'base_front.html.twig' %}

{% block title %}Accueil - Horozia{% endblock %}

{% block body %}



<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('assets/images/bg_5.jpg') }}');">
    <div class="overlay"></div>

    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Bienvenue chez Horozia</span>
                <h1 class="mb-4">Découvrez votre prochaine destination</h1>
                <p class="mb-4">
                    Horozia vous propose des voyages soigneusement sélectionnés, une réservation simple
                    et une expérience moderne pour explorer le monde avec élégance.
                </p>
                <p>
                    <a href="{{ path('app_front_voyages') }}" class="btn btn-primary py-3 px-4">Explorer les voyages</a>
                </p>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section ftco-no-pb ftco-no-pt search-bg-block">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="search-wrap-1 ftco-animate">
                    <form method="get" action="{{ path('app_front_home') }}" class="search-property-1">
                        <div class="row no-gutters align-items-stretch">

                            <div class="col-lg d-flex">
                                <div class="form-group p-4 border-0">
                                    <label for="destination">Destination</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-search"></span></div>
                                        <input
                                            type="text"
                                            id="destination"
                                            name="destination"
                                            class="form-control"
                                            placeholder="Rechercher une destination"
                                            value="{{ filters.destination|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="date_depart">Date départ</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-calendar"></span></div>
                                        <input
                                            type="date"
                                            id="date_depart"
                                            name="date_depart"
                                            class="form-control"
                                            value="{{ filters.date_depart|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="date_retour">Date retour</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-calendar"></span></div>
                                        <input
                                            type="date"
                                            id="date_retour"
                                            name="date_retour"
                                            class="form-control"
                                            value="{{ filters.date_retour|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="budget_max">Budget max</label>
                                    <div class="form-field">
                                        <div class="select-wrap">
                                            <div class="icon"><span class="fa fa-chevron-down"></span></div>
                                            <select name="budget_max" id="budget_max" class="form-control">
                                                <option value="">Choisir</option>
                                                <option value="500" {{ filters.budget_max == '500' ? 'selected' : '' }}>500 DT</option>
                                                <option value="1000" {{ filters.budget_max == '1000' ? 'selected' : '' }}>1000 DT</option>
                                                <option value="1500" {{ filters.budget_max == '1500' ? 'selected' : '' }}>1500 DT</option>
                                                <option value="2000" {{ filters.budget_max == '2000' ? 'selected' : '' }}>2000 DT</option>
                                                <option value="3000" {{ filters.budget_max == '3000' ? 'selected' : '' }}>3000 DT</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group d-flex w-100 border-0">
                                    <div class="form-field w-100 align-items-center d-flex">
                                        <button type="submit" class="align-self-stretch form-control btn btn-primary">
                                            RECHERCHER
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section" id="voyages">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Nos voyages</span>
                <h2 class="mb-4">Voyages populaires</h2>
            </div>
        </div>

        <div class="row">
            {% if voyagesPopulaires is not empty %}
                {% for voyage in voyagesPopulaires %}
                    <div class="col-md-4 ftco-animate mb-4">
                        <div class="project-wrap h-100">

                            {% set imagePath = voyage.imageUrl ?: 'front/pacific/images/destination-1.jpg' %}

                            <a href="#" class="img"
                               style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}');">
                            </a>

                            <div class="text p-4">
                                <span class="price">
                                    {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne
                                </span>

                                <span class="days">
                                    {{ voyage.dateDepart|date('d M') }} → {{ voyage.dateRetour|date('d M Y') }}
                                </span>

                                <h3>
                                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}">{{ voyage.titre }}</a>
                                </h3>

                                <p class="location">
                                    <span class="fa fa-map-marker"></span>
                                    {{ voyage.destination }}
                                </p>
                                <ul>
                                    <li>
                                        <span class="fa fa-users"></span>
                                        {{ voyage.placesRestantes }} places restantes
                                    </li>
                                    <li>
                                        <span class="fa fa-calendar"></span>
                                        Départ {{ voyage.dateDepart|date('d/m/Y') }}
                                    </li>
                                </ul>

                                <p class="mt-3">
                                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}" class="btn btn-primary py-2 px-3">
    Voir détails
</a>
                                </p>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucun voyage populaire disponible pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="ftco-section soft-section" id="services">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Pourquoi choisir Horozia</span>
                <h2 class="mb-4">Une plateforme pensée pour vos voyages</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-globe text-primary"></span>
                    </div>
                    <h3 class="mb-3">Destinations variées</h3>
                    <p>
                        Découvrez des voyages soigneusement sélectionnés : détente, urbain, aventure et évasion.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-calendar-check-o text-primary"></span>
                    </div>
                    <h3 class="mb-3">Réservation simple</h3>
                    <p>
                        Réservez votre voyage rapidement grâce à une interface claire, moderne et intuitive.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-star text-primary"></span>
                    </div>
                    <h3 class="mb-3">Expérience premium</h3>
                    <p>
                        Horozia met l’accent sur le confort, le design et la qualité de l’expérience utilisateur.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Commencez votre aventure</span>
                <h2 class="mb-4">Réservez votre prochain voyage avec Horozia</h2>
                <p>
                    Explorez nos offres et trouvez la destination qui vous ressemble.
                </p>
                <a href="#voyages" class="btn btn-primary py-3 px-4 mt-3">Voir tous les voyages</a>
            </div>
        </div>
    </div>
</section>

<footer class="ftco-footer bg-bottom" id="contact" style="background-color: #23779C;">
    <div class="container py-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Horozia</h2>
                <p class="text-white-50">
                    Horozia est une plateforme dédiée à la gestion des voyages et des réservations,
                    offrant une expérience élégante et moderne aux voyageurs.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Liens rapides</h2>
                <ul class="list-unstyled">
                    <li><a href="{{ path('app_front_home') }}" class="text-white-50">Accueil</a></li>
                    <li><a href="#voyages" class="text-white-50">Voyages</a></li>
                    <li><a href="#services" class="text-white-50">Services</a></li>
                    <li><a href="#contact" class="text-white-50">Contact</a></li>
                </ul>
            </div>

            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Contact</h2>
                <p class="text-white-50 mb-1">Tunisie</p>
                <p class="text-white-50 mb-1">contact@horozia.com</p>
                <p class="text-white-50">+216 00 000 000</p>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12 text-center">
                <p class="text-white-50 mb-0">
                    © {{ "now"|date("Y") }} Horozia. Tous droits réservés.
                </p>
            </div>
        </div>
    </div>
</footer>

{% endblock %}