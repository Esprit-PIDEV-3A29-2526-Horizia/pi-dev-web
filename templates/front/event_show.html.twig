{% extends 'base_front.html.twig' %}

{% block title %}{{ event.getTitre() }} - Pacific Travel Agency{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Force dark navbar on this page */
    #ftco-navbar {
        background: #000 !important;
        position: relative !important;
    }
</style>
{% endblock %}

{% block body %}
<section class="ftco-section" style="padding-top: 80px;">
    <div class="container">
        <div class="row">

            {# ── Left: Image ── #}
            <div class="col-md-6 ftco-animate">
                {% if event.getImage_url() %}
                    <img src="{{ event.getImage_url() }}" alt="{{ event.getTitre() }}"
                         style="width:100%; height:450px; object-fit:cover; border-radius:8px;">
                {% else %}
                    <div style="width:100%; height:450px; background:#eef2f7; border-radius:8px;
                                display:flex; align-items:center; justify-content:center; color:#aaa;">
                        <i class="fa fa-image fa-3x"></i>
                    </div>
                {% endif %}
            </div>

            {# ── Right: Details ── #}
            <div class="col-md-6 ftco-animate pl-md-5">
                <span class="subheading">{{ event.getCategorie() }}</span>
                <h2 class="mb-3">{{ event.getTitre() }}</h2>
                <p class="mb-4">{{ event.getDescription() }}</p>

                <ul class="list-unstyled mb-4">
                    <li class="mb-2">
                        <span class="fa fa-map-marker mr-2" style="color:#F96D00;"></span>
                        <strong>Lieu :</strong> {{ event.getLocation() }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-calendar mr-2" style="color:#F96D00;"></span>
                        <strong>Du :</strong> {{ event.getDate_debut()|date('d/m/Y H:i') }}
                        <strong> au </strong> {{ event.getDate_fin()|date('d/m/Y H:i') }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-ticket mr-2" style="color:#F96D00;"></span>
                        <strong>Places restantes :</strong>
                        {{ event.getPlaces_restantes() }} / {{ event.getCapacite_max() }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-money mr-2" style="color:#F96D00;"></span>
                        <strong>Prix par place :</strong>
                        <span style="color:#F96D00; font-size:1.3rem; font-weight:700;">
                            {{ event.getPrix() }} TND
                        </span>
                    </li>
                </ul>

                {% if event.getCapacite_max() > 0 %}
                    {% set pct = (((event.getCapacite_max() - event.getPlaces_restantes()) / event.getCapacite_max()) * 100)|round %}
                {% else %}
                    {% set pct = 0 %}
                {% endif %}
                <div class="mb-4">
                    <div style="background:#eee; border-radius:999px; height:8px; overflow:hidden;">
                        <div style="width:{{ pct }}%; height:100%; border-radius:999px;
                                    background:{{ pct >= 90 ? '#dc3545' : (pct >= 60 ? '#ffc107' : '#F96D00') }};"></div>
                    </div>
                    <small class="text-muted">{{ pct }}% des places réservées</small>
                </div>

                {% if event.getPlaces_restantes() > 0 %}
                    <a href="{{ path('app_participation_new', {id: event.getId_event()}) }}"
                       class="btn btn-primary py-3 px-5">
                        <span class="fa fa-ticket mr-2"></span> S'inscrire à cet événement
                    </a>
                {% else %}
                    <button class="btn btn-secondary py-3 px-5" disabled>
                        <span class="fa fa-times mr-2"></span> Complet
                    </button>
                {% endif %}

                <a href="{{ path('app_front_events') }}" class="btn btn-outline-primary py-3 px-4 ml-2">
                    <span class="fa fa-arrow-left mr-2"></span> Retour
                </a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
