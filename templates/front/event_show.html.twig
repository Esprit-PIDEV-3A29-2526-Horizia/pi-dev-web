{% extends 'base_front.html.twig' %}

{% block title %}{{ event.getTitre() }} - Pacific Travel Agency{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* Force dark navbar on this page */
    #ftco-navbar {
        background: #000 !important;
        position: relative !important;
    }
    .artist-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        margin-top: 40px;
    }
    .artist-header {
        background: linear-gradient(135deg, #23779C, #3D94CA);
        color: white;
        padding: 20px 25px;
    }
    .artist-header h3 {
        margin: 0;
        font-weight: 600;
    }
    .artist-body {
        padding: 25px;
    }
    .artist-stats {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .artist-stats span {
        font-weight: 700;
        color: #23779C;
    }
    .artist-bio {
        line-height: 1.8;
        color: #555;
    }
    .artist-tags .badge {
        background: #e9ecef;
        color: #23779C;
        padding: 5px 12px;
        margin-right: 8px;
        border-radius: 20px;
        font-weight: 500;
    }
</style>
{% endblock %}

{% block body %}
<section class="ftco-section" style="padding-top: 80px;">
    <div class="container">
        <div class="row">

            {# ── Left: Image ── #}
            <div class="col-md-6 ftco-animate">
                {% if event.getImage_url() %}
                    <img src="{{ event.getImage_url() }}" alt="{{ event.getTitre() }}"
                         style="width:100%; height:450px; object-fit:cover; border-radius:8px;">
                {% else %}
                    <div style="width:100%; height:450px; background:#eef2f7; border-radius:8px;
                                display:flex; align-items:center; justify-content:center; color:#aaa;">
                        <i class="fa fa-image fa-3x"></i>
                    </div>
                {% endif %}
            </div>

            {# ── Right: Details ── #}
            <div class="col-md-6 ftco-animate pl-md-5">
                <span class="subheading">{{ event.getCategorie() }}</span>
                <h2 class="mb-3">{{ event.getTitre() }}</h2>
                <p class="mb-4">{{ event.getDescription() }}</p>

                <ul class="list-unstyled mb-4">
                    <li class="mb-2">
                        <span class="fa fa-map-marker mr-2" style="color:#F96D00;"></span>
                        <strong>Lieu :</strong> {{ event.getLocation() }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-calendar mr-2" style="color:#F96D00;"></span>
                        <strong>Du :</strong> {{ event.getDate_debut()|date('d/m/Y H:i') }}
                        <strong> au </strong> {{ event.getDate_fin()|date('d/m/Y H:i') }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-ticket mr-2" style="color:#F96D00;"></span>
                        <strong>Places restantes :</strong>
                        {{ event.getPlaces_restantes() }} / {{ event.getCapacite_max() }}
                    </li>
                    <li class="mb-2">
                        <span class="fa fa-money mr-2" style="color:#F96D00;"></span>
                        <strong>Prix par place :</strong>
                        <span style="color:#F96D00; font-size:1.3rem; font-weight:700;">
                            {{ event.getPrix() }} TND
                        </span>
                    </li>
                </ul>

                {% if event.getCapacite_max() > 0 %}
                    {% set pct = (((event.getCapacite_max() - event.getPlaces_restantes()) / event.getCapacite_max()) * 100)|round %}
                {% else %}
                    {% set pct = 0 %}
                {% endif %}
                <div class="mb-4">
                    <div style="background:#eee; border-radius:999px; height:8px; overflow:hidden;">
                        <div style="width:{{ pct }}%; height:100%; border-radius:999px;
                                    background:{{ pct >= 90 ? '#dc3545' : (pct >= 60 ? '#ffc107' : '#F96D00') }};"></div>
                    </div>
                    <small class="text-muted">{{ pct }}% des places réservées</small>
                </div>

                {% if event.getPlaces_restantes() > 0 %}
                    <a href="{{ path('app_participation_new', {id: event.getId_event()}) }}"
                       class="btn btn-primary py-3 px-5">
                        <span class="fa fa-ticket mr-2"></span> S'inscrire à cet événement
                    </a>
                {% else %}
                    <button class="btn btn-secondary py-3 px-5" disabled>
                        <span class="fa fa-times mr-2"></span> Complet
                    </button>
                {% endif %}

                <a href="{{ path('app_front_events') }}" class="btn btn-outline-primary py-3 px-4 ml-2">
                    <span class="fa fa-arrow-left mr-2"></span> Retour
                </a>
            </div>
        </div>

        {# ── ARTIST INFO SECTION (only shows for concerts) ── #}
        {% if artistInfo is defined and artistInfo %}
        <div class="row">
            <div class="col-12">
                <div class="artist-card">
                    <div class="artist-header">
                        <h3><i class="fa fa-music mr-2"></i> About {{ artistInfo.name }}</h3>
                    </div>
                    <div class="artist-body">
                        <div class="row">
                            {% if artistInfo.image %}
                            <div class="col-md-3 text-center">
                                <img src="{{ artistInfo.image }}" alt="{{ artistInfo.name }}" class="img-fluid rounded" style="max-width:100%;">
                            </div>
                            <div class="col-md-9">
                            {% else %}
                            <div class="col-md-12">
                            {% endif %}
                                <div class="artist-stats">
                                    <i class="fa fa-headphones mr-2"></i> 
                                    <strong>Listeners:</strong> <span>{{ artistInfo.listeners|number_format }}</span> &nbsp;&nbsp;|&nbsp;&nbsp;
                                    <i class="fa fa-play-circle mr-2"></i> 
                                    <strong>Play count:</strong> <span>{{ artistInfo.playcount|number_format }}</span>
                                </div>
                                <div class="artist-bio">
                                    <strong><i class="fa fa-info-circle mr-2"></i> Biography:</strong>
                                    <p style="margin-top: 10px;">{{ artistInfo.bio|raw }}</p>
                                </div>
                                {% if artistInfo.tags %}
                                <div class="artist-tags mt-3">
                                    <strong><i class="fa fa-tags mr-2"></i> Tags:</strong>
                                    <div style="margin-top: 10px;">
                                    {% for tag in artistInfo.tags %}
                                        <span class="badge">{{ tag.name }}</span>
                                    {% endfor %}
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        {# ── END ARTIST INFO SECTION ── #}

    </div>
</section>
{% endblock %}