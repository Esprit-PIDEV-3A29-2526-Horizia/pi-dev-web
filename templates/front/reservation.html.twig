{% extends 'front/base_front.html.twig' %}

{% block title %}Réserver - {{ voyage.titre }}{% endblock %}

{% block body %}

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light scrolled" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand navbar-logo" href="{{ path('app_front_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Horozia Logo">
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>

        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}" class="nav-link">Détail voyage</a>
                </li>
                <li class="nav-item active">
                    <a href="#" class="nav-link">Réserver</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<section class="ftco-section reservation-page">
    <div class="container">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success mb-4">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger mb-4">{{ message }}</div>
        {% endfor %}

        <div class="row">
            <div class="col-lg-7 mb-4">
                <div class="reservation-box bg-white p-4 p-md-5 rounded shadow-sm h-100">
                    <h2 class="mb-4">Réserver votre voyage</h2>

                    <form method="post">
                        <div class="form-group">
                            <label for="nom">Nom</label>
                            <input id="nom" type="text" name="nom" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="prenom">Prénom</label>
                            <input id="prenom" type="text" name="prenom" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="email">Email</label>
                            <input id="email" type="email" name="email" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="nb_personnes">Nombre de personnes</label>
                            <input id="nb_personnes" type="number" name="nb_personnes" class="form-control" min="1" max="{{ voyage.placesRestantes }}" value="1" required>
                        </div>

                        <div class="mt-4 d-flex flex-wrap align-items-center">
                            <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}" class="btn btn-outline-secondary mr-2 mb-2">
                                Retour
                            </a>
                            <button type="submit" class="btn btn-primary mb-2">
                                Confirmer la réservation
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-5 mb-4">
                <div class="reservation-summary bg-white p-4 rounded shadow-sm h-100">
                    <h3 class="mb-4">{{ voyage.titre }}</h3>

                    <p><strong>Destination :</strong> {{ voyage.destination }}</p>
                    <p><strong>Prix :</strong> {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne</p>
                    <p><strong>Date départ :</strong> {{ voyage.dateDepart|date('d/m/Y') }}</p>
                    <p><strong>Date retour :</strong> {{ voyage.dateRetour|date('d/m/Y') }}</p>
                    <p><strong>Places restantes :</strong> {{ voyage.placesRestantes }}</p>

                    <hr>

                    <p class="mb-0">
                        {{ voyage.description|length > 220 ? voyage.description|slice(0, 220) ~ '...' : voyage.description }}
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}