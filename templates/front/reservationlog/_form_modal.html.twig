<div class="row g-3">
    <div class="col-md-5">
        <img src="{{ logement.image ? logement.image : asset('front/pacific/images/destination-1.jpg') }}" class="img-fluid rounded w-100" alt="{{ logement.nom }}" style="height: 180px; object-fit: cover;">
    </div>
    <div class="col-md-7">
        <h4 class="fw-bold mb-2">{{ logement.nom }}</h4>
        <p class="mb-1 text-muted"><i class="fa fa-map-marker me-1"></i> {{ logement.adresse }}</p>
        <p class="mb-1 text-muted"><i class="fa fa-users me-1"></i> Capacité : {{ logement.capacite }} personnes</p>
        <p class="mb-1 text-muted"><i class="fa fa-tag me-1"></i> Type : {{ logement.type }}</p>
        <p class="mb-0"><i class="fa fa-money me-1"></i> Prix / nuit : <strong>{{ logement.tarifNuit|number_format(0, ',', ' ') }} DT</strong></p>
    </div>
</div>

<input type="hidden" id="prix_par_nuit_data" value="{{ logement.tarifNuit }}">

<form id="reservationFormModal" class="mt-4" novalidate>
    <input type="hidden" name="logement_id" value="{{ logement.id }}">
    <div id="formErrors" class="alert alert-danger d-none mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label for="date_arrivee_modal" class="form-label fw-semibold small">Date d'arrivée</label>
            <input type="date" id="date_arrivee_modal" name="date_arrivee" class="form-control">
            <div class="invalid-feedback">Veuillez choisir une date valide (aujourd'hui ou dans le futur).</div>
        </div>
        <div class="col-md-6">
            <label for="date_depart_modal" class="form-label fw-semibold small">Date de départ</label>
            <input type="date" id="date_depart_modal" name="date_depart" class="form-control">
            <div class="invalid-feedback">La date de départ doit être postérieure à la date d'arrivée.</div>
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label fw-semibold small mb-2">Modalité de paiement</label>
        <div class="d-flex justify-content-start gap-4">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="modalite" id="enLigne_modal" value="En ligne" checked>
                <label class="form-check-label" for="enLigne_modal">En ligne</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="modalite" id="surPlace_modal" value="Sur place">
                <label class="form-check-label" for="surPlace_modal">Sur place</label>
            </div>
        </div>
        <div id="modaliteError" class="invalid-feedback" style="display: none;">Veuillez choisir une modalité de paiement.</div>
    </div>

    <div class="mt-3">
        <label class="form-label fw-semibold small mb-2">Détails des occupants</label>
        <div class="row g-2">
            <div class="col-md-4">
                <label for="adultes" class="form-label small">Adultes</label>
                <input type="number" id="adultes" name="adultes" class="form-control" value="1">
            </div>
            <div class="col-md-4">
                <label for="enfants" class="form-label small">Enfants</label>
                <input type="number" id="enfants" name="enfants" class="form-control" value="0">
            </div>
            <div class="col-md-4">
                <label for="nombre_chambres" class="form-label small">Nombre de chambres</label>
                <input type="number" id="nombre_chambres" name="nombre_chambres" class="form-control" value="1">
            </div>
        </div>
        <div class="col-md-12 mt-2" id="repartitionContainer" style="display: none;">
            <label for="repartition_chambres" class="form-label small">Répartition des chambres</label>
            <select id="repartition_chambres" name="repartition_chambres" class="form-select">
                <option value="">Choisir une répartition</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <label for="mode_reservation" class="form-label fw-semibold small">Formule de pension</label>
        <select id="mode_reservation" name="mode_reservation" class="form-select">
            <option value="" disabled selected>Choisir une formule</option>
            <option value="all_inclusive">All Inclusive</option>
            <option value="soft">All Inclusive Soft (sans alcool)</option>
            <option value="demi_pension">Demi‑pension</option>
            <option value="petit_dejeuner">Logement Petit déjeuner</option>
        </select>
        <div id="pensionError" class="invalid-feedback" style="display: none;">Veuillez choisir une formule de pension.</div>
    </div>

    <div class="card bg-light border-0 mt-4 p-3 rounded-4">
        <h6 class="fw-bold mb-3">Détails du paiement</h6>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Nombre de nuits :</span>
            <span><span id="nuits_modal">0</span> nuit(s)</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted" id="pensionLabel">Prix par personne / nuit :</span>
            <span><span id="prix_pension_nuit">0</span> DT</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Nombre de personnes :</span>
            <span><span id="personnes_modal">0</span></span>
        </div>
        <div class="d-flex justify-content-between fw-bold">
            <span>Total :</span>
            <span id="total_modal">0 DT</span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-4 py-2 rounded-pill fw-semibold">Confirmer la réservation</button>
</form>