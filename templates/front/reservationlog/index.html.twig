{% extends 'front/base_front.html.twig' %}

{% block title %}Mes Réservations - Horozia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ========== STYLE CARTE (identique aux logements) ========== */
        .reservation-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 2px solid #23779C;
            position: relative;
        }
        .reservation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }
        .reservation-card-content {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .card-header h5 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1f2d3d;
            margin: 0;
        }
        .badge-status {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-status.confirmed { background: #81AE8D; color: white; }
        .badge-status.pending { background: #E8B156; color: #333; }
        .badge-status.cancelled { background: #dc3545; color: white; }

        .card-details {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }
        .detail-item {
            flex: 1;
            min-width: 100px;
        }
        .detail-item small {
            font-size: 0.7rem;
            color: #6c757d;
            display: block;
        }
        .detail-item p {
            margin: 0;
            font-weight: 600;
            font-size: 0.9rem;
            color: #1f2d3d;
        }
        .card-actions {
            display: flex;
            gap: 12px;
            margin-top: auto;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }
        .reservation-card:hover .card-actions {
            opacity: 1;
        }
        .btn-action {
            flex: 1;
            background: #f0f0f0;
            border: none;
            border-radius: 40px;
            padding: 8px 0;
            font-size: 0.8rem;
            font-weight: 600;
            color: #23779C;
            text-align: center;
            text-decoration: none;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-action:hover {
            background: #23779C;
            color: white;
        }
        .btn-delete {
            background: #ffe6e6;
            color: #dc3545;
        }
        .btn-delete:hover {
            background: #dc3545;
            color: white;
        }
        .btn-qr {
            background: #E8B156;
            color: white;
        }
        .btn-qr:hover {
            background: #d6a041;
        }

        /* Style des champs (Uiverse) */
        .custom-input, .custom-select {
            border: none;
            outline: none;
            border-radius: 15px;
            padding: 1em;
            background-color: #ccc;
            box-shadow: inset 2px 5px 10px rgba(0,0,0,0.3);
            transition: 300ms ease-in-out;
            width: 100%;
            font-size: 1rem;
        }
        .custom-input:focus, .custom-select:focus {
            background-color: white;
            transform: scale(1.05);
            box-shadow: 13px 13px 100px #969696, -13px -13px 100px #ffffff;
        }
        .search-wrapper {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .search-wrapper .search-field {
            flex: 2;
            min-width: 200px;
        }
        .search-wrapper .status-field {
            flex: 1;
            min-width: 180px;
        }
        .custom-select option[value=""] {
            color: #888;
        }
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }
        .loading-spinner.active {
            display: block;
        }
        @media (max-width: 768px) {
            .card-details { flex-direction: column; gap: 8px; }
            .card-actions { flex-wrap: wrap; }
            .btn-action { flex: auto; }
            .search-wrapper { flex-direction: column; gap: 15px; }
        }
    </style>
{% endblock %}

{% block body %}
<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_front_home') }}">Horozia<span>TRAVEL AGENCY</span></a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>
        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#voyages" class="nav-link">Voyages</a></li>
                <li class="nav-item"><a href="{{ path('app_front_logement_index') }}" class="nav-link">Logement</a></li>
                <li class="nav-item dropdown active">
                    <a class="nav-link dropdown-toggle" href="#" id="reservationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Mes réservations
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="reservationsDropdown">
                        <li><a class="dropdown-item" href="{{ path('app_front_reservation_index') }}">Voir mes réservations</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#services" class="nav-link">Services</a></li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#contact" class="nav-link">Contact</a></li>
            </ul>
        </div>
    </div>
</nav>

<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/back.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Vos séjours</span>
                <h1 class="mb-4">Mes réservations</h1>
                <p class="mb-4">
                    Retrouvez ici toutes vos réservations, leur statut et les détails de vos séjours.
                </p>

                <div class="search-wrapper">
                    <div class="search-field">
                        <input type="text" id="searchInput" class="custom-input" placeholder="Rechercher par nom de logement...">
                    </div>
                    <div class="status-field">
                        <select id="statusSelect" class="custom-select">
                            <option value="" selected>Tous les statuts</option>
                            <option value="confirmée">Confirmée</option>
                            <option value="en_attente">En attente</option>
                            <option value="terminée">Terminée</option>
                            <option value="annulée">Annulée</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container mt-4 mb-5">
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
    <div id="reservationsContainer" class="row g-4">
        <!-- Les cartes seront chargées ici par AJAX -->
    </div>
</div>

<!-- Modale QR Code -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">QR Code de réservation</h5>
                <button type="button" id="closeQrModalBtn" class="btn-close btn-close-white" aria-label="Fermer"></button>
            </div>
            <div class="modal-body text-center" id="qrModalBody">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        const searchInput = document.getElementById('searchInput');
        const statusSelect = document.getElementById('statusSelect');
        const container = document.getElementById('reservationsContainer');
        const spinner = document.getElementById('loadingSpinner');
function fetchReservations() {
    const search = searchInput.value;
    const status = statusSelect.value;
    const url = `{{ path('app_front_reservation_ajax') }}?search=${encodeURIComponent(search)}&status=${encodeURIComponent(status)}`;
    
    spinner.classList.add('active');
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(response => response.json())
        .then(data => {
            if (data.html) container.innerHTML = data.html;
            spinner.classList.remove('active');
            attachDeleteEvents();
            attachQrEvents();
            attachEditEvents(); // <-- AJOUT OBLIGATOIRE
        })
        .catch(error => {
            console.error('Erreur:', error);
            spinner.classList.remove('active');
        });
}
        function deleteReservation(id, element) {
            Swal.fire({
                title: 'Confirmation',
                text: 'Voulez-vous vraiment supprimer cette réservation ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Oui, supprimer',
                cancelButtonText: 'Annuler',
                background: '#ffffff',
                borderRadius: '18px'
            }).then((result) => {
                if (result.isConfirmed) {
                    const url = `{{ path('app_front_reservation_delete', {'id': 0}) }}`.replace('0', id);
                    fetch(url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            const card = element.closest('.col-md-6');
                            if (card) card.remove();
                            if (container.children.length === 0) {
                                container.innerHTML = '<div class="col-12"><div class="text-center py-5 bg-light rounded-4"><i class="bi bi-calendar-x display-1 text-muted mb-4 d-block"></i><h3 class="text-muted mb-3">Aucune réservation</h3><p class="text-muted mb-4">Commencez par réserver un logement.</p><a href="{{ path('app_front_logement_index') }}" class="btn btn-horozia-primary btn-lg px-5 rounded-pill"><i class="bi bi-house-door me-2"></i> Découvrir les logements</a></div></div>';
                            }
                            Swal.fire({
                                title: 'Supprimée !',
                                text: 'La réservation a été supprimée.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false,
                                background: '#ffffff',
                                borderRadius: '18px'
                            });
                        } else {
                            Swal.fire({
                                title: 'Erreur',
                                text: data.error || 'Impossible de supprimer la réservation.',
                                icon: 'error',
                                confirmButtonColor: '#23779C'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        Swal.fire({
                            title: 'Erreur',
                            text: 'Une erreur est survenue.',
                            icon: 'error',
                            confirmButtonColor: '#23779C'
                        });
                    });
                }
            });
        }
        function attachEditEvents() {
    document.querySelectorAll('.btn-edit').forEach(btn => {
        btn.removeEventListener('click', window.editHandler);
        const handler = function(e) {
            e.preventDefault();
            const id = this.getAttribute('data-id');
            const modal = new bootstrap.Modal(document.getElementById('qrModal'));
            const modalBody = document.getElementById('qrModalBody');
            
            modalBody.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Chargement...</span></div>';
            modal.show();
            
            fetch(`/reservation/edit-modal/${id}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.text())
            .then(html => {
                modalBody.innerHTML = html;
                document.querySelector('#qrModal .modal-title').innerText = 'Modifier la réservation';
                
                const editForm = document.getElementById('editReservationForm');
                if (editForm) {
                    editForm.addEventListener('submit', function(e) {
                        e.preventDefault();
                        const formData = new FormData(editForm);
                        fetch(editForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                modal.hide();
                                fetchReservations();
                                Swal.fire({
                                    title: 'Succès',
                                    text: data.message,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                });
                            } else {
                                document.getElementById('formErrors').innerHTML = '<div class="alert alert-danger">' + (data.error || 'Erreur') + '</div>';
                                document.getElementById('formErrors').classList.remove('d-none');
                            }
                        });
                    });
                }
            })
            .catch(error => {
                modalBody.innerHTML = '<div class="alert alert-danger">Erreur lors du chargement du formulaire.</div>';
            });
        };
        btn.addEventListener('click', handler);
        btn.editHandler = handler;
    });
}
        function attachDeleteEvents() {
            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.removeEventListener('click', window.deleteHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.getAttribute('data-id');
                    if (id) deleteReservation(id, this);
                };
                btn.addEventListener('click', handler);
                btn.deleteHandler = handler;
            });
        }

        function attachQrEvents() {
            document.querySelectorAll('.btn-qr').forEach(btn => {
                btn.removeEventListener('click', window.qrHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.getAttribute('data-id');
                    const modal = new bootstrap.Modal(document.getElementById('qrModal'));
                    const modalBody = document.getElementById('qrModalBody');
                    
                    modalBody.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Chargement...</span></div>';
                    modal.show();
                    
                    fetch(`/reservation/qrcode/${id}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => response.text())
                    .then(html => {
                        modalBody.innerHTML = html;
                    })
                    .catch(error => {
                        modalBody.innerHTML = '<div class="alert alert-danger">Erreur lors du chargement du QR code.</div>';
                    });
                };
                btn.addEventListener('click', handler);
                btn.qrHandler = handler;
            });
        }

        // Fermeture manuelle de la modale QR
        document.getElementById('closeQrModalBtn').addEventListener('click', function() {
            const modalElement = document.getElementById('qrModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();
        });

        let debounceTimer;
        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(fetchReservations, 300);
        });
        statusSelect.addEventListener('change', fetchReservations);
        
        fetchReservations();
    </script>
{% endblock %}