{% extends 'front/base_front.html.twig' %}

{% block title %}Mes Réservations - Horozia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ========== STYLE CARTE ========== */
        .reservation-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 2px solid #23779C;
            position: relative;
        }
        .reservation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }
        .reservation-card-content {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .card-header h5 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1f2d3d;
            margin: 0;
        }
        .badge-status {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-status.confirmed { background: #81AE8D; color: white; }
        .badge-status.pending { background: #E8B156; color: #333; }
        .badge-status.cancelled { background: #dc3545; color: white; }

        .card-details {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }
        .detail-item {
            flex: 1;
            min-width: 100px;
        }
        .detail-item small {
            font-size: 0.7rem;
            color: #6c757d;
            display: block;
        }
        .detail-item p {
            margin: 0;
            font-weight: 600;
            font-size: 0.9rem;
            color: #1f2d3d;
        }
        .card-actions {
            display: flex;
            gap: 12px;
            margin-top: auto;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }
        .reservation-card:hover .card-actions {
            opacity: 1;
        }
        .btn-action {
            flex: 1;
            background: #f0f0f0;
            border: none;
            border-radius: 40px;
            padding: 8px 0;
            font-size: 0.8rem;
            font-weight: 600;
            color: #23779C;
            text-align: center;
            text-decoration: none;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-action:hover {
            background: #23779C;
            color: white;
        }
        .btn-delete {
            background: #ffe6e6;
            color: #dc3545;
        }
        .btn-delete:hover {
            background: #dc3545;
            color: white;
        }
        .btn-qr {
            background: #E8B156;
            color: white;
        }
        .btn-qr:hover {
            background: #d6a041;
        }

        /* Style des champs */
        .custom-input, .custom-select {
            border: none;
            outline: none;
            border-radius: 15px;
            padding: 1em;
            background-color: #ccc;
            box-shadow: inset 2px 5px 10px rgba(0,0,0,0.3);
            transition: 300ms ease-in-out;
            width: 100%;
            font-size: 1rem;
        }
        .custom-input:focus, .custom-select:focus {
            background-color: white;
            transform: scale(1.05);
            box-shadow: 13px 13px 100px #969696, -13px -13px 100px #ffffff;
        }
        .search-wrapper {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .search-wrapper .search-field {
            flex: 2;
            min-width: 200px;
        }
        .search-wrapper .status-field {
            flex: 1;
            min-width: 180px;
        }
        .custom-select option[value=""] {
            color: #888;
        }
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }
        .loading-spinner.active {
            display: block;
        }
        @media (max-width: 768px) {
            .card-details { flex-direction: column; gap: 8px; }
            .card-actions { flex-wrap: wrap; }
            .btn-action { flex: auto; }
            .search-wrapper { flex-direction: column; gap: 15px; }
        }
    </style>
{% endblock %}

{% block body %}
