{% extends 'base_front.html.twig' %}

{% block title %}Mes Réservations - Horozia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .reservation-card {
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            border: 2px solid #23779C;
            position: relative;
        }
        .reservation-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12);
        }
        .reservation-card-content {
            padding: 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .card-header h5 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1f2d3d;
            margin: 0;
        }
        
        .badge-status {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .badge-status.confirmed { background: #3D94CA; color: white; }
        .badge-status.pending { background: #E8B156; color: #333; }
        .badge-status.cancelled { background: #DACEB6; color: #333; }
        .badge-status.completed { background: #81AE8D; color: white; }
        .badge-status.expired { background: #6c757d; color: white; }
        .badge-status.request_cancellation { background: #E8B156; color: #333; }

        .card-details {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }
        .detail-item {
            flex: 1;
            min-width: 100px;
        }
        .detail-item small {
            font-size: 0.7rem;
            color: #6c757d;
            display: block;
        }
        .detail-item p {
            margin: 0;
            font-weight: 600;
            font-size: 0.9rem;
            color: #1f2d3d;
        }
        
        .card-actions {
            display: flex;
            gap: 12px;
            margin-top: auto;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }
        .reservation-card:hover .card-actions {
            opacity: 1;
        }
        .btn-action {
            flex: 1;
            background: #f0f0f0;
            border: none;
            border-radius: 40px;
            padding: 8px 0;
            font-size: 0.8rem;
            font-weight: 600;
            color: #23779C;
            text-align: center;
            text-decoration: none;
            transition: 0.2s;
            cursor: pointer;
        }
        .btn-action:hover {
            background: #23779C;
            color: white;
        }
        .btn-edit {
            background: #f0f0f0;
            color: #23779C;
        }
        .btn-edit:hover {
            background: #23779C;
            color: white;
        }
        .btn-delete {
            background: #ffe6e6;
            color: #dc3545;
        }
        .btn-delete:hover {
            background: #dc3545;
            color: white;
        }
        .btn-request-cancel {
            background: #E8B156;
            color: #333;
        }
        .btn-request-cancel:hover {
            background: #d6a041;
            color: white;
        }
        .btn-permanent-delete {
            background: #daceb6ad;
            color: #333;
        }
        .btn-permanent-delete:hover {
            background: #DACEB6;
            color: #333;
        }
        .btn-qr {
            background: #81ae8d85;
            color: white;
        }
        .btn-qr:hover {
            background: #81AE8D;
            color: white;
        }
        .btn-pay {
            background: #23779C;
            color: white;
        }
        .btn-pay:hover {
            background: #1a5c7a;
            color: white;
        }

        .custom-input, .custom-select {
            border: none;
            outline: none;
            border-radius: 15px;
            padding: 1em;
            background-color: #ccc;
            box-shadow: inset 2px 5px 10px rgba(0,0,0,0.3);
            transition: 300ms ease-in-out;
            width: 100%;
            font-size: 1rem;
        }
        .custom-input:focus, .custom-select:focus {
            background-color: white;
            transform: scale(1.05);
            box-shadow: 13px 13px 100px #969696, -13px -13px 100px #ffffff;
        }
        .search-wrapper {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .search-wrapper .search-field {
            flex: 2;
            min-width: 200px;
        }
        .search-wrapper .status-field {
            flex: 1;
            min-width: 180px;
        }
        .custom-select option[value=""] {
            color: #888;
        }
        .loading-spinner {
            display: none;
            text-align: center;
            padding: 20px;
        }
        .loading-spinner.active {
            display: block;
        }

        .pagination-wrapper {
            margin-top: 40px;
            display: flex;
            justify-content: center;
        }
        .pagination {
            display: flex;
            gap: 8px;
            list-style: none;
            padding: 0;
            flex-wrap: wrap;
        }
        .page-item {
            display: inline-block;
        }
        .page-link {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #f0f0f0;
            color: #23779C;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.2s;
            border: 1px solid #ddd;
            cursor: pointer;
        }
        .page-link:hover {
            background-color: #23779C;
            color: white;
            border-color: #23779C;
        }
        .page-item.active .page-link {
            background-color: #23779C;
            color: white;
            border-color: #23779C;
        }
        .page-item.disabled .page-link {
            background-color: #e9ecef;
            color: #6c757d;
            cursor: not-allowed;
            pointer-events: none;
        }
        .page-link-prev, .page-link-next {
            width: auto;
            padding: 0 16px;
            border-radius: 40px;
        }
        @media (max-width: 768px) {
            .card-details { flex-direction: column; gap: 8px; }
            .card-actions { flex-wrap: wrap; }
            .btn-action { flex: auto; }
            .search-wrapper { flex-direction: column; gap: 15px; }
            .page-link {
                width: 35px;
                height: 35px;
                font-size: 0.8rem;
            }
            .page-link-prev, .page-link-next {
                width: auto;
                padding: 0 12px;
            }
        }
        /* Animation pour la carte surlignée */
        @keyframes highlightAnimation {
            0% {
                background-color: #fff3cd;
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(232, 177, 86, 0.7);
            }
            50% {
                background-color: #ffeeba;
                transform: scale(1.02);
                box-shadow: 0 0 0 10px rgba(232, 177, 86, 0);
            }
            100% {
                background-color: transparent;
                transform: scale(1);
                box-shadow: 0 0 0 0 rgba(232, 177, 86, 0);
            }
        }

        .highlight-card {
            animation: highlightAnimation 0.8s ease-in-out 3 !important;
            border: 2px solid #E8B156 !important;
            border-radius: 20px;
        }
    </style>
{% endblock %}

{% block body %}
<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/back.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Vos séjours</span>
                <h1 class="mb-4">Mes réservations</h1>
                <p class="mb-4">Retrouvez ici toutes vos réservations, leur statut et les détails de vos séjours.</p>

                <div class="search-wrapper">
                    <div class="search-field">
                        <input type="text" id="searchInput" class="custom-input" placeholder="Rechercher par nom de logement...">
                    </div>
                    <div class="status-field">
                        <select id="statusSelect" class="custom-select">
                            <option value="" selected>Tous les statuts</option>
                            <option value="confirmée">Confirmée</option>
                            <option value="en_attente">En attente</option>
                            <option value="terminée">Terminée</option>
                            <option value="expirée">Expirée</option>
                            <option value="annulée">Annulée</option>
                            <option value="demande_annulation">Demande annulation</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container mt-4 mb-5">
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden"></span>
        </div>
    </div>
    <div id="reservationsContainer" class="row g-4"></div>
    <div id="paginationContainer" class="pagination-wrapper"></div>
</div>

<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">QR Code de réservation</h5>
                <button type="button" id="closeQrModalBtn" class="btn-close btn-close-white" aria-label="Fermer"></button>
            </div>
            <div class="modal-body text-center" id="qrModalBody">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden"></span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const loginUrl = '{{ path('app_login') }}';
        const searchInput = document.getElementById('searchInput');
        const statusSelect = document.getElementById('statusSelect');
        const container = document.getElementById('reservationsContainer');
        const paginationContainer = document.getElementById('paginationContainer');
        const spinner = document.getElementById('loadingSpinner');
        let debounceTimer;
        let currentPage = 1;
        const limit = 6;

        function redirectToLogin() {
            window.location.href = loginUrl;
        }

        function fetchReservations(page = 1) {
            currentPage = page;
            const search = searchInput.value;
            const status = statusSelect.value;
            const url = `{{ path('app_front_reservation_ajax') }}?search=${encodeURIComponent(search)}&status=${encodeURIComponent(status)}&page=${page}&limit=${limit}`;

            spinner.classList.add('active');
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(response => {
                    if (response.status === 401) {
                        redirectToLogin();
                        throw new Error('Non authentifié');
                    }
                    if (!response.ok) {
                        throw new Error(`Erreur HTTP ${response.status}`);
                    }
                    const contentType = response.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) {
                        throw new Error('La réponse n\'est pas au format JSON');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.html) container.innerHTML = data.html;
                    spinner.classList.remove('active');
                    
                    if (data.totalPages > 1) {
                        renderPagination(data.currentPage, data.totalPages);
                    } else {
                        paginationContainer.innerHTML = '';
                    }
                    
                    attachDeleteEvents();
                    attachQrEvents();
                    attachEditEvents();
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    spinner.classList.remove('active');
                    container.innerHTML = '<div class="col-12 text-center text-danger">Une erreur technique est survenue. Veuillez rafraîchir la page ou contacter l\'administrateur.</div>';
                    paginationContainer.innerHTML = '';
                });
        }

        function renderPagination(currentPage, totalPages) {
            let html = '<ul class="pagination">';
            if (currentPage > 1) {
                html += `<li class="page-item"><button class="page-link page-link-prev" data-page="${currentPage - 1}">« Précédent</button></li>`;
            } else {
                html += `<li class="page-item disabled"><span class="page-link page-link-prev">« Précédent</span></li>`;
            }
            let startPage = Math.max(1, currentPage - 2);
            let endPage = Math.min(totalPages, currentPage + 2);
            if (startPage > 1) {
                html += `<li class="page-item"><button class="page-link" data-page="1">1</button></li>`;
                if (startPage > 2) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            for (let i = startPage; i <= endPage; i++) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}"><button class="page-link" data-page="${i}">${i}</button></li>`;
            }
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                html += `<li class="page-item"><button class="page-link" data-page="${totalPages}">${totalPages}</button></li>`;
            }
            if (currentPage < totalPages) {
                html += `<li class="page-item"><button class="page-link page-link-next" data-page="${currentPage + 1}">Suivant »</button></li>`;
            } else {
                html += `<li class="page-item disabled"><span class="page-link page-link-next">Suivant »</span></li>`;
            }
            html += '</ul>';
            paginationContainer.innerHTML = html;
            
            document.querySelectorAll('[data-page]').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const page = parseInt(btn.dataset.page);
                    if (!isNaN(page) && page !== currentPage) {
                        fetchReservations(page);
                    }
                });
            });
        }

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => fetchReservations(1), 300);
        });
        statusSelect.addEventListener('change', () => fetchReservations(1));

        function deleteReservation(id, element) {
            Swal.fire({
                title: 'Confirmation',
                text: 'Voulez-vous vraiment supprimer cette réservation ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Oui, supprimer',
                cancelButtonText: 'Annuler'
            }).then((result) => {
                if (result.isConfirmed) {
                    const url = `{{ path('app_front_reservation_delete', {'id': 0}) }}`.replace('0', id);
                    fetch(url, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' }
                    })
                    .then(response => {
                        if (response.status === 401) redirectToLogin();
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            const card = element.closest('.col-md-6');
                            if (card) card.remove();
                            if (container.children.length === 0) {
                                container.innerHTML = '<div class="col-12"><div class="text-center py-5 bg-light rounded-4"><i class="bi bi-calendar-x display-1 text-muted mb-4 d-block"></i><h3 class="text-muted mb-3">Aucune réservation</h3><p class="text-muted mb-4">Commencez par réserver un logement.</p><a href="{{ path('app_front_logement_index') }}" class="btn btn-horozia-primary btn-lg px-5 rounded-pill" style="background:#23779C; color:white;"><i class="bi bi-house-door me-2"></i> Découvrir les logements</a></div></div>';
                            }
                            Swal.fire({
                                title: 'Supprimée !',
                                text: 'La réservation a été supprimée.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        } else {
                            Swal.fire('Erreur', data.error, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        Swal.fire('Erreur', 'Une erreur est survenue.', 'error');
                    });
                }
            });
        }

        function permanentDeleteReservation(id, element) {
            Swal.fire({
                title: 'Confirmation',
                text: 'Voulez-vous vraiment supprimer définitivement cette réservation annulée ? Cette action est irréversible.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Oui, supprimer définitivement',
                cancelButtonText: 'Annuler'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/reservation/permanent-delete/${id}`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json' }
                    })
                    .then(response => {
                        if (response.status === 401) redirectToLogin();
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            const card = element.closest('.col-md-6');
                            if (card) card.remove();
                            Swal.fire({
                                title: 'Supprimée !',
                                text: 'La réservation a été supprimée définitivement.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            Swal.fire('Erreur', data.error, 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        Swal.fire('Erreur', 'Une erreur est survenue.', 'error');
                    });
                }
            });
        }

        function requestCancelReservation(id) {
            Swal.fire({
                title: 'Demande d\'annulation',
                text: 'Voulez-vous demander l\'annulation de cette réservation à l\'administrateur ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Oui, demander',
                cancelButtonText: 'Non'
            }).then(result => {
                if (result.isConfirmed) {
                    fetch(`/reservation/request-cancel/${id}`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => {
                        if (response.status === 401) redirectToLogin();
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Demande envoyée', data.message, 'success');
                            fetchReservations(currentPage);
                        } else {
                            Swal.fire('Erreur', data.error, 'error');
                        }
                    });
                }
            });
        }

        function attachDeleteEvents() {
            document.querySelectorAll('.btn-delete').forEach(btn => {
                btn.removeEventListener('click', window.deleteHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.dataset.id;
                    const createdAt = parseInt(this.dataset.createdAt);
                    const now = Math.floor(Date.now() / 1000);
                    const ageHours = (now - createdAt) / 3600;

                    if (ageHours < 1) {
                        deleteReservation(id, this);
                    } else {
                        requestCancelReservation(id);
                    }
                };
                btn.addEventListener('click', handler);
                btn.deleteHandler = handler;
            });

            document.querySelectorAll('.btn-request-cancel').forEach(btn => {
                btn.removeEventListener('click', window.requestCancelHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.dataset.id;
                    requestCancelReservation(id);
                };
                btn.addEventListener('click', handler);
                btn.requestCancelHandler = handler;
            });

            document.querySelectorAll('.btn-permanent-delete').forEach(btn => {
                btn.removeEventListener('click', window.permanentDeleteHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.dataset.id;
                    permanentDeleteReservation(id, this);
                };
                btn.addEventListener('click', handler);
                btn.permanentDeleteHandler = handler;
            });
        }

        function attachEditEvents() {
            document.querySelectorAll('.btn-edit').forEach(btn => {
                btn.removeEventListener('click', window.editHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.getAttribute('data-id');
                    const modal = new bootstrap.Modal(document.getElementById('qrModal'));
                    const modalBody = document.getElementById('qrModalBody');
                    modalBody.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden"></span></div>';
                    modal.show();
                    fetch(`/reservation/edit-modal/${id}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => {
                        if (response.status === 401) redirectToLogin();
                        return response.text();
                    })
                    .then(html => {
                        modalBody.innerHTML = html;
                        document.querySelector('#qrModal .modal-title').innerText = 'Modifier la réservation';
                    })
                    .catch(() => {
                        modalBody.innerHTML = '<div class="alert alert-danger">Erreur lors du chargement du formulaire.</div>';
                    });
                };
                btn.addEventListener('click', handler);
                btn.editHandler = handler;
            });
        }

        function attachQrEvents() {
            document.querySelectorAll('.btn-qr').forEach(btn => {
                btn.removeEventListener('click', window.qrHandler);
                const handler = function(e) {
                    e.preventDefault();
                    const id = this.getAttribute('data-id');
                    const modal = new bootstrap.Modal(document.getElementById('qrModal'));
                    const modalBody = document.getElementById('qrModalBody');
                    modalBody.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden"></span></div>';
                    modal.show();
                    fetch(`/reservation/qrcode/${id}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(response => {
                        if (response.status === 401) redirectToLogin();
                        return response.text();
                    })
                    .then(html => { modalBody.innerHTML = html; })
                    .catch(() => { modalBody.innerHTML = '<div class="alert alert-danger">Erreur QR code</div>'; });
                };
                btn.addEventListener('click', handler);
                btn.qrHandler = handler;
            });
        }

        document.getElementById('closeQrModalBtn').addEventListener('click', function() {
            const modalElement = document.getElementById('qrModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) modal.hide();
        });

        // ========== POLLING DES NOTIFICATIONS POUR L'UTILISATEUR ==========
        let notificationPollingInterval = null;

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        function loadUserNotifications() {
            fetch('/user/notifications', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                const badge = document.getElementById('notificationBadge');
                const count = data.notifications ? data.notifications.length : 0;
                
                if (count > 0) {
                    badge.innerText = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
                
                const listContainer = document.getElementById('notificationsList');
                if (listContainer) {
                    if (!data.notifications || data.notifications.length === 0) {
                        listContainer.innerHTML = '<div class="dropdown-item text-center text-muted">Aucune notification</div>';
                    } else {
                        let html = '';
                        data.notifications.forEach(notif => {
                            html += `
                                <a href="{{ path('app_front_reservationlog_index') }}?highlight=${notif.reservationId || ''}" class="dropdown-item notification-item" style="white-space: normal;">
                                    <div class="small fw-bold">${notif.type === 'success' ? '✅ Annulation acceptée' : '❌ Demande rejetée'}</div>
                                    <div class="small">${escapeHtml(notif.message)}</div>
                                    <small class="text-muted">Maintenant</small>
                                </a>
                            `;
                        });
                        listContainer.innerHTML = html;
                    }
                }
            })
            .catch(err => console.error('Erreur chargement notifications:', err));
        }

        // Démarrer le polling des notifications toutes les 5 secondes
        if ({{ app.user ? 'true' : 'false' }}) {
            notificationPollingInterval = setInterval(loadUserNotifications, 5000);
            setTimeout(loadUserNotifications, 1000);
        }

        // Demander la permission pour les notifications push
        if (Notification.permission !== 'denied') {
            Notification.requestPermission();
        }

        // Nettoyer les intervalles
        window.addEventListener('beforeunload', function() {
            if (notificationPollingInterval) clearInterval(notificationPollingInterval);
        });

        // Gestion du surlignement quand on vient d'une notification
        const urlParams = new URLSearchParams(window.location.search);
        const highlightId = urlParams.get('highlight');

        if (highlightId) {
            setTimeout(() => {
                const targetCard = document.querySelector(`.col-md-6[data-id="${highlightId}"]`);
                if (targetCard) {
                    targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    targetCard.classList.add('highlight-card');
                    setTimeout(() => {
                        targetCard.classList.remove('highlight-card');
                    }, 3000);
                }
            }, 1000);
        }

        // Chargement initial des réservations
        fetchReservations(1);
    </script>
{% endblock %}