<div class="row g-3">
    <div class="col-md-5">
        <img src="{{ logement.image ? logement.image : asset('front/pacific/images/destination-1.jpg') }}" class="img-fluid rounded w-100" alt="{{ logement.nom }}" style="height: 180px; object-fit: cover;">
    </div>
    <div class="col-md-7">
        <h4 class="fw-bold mb-2">{{ logement.nom }}</h4>
        <p class="mb-1 text-muted"><i class="fa fa-map-marker me-1"></i> {{ logement.adresse }}</p>
        <p class="mb-1 text-muted"><i class="fa fa-users me-1"></i> Capacité : {{ logement.capacite }} personnes</p>
        <p class="mb-1 text-muted"><i class="fa fa-tag me-1"></i> Type : {{ logement.type }}</p>
        <p class="mb-0"><i class="fa fa-money me-1"></i> Prix / nuit : <strong>{{ logement.tarifNuit|number_format(0, ',', ' ') }} DT</strong></p>
    </div>
</div>

<input type="hidden" id="prix_par_nuit_data" value="{{ logement.tarifNuit }}">

<form method="post" action="{{ path('app_front_reservation_edit', {'id': reservation.idreslog}) }}" id="editReservationForm" class="mt-4" novalidate>
    <div id="formErrors" class="alert alert-danger d-none mb-3"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label for="date_arrivee_edit" class="form-label fw-semibold small">Date d'arrivée</label>
            <input type="date" id="date_arrivee_edit" name="date_arrivee" class="form-control" value="{{ reservation.dateDebut|date('Y-m-d') }}">
            <div class="invalid-feedback">Veuillez choisir une date valide (aujourd'hui ou dans le futur).</div>
        </div>
        <div class="col-md-6">
            <label for="date_depart_edit" class="form-label fw-semibold small">Date de départ</label>
            <input type="date" id="date_depart_edit" name="date_depart" class="form-control" value="{{ reservation.dateFin|date('Y-m-d') }}">
            <div class="invalid-feedback">La date de départ doit être postérieure à la date d'arrivée.</div>
        </div>
    </div>

    <div class="mt-3">
        <label class="form-label fw-semibold small mb-2">Modalité de paiement</label>
        <div class="d-flex justify-content-start gap-4">
            <div class="form-check">
                <input class="form-check-input" type="radio" name="modalite" id="enLigne_edit" value="En ligne" {{ reservation.modalites == 'En ligne' ? 'checked' : '' }}>
                <label class="form-check-label" for="enLigne_edit">En ligne</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="modalite" id="surPlace_edit" value="Sur place" {{ reservation.modalites == 'Sur place' ? 'checked' : '' }}>
                <label class="form-check-label" for="surPlace_edit">Sur place</label>
            </div>
        </div>
        <div id="modaliteError" class="invalid-feedback" style="display: none;">Veuillez choisir une modalité de paiement.</div>
    </div>

    <div class="mt-3">
        <label class="form-label fw-semibold small mb-2">Détails des occupants</label>
        <div class="row g-2">
            <div class="col-md-4">
                <label for="adultes_edit" class="form-label small">Adultes</label>
                <input type="number" id="adultes_edit" name="adultes" class="form-control" value="{{ reservation.adultes }}" min="1">
            </div>
            <div class="col-md-4">
                <label for="enfants_edit" class="form-label small">Enfants</label>
                <input type="number" id="enfants_edit" name="enfants" class="form-control" value="{{ reservation.enfants }}" min="0">
            </div>
            <div class="col-md-4">
                <label for="nombre_chambres_edit" class="form-label small">Nombre de chambres</label>
                <input type="number" id="nombre_chambres_edit" name="nombre_chambres" class="form-control" value="{{ reservation.nombreChambres }}" min="1">
            </div>
        </div>
        <div class="col-md-12 mt-2" id="repartitionContainer" style="display: none;">
            <label for="repartition_chambres_edit" class="form-label small">Répartition des chambres</label>
            <select id="repartition_chambres_edit" name="repartition_chambres" class="form-select">
                <option value="">Choisir une répartition</option>
            </select>
        </div>
    </div>

    <div class="mt-3">
        <label for="mode_reservation_edit" class="form-label fw-semibold small">Formule de pension</label>
        <select id="mode_reservation_edit" name="mode_reservation" class="form-select">
            <option value="" disabled selected>Choisir une formule</option>
            <option value="all_inclusive" {{ reservation.modeReservation == 'all_inclusive' ? 'selected' : '' }}>All Inclusive</option>
            <option value="soft" {{ reservation.modeReservation == 'soft' ? 'selected' : '' }}>All Inclusive Soft (sans alcool)</option>
            <option value="demi_pension" {{ reservation.modeReservation == 'demi_pension' ? 'selected' : '' }}>Demi‑pension</option>
            <option value="petit_dejeuner" {{ reservation.modeReservation == 'petit_dejeuner' ? 'selected' : '' }}>Logement Petit déjeuner</option>
        </select>
        <div id="pensionError" class="invalid-feedback" style="display: none;">Veuillez choisir une formule de pension.</div>
    </div>

    <div class="card bg-light border-0 mt-4 p-3 rounded-4">
        <h6 class="fw-bold mb-3">Détails du paiement</h6>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Nombre de nuits :</span>
            <span><span id="nuits_edit">0</span> nuit(s)</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted" id="pensionLabelEdit">Prix par personne / nuit :</span>
            <span><span id="prix_pension_nuit_edit">0</span> DT</span>
        </div>
        <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Nombre de personnes :</span>
            <span><span id="personnes_edit">0</span></span>
        </div>
        <div class="d-flex justify-content-between fw-bold">
            <span>Total :</span>
            <span id="total_edit">0 DT</span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-4 py-2 rounded-pill fw-semibold">Enregistrer les modifications</button>
</form>

<script>
    (function() {
        const dateArrivee = document.getElementById('date_arrivee_edit');
        const dateDepart = document.getElementById('date_depart_edit');
        const totalSpan = document.getElementById('total_edit');
        const nuitsSpan = document.getElementById('nuits_edit');
        const prixParNuit = parseFloat(document.getElementById('prix_par_nuit_data').value);
        const form = document.getElementById('editReservationForm');
        const formErrorsDiv = document.getElementById('formErrors');
        const modaliteRadios = document.querySelectorAll('input[name="modalite"]');
        const adultesInput = document.getElementById('adultes_edit');
        const enfantsInput = document.getElementById('enfants_edit');
        const modeReservationSelect = document.getElementById('mode_reservation_edit');
        const chambresInput = document.getElementById('nombre_chambres_edit');
        const personnesSpan = document.getElementById('personnes_edit');
        const prixPensionSpan = document.getElementById('prix_pension_nuit_edit');
        const pensionLabelSpan = document.getElementById('pensionLabelEdit');

        // ========== RÉPARTITION DES CHAMBRES ==========
        function updateRepartitionOptions() {
            const adultes = parseInt(adultesInput?.value || 1);
            const enfants = parseInt(enfantsInput?.value || 0);
            const totalPersonnes = adultes + enfants;
            const chambresDemandees = parseInt(chambresInput?.value || 1);
            const maxParChambre = 4;
            const chambresNecessaires = Math.ceil(totalPersonnes / maxParChambre);
            const chambresEffectives = Math.max(chambresDemandees, chambresNecessaires);
            const repartitionContainer = document.getElementById('repartitionContainer');
            const repartitionSelect = document.getElementById('repartition_chambres_edit');

            if (!repartitionContainer) return;
            const oldValue = repartitionSelect ? repartitionSelect.value : '';

            if (chambresEffectives > 1 && chambresDemandees === 1 && totalPersonnes > 0) {
                const combos = [];
                function findCombos(remaining, chambers, current) {
                    if (chambers === 0) {
                        if (remaining === 0) combos.push([...current]);
                        return;
                    }
                    for (let i = 1; i <= Math.min(remaining, maxParChambre); i++) {
                        current.push(i);
                        findCombos(remaining - i, chambers - 1, current);
                        current.pop();
                    }
                }
                findCombos(totalPersonnes, chambresEffectives, []);
                const uniqueCombos = [];
                combos.forEach(combo => {
                    const sorted = [...combo].sort((a,b)=>a-b);
                    const key = sorted.join(',');
                    if (!uniqueCombos.some(c => c.join(',') === key)) uniqueCombos.push(sorted);
                });
                repartitionSelect.innerHTML = '<option value="">Choisir une répartition</option>';
                uniqueCombos.forEach(combo => {
                    const labels = combo.map(p => p + ' personne' + (p > 1 ? 's' : ''));
                    const text = labels.join(' + ');
                    repartitionSelect.innerHTML += `<option value="${combo.join(',')}">${text}</option>`;
                });
                if (oldValue && Array.from(repartitionSelect.options).some(opt => opt.value === oldValue)) {
                    repartitionSelect.value = oldValue;
                }
                repartitionContainer.style.display = 'block';
            } else {
                repartitionContainer.style.display = 'none';
                if (repartitionSelect) repartitionSelect.value = '';
            }
        }

        // ========== CALCUL DU TOTAL (avec pension) ==========
        function calculerTotal() {
            const adultes = parseInt(adultesInput?.value || 1);
            const enfants = parseInt(enfantsInput?.value || 0);
            const nombrePersonnes = adultes + enfants;
            const modeReservation = modeReservationSelect?.value || null;

            let coefficient = 1.00;
            let pensionLabel = "Prix par personne / nuit";
            if (modeReservation === 'demi_pension') {
                coefficient = 1.20;
                pensionLabel = "Prix par personne / nuit (Demi-pension)";
            } else if (modeReservation === 'all_inclusive') {
                coefficient = 1.45;
                pensionLabel = "Prix par personne / nuit (All Inclusive)";
            } else if (modeReservation === 'soft') {
                coefficient = 1.37;
                pensionLabel = "Prix par personne / nuit (Soft)";
            } else if (modeReservation === 'petit_dejeuner') {
                coefficient = 1.00;
                pensionLabel = "Prix par personne / nuit (Petit déjeuner)";
            }

            const prixPensionNuit = prixParNuit * coefficient;
            if (prixPensionSpan) prixPensionSpan.innerText = prixPensionNuit.toFixed(2);
            if (pensionLabelSpan) pensionLabelSpan.innerText = pensionLabel;
            if (personnesSpan) personnesSpan.innerText = nombrePersonnes;

            if (dateArrivee.value && dateDepart.value) {
                const arrivee = new Date(dateArrivee.value);
                const depart = new Date(dateDepart.value);
                if (depart > arrivee) {
                    const nuits = (depart - arrivee) / (1000 * 60 * 60 * 24);
                    const total = nuits * nombrePersonnes * prixPensionNuit;
                    if (nuitsSpan) nuitsSpan.innerText = nuits;
                    if (totalSpan) totalSpan.innerText = total.toFixed(2) + ' DT';
                    return;
                }
            }
            if (nuitsSpan) nuitsSpan.innerText = '0';
            if (totalSpan) totalSpan.innerText = '0 DT';
        }

        // ========== VALIDATION ==========
        function validateForm(event) {
            let isValid = true;
            let errorMessages = [];

            dateArrivee.classList.remove('is-invalid');
            dateDepart.classList.remove('is-invalid');
            const modaliteError = document.getElementById('modaliteError');
            if (modaliteError) modaliteError.style.display = 'none';
            formErrorsDiv.classList.add('d-none');
            formErrorsDiv.innerHTML = '';

            if (!dateArrivee.value) {
                errorMessages.push('La date d\'arrivée est obligatoire.');
                dateArrivee.classList.add('is-invalid');
                isValid = false;
            } else {
                const arrivee = new Date(dateArrivee.value);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                if (arrivee < today) {
                    errorMessages.push('La date d\'arrivée ne peut pas être dans le passé.');
                    dateArrivee.classList.add('is-invalid');
                    isValid = false;
                }
            }

            if (!dateDepart.value) {
                errorMessages.push('La date de départ est obligatoire.');
                dateDepart.classList.add('is-invalid');
                isValid = false;
            } else if (dateArrivee.value) {
                const arrivee = new Date(dateArrivee.value);
                const depart = new Date(dateDepart.value);
                if (depart <= arrivee) {
                    errorMessages.push('La date de départ doit être postérieure à la date d\'arrivée.');
                    dateDepart.classList.add('is-invalid');
                    isValid = false;
                }
            }

            let modaliteChecked = false;
            modaliteRadios.forEach(radio => { if (radio.checked) modaliteChecked = true; });
            if (!modaliteChecked) {
                errorMessages.push('Veuillez choisir une modalité de paiement.');
                if (modaliteError) modaliteError.style.display = 'block';
                isValid = false;
            }

            const modeReservation = modeReservationSelect?.value || null;
            const pensionErrorDiv = document.getElementById('pensionError');
            if (!modeReservation) {
                errorMessages.push('Veuillez choisir une formule de pension.');
                if (pensionErrorDiv) pensionErrorDiv.style.display = 'block';
                modeReservationSelect?.classList.add('is-invalid');
                isValid = false;
            } else {
                if (pensionErrorDiv) pensionErrorDiv.style.display = 'none';
                modeReservationSelect?.classList.remove('is-invalid');
            }

            const adultes = parseInt(adultesInput?.value || 0);
            const enfants = parseInt(enfantsInput?.value || 0);
            const chambres = parseInt(chambresInput?.value || 0);
            if (adultes < 1) errorMessages.push('Au moins 1 adulte.');
            if (enfants < 0) errorMessages.push('Nombre d\'enfants invalide.');
            if (chambres < 1) errorMessages.push('Au moins 1 chambre.');

            if (errorMessages.length > 0) {
                isValid = false;
                formErrorsDiv.innerHTML = errorMessages.join('<br>');
                formErrorsDiv.classList.remove('d-none');
            }

            if (!isValid) event.preventDefault();
        }

        // ========== ÉCOUTEURS ==========
        dateArrivee.addEventListener('change', () => { calculerTotal(); updateRepartitionOptions(); });
        dateDepart.addEventListener('change', () => { calculerTotal(); updateRepartitionOptions(); });
        if (adultesInput) adultesInput.addEventListener('input', () => { calculerTotal(); updateRepartitionOptions(); });
        if (enfantsInput) enfantsInput.addEventListener('input', () => { calculerTotal(); updateRepartitionOptions(); });
        if (modeReservationSelect) modeReservationSelect.addEventListener('change', () => { calculerTotal(); updateRepartitionOptions(); });
        if (chambresInput) chambresInput.addEventListener('input', () => { calculerTotal(); updateRepartitionOptions(); });

        calculerTotal();
        updateRepartitionOptions();
        form.addEventListener('submit', validateForm);
    })();
</script>