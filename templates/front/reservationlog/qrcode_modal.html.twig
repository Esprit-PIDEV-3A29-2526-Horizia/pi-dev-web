<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>QR Code - Réservation #{{ reservation.idreslog }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="card shadow-sm mx-auto" style="max-width: 500px;">
            <div class="card-body text-center">
                <img src="{{ qrCodeDataUri }}" alt="QR Code" class="img-fluid mb-3" style="max-width: 250px;">
                <h5>Réservation #{{ reservation.idreslog }}</h5>
                <p class="mb-1"><strong>{{ reservation.logement.nom }}</strong></p>
                <p class="mb-1">{{ reservation.dateDebut|date('d/m/Y') }} → {{ reservation.dateFin|date('d/m/Y') }}</p>
                <p class="mb-3">{{ reservation.montant|number_format(2, ',', ' ') }} DT</p>
                <button id="sendEmailBtn" class="btn btn-primary">
                    <i class="fa fa-envelope"></i> Envoyer par email (PDF)
                </button>
                <div id="emailMessage" class="mt-3"></div>
            </div>
        </div>
    </div>
    <script>
        document.getElementById('sendEmailBtn').addEventListener('click', function() {
            const btn = this;
            const msgDiv = document.getElementById('emailMessage');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Envoi...';
            
            fetch('{{ path('app_front_reservation_send_email', {'id': reservation.idreslog}) }}', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    msgDiv.innerHTML = '<div class="alert alert-success mt-2">Email envoyé !</div>';
                } else {
                    msgDiv.innerHTML = '<div class="alert alert-danger mt-2">Erreur : ' + (data.error || 'Envoi échoué') + '</div>';
                }
            })
            .catch(() => {
                msgDiv.innerHTML = '<div class="alert alert-danger mt-2">Erreur réseau.</div>';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-envelope"></i> Envoyer par email (PDF)';
            });
        });
    </script>
</body>
</html>