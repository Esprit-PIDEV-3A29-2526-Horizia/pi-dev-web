{% extends 'front/base_front.html.twig' %}

{% block title %}Nos logements - Horozia{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ========== STYLES FLIP CARD ========== */
        .flip-card {
            background-color: transparent;
            width: 100%;
            height: 450px;
            perspective: 1000px;
            margin-bottom: 30px;
        }
        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s;
            transform-style: preserve-3d;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            border: 2px solid #23779C;
        }
        .flip-card:hover .flip-card-inner {
            transform: rotateY(180deg);
        }
        .flip-card-front, .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 20px;
            overflow: hidden;
        }
        .flip-card-front {
            background-color: #fff;
            color: #333;
        }
        .flip-card-front-img {
            height: 220px;
            background-size: cover;
            background-position: center;
            position: relative;
        }
        .price-badge {
            position: absolute;
            bottom: 15px;
            right: 15px;
            background: #23779C;
            color: white;
            padding: 8px 16px;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            z-index: 2;
        }
        .flip-card-front-content {
            padding: 20px;
            text-align: left;
        }
        .flip-card-front-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #1f2d3d;
            margin-bottom: 5px;
        }
        .flip-card-front-type {
            color: #23779C;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .flip-card-front-location {
            color: #6c757d;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 15px;
        }
        .flip-card-back {
            background: linear-gradient(135deg, #23779C, #3D94CA);
            color: white;
            transform: rotateY(180deg);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 25px;
            text-align: left;
        }
        .flip-card-back h3 {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 15px;
            color: white;
        }
        .flip-card-back p {
            margin-bottom: 12px;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .btn-reserver {
            display: block;
            background: white;
            color: #23779C;
            text-align: center;
            padding: 14px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            margin-top: 20px;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
            width: 100%;
        }
        .btn-reserver:hover {
            background: #f0f0f0;
            transform: scale(1.02);
            color: #1a5c7a;
        }
        .equipement-badge {
            display: inline-block;
            background: rgba(255,255,255,0.2);
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            margin-right: 6px;
            margin-bottom: 6px;
        }

        /* ========== MODALE ========== */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(5px);
            z-index: 9999;
            justify-content: center;
            align-items: center;
        }
        .modal-overlay.active {
            display: flex;
        }
        .modal-container {
            background: white;
            border-radius: 20px;
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 20px;
            position: relative;
            border: 2px solid #23779C;
        }
        .modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 28px;
            cursor: pointer;
            color: #23779C;
        }
        body.modal-open {
            overflow: hidden;
        }

        /* ========== STYLES RECHERCHE DYNAMIQUE ========== */
        .custom-input, .custom-select {
            border: none;
            outline: none;
            border-radius: 15px;
            padding: 1em;
            background-color: #ccc;
            box-shadow: inset 2px 5px 10px rgba(0,0,0,0.3);
            transition: 300ms ease-in-out;
            width: 100%;
            font-size: 1rem;
        }
        .custom-input:focus, .custom-select:focus {
            background-color: white;
            transform: scale(1.05);
            box-shadow: 13px 13px 100px #969696, -13px -13px 100px #ffffff;
        }
        .search-wrapper {
            display: flex;
            gap: 20px;
            align-items: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .search-wrapper .search-field {
            flex: 2;
            min-width: 200px;
        }
        .search-wrapper .type-field {
            flex: 1;
            min-width: 180px;
        }
        .search-wrapper .sort-field {
            flex: 1;
            min-width: 180px;
        }
        @media (max-width: 768px) {
            .search-wrapper { flex-direction: column; gap: 15px; }
        }

        /* Message dans la modale */
        .modal-message {
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 16px;
            font-size: 0.9rem;
        }
        .modal-message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .modal-message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
    </style>
{% endblock %}

{% block body %}

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_front_home') }}">Horozia<span>TRAVEL AGENCY</span></a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>
        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#voyages" class="nav-link">Voyages</a></li>
                <li class="nav-item active"><a href="{{ path('app_front_logement_index') }}" class="nav-link">Logement</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="reservationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Mes réservations
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="reservationsDropdown">
                        <li><a class="dropdown-item" href="{{ path('app_front_reservation_index') }}">Voir mes réservations</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#services" class="nav-link">Services</a></li>
                <li class="nav-item"><a href="{{ path('app_front_home') }}#contact" class="nav-link">Contact</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- HERO SECTION avec barre de recherche -->
<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/back.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Bienvenue chez Horozia</span>
                <h1 class="mb-4">Découvrez votre prochain logement</h1>
                <p class="mb-4">Horozia vous propose des hébergements soigneusement sélectionnés, une réservation simple et une expérience moderne pour vos séjours.</p>

                <form id="filtersForm" method="get" action="{{ path('app_front_logement_index') }}" class="search-wrapper">
                    <div class="search-field">
                        <input type="text" name="q" id="searchInput" class="custom-input" placeholder="Rechercher par nom, adresse ou type..." value="{{ currentSearch }}">
                    </div>
                    <div class="type-field">
                        <select name="type" id="typeSelect" class="custom-select">
                            <option value="tous" {% if currentType == 'tous' or currentType is empty %}selected{% endif %}>Tous les types</option>
                            {% for typeOption in allTypes %}
                                <option value="{{ typeOption }}" {% if currentType == typeOption %}selected{% endif %}>
                                    {{ typeOption|capitalize }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="sort-field">
                        <select name="sort" id="sortSelect" class="custom-select">
                            <option value="" {% if currentSort is empty %}selected{% endif %}>Trier par défaut</option>
                            <option value="prix_asc" {% if currentSort == 'prix_asc' %}selected{% endif %}>Prix croissant</option>
                            <option value="prix_desc" {% if currentSort == 'prix_desc' %}selected{% endif %}>Prix décroissant</option>
                        </select>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- LISTE DES LOGEMENTS -->
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Nos hébergements</span>
                <h2 class="mb-4">Logements disponibles</h2>
            </div>
        </div>

        <div class="cards-container row g-4">
            {% for logement in logements %}
                <div class="col-md-4 ftco-animate mb-4">
                    <div class="flip-card">
                        <div class="flip-card-inner">
                            <div class="flip-card-front">
                                <div class="flip-card-front-img" style="background-image: url('{{ logement.image ? logement.image : asset('front/pacific/images/destination-1.jpg') }}');">
                                    <div class="price-badge">{{ logement.tarifNuit|number_format(0, ',', ' ') }} DT / nuit</div>
                                </div>
                                <div class="flip-card-front-content">
                                    <div class="flip-card-front-title">{{ logement.nom }}</div>
                                    <div class="flip-card-front-type">{{ logement.type }}</div>
                                    <div class="flip-card-front-location">
                                        <i class="fa fa-map-marker"></i> {{ logement.adresse|slice(0, 40) }}
                                    </div>
                                </div>
                            </div>
                            <div class="flip-card-back">
                                <div>
                                    <h3>{{ logement.nom }}</h3>
                                    <p><i class="fa fa-users"></i> Capacité : {{ logement.capacite }} personnes</p>
                                    <p><i class="fa fa-tag"></i> Type : {{ logement.type }}</p>
                                    <p><i class="fa fa-map-marker"></i> {{ logement.adresse }}</p>
                                    <p><i class="fa fa-money"></i> {{ logement.tarifNuit|number_format(0, ',', ' ') }} DT / nuit</p>
                                    {% if logement.equipement %}
                                        <div>
                                            {% set equipements = logement.equipement|split(',') %}
                                            {% for equip in equipements|slice(0, 4) %}
                                                <span class="equipement-badge">{{ equip|trim }}</span>
                                            {% endfor %}
                                            {% if equipements|length > 4 %}
                                                <span class="equipement-badge">+{{ equipements|length - 4 }}</span>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                                <button type="button" class="btn-reserver" data-id="{{ logement.id }}">
                                    <i class="fa fa-calendar-check-o"></i> Réserver
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center">Aucun logement disponible.</div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- MODALE DE RÉSERVATION -->
<div id="reservationModalOverlay" class="modal-overlay">
    <div class="modal-container">
        <span class="modal-close">&times;</span>
        <div id="modalContent">
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Chargement...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="ftco-footer bg-bottom" style="background-color: #23779C;">
    <div class="container py-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Horozia</h2>
                <p class="text-white-50">Horozia est une plateforme dédiée à la gestion des voyages et des réservations, offrant une expérience élégante et moderne aux voyageurs.</p>
            </div>
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Liens rapides</h2>
                <ul class="list-unstyled">
                    <li><a href="{{ path('app_front_home') }}" class="text-white-50">Accueil</a></li>
                    <li><a href="{{ path('app_front_home') }}#voyages" class="text-white-50">Voyages</a></li>
                    <li><a href="{{ path('app_front_logement_index') }}" class="text-white-50">Logement</a></li>
                    <li><a href="{{ path('app_front_home') }}#services" class="text-white-50">Services</a></li>
                    <li><a href="{{ path('app_front_home') }}#contact" class="text-white-50">Contact</a></li>
                </ul>
            </div>
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Contact</h2>
                <p class="text-white-50 mb-1">Tunisie</p>
                <p class="text-white-50 mb-1">contact@horozia.com</p>
                <p class="text-white-50">+216 00 000 000</p>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-md-12 text-center">
                <p class="text-white-50 mb-0">© {{ "now"|date("Y") }} Horozia. Tous droits réservés.</p>
            </div>
        </div>
    </div>
</footer>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Variables globales
        const isConnected = {{ isConnected|default(false) ? 'true' : 'false' }};
        const loginUrl = "/login";

        // ========== SOUMISSION AUTOMATIQUE (recherche) ==========
        const searchForm = document.getElementById('filtersForm');
        const searchInput = document.getElementById('searchInput');
        const typeSelect = document.getElementById('typeSelect');
        const sortSelect = document.getElementById('sortSelect');

        let timeoutId = null;
        function submitSearchForm() { searchForm.submit(); }
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                if (timeoutId) clearTimeout(timeoutId);
                timeoutId = setTimeout(submitSearchForm, 500);
            });
        }
        if (typeSelect) typeSelect.addEventListener('change', submitSearchForm);
        if (sortSelect) sortSelect.addEventListener('change', submitSearchForm);

        // ========== GESTION DE LA MODALE ==========
        const modalOverlay = document.getElementById('reservationModalOverlay');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.querySelector('.modal-close');

        function openModal() {
            modalOverlay.classList.add('active');
            document.body.classList.add('modal-open');
        }
        function closeModal() {
            modalOverlay.classList.remove('active');
            document.body.classList.remove('modal-open');
            modalContent.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Chargement...</span></div></div>';
        }
        if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
        modalOverlay.addEventListener('click', (e) => { if (e.target === modalOverlay) closeModal(); });

        // ========== BOUTONS "RÉSERVER" ==========
        document.querySelectorAll('.btn-reserver').forEach(btn => {
            btn.addEventListener('click', function() {
                if (!isConnected) {
                    Swal.fire({
                        title: 'Connexion requise',
                        text: 'Veuillez vous connecter pour effectuer une réservation.',
                        icon: 'warning',
                        confirmButtonColor: '#23779C',
                        confirmButtonText: 'Se connecter'
                    }).then((result) => {
                        if (result.isConfirmed) window.location.href = loginUrl;
                    });
                    return;
                }
                const logementId = this.getAttribute('data-id');
                fetch(`/logement/${logementId}/reserver-modal`, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(response => response.text())
                .then(html => {
                    modalContent.innerHTML = html;
                    openModal();
                    setTimeout(() => initReservationForm(), 100);
                })
                .catch(error => {
                    console.error(error);
                    Swal.fire({
                        title: 'Erreur',
                        text: 'Impossible de charger le formulaire.',
                        icon: 'error',
                        confirmButtonColor: '#23779C'
                    });
                    closeModal();
                });
            });
        });

        // ========== FORMULAIRE DE RÉSERVATION ==========
        function initReservationForm() {
            const dateArrivee = document.getElementById('date_arrivee_modal');
            const dateDepart = document.getElementById('date_depart_modal');
            const totalSpan = document.getElementById('total_modal');
            const nuitsSpan = document.getElementById('nuits_modal');
            const reservationForm = document.getElementById('reservationFormModal');
            const formErrorsDiv = document.getElementById('formErrors');
            const modaliteRadios = document.querySelectorAll('input[name="modalite"]');

            if (!dateArrivee || !dateDepart) return;

            const prixInput = document.getElementById('prix_par_nuit_data');
            const prixParNuit = prixInput ? parseFloat(prixInput.value) : 0;

            function calculerTotal() {
                if (dateArrivee.value && dateDepart.value) {
                    const arrivee = new Date(dateArrivee.value);
                    const depart = new Date(dateDepart.value);
                    if (depart > arrivee) {
                        const nuits = (depart - arrivee) / (1000 * 60 * 60 * 24);
                        const total = nuits * prixParNuit;
                        if (nuitsSpan) nuitsSpan.innerText = nuits;
                        if (totalSpan) totalSpan.innerText = total.toFixed(2) + ' DT';
                        return;
                    }
                }
                if (nuitsSpan) nuitsSpan.innerText = '0';
                if (totalSpan) totalSpan.innerText = '0 DT';
            }

            let isSubmitting = false;

            // Fonction pour afficher un message dans la modale (sous le formulaire)
            function showModalMessage(message, type = 'success') {
                // Supprimer l'ancien message s'il existe
                const oldMsg = document.getElementById('dynamicModalMessage');
                if (oldMsg) oldMsg.remove();
                // Créer le nouveau message
                const msgDiv = document.createElement('div');
                msgDiv.id = 'dynamicModalMessage';
                msgDiv.className = `modal-message ${type}`;
                msgDiv.innerText = message;
                // Insérer après le bouton ou avant le formulaire
                const submitBtn = reservationForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.parentNode.insertBefore(msgDiv, submitBtn.nextSibling);
                } else {
                    reservationForm.appendChild(msgDiv);
                }
                // Scroll pour voir le message
                msgDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            function clearModalMessage() {
                const oldMsg = document.getElementById('dynamicModalMessage');
                if (oldMsg) oldMsg.remove();
            }

            async function submitReservation(event) {
                event.preventDefault();
                if (isSubmitting) return;
                isSubmitting = true;
                clearModalMessage();

                // Réinitialisation
                dateArrivee.classList.remove('is-invalid');
                dateDepart.classList.remove('is-invalid');
                const modaliteError = document.getElementById('modaliteError');
                if (modaliteError) modaliteError.style.display = 'none';
                if (formErrorsDiv) {
                    formErrorsDiv.classList.add('d-none');
                    formErrorsDiv.innerHTML = '';
                }

                let errorMessages = [];

                // Validation date arrivée
                if (!dateArrivee.value) {
                    errorMessages.push('La date d\'arrivée est obligatoire.');
                    dateArrivee.classList.add('is-invalid');
                } else {
                    const arrivee = new Date(dateArrivee.value);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    if (arrivee < today) {
                        errorMessages.push('La date d\'arrivée ne peut pas être dans le passé.');
                        dateArrivee.classList.add('is-invalid');
                    }
                }

                // Validation date départ
                if (!dateDepart.value) {
                    errorMessages.push('La date de départ est obligatoire.');
                    dateDepart.classList.add('is-invalid');
                } else if (dateArrivee.value) {
                    const arrivee = new Date(dateArrivee.value);
                    const depart = new Date(dateDepart.value);
                    if (depart <= arrivee) {
                        errorMessages.push('La date de départ doit être postérieure à la date d\'arrivée.');
                        dateDepart.classList.add('is-invalid');
                    }
                }

                // Validation modalité
                let selectedModalite = null;
                modaliteRadios.forEach(radio => {
                    if (radio.checked) selectedModalite = radio.value;
                });
                if (!selectedModalite) {
                    errorMessages.push('Veuillez choisir une modalité de paiement.');
                    if (modaliteError) modaliteError.style.display = 'block';
                }

                if (errorMessages.length > 0) {
                    if (formErrorsDiv) {
                        formErrorsDiv.innerHTML = errorMessages.join('<br>');
                        formErrorsDiv.classList.remove('d-none');
                    }
                    isSubmitting = false;
                    return;
                }

                const logementId = reservationForm.querySelector('input[name="logement_id"]').value;
                let paiementImmediat = false;

                // Choix pour paiement en ligne (SweetAlert)
                if (selectedModalite === 'En ligne') {
                    const result = await Swal.fire({
                        title: 'Paiement en ligne',
                        text: 'Choisissez une option :',
                        icon: 'question',
                        showDenyButton: true,
                        showCancelButton: false,
                        confirmButtonText: 'Payer maintenant',
                        denyButtonText: 'Payer plus tard',
                        confirmButtonColor: '#23779C',
                        denyButtonColor: '#6c757d'
                    });
                    if (result.isConfirmed) {
                        paiementImmediat = true;
                    } else if (result.isDenied) {
                        paiementImmediat = false;
                    } else {
                        isSubmitting = false;
                        return;
                    }
                }

                const data = {
                    logement_id: logementId,
                    date_arrivee: dateArrivee.value,
                    date_depart: dateDepart.value,
                    modalite: selectedModalite,
                    paiement_immediat: paiementImmediat
                };

                try {
                    const response = await fetch('/reservation/create-ajax', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify(data)
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        console.error('HTTP error:', response.status, errorText);
                        showModalMessage(`Erreur serveur (${response.status})`, 'error');
                        isSubmitting = false;
                        return;
                    }

                    const result = await response.json();
                    if (result.success) {
                        showModalMessage(result.message, 'success');
                        // Fermer la modale après 2 secondes et rediriger
                        setTimeout(() => {
                            closeModal();
                            window.location.href = "{{ path('app_front_reservation_index') }}";
                        }, 2000);
                    } else {
                        showModalMessage(result.message, 'error');
                        isSubmitting = false;
                    }
                } catch (err) {
                    console.error(err);
                    showModalMessage('Une erreur technique est survenue. Veuillez réessayer.', 'error');
                    isSubmitting = false;
                }
            }

            if (reservationForm) {
                reservationForm.removeEventListener('submit', reservationForm.submitHandler);
                reservationForm.submitHandler = submitReservation;
                reservationForm.addEventListener('submit', reservationForm.submitHandler);
            }

            dateArrivee.addEventListener('change', calculerTotal);
