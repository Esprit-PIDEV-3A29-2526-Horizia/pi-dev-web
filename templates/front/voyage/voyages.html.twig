{% extends 'base_front.html.twig' %}

{% block title %}Voyages - Horozia{% endblock %}

{% block body %}


<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/voyage.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="{{ path('app_front_home') }}">Accueil <i class="fa fa-chevron-right"></i></a>
                    </span>
                    <span>Voyages <i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Nos Voyages</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section ftco-no-pb">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="search-wrap-1 ftco-animate">
                    <form method="get" action="{{ path('app_front_voyages') }}" class="search-property-1">
                        <div class="row no-gutters">
                            <div class="col-lg d-flex">
                                <div class="form-group p-4 border-0">
                                    <label for="destination">Destination</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-search"></span></div>
                                        <input
                                            type="text"
                                            id="destination"
                                            name="destination"
                                            class="form-control"
                                            placeholder="Rechercher une destination"
                                            value="{{ filters.destination|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="date_depart">Date départ</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-calendar"></span></div>
                                        <input
                                            type="date"
                                            id="date_depart"
                                            name="date_depart"
                                            class="form-control"
                                            value="{{ filters.date_depart|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="date_retour">Date retour</label>
                                    <div class="form-field">
                                        <div class="icon"><span class="fa fa-calendar"></span></div>
                                        <input
                                            type="date"
                                            id="date_retour"
                                            name="date_retour"
                                            class="form-control"
                                            value="{{ filters.date_retour|default('') }}"
                                        >
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group p-4">
                                    <label for="budget_max">Budget max</label>
                                    <div class="form-field">
                                        <div class="select-wrap">
                                            <div class="icon"><span class="fa fa-chevron-down"></span></div>
                                            <select name="budget_max" id="budget_max" class="form-control">
                                                <option value="">Choisir</option>
                                                <option value="500" {{ filters.budget_max == '500' ? 'selected' : '' }}>500 DT</option>
                                                <option value="1000" {{ filters.budget_max == '1000' ? 'selected' : '' }}>1000 DT</option>
                                                <option value="1500" {{ filters.budget_max == '1500' ? 'selected' : '' }}>1500 DT</option>
                                                <option value="2000" {{ filters.budget_max == '2000' ? 'selected' : '' }}>2000 DT</option>
                                                <option value="3000" {{ filters.budget_max == '3000' ? 'selected' : '' }}>3000 DT</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg d-flex">
                                <div class="form-group d-flex w-100 border-0">
                                    <div class="form-field w-100 align-items-center d-flex">
                                        <button type="submit" class="align-self-stretch form-control btn btn-primary">
                                            SEARCH
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="text-right mt-3">
                    <a href="{{ path('app_front_voyages') }}" class="btn btn-sm btn-light px-3">Réinitialiser</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-12 text-center">
                <h2 class="mb-2">Nos voyages</h2>
            </div>
        </div>

        <div class="row">
            {% if voyages is not empty %}
                {% for voyage in voyages %}
                    <div class="col-md-4 ftco-animate">
                        <div class="project-wrap hotel">
                            {% set imagePath = voyage.imageUrl ?: 'front/pacific/images/destination-1.jpg' %}

                            <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}"
                               class="img"
                               style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}');">
                                <span class="price">{{ voyage.prix|number_format(0, ',', ' ') }} DT/personne</span>
                            </a>

                            <div class="text p-4">
                                <p class="star mb-2">
                                    <span class="fa fa-star"></span>
                                    <span class="fa fa-star"></span>
                                    <span class="fa fa-star"></span>
                                    <span class="fa fa-star"></span>
                                    <span class="fa fa-star"></span>
                                </p>

                                <span class="days">
                                    {{ voyage.dateDepart|date('d/m/Y') }} - {{ voyage.dateRetour|date('d/m/Y') }}
                                </span>

                                <h3>
                                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}">
                                        {{ voyage.titre }}
                                    </a>
                                </h3>

                                <p class="location">
                                    <span class="fa fa-map-marker"></span> {{ voyage.destination }}
                                </p>

                                <ul>
                                    <li><span class="fa fa-users"></span> {{ voyage.placesRestantes }}</li>
                                    <li><span class="fa fa-calendar"></span> Départ</li>
                                    <li><span class="fa fa-plane"></span> Voyage</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucun voyage ne correspond à votre recherche.</p>
                </div>
            {% endif %}
        </div>

        <div class="row mt-5">
            <div class="col text-center">
                <div class="block-27">
                    <ul>
                        <li class="active"><span>1</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-intro ftco-section ftco-no-pt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 text-center">
                <div class="img" style="background-image: url('{{ asset('front/pacific/images/bg_2.jpg') }}');">
                    <div class="overlay"></div>
                    <h2>Horozia, votre agence de voyage</h2>
                    <p>Découvrez des voyages uniques et vivez une expérience moderne et élégante.</p>
                    <p class="mb-0">
                        <a href="{{ path('app_front_home') }}" class="btn btn-primary px-4 py-3">
                            Retour à l'accueil
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<footer class="ftco-footer bg-bottom ftco-no-pt" id="contact" style="background-image: url('{{ asset('front/pacific/images/bg_3.jpg') }}');">
    <div class="container">
        <div class="row mb-5">
            <div class="col-md pt-5">
                <div class="ftco-footer-widget pt-md-5 mb-4">
                    <h2 class="ftco-heading-2">À propos</h2>
                    <p>Horozia vous accompagne dans la découverte de destinations sélectionnées avec soin.</p>
                </div>
            </div>

            <div class="col-md pt-5 border-left">
                <div class="ftco-footer-widget pt-md-5 mb-4 ml-md-5">
                    <h2 class="ftco-heading-2">Navigation</h2>
                    <ul class="list-unstyled">
                        <li><a href="{{ path('app_front_home') }}" class="py-2 d-block">Accueil</a></li>
                        <li><a href="{{ path('app_front_voyages') }}" class="py-2 d-block">Voyages</a></li>
                        <li><a href="{{ path('app_front_home') }}#services" class="py-2 d-block">Services</a></li>
                        <li><a href="#contact" class="py-2 d-block">Contact</a></li>
                    </ul>
                </div>
            </div>

            <div class="col-md pt-5 border-left">
                <div class="ftco-footer-widget pt-md-5 mb-4">
                    <h2 class="ftco-heading-2">Expériences</h2>
                    <ul class="list-unstyled">
                        <li><a href="#" class="py-2 d-block">Aventure</a></li>
                        <li><a href="#" class="py-2 d-block">Détente</a></li>
                        <li><a href="#" class="py-2 d-block">Nature</a></li>
                        <li><a href="#" class="py-2 d-block">Culture</a></li>
                    </ul>
                </div>
            </div>

            <div class="col-md pt-5 border-left">
                <div class="ftco-footer-widget pt-md-5 mb-4">
                    <h2 class="ftco-heading-2">Contact</h2>
                    <div class="block-23 mb-3">
                        <ul>
                            <li><span class="icon fa fa-map-marker"></span><span class="text">Tunisie</span></li>
                            <li><a href="#"><span class="icon fa fa-phone"></span><span class="text">+216 00 000 000</span></a></li>
                            <li><a href="#"><span class="icon fa fa-paper-plane"></span><span class="text">contact@horozia.com</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 text-center">
                <p>© {{ "now"|date("Y") }} Horozia. Tous droits réservés.</p>
            </div>
        </div>
    </div>
</footer>

{% endblock %}