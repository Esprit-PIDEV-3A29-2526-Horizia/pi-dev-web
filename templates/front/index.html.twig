{% extends 'front/base_front.html.twig' %}

{% block title %}Accueil - Horozia{% endblock %}

{% block body %}

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_front_home') }}">
            Horozia
            <span>TRAVEL AGENCY</span>
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>

        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item active"><a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="#voyages" class="nav-link">Voyages</a></li>
<li class="nav-item {{ app.request.attributes.get('_route') == 'app_front_logement_index' ? 'active' : '' }}">
    <a href="{{ path('app_front_logement_index') }}" class="nav-link">Logement</a>
</li>
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="reservationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        Mes réservations
    </a>
    <ul class="dropdown-menu" aria-labelledby="reservationsDropdown">
        <li><a class="dropdown-item" href="{{ path('app_front_reservation_index') }}">Voir mes réservations</a></li>
    </ul>
</li>
                <li class="nav-item"><a href="#services" class="nav-link">Services</a></li>
                <li class="nav-item"><a href="#contact" class="nav-link">Contact</a></li>
            </ul>
        </div>
    </div>
</nav>

<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/back.jpg') }}');">
    <div class="overlay"></div>

    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Bienvenue chez Horozia</span>
                <h1 class="mb-4">Découvrez votre prochaine destination</h1>
                <p class="mb-4">
                    Horozia vous propose des voyages soigneusement sélectionnés, une réservation simple
                    et une expérience moderne pour explorer le monde avec élégance.
                </p>
                <p>
                    <a href="#voyages" class="btn btn-primary py-3 px-4">Explorer les voyages</a>
                </p>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section" id="voyages">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Nos voyages</span>
                <h2 class="mb-4">Voyages populaires</h2>
            </div>
        </div>

        
    </div>
</section>

<section class="ftco-section soft-section" id="services">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Pourquoi choisir Horozia</span>
                <h2 class="mb-4">Une plateforme pensée pour vos voyages</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-globe text-primary"></span>
                    </div>
                    <h3 class="mb-3">Destinations variées</h3>
                    <p>
                        Découvrez des voyages soigneusement sélectionnés : détente, urbain, aventure et évasion.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-calendar-check-o text-primary"></span>
                    </div>
                    <h3 class="mb-3">Réservation simple</h3>
                    <p>
                        Réservez votre voyage rapidement grâce à une interface claire, moderne et intuitive.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-star text-primary"></span>
                    </div>
                    <h3 class="mb-3">Expérience premium</h3>
                    <p>
                        Horozia met l’accent sur le confort, le design et la qualité de l’expérience utilisateur.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Commencez votre aventure</span>
                <h2 class="mb-4">Réservez votre prochain voyage avec Horozia</h2>
                <p>
                    Explorez nos offres et trouvez la destination qui vous ressemble.
                </p>
                <a href="#voyages" class="btn btn-primary py-3 px-4 mt-3">Voir tous les voyages</a>
            </div>
        </div>
    </div>
</section>

<footer class="ftco-footer bg-bottom" id="contact" style="background-color: #23779C;">
    <div class="container py-5">
        <div class="row">
            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Horozia</h2>
                <p class="text-white-50">
                    Horozia est une plateforme dédiée à la gestion des voyages et des réservations,
                    offrant une expérience élégante et moderne aux voyageurs.
                </p>
            </div>

            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Liens rapides</h2>
                <ul class="list-unstyled">
                    <li><a href="{{ path('app_front_home') }}" class="text-white-50">Accueil</a></li>
                    <li><a href="#voyages" class="text-white-50">Voyages</a></li>
                    <li><a href="#services" class="text-white-50">Services</a></li>
                    <li><a href="#contact" class="text-white-50">Contact</a></li>
                </ul>
            </div>

            <div class="col-md-4 mb-4">
                <h2 class="ftco-heading-2 text-white">Contact</h2>
                <p class="text-white-50 mb-1">Tunisie</p>
                <p class="text-white-50 mb-1">contact@horozia.com</p>
                <p class="text-white-50">+216 00 000 000</p>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-12 text-center">
                <p class="text-white-50 mb-0">
                    © {{ "now"|date("Y") }} Horozia. Tous droits réservés.
                </p>
            </div>
        </div>
    </div>
</footer>

{% endblock %}