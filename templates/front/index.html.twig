{% extends 'base_front.html.twig' %}

{% block title %}Accueil - Horozia{% endblock %}

{% block body %}



<section class="hero-wrap js-fullheight" style="background-image: url('{{ asset('front/pacific/images/bg_5.jpg') }}');">
    <div class="overlay"></div>

    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-center">
            <div class="col-md-8 ftco-animate">
                <span class="subheading">Bienvenue chez Horozia</span>
                <h1 class="mb-4">Découvrez votre prochaine destination</h1>
                <p class="mb-4">
                    Horozia vous propose des voyages soigneusement sélectionnés, une réservation simple
                    et une expérience moderne pour explorer le monde avec élégance.
                </p>
                <p>
                    <a href="#voyages" class="btn btn-primary py-3 px-4">Explorer les voyages</a>
                </p>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section" id="voyages">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Top destinations</span>
                <h2 class="mb-4">Top 3 voyages les plus réservés</h2>
            </div>
        </div>

        <div class="row">
            {% if voyages is not empty %}
                {% for voyage in voyages %}
                    {% set imagePath = voyage.imageUrl ?: 'front/pacific/images/destination-1.jpg' %}
                    {% set weather = weatherData[voyage.id] ?? null %}
                    {% set converted = convertedPrices[voyage.id] ?? null %}

                    <div class="col-md-4 ftco-animate mb-4">
                        <div class="project-wrap h-100 top-voyage-card">

                            <div class="top-badge
                                {% if loop.index == 1 %}
                                    badge-gold
                                {% elseif loop.index == 2 %}
                                    badge-silver
                                {% else %}
                                    badge-bronze
                                {% endif %}
                            ">
                            </div>

                            <div class="front-image-box">
                                <a href="{{ path('app_front_voyage_detail', {'id': voyage.id, 'currency': currency}) }}"
                                   class="img"
                                   style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}');">
                                </a>

                                <button
                                    type="button"
                                    class="favori-btn js-favori-toggle"
                                    data-voyage-id="{{ voyage.id }}"
                                    title="Ajouter aux favoris"
                                >
                                    <i class="fa fa-heart-o"></i>
                                </button>

                                {% if weather %}
                                    <div class="floating-weather-pill-front">
                                        <img src="https://openweathermap.org/img/wn/{{ weather.icon }}.png" alt="Météo">
                                        <span>{{ weather.temperature|round }}°C</span>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="text p-4">
                                {% if currency == 'TND' %}
                                    <span class="price">
                                        {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne
                                    </span>
                                {% elseif converted is not null %}
                                    <span class="price">
                                        {{ converted|number_format(2, ',', ' ') }} {{ currencySymbol }} / personne
                                    </span>
                                    <div class="converted-price-front">
                                        Prix de base : {{ voyage.prix|number_format(0, ',', ' ') }} DT
                                    </div>
                                {% else %}
                                    <span class="price">
                                        {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne
                                    </span>
                                {% endif %}

                                <span class="days">
                                    {{ voyage.dateDepart|date('d M') }} → {{ voyage.dateRetour|date('d M Y') }}
                                </span>

                                <h3>
                                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id, 'currency': currency}) }}">{{ voyage.titre }}</a>
                                </h3>

                                <p class="location">
                                    <span class="fa fa-map-marker"></span>
                                    {{ voyage.destination }}
                                </p>
                            </div>

                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="col-12 text-center">
                    <p>Aucun voyage disponible pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </div>
</section>

<section class="ftco-section soft-section" id="services">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Pourquoi choisir Horozia</span>
                <h2 class="mb-4">Une plateforme pensée pour vos voyages</h2>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-globe text-primary"></span>
                    </div>
                    <h3 class="mb-3">Destinations variées</h3>
                    <p>
                        Découvrez des voyages soigneusement sélectionnés : détente, urbain, aventure et évasion.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-calendar-check-o text-primary"></span>
                    </div>
                    <h3 class="mb-3">Réservation simple</h3>
                    <p>
                        Réservez votre voyage rapidement grâce à une interface claire, moderne et intuitive.
                    </p>
                </div>
            </div>

            <div class="col-md-4 ftco-animate mb-4">
                <div class="services-2 text-center p-4 bg-white h-100 rounded shadow-sm">
                    <div class="icon mb-3">
                        <span class="fa fa-star text-primary"></span>
                    </div>
                    <h3 class="mb-3">Expérience premium</h3>
                    <p>
                        Horozia met l’accent sur le confort, le design et la qualité de l’expérience utilisateur.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center pb-4">
            <div class="col-md-8 heading-section text-center ftco-animate">
                <span class="subheading">Commencez votre aventure</span>
                <h2 class="mb-4">Réservez votre prochain voyage avec Horozia</h2>
                <p>
                    Explorez nos offres et trouvez la destination qui vous ressemble.
                </p>
                <a href="{{ path('app_front_voyages', {currency: currency}) }}" class="btn btn-primary py-3 px-4 mt-3">Voir tous les voyages</a>
            </div>
        </div>
    </div>
</section>

<div id="chatbot-widget" class="chatbot-closed">
    <button type="button" id="chatbot-launcher" aria-label="Ouvrir le chatbot">
        <i class="fa fa-comments"></i>
    </button>

    <div id="chatbot-window">
        <div id="chatbot-header">
            <div class="chatbot-title">
                <i class="fa fa-comments"></i>
                <span>Assistant Horozia</span>
            </div>
            <button type="button" id="chatbot-close" aria-label="Fermer le chatbot">×</button>
        </div>

        <div id="chatbot-body">
            <div id="chatbot-messages">
                <div class="bot-message">
                    Bonjour 👋 Je suis l’assistant Horozia. Je peux vous aider à trouver des voyages disponibles, recommander des destinations et proposer des voyages selon votre budget.
                </div>
            </div>

            <div id="chatbot-suggestions">
                <button type="button" class="chatbot-suggestion">Voyages disponibles</button>
                <button type="button" class="chatbot-suggestion">Petit budget</button>
                <button type="button" class="chatbot-suggestion">Recommande-moi un voyage</button>
            </div>

            <div id="chatbot-input-area">
                <input type="text" id="chatbot-input" placeholder="Écrivez votre message..." autocomplete="off">
                <button type="button" id="chatbot-send" aria-label="Envoyer">
                    <i class="fa fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
</div>

