<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const widget = document.getElementById('chatbot-widget');
    const launcher = document.getElementById('chatbot-launcher');
    const closeBtn = document.getElementById('chatbot-close');
    const sendBtn = document.getElementById('chatbot-send');
    const input = document.getElementById('chatbot-input');
    const messages = document.getElementById('chatbot-messages');
    const suggestionButtons = document.querySelectorAll('.chatbot-suggestion');
    const favoriButtons = document.querySelectorAll('.js-favori-toggle');

    function openChatbot() {
        if (!widget) return;
        widget.classList.remove('chatbot-closed');
        widget.classList.add('chatbot-open');

        setTimeout(() => {
            if (input) input.focus();
        }, 100);
    }

    function closeChatbot() {
        if (!widget) return;
        widget.classList.remove('chatbot-open');
        widget.classList.add('chatbot-closed');
    }

    function addMessage(text, type) {
        if (!messages) return;

        const div = document.createElement('div');
        div.className = type === 'user' ? 'user-message' : 'bot-message';

        if (type === 'bot') {
            div.innerHTML = String(text);
        } else {
            div.textContent = String(text);
        }

        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
    }

    function addTyping() {
        removeTyping();

        const typing = document.createElement('div');
        typing.className = 'chatbot-typing';
        typing.id = 'chatbot-typing';
        typing.innerHTML = '<span></span><span></span><span></span>';
        messages.appendChild(typing);
        messages.scrollTop = messages.scrollHeight;
    }

    function removeTyping() {
        const typing = document.getElementById('chatbot-typing');
        if (typing) typing.remove();
    }

    async function sendMessage(customMessage = null) {
    if (!input) return;

    const message = customMessage !== null ? customMessage : input.value.trim();
    if (!message) return;

    addMessage(message, 'user');
    input.value = '';
    addTyping();

    try {
        const response = await fetch('/chatbot/message', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ message: message })
        });

        const rawText = await response.text();
        removeTyping();

        let data = {};
        try {
            data = JSON.parse(rawText);
        } catch (e) {
            addMessage('Réponse serveur invalide.', 'bot');
            return;
        }

        if (!response.ok) {
            addMessage(data.reply || 'Erreur serveur.', 'bot');
            return;
        }

        if (data.reply_html) {
            addMessage(
                (data.reply ? `<div class="chatbot-response-intro">${data.reply}</div>` : '') + data.reply_html,
                'bot'
            );
        } else {
            addMessage(data.reply || 'Aucune réponse reçue.', 'bot');
        }
    } catch (error) {
        removeTyping();
        addMessage('Impossible de contacter le serveur.', 'bot');
    }
}

    async function checkFavoriState(button) {
        const voyageId = button.dataset.voyageId;

        try {
            const response = await fetch(`/api/favoris/check/${voyageId}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const rawText = await response.text();

            let data = {};
            try {
                data = JSON.parse(rawText);
            } catch (e) {
                console.error('Réponse check non JSON:', rawText);
                return;
            }

            if (data.success && data.isFavorite) {
                button.classList.add('is-favorite');
                button.innerHTML = '<i class="fa fa-heart"></i>';
                button.title = 'Retirer des favoris';
            } else {
                button.classList.remove('is-favorite');
                button.innerHTML = '<i class="fa fa-heart-o"></i>';
                button.title = 'Ajouter aux favoris';
            }
        } catch (error) {
            console.error('Erreur check favori', error);
        }
    }

    async function toggleFavori(button) {
        const voyageId = button.dataset.voyageId;

        try {
            const response = await fetch(`/api/favoris/toggle/${voyageId}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const rawText = await response.text();

            let data = {};
            try {
                data = JSON.parse(rawText);
            } catch (e) {
                console.error('Réponse toggle non JSON:', rawText);
                await Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: 'Le serveur a retourné une réponse invalide.',
                    confirmButtonColor: '#23779c'
                });
                return;
            }

            if (!response.ok || !data.success) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Erreur',
                    text: data.message || 'Impossible de mettre à jour les favoris.',
                    confirmButtonColor: '#23779c'
                });
                return;
            }

            if (data.isFavorite) {
                button.classList.add('is-favorite');
                button.innerHTML = '<i class="fa fa-heart"></i>';
                button.title = 'Retirer des favoris';

                await Swal.fire({
                    icon: 'success',
                    title: 'Ajouté',
                    text: 'Le voyage a été ajouté à vos favoris.',
                    timer: 1200,
                    showConfirmButton: false
                });
            } else {
                button.classList.remove('is-favorite');
                button.innerHTML = '<i class="fa fa-heart-o"></i>';
                button.title = 'Ajouter aux favoris';

                await Swal.fire({
                    icon: 'success',
                    title: 'Retiré',
                    text: 'Le voyage a été retiré de vos favoris.',
                    timer: 1200,
                    showConfirmButton: false
                });
            }
        } catch (error) {
            console.error('Erreur toggle favori', error);
            await Swal.fire({
                icon: 'error',
                title: 'Erreur',
                text: 'Impossible de mettre à jour les favoris.',
                confirmButtonColor: '#23779c'
            });
        }
    }

    if (launcher) {
        launcher.addEventListener('click', openChatbot);
    }

    if (closeBtn) {
        closeBtn.addEventListener('click', closeChatbot);
    }

    if (sendBtn) {
        sendBtn.addEventListener('click', function (e) {
            e.preventDefault();
            sendMessage();
        });
    }

    if (input) {
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                sendMessage();
            }
        });
    }

    suggestionButtons.forEach(button => {
        button.addEventListener('click', function () {
            openChatbot();
            sendMessage(this.textContent.trim());
        });
    });

    favoriButtons.forEach(button => {
        checkFavoriState(button);

        button.addEventListener('click', function () {
            toggleFavori(this);
        });
    });
});
</script>

{% endblock %}