{% extends 'base_front.html.twig' %}

{% block title %}Modifier le commentaire{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h2 class="h4 mb-0">Modifier le commentaire</h2>
                    </div>
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            {{ form_errors(form) }}
                            {{ form_row(form.auteur, {'attr': {'class': 'form-control'}}) }}
                            {{ form_row(form.contenu, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <a href="{{ path('front_publication_show', {'id': commentaire.publication.id}) }}" class="btn btn-secondary">Annuler</a>
                                <button type="submit" class="btn btn-primary">Enregistrer</button>
                            </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}