{% extends 'front/base_front.html.twig' %}

{% block title %}Commentaire - Horozia{% endblock %}

{% block hero %}{% endblock %}

{% block body %}
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h3 class="h5 mb-0">Détail du commentaire</h3>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <strong>Auteur :</strong> {{ commentaire.auteur ?? 'Anonyme' }}
                        </div>
                        <div class="mb-3">
                            <strong>Publication :</strong>
                            <a href="{{ path('front_publication_show', {'id': commentaire.publication.id}) }}">
                                {{ commentaire.publication.titre }}
                            </a>
                        </div>
                        <div class="mb-3">
                            <strong>Date :</strong> {{ commentaire.dateCreation|date('d/m/Y H:i') }}
                        </div>
                        <div class="mb-3">
                            <strong>Contenu :</strong>
                            <p class="mt-2">{{ commentaire.contenu|nl2br }}</p>
                        </div>
                        {% if commentaire.modifie %}
                            <div class="mb-3 text-muted">
                                <small>(modifié)</small>
                            </div>
                        {% endif %}
                        <hr>
                        <div class="d-flex justify-content-end gap-2">
                            {% if app.user and (app.user.userIdentifier == commentaire.auteur or is_granted('ROLE_ADMIN')) %}
                                <a href="{{ path('front_commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-warning">
                                    <i class="fa fa-edit"></i> Modifier
                                </a>
                                <form method="post" action="{{ path('front_commentaire_delete', {'id': commentaire.id}) }}" style="display:inline-block">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
                                    <button class="btn btn-danger" onclick="return confirm('Supprimer ce commentaire ?')">
                                        <i class="fa fa-trash"></i> Supprimer
                                    </button>
                                </form>
                            {% endif %}
                            <a href="{{ path('front_publication_show', {'id': commentaire.publication.id}) }}#comment-form" class="btn btn-secondary">
                                Retour à la publication
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}