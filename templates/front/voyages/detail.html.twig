{% extends 'base_front.html.twig' %}

{% block title %}{{ voyage.titre }} - Horozia{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Succès',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

{% for message in app.flashes('error') %}
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

{% set imagePath = voyage.imageUrl ?: 'front/pacific/images/destination-1.jpg' %}

<section class="hero-wrap hero-wrap-2"
         style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}'); min-height: 60vh;">
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-start" style="min-height: 60vh;">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="{{ path('app_front_home', {currency: currency}) }}">Accueil <i class="fa fa-chevron-right"></i></a>
                    </span>
                    <span>{{ voyage.titre }}</span>
                </p>
                <h1 class="mb-3 bread">{{ voyage.titre }}</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm">
                    {% if weather %}
                        <div class="premium-weather-card-front mb-4">
                            <div class="premium-weather-top-front">
                                <div class="premium-weather-left-front">
                                    <div class="premium-weather-icon-front">
                                        <img src="https://openweathermap.org/img/wn/{{ weather.icon }}@2x.png" alt="Icône météo">
                                    </div>

                                    <div>
                                        <div class="premium-weather-label-front">Météo actuelle</div>
                                        <div class="premium-weather-city-front">
                                            {{ weather.city }}{% if weather.country %}, {{ weather.country }}{% endif %}
                                        </div>
                                    </div>
                                </div>

                                <div class="premium-weather-temp-front">
                                    {{ weather.temperature|round }}°C
                                </div>
                            </div>

                            <div class="premium-weather-desc-front">
                                {{ weather.description|capitalize }}
                            </div>

                            <div class="premium-weather-stats-front">
                                <div class="premium-stat-card-front">
                                    <span class="stat-icon-front"><i class="fa fa-tint"></i></span>
                                    <div>
                                        <small>Humidité</small>
                                        <strong>{{ weather.humidity }}%</strong>
                                    </div>
                                </div>

                                <div class="premium-stat-card-front">
                                    <span class="stat-icon-front"><i class="fa fa-flag-o"></i></span>
                                    <div>
                                        <small>Vent</small>
                                        <strong>{{ weather.wind }} m/s</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="premium-weather-advice-front">
                                {{ weather.advice }}
                            </div>
                        </div>
                    {% endif %}

                    <h2 class="mb-4">{{ voyage.titre }}</h2>

                    <p class="mb-3">
                        <span class="fa fa-map-marker mr-2"></span>
                        <strong>Destination :</strong> {{ voyage.destination }}
                    </p>

                    <p class="mb-2">
                        <span class="fa fa-money mr-2"></span>
                        <strong>Prix :</strong> {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne
                    </p>

                    {% if currency != 'TND' and convertedPrice is not null %}
                        <p class="mb-3 converted-price-detail-front">
                            <strong>Prix converti :</strong> ≈ {{ convertedPrice|number_format(2, ',', ' ') }} {{ currencySymbol }} / personne
                        </p>
                    {% elseif currency != 'TND' %}
                        <p class="mb-3 converted-price-detail-front">
                            <strong>Prix converti :</strong> indisponible
                        </p>
                    {% endif %}
                    <h4 class="mb-3">Description</h4>
                    <p style="white-space: pre-line;">{{ voyage.description }}</p>

                    <div class="mt-4">
                        <a href="{{ path('app_front_voyages', {currency: currency}) }}" class="btn btn-outline-secondary mr-2">
                            Retour
                        </a>
                        <a href="{{ path('app_front_reserver_voyage', {'id': voyage.id}) }}" class="btn btn-primary">
                            Réserver
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="bg-white p-4 rounded shadow-sm">
                    <h4 class="mb-3">Résumé</h4>

                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><strong>Titre :</strong> {{ voyage.titre }}</li>
                        <li class="mb-3"><strong>Destination :</strong> {{ voyage.destination }}</li>
                        <li class="mb-3"><strong>Prix de base :</strong> {{ voyage.prix|number_format(0, ',', ' ') }} DT</li>

                        {% if currency != 'TND' and convertedPrice is not null %}
                            <li class="mb-3"><strong>Prix converti :</strong> {{ convertedPrice|number_format(2, ',', ' ') }} {{ currencySymbol }}</li>
                        {% endif %}

                        <li class="mb-3"><strong>Départ :</strong> {{ voyage.dateDepart|date('d/m/Y') }}</li>
                        <li class="mb-3"><strong>Retour :</strong> {{ voyage.dateRetour|date('d/m/Y') }}</li>
                        <li class="mb-3"><strong>Places restantes :</strong> {{ voyage.placesRestantes }}</li>
                        {% if voyage.categorie %}
                            <li class="mb-3"><strong>Catégorie :</strong> {{ voyage.categorie.nom }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
.currency-switcher-front {
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.currency-select-front {
    width: 140px;
    max-width: 100%;
}

.converted-price-detail-front {
    color: #23779c;
    font-weight: 700;
}

.premium-weather-card-front {
    background: linear-gradient(145deg, #f8fbff 0%, #eef5ff 100%);
    border: 1px solid #dbe9fb;
    border-radius: 24px;
    padding: 18px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
}

.premium-weather-top-front {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

.premium-weather-left-front {
    display: flex;
    align-items: center;
    gap: 12px;
}

.premium-weather-icon-front {
    width: 66px;
    height: 66px;
    border-radius: 20px;
    background: rgba(255,255,255,0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 20px rgba(46, 104, 173, 0.08);
}

.premium-weather-icon-front img {
    width: 54px;
    height: 54px;
}

.premium-weather-label-front {
    font-size: 0.9rem;
    font-weight: 700;
    color: #5f7691;
}

.premium-weather-city-front {
    font-size: 1.05rem;
    font-weight: 800;
    color: #173a60;
}

.premium-weather-temp-front {
    font-size: 2rem;
    font-weight: 900;
    color: #1c5c92;
    line-height: 1;
}

.premium-weather-desc-front {
    margin-top: 10px;
    color: #546c86;
    font-size: 1rem;
    font-weight: 600;
}

.premium-weather-stats-front {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 16px;
}

.premium-stat-card-front {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.88);
    border: 1px solid #e4eefb;
    border-radius: 18px;
    padding: 14px;
}

.premium-stat-card-front .stat-icon-front {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: #e8f1ff;
    color: #1f5e94;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
}

.premium-stat-card-front small {
    display: block;
    color: #6c8198;
    margin-bottom: 2px;
}

.premium-stat-card-front strong {
    color: #173a60;
    font-size: 1rem;
}

.premium-weather-advice-front {
    margin-top: 16px;
    padding: 14px 16px;
    background: rgba(225, 239, 255, 0.9);
    border-radius: 18px;
    color: #1f4f77;
    font-weight: 800;
    border-left: 4px solid #3b82f6;
}

@media (max-width: 768px) {
    .premium-weather-top-front {
        flex-direction: column;
        align-items: flex-start;
    }

    .premium-weather-stats-front {
        grid-template-columns: 1fr;
    }

    .premium-weather-temp-front {
        font-size: 1.6rem;
    }

    .currency-switcher-front {
        justify-content: flex-start;
    }
}
</style>

{% endblock %}