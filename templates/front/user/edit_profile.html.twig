{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Horozia{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card auth-card">
                <div class="card-header">
                    <i class="bi bi-pencil me-2"></i> Modifier mon profil
                </div>
                <div class="card-body p-4">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Téléphone</label>
                            <input type="tel" name="telephone" class="form-control" value="{{ user.telephone }}">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Adresse</label>
                            <textarea name="addresse" class="form-control" rows="3">{{ user.addresse }}</textarea>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-horozia-primary">
                                <i class="bi bi-save me-2"></i> Enregistrer
                            </button>
                            <a href="{{ path('app_profile') }}" class="btn btn-horozia-neutral">
                                <i class="bi bi-arrow-left me-2"></i> Retour
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}