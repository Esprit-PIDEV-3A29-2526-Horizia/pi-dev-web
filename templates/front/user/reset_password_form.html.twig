{% extends 'front/base_front.html.twig' %}

{% block title %}Nouveau mot de passe - Horozia{% endblock %}

{% block body %}
<style>
    /* Réutilise les styles du login si nécessaire */
    .login-section-custom {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{{ asset('assets/images/bg_5.jpg') }}');
        background-size: cover;
        background-position: center;
        padding: 2rem;
    }
    .login-card-custom {
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(15px);
        border-radius: 2rem;
        padding: 2rem;
        max-width: 460px;
        width: 100%;
    }
    .input-field-custom {
        width: 100%;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        margin-bottom: 1rem;
    }
    .login-btn-custom {
        width: 100%;
        background: linear-gradient(135deg, #ff6b35, #ff8c42);
        border: none;
        padding: 1rem;
        border-radius: 1rem;
        color: white;
        font-weight: bold;
        cursor: pointer;
    }
    .alert-custom-danger {
        background: rgba(254,226,226,0.95);
        color: #991b1b;
        padding: 0.75rem;
        border-radius: 1rem;
        margin-bottom: 1rem;
    }
</style>

<section class="login-section-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-card-custom">
                    <div class="card-body-custom">
                        <div class="login-header-custom text-center mb-4">
                            <div class="logo-circle mx-auto mb-3">
                                <i class="fas fa-lock fa-2x"></i>
                            </div>
                            <h3 class="text-white">Nouveau mot de passe</h3>
                            <p class="text-white-50">Choisissez un mot de passe sécurisé</p>
                        </div>

                        {% for message in app.flashes('error') %}
                            <div class="alert-custom-danger">{{ message }}</div>
                        {% endfor %}

                        <form method="post">
                            <div class="input-group-custom">
                                <label class="text-white">Nouveau mot de passe</label>
                                <input type="password" name="password" class="input-field-custom" required>
                            </div>
                            <div class="input-group-custom">
                                <label class="text-white">Confirmer</label>
                                <input type="password" name="confirm_password" class="input-field-custom" required>
                            </div>
                            <button type="submit" class="login-btn-custom">Modifier le mot de passe</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}