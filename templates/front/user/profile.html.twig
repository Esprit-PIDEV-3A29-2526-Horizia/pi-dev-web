{% extends 'front/base.html.twig' %}

{% block title %}Mon profil - Horozia{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card auth-card">
                <div class="card-body text-center p-4">
                    <div class="avatar-circle mb-3">
                        {{ user.prenom|first }}{{ user.nom|first }}
                    </div>
                    <h4>{{ user.nom }} {{ user.prenom }}</h4>
                    <p class="text-muted">
                        {% if user.profil %}
                            <span class="badge bg-horozia-primary">{{ user.profil.type }}</span>
                        {% endif %}
                    </p>
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-horozia-warning mt-2">
                        <i class="bi bi-pencil me-2"></i> Modifier mon profil
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <div class="card auth-card">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i> Mes informations
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 150px;">Nom complet :</th>
                            <td>{{ user.nom }} {{ user.prenom }}</td
                        </tr>
                        <tr>
                            <th>Email :</th>
                            <td>{{ user.email }}</td
                        </tr>
                        <tr>
                            <th>Téléphone :</th>
                            <td>{{ user.telephone ?: 'Non renseigné' }}</td
                        </tr>
                        <tr>
                            <th>Adresse :</th>
                            <td>{{ user.addresse ?: 'Non renseignée' }}</td
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}