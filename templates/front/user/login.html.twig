{% extends 'base_front.html.twig' %}

{% block title %}Connexion - Horozia{% endblock %}

{% block body %}

<style>
    /* Suppression complète de la top-bar */
    .ftco_navbar {
        display: none !important;
    }
    
    /* Section principale avec l'image de fond */
    .login-section-custom {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), 
                    url('{{ asset('assets/images/bg_5.jpg') }}');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        padding: 2rem;
        margin: 0;
    }
    
    /* Carte de login avec fond transparent (glassmorphism) */
    .login-card-custom {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(15px);
        border-radius: 2rem;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.2);
        overflow: hidden;
        width: 100%;
        max-width: 460px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .login-card-custom:hover {
        transform: translateY(-8px);
        box-shadow: 0 40px 70px rgba(0, 0, 0, 0.4);
    }
    
    .card-body-custom {
        padding: 2.8rem 2.5rem;
    }
    
    /* Logo et en-tête */
    .login-header-custom {
        text-align: center;
        margin-bottom: 2.2rem;
    }
    
    .logo-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, rgba(255, 107, 53, 0.9), rgba(255, 140, 66, 0.9));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem auto;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
    }
    
    .logo-circle i {
        font-size: 2.5rem;
        color: white;
        text-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }
    
    .login-header-custom h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.5rem;
        letter-spacing: -0.5px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    
    .login-header-custom p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        margin-bottom: 0;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
    
    /* Groupes de champs */
    .input-group-custom {
        margin-bottom: 1.5rem;
        position: relative;
    }
    
    .input-group-custom label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: #ffffff;
        font-size: 0.85rem;
        letter-spacing: 0.3px;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    
    .input-group-custom label i {
        margin-right: 8px;
        color: #ff8c42;
        font-size: 0.9rem;
    }
    
    .input-field-custom {
        width: 100%;
        padding: 1rem 1rem;
        font-size: 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.15);
        transition: all 0.2s;
        outline: none;
        color: #ffffff;
        font-weight: 500;
    }
    
    .input-field-custom::placeholder {
        color: rgba(255, 255, 255, 0.6);
        font-weight: 400;
    }
    
    .input-field-custom:focus {
        border-color: #ff8c42;
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 0 0 4px rgba(255, 140, 66, 0.2);
    }
    
    /* Options du formulaire */
    .form-options-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        font-size: 0.85rem;
        flex-wrap: wrap;
        gap: 10px;
    }
    
    .checkbox-label-custom {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        transition: color 0.2s;
    }
    
    .checkbox-label-custom:hover {
        color: #ff8c42;
    }
    
    .checkbox-label-custom input {
        width: 18px;
        height: 18px;
        accent-color: #ff8c42;
        cursor: pointer;
    }
    
    .forgot-link-custom {
        color: #ff8c42;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
        font-size: 0.85rem;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    }
    
    .forgot-link-custom:hover {
        color: #ffaa66;
        text-decoration: underline;
    }
    
    /* Bouton de connexion */
    .login-btn-custom {
        width: 100%;
        background: linear-gradient(135deg, #ff6b35, #ff8c42);
        border: none;
        padding: 1rem;
        border-radius: 1rem;
        font-weight: 700;
        font-size: 1rem;
        color: white;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 1.5rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    .login-btn-custom:hover {
        background: linear-gradient(135deg, #e55a2b, #ff7a2f);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255, 107, 53, 0.4);
    }
    
    .login-btn-custom:active {
        transform: translateY(0);
    }
    
    /* Séparateur élégant */
    .separator-custom {
        display: flex;
        align-items: center;
        text-align: center;
        color: rgba(255, 255, 255, 0.7);
        font-size: 0.75rem;
        margin: 1.5rem 0;
    }
    
    .separator-custom::before,
    .separator-custom::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    }
    
    .separator-custom span {
        margin: 0 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    /* Boutons sociaux */
    .social-login-custom {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    
    .social-btn-custom {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 0.8rem;
        border-radius: 1rem;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        cursor: pointer;
    }
    
    .social-btn-custom i {
        font-size: 1.2rem;
    }
    
    .social-btn-custom:hover {
        background: rgba(255, 255, 255, 0.25);
        transform: translateY(-2px);
        border-color: #ff8c42;
        color: #ff8c42;
    }
    
    /* Lien d'inscription */
    .signup-link-custom {
        text-align: center;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.85);
        margin-top: 1rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .signup-link-custom a {
        color: #ff8c42;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s;
    }
    
    .signup-link-custom a:hover {
        color: #ffaa66;
        text-decoration: underline;
    }
    
    /* Alertes */
    .alert-custom {
        border-radius: 1rem;
        border: none;
        padding: 1rem 1.2rem;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        font-weight: 500;
    }
    
    .alert-custom-danger {
        background: rgba(254, 226, 226, 0.95);
        color: #991b1b;
        border-left: 4px solid #ef4444;
    }
    
    .alert-custom-info {
        background: rgba(219, 234, 254, 0.95);
        color: #1e40af;
        border-left: 4px solid #3b82f6;
    }
    
    /* Animation d'apparition */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .login-card-custom {
        animation: fadeInUp 0.6s ease-out;
    }
    
    /* Responsive */
    @media (max-width: 576px) {
        .card-body-custom {
            padding: 2rem 1.5rem;
        }
        
        .login-header-custom h3 {
            font-size: 1.6rem;
        }
        
        .logo-circle {
            width: 65px;
            height: 65px;
        }
        
        .logo-circle i {
            font-size: 2rem;
        }
        
        .social-btn-custom span {
            display: none;
        }
        
        .social-btn-custom i {
            font-size: 1.3rem;
        }
        
        .social-btn-custom {
            justify-content: center;
            padding: 0.8rem;
        }
        
        .login-btn-custom {
            font-size: 0.9rem;
        }
    }
</style>

<section class="login-section-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-card-custom">
                    <div class="card-body-custom">
                        <!-- Logo et en-tête -->
                        <div class="login-header-custom">
                            <div class="logo-circle">
                                <i class="fas fa-plane-departure"></i>
                            </div>
                            <h3>Bienvenue</h3>
                            <p>Connectez-vous pour continuer l'aventure</p>
                        </div>

                        {% if error %}
                            <div class="alert-custom alert-custom-danger">
                                <i class="fas fa-exclamation-circle"></i> Email ou mot de passe incorrect.
                            </div>
                        {% endif %}

                        {% if app.user %}
                            <div class="alert-custom alert-custom-info">
                                <i class="fas fa-info-circle"></i> Vous êtes connecté en tant que {{ app.user.userIdentifier }}.
                                <a href="{{ path('app_logout') }}" style="color: #2563eb; font-weight: 600;">Déconnexion</a>
                            </div>
                        {% endif %}

                        <form method="post">
                            <div class="input-group-custom">
                                <label for="username"><i class="fas fa-envelope"></i> Adresse email</label>
                                <input type="email"
                                       value="{{ last_username }}"
                                       name="_username"
                                       id="username"
                                       class="input-field-custom"
                                       placeholder="exemple@email.com"
                                       required
                                       autofocus>
                            </div>

                            <div class="input-group-custom">
                                <label for="password"><i class="fas fa-lock"></i> Mot de passe</label>
                                <input type="password"
                                       name="_password"
                                       id="password"
                                       class="input-field-custom"
                                       placeholder="Entrez votre mot de passe"
                                       required>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-options-custom">
                                <label class="checkbox-label-custom">
                                    <input type="checkbox" name="_remember_me"> Se souvenir de moi
                                </label>
                                <a href="{{ path('app_forgot_password') }}" class="forgot-link-custom">Mot de passe oublié ?</a>
                            </div>

                            <button class="login-btn-custom" type="submit">
                                Se connecter <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>

                        <div class="separator-custom">
                            <span>Ou</span>
                        </div>

                        <div class="social-login-custom">
                            <a href="{{ path('connect_google_start') }}" class="social-btn-custom">
                                <i class="fab fa-google"></i> <span>Google</span>
                            </a>
                            <a href="#" class="social-btn-custom">
                                <i class="fab fa-facebook-f"></i> <span>Facebook</span>
                            </a>
                        </div>

                        <div class="signup-link-custom">
                            Nouveau voyageur ? <a href="{{ path('app_register') }}">Créer un compte</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Inclusion de Font Awesome -->
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
{% endblock %}

{% endblock %}