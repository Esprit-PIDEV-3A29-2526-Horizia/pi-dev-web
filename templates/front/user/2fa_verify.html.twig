{% extends 'base_front.html.twig' %}

{% block title %}Vérification biométrique - Horozia{% endblock %}

{% block body %}
<style>
    .login-section-custom {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), 
                    url('{{ asset('assets/images/bg_5.jpg') }}');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        padding: 2rem;
    }
    .login-card-custom {
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(15px);
        border-radius: 2rem;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.2);
        width: 100%;
        max-width: 460px;
        transition: transform 0.3s ease;
    }
    .card-body-custom {
        padding: 2.8rem 2.5rem;
    }
    .login-header-custom {
        text-align: center;
        margin-bottom: 2.2rem;
    }
    .logo-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, rgba(255, 107, 53, 0.9), rgba(255, 140, 66, 0.9));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem auto;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        border: 2px solid rgba(255, 255, 255, 0.3);
    }
    .logo-circle i {
        font-size: 2.5rem;
        color: white;
    }
    .login-header-custom h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    }
    .login-header-custom p {
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
    }
    video {
        width: 100%;
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: rgba(0,0,0,0.2);
        margin-bottom: 1rem;
    }
    .btn-verify {
        width: 100%;
        background: linear-gradient(135deg, #ff6b35, #ff8c42);
        border: none;
        padding: 1rem;
        border-radius: 1rem;
        font-weight: 700;
        font-size: 1rem;
        color: white;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    .btn-verify:hover {
        background: linear-gradient(135deg, #e55a2b, #ff7a2f);
        transform: translateY(-2px);
    }
    .alert-custom {
        border-radius: 1rem;
        padding: 1rem;
        margin-top: 1rem;
        font-size: 0.85rem;
    }
    .alert-success {
        background: rgba(209, 250, 229, 0.95);
        color: #065f46;
        border-left: 4px solid #10b981;
    }
    .alert-danger {
        background: rgba(254, 226, 226, 0.95);
        color: #991b1b;
        border-left: 4px solid #ef4444;
    }
</style>

<section class="login-section-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-card-custom">
                    <div class="card-body-custom">
                        <div class="login-header-custom">
                            <div class="logo-circle">
                                <i class="fas fa-fingerprint"></i>
                            </div>
                            <h3>Vérification biométrique</h3>
                            <p>Placez-vous devant la caméra</p>
                        </div>

                        <video id="webcam" autoplay playsinline></video>
                        <canvas id="canvas" style="display:none;"></canvas>
                        <button id="verifyBtn" class="btn-verify">Vérifier mon visage</button>
                        <div id="result" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const video = document.getElementById('webcam');
    const canvas = document.getElementById('canvas');
    const verifyBtn = document.getElementById('verifyBtn');

    navigator.mediaDevices.getUserMedia({ video: true })
        .then(stream => video.srcObject = stream)
        .catch(err => {
            console.error(err);
            document.getElementById('result').innerHTML = '<div class="alert-custom alert-danger">Impossible d\'accéder à la webcam.</div>';
        });

    verifyBtn.addEventListener('click', async () => {
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        canvas.getContext('2d').drawImage(video, 0, 0);
        const imageData = canvas.toDataURL('image/jpeg').split(',')[1];

        const response = await fetch('{{ path('app_2fa_verify_check') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'image=' + encodeURIComponent(imageData)
        });
        const result = await response.json();
        const resultDiv = document.getElementById('result');
        if (result.success) {
            resultDiv.innerHTML = '<div class="alert-custom alert-success">Visage reconnu ! Redirection...</div>';
            window.location.href = '{{ path('app_admin') }}';
        } else {
            resultDiv.innerHTML = '<div class="alert-custom alert-danger">' + (result.message || 'Échec de la vérification') + '</div>';
        }
    });
</script>
{% endblock %}