{% extends 'front/base_front.html.twig' %}

{% block title %}Mes réservations - Horozia{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Succès',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

{% for message in app.flashes('error') %}
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand navbar-logo" href="{{ path('app_front_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Horozia Logo">
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>

        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item"><a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a></li>
                <li class="nav-item"><a href="{{ path('app_front_voyages') }}" class="nav-link">Voyages</a></li>
                <li class="nav-item active"><a href="{{ path('app_front_mes_reservations') }}" class="nav-link">Mes réservations</a></li>
                <li class="nav-item"><a href="{{ path('app_front_mes_favoris') }}" class="nav-link">Mes favoris</a></li>
                <li class="nav-item"><a href="#services" class="nav-link">Services</a></li>
                <li class="nav-item"><a href="#contact" class="nav-link">Contact</a></li>
            </ul>
        </div>
    </div>
</nav>

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('front/pacific/images/image_2.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="{{ path('app_front_home') }}">Accueil <i class="fa fa-chevron-right"></i></a>
                    </span>
                    <span>Mes réservations <i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Mes réservations</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section reservation-page">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-md-8 text-center heading-section">
                <span class="subheading">Horozia</span>
                <h2>Mes réservations</h2>
                {% if totalReservations is defined %}
                    <p class="text-muted">{{ totalReservations }} réservations</p>
                {% endif %}
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-6">
                <form method="get" action="{{ path('app_front_mes_reservations') }}" class="bg-white rounded shadow-sm p-3">
                    <div class="form-row align-items-end">
                        <div class="col-md-8">
                            <label for="statut" class="font-weight-bold">Filtrer par statut</label>
                            <select name="statut" id="statut" class="form-control">
                                <option value="">Tous les statuts</option>
                                <option value="EN_ATTENTE" {{ selectedStatut == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                                <option value="CONFIRMEE" {{ selectedStatut == 'CONFIRMEE' ? 'selected' : '' }}>Confirmée</option>
                                <option value="ANNULEE" {{ selectedStatut == 'ANNULEE' ? 'selected' : '' }}>Annulée</option>
                            </select>
                        </div>

                        <div class="col-md-4 mt-3 mt-md-0">
                            <button type="submit" class="btn btn-primary btn-block">
                                Filtrer
                            </button>
                        </div>
                    </div>

                    {% if selectedStatut is not empty %}
                        <div class="mt-3 text-right">
                            <a href="{{ path('app_front_mes_reservations') }}" class="btn btn-sm btn-light">
                                Réinitialiser
                            </a>
                        </div>
                    {% endif %}
                </form>
            </div>
        </div>

        {% if reservations is not empty %}
            <div class="row">
                {% for reservation in reservations %}
                    {% set statut = reservation.statut|upper %}
                    {% set voyage = reservation.voyage ?? null %}

                    <div class="col-md-6 col-xl-4 mb-4">
                        <div class="front-reservation-card h-100">
                            <div class="front-reservation-card-header">
                                <div>
                                    <h5 class="mb-1">
                                        {{ voyage ? voyage.titre : 'Voyage introuvable' }}
                                    </h5>
                                </div>

                                <span class="status-badge
                                    {% if statut == 'CONFIRMEE' %}
                                        status-confirmed
                                    {% elseif statut == 'ANNULEE' %}
                                        status-cancelled
                                    {% else %}
                                        status-pending
                                    {% endif %}
                                ">
                                    {% if statut == 'CONFIRMEE' %}
                                        <i class="fa fa-check-circle"></i> Confirmée
                                    {% elseif statut == 'ANNULEE' %}
                                        <i class="fa fa-times-circle"></i> Annulée
                                    {% else %}
                                        <i class="fa fa-clock-o"></i> En attente
                                    {% endif %}
                                </span>
                            </div>

                            <div class="front-reservation-card-body">
                                <p><strong>📍 Destination :</strong> {{ voyage ? voyage.destination : 'Indisponible' }}</p>
                                <p><strong>📅 Date réservation :</strong> {{ reservation.dateReservation|date('d/m/Y H:i') }}</p>
                                <p><strong>👨 Adultes :</strong> {{ reservation.nbAdultes ?? 0 }}</p>
                                <p><strong>🧒 Enfants :</strong> {{ reservation.nbEnfants ?? 0 }}</p>
                                {% if reservation.prixTotal is defined and reservation.prixTotal is not null %}
                                    <p class="front-price">
                                        <strong>Prix total :</strong> {{ reservation.prixTotal|number_format(2, '.', ' ') }} DT
                                    </p>
                                {% endif %}
                            </div>

                            <div class="front-reservation-card-footer">
                                {% if voyage %}
                                    <a href="{{ path('app_front_voyage_detail', {'id': voyage.id}) }}"
                                       class="btn front-btn-detail">
                                        Voir le voyage
                                    </a>
                                {% else %}
                                    <button class="btn front-btn-disabled" disabled>
                                        Voyage supprimé
                                    </button>
                                {% endif %}

                                {% if statut == 'EN_ATTENTE' %}
                                    <form method="post"
                                          action="{{ path('app_front_annuler_reservation', {'id': reservation.id}) }}"
                                          class="cancel-reservation-form d-inline-block">
                                        <input type="hidden" name="_token" value="{{ csrf_token('annuler_reservation_' ~ reservation.id) }}">
                                        <button type="submit" class="btn front-btn-cancel">
                                            Annuler
                                        </button>
                                    </form>
                                {% elseif statut == 'CONFIRMEE' %}
                                    <button class="btn front-btn-confirmed" disabled>
                                        Confirmée
                                    </button>
                                {% else %}
                                    <button class="btn front-btn-disabled" disabled>
                                        Annulée
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if totalPages is defined and totalPages > 1 %}
                <div class="row mt-5">
                    <div class="col-12">
                        <nav aria-label="Pagination des réservations">
                            <ul class="custom-pagination">

                                <li class="{{ currentPage == 1 ? 'disabled' : '' }}">
                                    <a href="{{ currentPage == 1
                                        ? '#'
                                        : path('app_front_mes_reservations', {
                                            page: currentPage - 1,
                                            statut: selectedStatut
                                        })
                                    }}">
                                        &lsaquo;
                                    </a>
                                </li>

                                {% for p in 1..totalPages %}
                                    <li class="{{ p == currentPage ? 'active' : '' }}">
                                        <a href="{{ path('app_front_mes_reservations', {
                                            page: p,
                                            statut: selectedStatut
                                        }) }}">
                                            {{ p }}
                                        </a>
                                    </li>
                                {% endfor %}

                                <li class="{{ currentPage == totalPages ? 'disabled' : '' }}">
                                    <a href="{{ currentPage == totalPages
                                        ? '#'
                                        : path('app_front_mes_reservations', {
                                            page: currentPage + 1,
                                            statut: selectedStatut
                                        })
                                    }}">
                                        &rsaquo;
                                    </a>
                                </li>

                            </ul>
                        </nav>
                    </div>
                </div>
            {% endif %}

        {% else %}
            <div class="bg-white rounded shadow-sm p-5 text-center">
                <h4 class="mb-3">Aucune réservation trouvée</h4>
                <p class="mb-4">Il n’y a pas encore de réservation correspondant à ce filtre.</p>
                <a href="{{ path('app_front_voyages') }}" class="btn btn-primary">
                    Découvrir les voyages
                </a>
            </div>
        {% endif %}
    </div>
</section>

<style>
.front-reservation-card {
    background: #ffffff;
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
    transition: 0.3s ease;
    border: 1px solid #eef1f5;
    display: flex;
    flex-direction: column;
}

.front-reservation-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);
}

.front-reservation-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 18px;
}

.front-reservation-card-header h5 {
    font-weight: 700;
    color: #1f2d3d;
    margin: 0;
}

.front-reservation-card-body {
    flex-grow: 1;
}

.front-reservation-card-body p {
    margin-bottom: 10px;
    color: #4b5563;
}

.front-price {
    font-size: 1.05rem;
    color: #f15d30 !important;
    font-weight: 700;
}

.front-reservation-card-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.status-confirmed {
    background: rgba(40, 167, 69, 0.14);
    color: #1f7a36;
}

.status-cancelled {
    background: rgba(220, 53, 69, 0.14);
    color: #b42318;
}

.status-pending {
    background: rgba(255, 193, 7, 0.18);
    color: #8a6d00;
}

.front-btn-detail,
.front-btn-cancel,
.front-btn-confirmed,
.front-btn-disabled {
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
    text-decoration: none !important;
    border: none;
}

.front-btn-detail {
    background: #f15d30;
    color: #fff !important;
}

.front-btn-detail:hover {
    background: #d94f26;
    color: #fff !important;
}

.front-btn-cancel {
    background: #dc3545;
    color: #fff;
}

.front-btn-cancel:hover {
    background: #bb2d3b;
    color: #fff;
}

.front-btn-confirmed {
    background: #6c757d;
    color: #fff;
    cursor: default;
}

.front-btn-disabled {
    background: #e9ecef;
    color: #6c757d;
    cursor: default;
}

.custom-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
}

.custom-pagination li {
    margin: 0;
}

.custom-pagination li a {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid #e5e5e5;
    background: #fff;
    color: #111;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 22px;
    font-weight: 500;
    transition: all 0.25s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.custom-pagination li a:hover {
    background: #f8f8f8;
    transform: translateY(-2px);
    color: #111;
    text-decoration: none;
}

.custom-pagination li.active a {
    background: #2f2e3d;
    color: #fff;
    border-color: #2f2e3d;
    box-shadow: 0 6px 16px rgba(47, 46, 61, 0.25);
}

.custom-pagination li.disabled a {
    pointer-events: none;
    opacity: 0.45;
    background: #fafafa;
}
</style>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const forms = document.querySelectorAll('.cancel-reservation-form');

            forms.forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    Swal.fire({
                        title: 'Annuler la réservation ?',
                        text: "Cette action annulera votre réservation.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Oui, annuler',
                        cancelButtonText: 'Non'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}