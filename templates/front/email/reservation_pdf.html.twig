<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Réservation</title>
    <style>
        body { font-family: DejaVu Sans, sans-serif; }
        .header { text-align: center; margin-bottom: 30px; }
        .details { width: 100%; border-collapse: collapse; }
        .details td { padding: 8px; border-bottom: 1px solid #ddd; }
        .label { font-weight: bold; width: 40%; background: #f5f5f5; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Horozia - Confirmation de réservation</h1>
        <p>Réservation </p>
    </div>
    <table class="details">
        <tr><td class="label">Logement</td><td>{{ reservation.logement.nom }}</td></tr>
        <tr><td class="label">Adresse</td><td>{{ reservation.logement.adresse }}</td></tr>
        <tr><td class="label">Arrivée</td><td>{{ reservation.dateDebut|date('d/m/Y') }}</td></tr>
        <tr><td class="label">Départ</td><td>{{ reservation.dateFin|date('d/m/Y') }}</td></tr>
        <tr><td class="label">Montant total</td><td>{{ reservation.montant|number_format(2, ',', ' ') }} DT</td></tr>
        <tr><td class="label">Modalité</td><td>{{ reservation.modalites }}</td></tr>
        <tr><td class="label">Statut</td><td>{{ reservation.status }}</td></tr>
    </table>
</body>
</html>