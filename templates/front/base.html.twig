<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="{{ asset('images/logo.png') }}">
    <title>{% block title %}Horozia{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        <style>
            :root {
                --color-primary: #23779C;
                --color-secondary: #3D94CA;
                --color-accent: #81AE8D;
                --color-warning: #E8B156;
                --color-neutral: #DACEB6;
                --color-dark: #103749;
                --color-sidebar: #1f2d3d;
                --color-light-bg: #f8f6f1;
                --color-white: #ffffff;
                --color-border: #e9edf3;
                --color-muted: #6c757d;
            }

            body {
                background-color: var(--color-light-bg);
                margin: 0;
                padding: 0;
            }

            .navbar-brand {
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .hero-section {
                background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
                color: white;
                padding: 80px 0;
                border-radius: 0 0 30px 30px;
                margin-bottom: 40px;
            }

            .card-hover:hover {
                transform: translateY(-4px);
                transition: 0.3s;
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
            }

            .bg-horozia-dark { background-color: var(--color-dark) !important; }
            .bg-horozia-primary { background-color: var(--color-primary) !important; }
            .bg-horozia-secondary { background-color: var(--color-secondary) !important; }
            .bg-horozia-accent { background-color: var(--color-accent) !important; }
            .bg-horozia-neutral { background-color: var(--color-neutral) !important; }

            .text-horozia-primary { color: var(--color-primary) !important; }
            .text-horozia-secondary { color: var(--color-secondary) !important; }
            .text-horozia-accent { color: var(--color-accent) !important; }

            .btn-horozia-primary,
            .btn-horozia-secondary,
            .btn-horozia-accent,
            .btn-horozia-warning,
            .btn-horozia-neutral {
                border-radius: 10px;
                font-weight: 600;
                transition: 0.2s ease;
            }

            .btn-horozia-primary {
                background-color: var(--color-primary);
                border-color: var(--color-primary);
                color: white;
            }

            .btn-horozia-primary:hover {
                background-color: #1d6482;
                border-color: #1d6482;
                color: white;
            }

            .btn-horozia-secondary {
                background-color: var(--color-secondary);
                border-color: var(--color-secondary);
                color: white;
            }

            .btn-horozia-secondary:hover {
                background-color: #337fad;
                border-color: #337fad;
                color: white;
            }

            .btn-horozia-accent {
                background-color: var(--color-accent);
                border-color: var(--color-accent);
                color: white;
            }

            .btn-horozia-accent:hover {
                background-color: #709b7b;
                border-color: #709b7b;
                color: white;
            }

            .btn-horozia-warning {
                background-color: var(--color-warning);
                border-color: var(--color-warning);
                color: white;
            }

            .btn-horozia-warning:hover {
                background-color: #d39d47;
                border-color: #d39d47;
                color: white;
            }

            .btn-horozia-neutral {
                background-color: var(--color-neutral);
                border-color: var(--color-neutral);
                color: #333;
            }

            .btn-horozia-neutral:hover {
                background-color: #cfc2a9;
                border-color: #cfc2a9;
                color: #333;
            }

            .card-horozia {
                border: none;
                box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
                border-radius: 14px;
                background-color: #fff;
            }

            .auth-card {
                border: none;
                border-radius: 20px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                overflow: hidden;
            }

            .auth-card .card-header {
                background: var(--color-primary);
                color: white;
                padding: 20px;
                text-align: center;
                font-size: 1.3rem;
                font-weight: bold;
                border: none;
            }

            .alert-horozia {
                border: none;
                border-radius: 14px;
                padding: 14px 18px;
                font-weight: 500;
                box-shadow: 0 8px 18px rgba(0, 0, 0, 0.06);
            }

            .alert-success.alert-horozia {
                background-color: rgba(129, 174, 141, 0.18);
                color: #2f5d3a;
            }

            .alert-danger.alert-horozia {
                background-color: rgba(220, 53, 69, 0.12);
                color: #842029;
            }

            .footer-horozia {
                background: var(--color-dark);
                color: white;
                padding: 40px 0 20px;
                margin-top: 50px;
            }

            .avatar-circle {
                width: 80px;
                height: 80px;
                background: var(--color-primary);
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                font-size: 32px;
                font-weight: bold;
                margin: 0 auto;
            }
        </style>
    {% endblock %}
</head>
<body>

    {% block navbar %}
        <nav class="navbar navbar-expand-lg navbar-dark bg-horozia-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo Horozia" width="60" height="60" style="object-fit: contain;">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Voyages</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Réservations</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex gap-2">
                        {% if app.user %}
                            <div class="dropdown">
                                <a class="btn btn-outline-light btn-sm dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> {{ app.user.prenom }}
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="{{ path('app_profile') }}">Mon profil</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a></li>
                                </ul>
                            </div>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">Connexion</a>
                            <a href="{{ path('app_register') }}" class="btn btn-horozia-secondary btn-sm">Inscription</a>
                        {% endif %}
<a href="/admin" class="btn btn-horozia-primary btn-sm">Espace Admin</a>                    </div>
                </div>
            </div>
        </nav>
    {% endblock %}

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="container mt-3">
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-horozia alert-dismissible fade show" role="alert">
                    <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill' }} me-2"></i>
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}

    {% block footer %}
        <footer class="footer-horozia">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h5><i class="bi bi-compass-fill me-2"></i>Horozia</h5>
                        <p class="text-white-50">Votre partenaire de voyage pour découvrir les plus belles destinations.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Liens utiles</h5>
                        <ul class="list-unstyled">
                            <li><a href="#" class="text-white-50 text-decoration-none">À propos</a></li>
                            <li><a href="#" class="text-white-50 text-decoration-none">Conditions générales</a></li>
                            <li><a href="#" class="text-white-50 text-decoration-none">Politique de confidentialité</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h5>Contact</h5>
                        <p class="text-white-50">
                            <i class="bi bi-envelope me-2"></i> contact@horozia.com<br>
                            <i class="bi bi-telephone me-2"></i> +216 XX XXX XXX
                        </p>
                    </div>
                </div>
                <hr class="bg-white-50">
                <div class="text-center text-white-50">
                    <small>&copy; 2025 Horozia - Tous droits réservés</small>
                </div>
            </div>
        </footer>
    {% endblock %}

    {% block javascripts %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    {% endblock %}
</body>
</html>