{% extends 'front/base_front.html.twig' %}

{% block title %}Paiement réussi{% endblock %}

{% block body %}
<section class="ftco-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div style="background:#ffffff;border-radius:18px;box-shadow:0 10px 30px rgba(0,0,0,0.08);padding:40px;text-align:center;">
                    <div style="width:80px;height:80px;border-radius:50%;background:#dcfce7;color:#16a34a;display:flex;align-items:center;justify-content:center;font-size:38px;font-weight:bold;margin:0 auto 20px auto;">
                        ✓
                    </div>

                    <h2 style="font-weight:800;color:#1f2937;margin-bottom:12px;">
                        Paiement effectué avec succès
                    </h2>

                    <p style="color:#6b7280;font-size:16px;margin-bottom:25px;">
                        Merci, votre paiement a bien été enregistré.
                    </p>

                    <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:14px;padding:22px;text-align:left;max-width:520px;margin:0 auto 25px auto;">
                        <p><strong>Réservation :</strong> #{{ reservation.id }}</p>
                        <p><strong>Voyage :</strong> {{ reservation.voyage.titre }}</p>
                        <p><strong>Destination :</strong> {{ reservation.voyage.destination }}</p>
                        <p><strong>Nombre de personnes :</strong> {{ reservation.nbrPersonnes }}</p>
                        <p><strong>Statut :</strong> {{ reservation.statut }}</p>
                    </div>

                    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                        <a href="{{ path('app_front_mes_reservations') }}" class="btn btn-primary">
                            Voir mes réservations
                        </a>

                        <a href="{{ path('app_front_home', {'currency': 'TND'}) }}" class="btn btn-outline-secondary">
                            Retour à l’accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}