{% extends 'front/base_front.html.twig' %}

{% block title %}{{ voyage.titre }} - Horozia{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Succès',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

{% for message in app.flashes('error') %}
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK'
        });
    </script>
{% endfor %}

<nav class="navbar navbar-expand-lg navbar-dark ftco_navbar ftco-navbar-light scrolled" id="ftco-navbar">
    <div class="container">
        <a class="navbar-brand navbar-logo" href="{{ path('app_front_home') }}">
            <img src="{{ asset('images/logo.png') }}" alt="Horozia Logo">
        </a>

        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="fa fa-bars"></span> Menu
        </button>

        <div class="collapse navbar-collapse" id="ftco-nav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a href="{{ path('app_front_home') }}" class="nav-link">Accueil</a>
                </li>
                <li class="nav-item active">
                    <a href="#" class="nav-link">Détail voyage</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

{% set imagePath = voyage.imageUrl ?: 'front/pacific/images/destination-1.jpg' %}

<section class="hero-wrap hero-wrap-2"
         style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}'); min-height: 60vh;">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text align-items-end justify-content-start" style="min-height: 60vh;">
            <div class="col-md-9 ftco-animate pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="{{ path('app_front_home') }}">Accueil <i class="fa fa-chevron-right"></i></a>
                    </span>
                    <span>{{ voyage.titre }}</span>
                </p>
                <h1 class="mb-3 bread">{{ voyage.titre }}</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="bg-white p-4 p-md-5 rounded shadow-sm">
                    <h2 class="mb-4">{{ voyage.titre }}</h2>

                    <p class="mb-3">
                        <span class="fa fa-map-marker mr-2"></span>
                        <strong>Destination :</strong> {{ voyage.destination }}
                    </p>

                    <p class="mb-3">
                        <span class="fa fa-money mr-2"></span>
                        <strong>Prix :</strong> {{ voyage.prix|number_format(0, ',', ' ') }} DT / personne
                    </p>

                    <p class="mb-3">
                        <span class="fa fa-calendar mr-2"></span>
                        <strong>Date de départ :</strong> {{ voyage.dateDepart|date('d/m/Y') }}
                    </p>

                    <p class="mb-3">
                        <span class="fa fa-calendar-check-o mr-2"></span>
                        <strong>Date de retour :</strong> {{ voyage.dateRetour|date('d/m/Y') }}
                    </p>

                    <p class="mb-4">
                        <span class="fa fa-users mr-2"></span>
                        <strong>Places restantes :</strong> {{ voyage.placesRestantes }}
                    </p>

                    {% if voyage.categorie %}
                        <p class="mb-4">
                            <span class="fa fa-tag mr-2"></span>
                            <strong>Catégorie :</strong>
                            {{ attribute(voyage.categorie, 'nom') is defined ? voyage.categorie.nom : 'Catégorie' }}
                        </p>
                    {% endif %}

                    <h4 class="mb-3">Description</h4>
                    <p style="white-space: pre-line;">{{ voyage.description }}</p>

                    <div class="mt-4">
                        <a href="{{ path('app_front_home') }}#voyages" class="btn btn-outline-secondary mr-2">
                            Retour
                        </a>
                        <a href="{{ path('app_front_reserver_voyage', {'id': voyage.id}) }}" class="btn btn-primary">
                            Réserver
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="bg-white p-4 rounded shadow-sm">
                    <h4 class="mb-3">Résumé</h4>

                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><strong>Titre :</strong> {{ voyage.titre }}</li>
                        <li class="mb-3"><strong>Destination :</strong> {{ voyage.destination }}</li>
                        <li class="mb-3"><strong>Prix :</strong> {{ voyage.prix|number_format(0, ',', ' ') }} DT</li>
                        <li class="mb-3"><strong>Départ :</strong> {{ voyage.dateDepart|date('d/m/Y') }}</li>
                        <li class="mb-3"><strong>Retour :</strong> {{ voyage.dateRetour|date('d/m/Y') }}</li>
                        <li class="mb-3"><strong>Places :</strong> {{ voyage.placesRestantes }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}