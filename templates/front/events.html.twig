{% extends 'base_front.html.twig' %}

{% block title %}Events - Pacific Travel Agency{% endblock %}

{% block body %}
<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg') }}');">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
       <p class="breadcrumbs"><span class="mr-2"><a href="{{ path('app_home') }}">Home <i class="fa fa-chevron-right"></i></a></span> <span>Events <i class="fa fa-chevron-right"></i></span></p>
       <h1 class="mb-0 bread">Our Events</h1>
     </div>
   </div>
 </div>
</section>

<section class="ftco-section ftco-no-pb">
 <div class="container">
  <div class="row">
   <div class="col-md-12">
    <div class="search-wrap-1 ftco-animate">
     <form method="get" action="{{ path('app_front_events') }}" class="search-property-1">
      <div class="row no-gutters">
       <div class="col-lg d-flex">
        <div class="form-group p-4 border-0">
         <label for="#">Search Event</label>
         <div class="form-field">
           <div class="icon"><span class="fa fa-search"></span></div>
           <input type="text" name="search" class="form-control" placeholder="Search by title, location or category" value="{{ search }}">
         </div>
       </div>
     </div>
     <div class="col-lg d-flex">
      <div class="form-group p-4">
       <label for="#">Price Limit</label>
       <div class="form-field">
         <div class="select-wrap">
          <div class="icon"><span class="fa fa-chevron-down"></span></div>
            <select name="price_limit" class="form-control">
                <option value="">All prices</option>
                <option value="50" {% if price_limit == 50 %}selected{% endif %}>$50 or less</option>
                <option value="100" {% if price_limit == 100 %}selected{% endif %}>$100 or less</option>
                <option value="200" {% if price_limit == 200 %}selected{% endif %}>$200 or less</option>
                <option value="500" {% if price_limit == 500 %}selected{% endif %}>$500 or less</option>
                <option value="1000" {% if price_limit == 1000 %}selected{% endif %}>$1000 or less</option>
            </select>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg d-flex">
    <div class="form-group d-flex w-100 border-0">
     <div class="form-field w-100 align-items-center d-flex">
      <input type="submit" value="Search" class="align-self-stretch form-control btn btn-primary">
    </div>
  </div>
  </div>
  </div>
</form>
</div>
</div>
</div>
</div>
</section>

<section class="ftco-section">
 <div class="container">
  <div class="row">
   {% for event in events %}
   <div class="col-md-4 ftco-animate">
    <div class="project-wrap hotel">
     <a href="{{ path('app_front_event_show', {'id': event.id_event}) }}" class="img" style="background-image: url({{ event.image_url ? asset(event.image_url) : asset('assets/images/hotel-resto-1.jpg') }});">
      <span class="price">${{ event.prix }}/person</span>
    </a>
    <div class="text p-4">
      <p class="star mb-2">
        {% set rating = 4 %}
        {% for i in 1..5 %}
          {% if i <= rating %}
            <span class="fa fa-star"></span>
          {% else %}
            <span class="fa fa-star-o"></span>
          {% endif %}
        {% endfor %}
      </p>
      <span class="days">{{ event.date_debut|date('d M Y') }} - {{ event.date_fin|date('d M Y') }}</span>
      <h3><a href="{{ path('app_front_event_show', {'id': event.id_event}) }}">{{ event.titre }}</a></h3>
      <p class="location"><span class="fa fa-map-marker"></span> {{ event.location }}</p>
      <ul>
       <li><span class="flaticon-users"></span> {{ event.capacite_max }} places</li>
       <li><span class="flaticon-ticket"></span> {{ event.places_restantes }} restantes</li>
       <li><span class="flaticon-price-tag"></span> {{ event.categorie }}</li>
     </ul>
   </div>
 </div>
</div>
   {% else %}
   <div class="col-md-12 text-center">
     <p>No events found.</p>
   </div>
   {% endfor %}
  </div>
 </div>
</section>

<section class="ftco-intro ftco-section ftco-no-pt">
 <div class="container">
  <div class="row justify-content-center">
   <div class="col-md-12 text-center">
    <div class="img" style="background-image: url({{ asset('assets/images/bg_2.jpg') }});">
     <div class="overlay"></div>
     <h2>Join Our Amazing Events</h2>
     <p>Discover unique experiences and create unforgettable memories with us</p>
     <p class="mb-0"><a href="{{ path('app_front_events') }}" class="btn btn-primary px-4 py-3">View All Events</a></p>
   </div>
 </div>
</div>
</div>
</section>
{% endblock %}