{% extends 'front/base_front.html.twig' %}

{% block title %}Vérification de sécurité - Horozia{% endblock %}

{% block body %}
<style>
    .login-section-custom {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
                    url('{{ asset('assets/images/bg_5.jpg') }}');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        padding: 2rem;
    }
    .login-card-custom {
        background: rgba(255,255,255,0.12);
        backdrop-filter: blur(15px);
        border-radius: 2rem;
        box-shadow: 0 30px 60px rgba(0,0,0,0.3);
        overflow: hidden;
        width: 100%;
        max-width: 460px;
    }
    .card-body-custom {
        padding: 2.8rem 2.5rem;
    }
    .login-header-custom {
        text-align: center;
        margin-bottom: 2rem;
    }
    .logo-circle {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, rgba(255,107,53,0.9), rgba(255,140,66,0.9));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.2rem;
    }
    .logo-circle i {
        font-size: 2.5rem;
        color: white;
    }
    .login-header-custom h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: white;
    }
    .login-header-custom p {
        color: rgba(255,255,255,0.85);
    }
    .alert-custom {
        border-radius: 1rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.85rem;
        font-weight: 500;
    }
    .alert-success {
        background: rgba(209,250,229,0.95);
        color: #065f46;
        border-left: 4px solid #10b981;
    }
    .alert-danger {
        background: rgba(254,226,226,0.95);
        color: #991b1b;
        border-left: 4px solid #ef4444;
    }
    .alert-warning {
        background: rgba(254,243,199,0.95);
        color: #92400e;
        border-left: 4px solid #f59e0b;
    }
    video {
        width: 100%;
        border-radius: 1rem;
        margin-bottom: 1rem;
    }
</style>

<section class="login-section-custom">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="login-card-custom">
                    <div class="card-body-custom">
                        <div class="login-header-custom">
                            <div class="logo-circle">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Vérification de sécurité</h3>
                            <p>Une tentative suspecte a été détectée</p>
                        </div>

                        <video id="webcam" autoplay playsinline></video>
                        <canvas id="canvas" style="display:none;"></canvas>
                        <div id="message" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const video = document.getElementById('webcam');
    const canvas = document.getElementById('canvas');
    const msgDiv = document.getElementById('message');

    navigator.mediaDevices.getUserMedia({ video: true })
        .then(stream => {
            video.srcObject = stream;
            setTimeout(() => {
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0);
                const imageData = canvas.toDataURL('image/jpeg').split(',')[1];
                fetch('/capture-face/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'image=' + encodeURIComponent(imageData)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        msgDiv.innerHTML = '<div class="alert-custom alert-success">Image envoyée. Redirection...</div>';
                        setTimeout(() => window.location.href = '/login', 2000);
                    } else {
                        msgDiv.innerHTML = '<div class="alert-custom alert-danger">Erreur, contactez l\'administrateur.</div>';
                    }
                })
                .catch(() => {
                    msgDiv.innerHTML = '<div class="alert-custom alert-danger">Erreur de communication.</div>';
                });
            }, 1000);
        })
        .catch(err => {
            console.error(err);
            msgDiv.innerHTML = '<div class="alert-custom alert-warning">Webcam inaccessible. Envoi sans photo.</div>';
            fetch('/capture-face/send', { method: 'POST', body: 'image=' })
                .then(() => setTimeout(() => window.location.href = '/login', 2000));
        });
</script>
{% endblock %}