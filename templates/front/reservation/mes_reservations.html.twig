{% extends 'base_front.html.twig' %}

{% block title %}Mes réservations - Horozia{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Succès',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK',
            confirmButtonColor: '#81AE8D'
        });
    </script>
{% endfor %}

{% for message in app.flashes('error') %}
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Erreur',
            text: "{{ message|e('js') }}",
            confirmButtonText: 'OK',
            confirmButtonColor: '#23779C'
        });
    </script>
{% endfor %}

<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('front/pacific/images/image_2.jpg') }}');">
    <div class="overlay"></div>
    <div class="container">
        <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
            <div class="col-md-9 ftco-animate pb-5 text-center">
                <p class="breadcrumbs">
                    <span class="mr-2">
                        <a href="{{ path('app_front_home', {'currency': currency|default('TND')}) }}">Accueil <i class="fa fa-chevron-right"></i></a>
                    </span>
                    <span>Mes réservations <i class="fa fa-chevron-right"></i></span>
                </p>
                <h1 class="mb-0 bread">Mes réservations</h1>
            </div>
        </div>
    </div>
</section>

<section class="ftco-section reservations-page">
    <div class="container">
        <div class="section-heading text-center mb-5">
            <span class="subheading">Horozia</span>
            <h2 class="mb-2">Mes réservations</h2>
            <p class="text-muted">
                {{ reservations.getTotalItemCount is defined ? reservations.getTotalItemCount : reservations|length }} réservations
            </p>
        </div>

        <div class="filter-box mb-5">
            <form method="get" action="{{ path('app_front_mes_reservations') }}" class="row align-items-end">
                <div class="col-md-8 mb-3 mb-md-0">
                    <label for="statut" class="filter-label">Filtrer par statut</label>
                    <select name="statut" id="statut" class="form-control custom-select-box">
                        <option value="" {{ selectedStatut == '' ? 'selected' : '' }}>Tous les statuts</option>
                        <option value="EN_ATTENTE" {{ selectedStatut == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                        <option value="CONFIRMEE" {{ selectedStatut == 'CONFIRMEE' ? 'selected' : '' }}>Confirmée</option>
                        <option value="ANNULEE" {{ selectedStatut == 'ANNULEE' ? 'selected' : '' }}>Annulée</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-filter btn-block">Filtrer</button>
                </div>
            </form>
        </div>

        {% if reservations|length > 0 %}
            <div class="row">
                {% for reservation in reservations %}
                    {% set statut = reservation.statut|default('EN_ATTENTE')|upper %}
                    {% set paymentStatus = reservation.paymentStatus|default('NON_PAYEE')|upper %}
                    {% set voyage = reservation.voyage ?? null %}
                    {% set imagePath = voyage and voyage.imageUrl ? voyage.imageUrl : 'front/pacific/images/destination-1.jpg' %}

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="reservation-card">
                            <div class="reservation-image-wrap">
                                <div class="reservation-image"
                                     style="background-image: url('{% if imagePath starts with 'http' %}{{ imagePath }}{% else %}{{ asset(imagePath) }}{% endif %}');">
                                </div>
                                <div class="reservation-overlay"></div>

                                <div class="reservation-badges">
                                    <span class="res-badge
                                        {% if statut == 'CONFIRMEE' %}
                                            badge-confirmed
                                        {% elseif statut == 'ANNULEE' %}
                                            badge-cancelled
                                        {% else %}
                                            badge-pending
                                        {% endif %}
                                    ">
                                        {% if statut == 'CONFIRMEE' %}
                                            Confirmée
                                        {% elseif statut == 'ANNULEE' %}
                                            Annulée
                                        {% else %}
                                            En attente
                                        {% endif %}
                                    </span>

                                    <span class="res-badge
                                        {% if paymentStatus == 'PAYEE' %}
                                            badge-paid
                                        {% else %}
                                            badge-unpaid
                                        {% endif %}
                                    ">
                                        {% if paymentStatus == 'PAYEE' %}
                                            Payée
                                        {% else %}
                                            Non payée
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="reservation-image-content">
                                    <div class="res-label">Réservation du</div>
                                    <div class="res-date">
                                        {{ reservation.dateReservation ? reservation.dateReservation|date('Y-m-d') : '-' }}
                                    </div>
                                    <div class="res-time">
                                        {{ reservation.dateReservation ? reservation.dateReservation|date('H:i') : '' }}
                                    </div>
                                </div>
                            </div>

                            <div class="reservation-content">
                                <h3 class="reservation-title">
                                    {{ voyage ? voyage.titre : 'Voyage introuvable' }}
                                </h3>

                                <div class="reservation-actions">
                                    <a href="{{ path('app_front_reservation_detail', {'id': reservation.id}) }}" class="btn btn-detail">
                                        Détail
                                    </a>

                                    <button
                                        type="button"
                                        class="btn btn-qr qr-popup-btn"
                                        data-qr-url="{{ path('app_reservation_qrcode', {'id': reservation.id}) }}"
                                        data-download-url="{{ path('app_reservation_qrcode_download', {'id': reservation.id}) }}"
                                        data-voyage-title="{{ voyage ? voyage.titre|e('html_attr') : 'Réservation' }}"
                                        data-reservation-id="{{ reservation.id }}">
                                        QR Code
                                    </button>

                                    {% if statut != 'ANNULEE' and statut != 'CONFIRMEE' and paymentStatus != 'PAYEE' %}
                                        <form method="post"
                                              action="{{ path('app_front_annuler_reservation', {'id': reservation.id}) }}"
                                              class="d-inline-block cancel-reservation-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('annuler_reservation_' ~ reservation.id) }}">
                                            <button type="submit" class="btn btn-cancel">
                                                Annuler
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% if reservations.paginationData is defined and reservations.pageCount > 1 %}
                    <div class="col-12">
                        <div class="pagination-wrapper">
                            {{ knp_pagination_render(reservations, 'front/pagination.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="empty-box text-center">
                <h3>Aucune réservation trouvée</h3>
                <p>Il n’y a pas encore de réservation correspondant à ce filtre.</p>
                <a href="{{ path('app_front_voyages', {'currency': currency|default('TND')}) }}" class="btn btn-discover">
                    Découvrir les voyages
                </a>
            </div>
        {% endif %}
    </div>
</section>

<style>
:root {
    --hz-blue-dark: #23779C;
    --hz-blue-light: #3D94CA;
    --hz-green: #81AE8D;
    --hz-gold: #E8B156;
    --hz-beige: #DACEB6;
    --hz-border: #E8E3D8;
    --hz-text: #1F2937;
    --hz-muted: #6B7280;
}

.reservations-page {
    background: #f9fafb;
}

.section-heading .subheading {
    color: #e76f51;
    font-weight: 700;
    display: inline-block;
    margin-bottom: 8px;
}

.section-heading h2 {
    color: var(--hz-text);
    font-weight: 800;
}

.filter-box {
    background: #fff;
    border: 1px solid var(--hz-border);
    border-radius: 26px;
    padding: 22px;
    box-shadow: 0 10px 24px rgba(35, 119, 156, 0.06);
}

.filter-label {
    display: block;
    font-weight: 700;
    color: var(--hz-text);
    margin-bottom: 10px;
}

.custom-select-box {
    height: 56px;
    border-radius: 14px;
    border: 1px solid #dce6ee;
    box-shadow: none !important;
}

.btn-filter {
    background: var(--hz-blue-dark);
    color: #fff !important;
    border-radius: 14px;
    height: 56px;
    font-weight: 700;
    border: none;
}

.btn-filter:hover {
    background: #1d6483;
    color: #fff !important;
}

.reservation-card {
    background: #fff;
    border: 1px solid var(--hz-border);
    border-radius: 26px;
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(35, 119, 156, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.reservation-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 30px rgba(35, 119, 156, 0.12);
}

.reservation-image-wrap {
    position: relative;
    height: 260px;
    overflow: hidden;
}

.reservation-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
}

.reservation-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72), rgba(0,0,0,0.12));
}

.reservation-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    z-index: 2;
}

.res-badge {
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
}

.badge-confirmed {
    background: rgba(129, 174, 141, 0.92);
}

.badge-cancelled {
    background: rgba(232, 177, 86, 0.92);
}

.badge-pending {
    background: rgba(35, 119, 156, 0.92);
}

.badge-paid {
    background: rgba(129, 174, 141, 0.92);
}

.badge-unpaid {
    background: rgba(232, 177, 86, 0.92);
}

.reservation-image-content {
    position: absolute;
    left: 22px;
    bottom: 20px;
    z-index: 2;
    color: #fff;
}

.res-label {
    font-size: 13px;
    opacity: 0.95;
}

.res-date {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.1;
}

.res-time {
    margin-top: 6px;
    font-size: 14px;
    opacity: 0.95;
}

.reservation-content {
    padding: 24px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.reservation-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--hz-text);
    margin-bottom: 18px;
}

.reservation-actions {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
}

.btn-detail,
.btn-qr,
.btn-cancel,
.btn-discover {
    border: none;
    border-radius: 14px;
    padding: 11px 18px;
    font-weight: 700;
    text-decoration: none !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: 0.25s ease;
    cursor: pointer;
}

.btn-detail {
    background: var(--hz-blue-dark);
    color: #fff !important;
}

.btn-detail:hover {
    background: #1d6483;
    color: #fff !important;
}

.btn-qr {
    background: var(--hz-green);
    color: #fff !important;
}

.btn-qr:hover {
    background: #709b7b;
    color: #fff !important;
    transform: translateY(-2px);
}

.btn-cancel {
    background: var(--hz-gold);
    color: #fff !important;
}

.btn-cancel:hover {
    background: #d79f42;
    color: #fff !important;
}

.empty-box {
    background: #fff;
    border: 1px solid var(--hz-border);
    border-radius: 28px;
    padding: 60px 30px;
    box-shadow: 0 10px 24px rgba(35, 119, 156, 0.06);
}

.empty-box h3 {
    color: var(--hz-text);
    font-weight: 800;
    margin-bottom: 14px;
}

.empty-box p {
    color: var(--hz-muted);
    margin-bottom: 24px;
}

.btn-discover {
    background: var(--hz-blue-dark);
    color: #fff !important;
}

.btn-discover:hover {
    background: #1d6483;
    color: #fff !important;
}

.pagination-wrapper {
    margin-top: 30px;
    display: flex;
    justify-content: center;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-left: 0;
    list-style: none;
    margin: 0;
}

.page-item {
    list-style: none;
}

.page-item .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    background: #f1f3f5;
    color: #7a8a99;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    border: none;
    box-shadow: none;
    transition: all 0.25s ease;
}

.page-item .page-link:hover {
    background: #e7ebef;
    color: #23779C;
    text-decoration: none;
}

.page-item.active .page-link {
    background: #23779C;
    color: #ffffff;
    box-shadow: 0 6px 14px rgba(35, 119, 156, 0.25);
}

.page-item.disabled .page-link {
    background: #f1f3f5;
    color: #b8c0c8;
    pointer-events: none;
    opacity: 1;
}

.page-item:first-child .page-link,
.page-item:last-child .page-link {
    padding: 0 24px;
}

.qr-popup-image-box {
    background: linear-gradient(145deg, #ffffff, #f6f8fb);
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    padding: 18px;
    display: inline-block;
    box-shadow: 0 10px 24px rgba(35, 119, 156, 0.08);
}

.qr-popup-help {
    margin-top: 15px;
    color: #6B7280;
    font-size: 15px;
}

@media (max-width: 768px) {
    .reservation-image-wrap {
        height: 230px;
    }

    .res-date {
        font-size: 20px;
    }

    .reservation-actions {
        gap: 8px;
    }

    .page-item .page-link {
        min-width: 46px;
        height: 46px;
        padding: 0 18px;
        font-size: 0.95rem;
    }
}
</style>

{% endblock %}
{% block javascripts %}
    {{ parent() }}
    
    {# Ajouter SweetAlert2 #}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const qrButtons = document.querySelectorAll('.qr-popup-btn');

            qrButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    const qrUrl = this.dataset.qrUrl;
                    const downloadUrl = this.dataset.downloadUrl;
                    const voyageTitle = this.dataset.voyageTitle;

                    Swal.fire({
                        title: 'QR Code - ' + voyageTitle,
                        html: `
                            <div style="text-align:center;">
                                <div class="qr-popup-image-box">
                                    <div id="qrLoader">Chargement...</div>
                                    <img id="qrImage" src="" style="max-width:240px;width:100%;display:none;">
                                </div>
                                <p class="qr-popup-help">
                                    Scannez ce QR code pour accéder rapidement au détail.
                                </p>
                            </div>
                        `,
                        showCloseButton: true,
                        showCancelButton: true,
                        confirmButtonText: 'Télécharger',
                        cancelButtonText: 'Fermer',
                        confirmButtonColor: '#23779C',
                        cancelButtonColor: '#DACEB6',
                        width: 500,

                        didOpen: () => {
                            const img = document.getElementById('qrImage');
                            const loader = document.getElementById('qrLoader');

                            img.onload = function () {
                                loader.style.display = 'none';
                                img.style.display = 'block';
                            };

                            img.onerror = function () {
                                loader.innerHTML = "Erreur de chargement du QR code";
                            };

                            img.src = qrUrl + '?t=' + new Date().getTime();
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.open(downloadUrl, '_blank');
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}