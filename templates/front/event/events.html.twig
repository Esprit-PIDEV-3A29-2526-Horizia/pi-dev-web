{% extends 'base_front.html.twig' %}

{% block title %}Events - Pacific Travel Agency{% endblock %}

{% block body %}
<section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('{{ asset('assets/images/bg_1.jpg') }}');">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-center">
      <div class="col-md-9 ftco-animate pb-5 text-center">
        <p class="breadcrumbs">
          <span class="mr-2"><a href="{{ path('app_home') }}">Home <i class="fa fa-chevron-right"></i></a></span>
          <span>Events <i class="fa fa-chevron-right"></i></span>
        </p>
        <h1 class="mb-0 bread">Our Events</h1>
      </div>
    </div>
  </div>
</section>

<section class="ftco-section ftco-no-pb">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="search-wrap-1 ftco-animate">
          <form method="get" action="{{ path('app_front_events') }}" class="search-property-1">
            <div class="row no-gutters">
              <div class="col-lg d-flex">
                <div class="form-group p-4 border-0">
                  <label>Search Event</label>
                  <div class="form-field">
                    <div class="icon"><span class="fa fa-search"></span></div>
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by title, location or category"
                           value="{{ search ?? '' }}">
                  </div>
                </div>
              </div>
              <div class="col-lg d-flex">
                <div class="form-group p-4">
                  <label>Price Limit</label>
                  <div class="form-field">
                    <div class="select-wrap">
                      <div class="icon"><span class="fa fa-chevron-down"></span></div>
                      <select name="price_limit" class="form-control">
                        <option value="">All prices</option>
                        <option value="50"   {{ price_limit == 50   ? 'selected' : '' }}>50 TND or less</option>
                        <option value="100"  {{ price_limit == 100  ? 'selected' : '' }}>100 TND or less</option>
                        <option value="200"  {{ price_limit == 200  ? 'selected' : '' }}>200 TND or less</option>
                        <option value="500"  {{ price_limit == 500  ? 'selected' : '' }}>500 TND or less</option>
                        <option value="1000" {{ price_limit == 1000 ? 'selected' : '' }}>1000 TND or less</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>
              <div class="col-lg d-flex">
                <div class="form-group d-flex w-100 border-0">
                  <div class="form-field w-100 align-items-center d-flex">
                    <input type="submit" value="Search"
                           class="align-self-stretch form-control btn btn-primary">
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="ftco-section">
  <div class="container">
    <div class="row">
      {% for event in events %}
      <div class="col-md-4 ftco-animate">
        <div class="project-wrap hotel">

          <a href="{{ path('app_front_event_show', {id: event.getId_event()}) }}"
             class="img"
             style="background-image: url({{ event.getImage_url() ? event.getImage_url() : asset('assets/images/hotel-resto-1.jpg') }});">
            <span class="price">{{ event.getPrix() }} TND/person</span>
          </a>

          <div class="text p-4">
            <p class="star mb-2">
              {% for i in 1..5 %}
                <span class="fa fa-star{{ i <= 4 ? '' : '-o' }}"></span>
              {% endfor %}
            </p>
            <span class="days">
              {{ event.getDate_debut()|date('d M Y') }} - {{ event.getDate_fin()|date('d M Y') }}
            </span>
            <h3>
              <a href="{{ path('app_front_event_show', {id: event.getId_event()}) }}">
                {{ event.getTitre() }}
              </a>
            </h3>
            <p class="location">
              <span class="fa fa-map-marker"></span> {{ event.getLocation() }}
            </p>
            <ul>
              <li><span class="flaticon-users"></span> {{ event.getCapacite_max() }} places</li>
              <li><span class="flaticon-ticket"></span> {{ event.getPlaces_restantes() }} restantes</li>
              <li><span class="flaticon-price-tag"></span> {{ event.getCategorie() }}</li>
            </ul>

            {# ── Action buttons ── #}
            <div class="d-flex mt-3" style="gap:8px;">
              <a href="{{ path('app_front_event_show', {id: event.getId_event()}) }}"
                 class="btn btn-primary py-2 px-3" style="flex:1; text-align:center;">
                <span class="fa fa-eye mr-1"></span> Voir détails
              </a>
              {% if event.getPlaces_restantes() > 0 %}
                <a href="{{ path('app_participation_new', {id: event.getId_event()}) }}"
                   class="btn btn-secondary py-2 px-3" style="flex:1; text-align:center;">
                  <span class="fa fa-ticket mr-1"></span> S'inscrire
                </a>
              {% else %}
                <button class="btn btn-secondary py-2 px-3" style="flex:1;" disabled>
                  Complet
                </button>
              {% endif %}
            </div>

          </div>
        </div>
      </div>
      {% else %}
      <div class="col-md-12 text-center">
        <p>No events found.</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="ftco-intro ftco-section ftco-no-pt">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-12 text-center">
        <div class="img" style="background-image: url({{ asset('assets/images/bg_2.jpg') }});">
          <div class="overlay"></div>
          <h2>Join Our Amazing Events</h2>
          <p>Discover unique experiences and create unforgettable memories with us</p>
          <p class="mb-0">
            <a href="{{ path('app_front_events') }}" class="btn btn-primary px-4 py-3">
              View All Events
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
